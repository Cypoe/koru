// std/sym — symbolic scalar expressions with a canonical normal form.
//
// A `sym` is a CANONICAL expression string over the decimal kernel:
//   atoms    π, e, φ            (named constants — derive to zero)
//   variable x                  (the free variable — sym:deriv w.r.t. x)
//   radical  √( <expr> )
//   inverse  inv( <expr> )      (a/b normalizes to a*inv(b))
//   product  ( <e1> * <e2> * ... )   coefficient first, then factors sorted
//   sum      ( <e1> + <e2> + ... )   constant term first, then terms sorted
//   decimal  a std/num canonical literal — 0e0 | [-]D[.DDD]e[-]E
//
// The normal form is the contract: value-equivalence is string equality,
// same law as std/num. NF rules applied at build time:
//   - nested add/mul flatten
//   - sum children group by structural base: π + π -> (2e0*π),
//     (2e0*π)+(3e0*π) -> (5e0*π); decimals fold into one constant term
//   - product decimals fold into one coefficient; coeff 0 -> 0e0,
//     coeff 1 drops; f and inv(f) cancel pairwise
//   - inv(inv(x)) -> x; inv distributes over product children;
//     inv(dec) folds to a decimal iff the mantissa's prime factors are all
//     in {2,5} (1/4 -> 2.5e-1 exact; inv(3) stays symbolic — no silent
//     inexact)
//   - √(dec>=0) folds iff a perfect square (√(0.25) -> 5e-1); a negative
//     decimal radicand refuses on |neg-root
//   - equal √ factors pair to their radicand (√2*√2 -> 2) when the
//     radicand is provably nonneg (dec >= 0 or a positive atom)
//   - coeff*inv(dec) reduces the rational to lowest terms, so the canon
//     for a value is the reduced fraction: 4*inv(6e1) -> inv(1.5e1),
//     which is what a fresh "1/15" produces
//   - inv(-d) -> -1*inv(d): the sign lives on the coefficient
//   - i is the imaginary atom (index 4); Q(i) constants form a ring:
//     i*i -> -1, (a+bi)(c+di) folds to its Q(i) product, inv(a+bi) is
//     conjugate over norm, sqrt(-d) -> i*sqrt(|d|)
//   - exp(u) is the exponential node: exp(0) -> 1, exp(1) -> e,
//     exp(log u) -> u, exp(c*log u) -> u^c for small |c|, exp(u)*exp(v)
//     -> exp(u+v), inv(exp u) -> exp(-u); log of a Q(i) constant is
//     (1/2)log(a^2+b^2) + i*arg on the principal branch
//
// What NF does NOT do: no distributive factoring, no trig/ident tables,
// no power node (π*π stays a product — a pow canon is a later rung).
// Those are the deriv/discovery rungs, not canon mechanics.
//
// Marks: sym-owned strings ride <sexpr!>, issued by lit/parse and every op,
// consumed linearly by ops, discharged by free, swapped to <allocated!> by
// render — the same discipline as std/num:exact.

~import std/io
~import std/num
~part supgen
~part certcomp
~part certreg
~part certgen
~part rel

const std = @import("std");
const BI = std.math.big.int.Managed;

const Dec = struct {
    neg: bool,
    m: BI,
    e: i64,
};

fn decDeinit(d: *Dec) void {
    d.m.deinit();
}

// ============================================================================
// Canonical decimal leaf — verbatim copy of std/num's Dec helpers (the
// honest-seam ruling: data crosses, logic stays in-module; a shared helper
// layer is a named debt, not a reason to couple modules).
// ============================================================================

fn decParse(alloc: std.mem.Allocator, s: []const u8) !Dec {
    var t = std.mem.trim(u8, s, " \t\r\n");
    if (t.len == 0) return error.BadNumber;

    var neg = false;
    if (t[0] == '+' or t[0] == '-') {
        neg = t[0] == '-';
        t = t[1..];
    }
    if (t.len == 0) return error.BadNumber;

    var sci: i64 = 0;
    if (std.mem.indexOfAny(u8, t, "eE")) |ei| {
        const es = t[ei + 1 ..];
        t = t[0..ei];
        if (es.len == 0) return error.BadNumber;
        sci = std.fmt.parseInt(i64, es, 10) catch return error.BadNumber;
    }

    var frac_len: i64 = 0;
    var digits = std.ArrayList(u8).initCapacity(alloc, t.len) catch return error.OutOfMemory;
    defer digits.deinit(alloc);

    var seen_dot = false;
    var seen_digit = false;
    for (t) |c| {
        if (c == '.') {
            if (seen_dot) return error.BadNumber;
            seen_dot = true;
            continue;
        }
        if (!std.ascii.isDigit(c)) return error.BadNumber;
        try digits.append(alloc, c);
        seen_digit = true;
        if (seen_dot) frac_len += 1;
    }
    if (!seen_digit) return error.BadNumber;

    return decFromDigits(alloc, digits.items, sci - frac_len, neg);
}

fn decFromDigits(alloc: std.mem.Allocator, raw: []const u8, e: i64, neg: bool) !Dec {
    var start: usize = 0;
    while (start < raw.len and raw[start] == '0') start += 1;
    var end: usize = raw.len;
    while (end > start and raw[end - 1] == '0') end -= 1;

    if (start == end) {
        const m = try BI.initSet(alloc, 0);
        return .{ .neg = false, .m = m, .e = 0 };
    }

    const stripped_trailing = raw.len - end;
    var m = try BI.initSet(alloc, 0);
    errdefer m.deinit();
    try m.setString(10, raw[start..end]);
    return .{ .neg = neg, .m = m, .e = e + @as(i64, @intCast(stripped_trailing)) };
}

fn decToString(alloc: std.mem.Allocator, d: *const Dec) ![]u8 {
    if (d.m.eqlZero()) return alloc.dupe(u8, "0e0");

    const ds = try d.m.toString(alloc, 10, .lower);
    defer alloc.free(ds);

    const adj: i64 = d.e + @as(i64, @intCast(ds.len)) - 1;

    var out = std.ArrayList(u8).initCapacity(alloc, ds.len + 24) catch return error.OutOfMemory;
    errdefer out.deinit(alloc);
    if (d.neg) try out.append(alloc, '-');
    try out.append(alloc, ds[0]);
    if (ds.len > 1) {
        try out.append(alloc, '.');
        try out.appendSlice(alloc, ds[1..]);
    }
    try out.append(alloc, 'e');
    var buf: [24]u8 = undefined;
    const es = std.fmt.bufPrint(&buf, "{d}", .{adj}) catch unreachable;
    try out.appendSlice(alloc, es);
    return out.toOwnedSlice(alloc);
}

fn pow10(alloc: std.mem.Allocator, k: i64) !BI {
    var r = try BI.initSet(alloc, 1);
    errdefer r.deinit();
    var ten = try BI.initSet(alloc, 10);
    defer ten.deinit();
    var i: i64 = 0;
    while (i < k) : (i += 1) {
        try r.mul(&r, &ten);
    }
    return r;
}

fn biGcd(alloc: std.mem.Allocator, a: *const BI, b: *const BI) !BI {
    var x = try a.clone();
    errdefer x.deinit();
    x.abs();
    var y = try b.clone();
    errdefer y.deinit();
    y.abs();
    while (!y.eqlZero()) {
        var q = BI.init(alloc) catch return error.OutOfMemory;
        var r = BI.init(alloc) catch {
            q.deinit();
            return error.OutOfMemory;
        };
        q.divTrunc(&r, &x, &y) catch {
            q.deinit();
            r.deinit();
            return error.OutOfMemory;
        };
        q.deinit();
        x.deinit();
        x = y;
        y = r;
    }
    y.deinit();
    return x;
}

fn decAdd(alloc: std.mem.Allocator, a: *const Dec, b: *const Dec) !Dec {
    const e_min = @min(a.e, b.e);
    var am = try a.m.clone();
    defer am.deinit();
    var bm = try b.m.clone();
    defer bm.deinit();
    if (a.e > e_min) {
        var p = try pow10(alloc, a.e - e_min);
        defer p.deinit();
        try am.mul(&am, &p);
    }
    if (b.e > e_min) {
        var p = try pow10(alloc, b.e - e_min);
        defer p.deinit();
        try bm.mul(&bm, &p);
    }
    if (a.neg) am.negate();
    if (b.neg) bm.negate();
    var r = try BI.init(alloc);
    defer r.deinit();
    try r.add(&am, &bm);

    const rneg = !r.isPositive();
    var m_abs = try r.clone();
    m_abs.abs();
    defer m_abs.deinit();
    const ds = try m_abs.toString(alloc, 10, .lower);
    defer alloc.free(ds);
    return decFromDigits(alloc, ds, e_min, rneg);
}

fn decMul(alloc: std.mem.Allocator, a: *const Dec, b: *const Dec) !Dec {
    var r = try BI.init(alloc);
    defer r.deinit();
    try r.mul(&a.m, &b.m);
    const ds = try r.toString(alloc, 10, .lower);
    defer alloc.free(ds);
    return decFromDigits(alloc, ds, a.e + b.e, a.neg != b.neg);
}

// Exact decimal reciprocal: m must divide a power of 10 — i.e. after
// stripping factors 2 and 5 the mantissa is 1. Result mantissa = 2^n5*5^n2,
// exponent = -e - n2 - n5. Returns null otherwise (inv stays symbolic).
fn decRecipExact(alloc: std.mem.Allocator, d: *const Dec) !?Dec {
    var m = try d.m.clone();
    defer m.deinit();
    var two = try BI.initSet(alloc, 2);
    defer two.deinit();
    var five = try BI.initSet(alloc, 5);
    defer five.deinit();
    var q = try BI.init(alloc);
    defer q.deinit();
    var rem = try BI.init(alloc);
    defer rem.deinit();
    var n2: i64 = 0;
    var n5: i64 = 0;
    while (true) {
        try q.divTrunc(&rem, &m, &two);
        if (!rem.eqlZero()) break;
        m.deinit();
        m = try q.clone();
        n2 += 1;
    }
    while (true) {
        try q.divTrunc(&rem, &m, &five);
        if (!rem.eqlZero()) break;
        m.deinit();
        m = try q.clone();
        n5 += 1;
    }
    var one = try BI.initSet(alloc, 1);
    defer one.deinit();
    if (!m.eql(one)) return null;
    var num = try BI.initSet(alloc, 1);
    defer num.deinit();
    var i: i64 = 0;
    while (i < n5) : (i += 1) try num.mul(&num, &two);
    i = 0;
    while (i < n2) : (i += 1) try num.mul(&num, &five);
    const ds = try num.toString(alloc, 10, .lower);
    defer alloc.free(ds);
    return @as(?Dec, try decFromDigits(alloc, ds, -d.e - n2 - n5, d.neg));
}

// sqrt(d) when d is a dec >= 0 whose value is a perfect square; null
// otherwise. value = m*10^e is a square iff e is even and m is a square
// (e odd absorbs a factor 10 into m first).
fn decSqrtExact(alloc: std.mem.Allocator, d: *const Dec) !?Dec {
    var m = try d.m.clone();
    defer m.deinit();
    var e = d.e;
    if (@mod(e, 2) != 0) {
        var ten = try BI.initSet(alloc, 10);
        defer ten.deinit();
        try m.mul(&m, &ten);
        e -= 1;
    }
    var s = try BI.init(alloc);
    defer s.deinit();
    try s.sqrt(&m);
    var s2 = try BI.init(alloc);
    defer s2.deinit();
    try s2.mul(&s, &s);
    if (!s2.eql(m)) return null;
    const ds = try s.toString(alloc, 10, .lower);
    defer alloc.free(ds);
    return @as(?Dec, try decFromDigits(alloc, ds, @divTrunc(e, 2), false));
}

// ============================================================================
// SNode — the expression tree. Canon strings are the boundary; nodes are
// internal only. Children are heap SNodes owned by their parent.
// ============================================================================

const NodeKind = enum { dec, atom, sq, inv, log, atan, exp, add, mul };

const SNode = struct {
    kind: NodeKind,
    dec: Dec = undefined,            // kind == .dec
    atom: u8 = 0,                    // kind == .atom: 0=pi, 1=e, 2=phi, 3=x, 4=i; >=5 named generators
    kids: []*SNode = &.{},           // kind == .add/.mul
    kid: *SNode = undefined,         // kind == .sq/.inv/.log/.atan/.exp
};

fn nodeNew(alloc: std.mem.Allocator, kind: NodeKind) !*SNode {
    const n = try alloc.create(SNode);
    n.* = .{ .kind = kind };
    return n;
}

fn nodeDec(alloc: std.mem.Allocator, d: Dec) !*SNode {
    const n = try nodeNew(alloc, .dec);
    n.dec = d;
    return n;
}

fn nodeAtom(alloc: std.mem.Allocator, a: u8) !*SNode {
    const n = try nodeNew(alloc, .atom);
    n.atom = a;
    return n;
}

fn nodeUnary(alloc: std.mem.Allocator, kind: NodeKind, k: *SNode) !*SNode {
    const n = try nodeNew(alloc, kind);
    n.kid = k;
    return n;
}

fn nodeList(alloc: std.mem.Allocator, kind: NodeKind, kids: []*SNode) !*SNode {
    const n = try nodeNew(alloc, kind);
    n.kids = kids;
    return n;
}

fn nodeFree(alloc: std.mem.Allocator, n: *SNode) void {
    switch (n.kind) {
        .dec => n.dec.m.deinit(),
        .add, .mul => {
            for (n.kids) |k| nodeFree(alloc, k);
            alloc.free(n.kids);
        },
        .sq, .inv, .log, .atan, .exp => nodeFree(alloc, n.kid),
        else => {},
    }
    alloc.destroy(n);
}

fn nodeClone(alloc: std.mem.Allocator, n: *const SNode) anyerror!*SNode {
    switch (n.kind) {
        .dec => return nodeDec(alloc, .{ .neg = n.dec.neg, .m = try n.dec.m.clone(), .e = n.dec.e }),
        .atom => return nodeAtom(alloc, n.atom),
        .sq, .inv, .log, .atan, .exp => return nodeUnary(alloc, n.kind, try nodeClone(alloc, n.kid)),
        .add, .mul => {
            const kids = try alloc.alloc(*SNode, n.kids.len);
            var built: usize = 0;
            errdefer {
                for (kids[0..built]) |k| nodeFree(alloc, k);
                alloc.free(kids);
            }
            for (n.kids, 0..) |k, i| {
                kids[i] = try nodeClone(alloc, k);
                built += 1;
            }
            return nodeList(alloc, n.kind, kids);
        },
    }
}

// ============================================================================
// Canon render
// ============================================================================

const ATOMS = [_][]const u8{ "π", "e", "φ", "x", "i" };

fn canonWrite(alloc: std.mem.Allocator, n: *const SNode, out: *std.ArrayList(u8)) !void {
    return canonWriteG(alloc, n, null, out);
}

fn canonWriteG(alloc: std.mem.Allocator, n: *const SNode, greg: ?*const GReg, out: *std.ArrayList(u8)) !void {
    switch (n.kind) {
        .dec => {
            const s = try decToString(alloc, &n.dec);
            defer alloc.free(s);
            try out.appendSlice(alloc, s);
        },
        .atom => {
            if (n.atom < 5) {
                try out.appendSlice(alloc, ATOMS[n.atom]);
            } else if (greg) |g| {
                try out.appendSlice(alloc, "g(");
                try out.appendSlice(alloc, g.names.items[n.atom - 5]);
                try out.append(alloc, ')');
            } else {
                var buf: [16]u8 = undefined;
                const ds = std.fmt.bufPrint(&buf, "g#{d}", .{n.atom - 5}) catch unreachable;
                try out.appendSlice(alloc, ds);
            }
        },
        .sq => {
            try out.appendSlice(alloc, "√(");
            try canonWriteG(alloc, n.kid, greg, out);
            try out.append(alloc, ')');
        },
        .inv => {
            try out.appendSlice(alloc, "inv(");
            try canonWriteG(alloc, n.kid, greg, out);
            try out.append(alloc, ')');
        },
        .log => {
            try out.appendSlice(alloc, "log(");
            try canonWriteG(alloc, n.kid, greg, out);
            try out.append(alloc, ')');
        },
        .atan => {
            try out.appendSlice(alloc, "atan(");
            try canonWriteG(alloc, n.kid, greg, out);
            try out.append(alloc, ')');
        },
        .exp => {
            try out.appendSlice(alloc, "exp(");
            try canonWriteG(alloc, n.kid, greg, out);
            try out.append(alloc, ')');
        },
        .add, .mul => {
            try out.append(alloc, '(');
            const sep: []const u8 = if (n.kind == .add) "+" else "*";
            for (n.kids, 0..) |k, i| {
                if (i > 0) try out.appendSlice(alloc, sep);
                try canonWriteG(alloc, k, greg, out);
            }
            try out.append(alloc, ')');
        },
    }
}

fn canonOf(alloc: std.mem.Allocator, n: *const SNode) ![]u8 {
    return canonOfG(alloc, n, null);
}

fn canonOfG(alloc: std.mem.Allocator, n: *const SNode, greg: ?*const GReg) ![]u8 {
    var out = std.ArrayList(u8){};
    errdefer out.deinit(alloc);
    try canonWriteG(alloc, n, greg, &out);
    return out.toOwnedSlice(alloc);
}

// ============================================================================
// Parser — user spelling to a raw tree, then normalize.
//   expr := sum ; sum := prod (('+'|'-') prod)* ; prod := unary (('*'|'/') unary)*
//   unary := '-' unary | factor
//   factor := '√' '(' expr ')' | 'inv' '(' expr ')' | '(' expr ')' | atom | decimal
// ============================================================================

// Generator registry — atoms 4.. index a declared generator (0=pi,1=e,
// 2=phi,3=x). GReg is per-call state built from a rel:v1 registry text;
// SNode stores only the index, so every tree in one derivation shares one
// registry. laws[i] == null means the generator is declared but lawless —
// deriving it refuses by name.
const GReg = struct {
    names: std.ArrayList([]const u8),
    laws: std.ArrayList(?*SNode),
};

const ParseCtx = struct {
    alloc: std.mem.Allocator,
    s: []const u8,
    i: usize = 0,
    greg: ?*GReg = null,
};

fn list2(alloc: std.mem.Allocator, a: *SNode, b: *SNode) ![]*SNode {
    const l = try alloc.alloc(*SNode, 2);
    l[0] = a;
    l[1] = b;
    return l;
}

fn negNode(alloc: std.mem.Allocator, inner: *SNode) !*SNode {
    const d = blk: {
        var m = try BI.initSet(alloc, 1);
        errdefer m.deinit();
        break :blk try nodeDec(alloc, .{ .neg = true, .m = m, .e = 0 });
    };
    errdefer nodeFree(alloc, d);
    const kids = try list2(alloc, d, inner);
    errdefer alloc.free(kids);
    return nodeList(alloc, .mul, kids);
}

fn parseExpr(c: *ParseCtx) anyerror!*SNode {
    var lhs = try parseProd(c);
    errdefer nodeFree(c.alloc, lhs);
    while (c.i < c.s.len and (c.s[c.i] == '+' or c.s[c.i] == '-')) {
        const minus = c.s[c.i] == '-';
        c.i += 1;
        var rhs = try parseProd(c);
        errdefer nodeFree(c.alloc, rhs);
        if (minus) rhs = try negNode(c.alloc, rhs);
        const kids = try list2(c.alloc, lhs, rhs);
        errdefer c.alloc.free(kids);
        lhs = try nodeList(c.alloc, .add, kids);
    }
    return lhs;
}

fn parseProd(c: *ParseCtx) anyerror!*SNode {
    var lhs = try parseUnary(c);
    errdefer nodeFree(c.alloc, lhs);
    while (c.i < c.s.len and (c.s[c.i] == '*' or c.s[c.i] == '/')) {
        const div = c.s[c.i] == '/';
        c.i += 1;
        var rhs = try parseUnary(c);
        errdefer nodeFree(c.alloc, rhs);
        if (div) rhs = try nodeUnary(c.alloc, .inv, rhs);
        const kids = try list2(c.alloc, lhs, rhs);
        errdefer c.alloc.free(kids);
        lhs = try nodeList(c.alloc, .mul, kids);
    }
    return lhs;
}

fn parseUnary(c: *ParseCtx) anyerror!*SNode {
    if (c.i < c.s.len and c.s[c.i] == '-') {
        c.i += 1;
        const inner = try parseUnary(c);
        errdefer nodeFree(c.alloc, inner);
        return negNode(c.alloc, inner);
    }
    return parseFactor(c);
}

fn utf8At(s: []const u8, i: usize) u21 {
    const b = s[i];
    if (b < 0x80) return b;
    if (b < 0xE0) {
        if (i + 1 >= s.len) return 0xFFFD;
        return @as(u21, b & 0x1F) << 6 | (s[i + 1] & 0x3F);
    }
    if (i + 2 >= s.len) return 0xFFFD;
    return @as(u21, b & 0x0F) << 12 | (@as(u21, s[i + 1] & 0x3F) << 6) | (s[i + 2] & 0x3F);
}

fn utf8Len(b: u8) usize {
    if (b < 0x80) return 1;
    if (b < 0xE0) return 2;
    return 3;
}

fn parseFactor(c: *ParseCtx) anyerror!*SNode {
    if (c.i >= c.s.len) return error.Bad;
    const cp = utf8At(c.s, c.i);
    if (cp == '√') {
        c.i += utf8Len(c.s[c.i]);
        if (c.i >= c.s.len or c.s[c.i] != '(') return error.Bad;
        c.i += 1;
        const inner = try parseExpr(c);
        errdefer nodeFree(c.alloc, inner);
        if (c.i >= c.s.len or c.s[c.i] != ')') return error.Bad;
        c.i += 1;
        return nodeUnary(c.alloc, .sq, inner);
    }
    if (cp == '(') {
        c.i += 1;
        const inner = try parseExpr(c);
        errdefer nodeFree(c.alloc, inner);
        if (c.i >= c.s.len or c.s[c.i] != ')') return error.Bad;
        c.i += 1;
        return inner;
    }
    if (cp == 'π') {
        c.i += utf8Len(c.s[c.i]);
        return nodeAtom(c.alloc, 0);
    }
    if (cp == 'φ') {
        c.i += utf8Len(c.s[c.i]);
        return nodeAtom(c.alloc, 2);
    }
    if (cp == 'e' and c.i + 3 < c.s.len and c.s[c.i + 1] == 'x' and c.s[c.i + 2] == 'p' and c.s[c.i + 3] == '(') {
        c.i += 4;
        const inner = try parseExpr(c);
        errdefer nodeFree(c.alloc, inner);
        if (c.i >= c.s.len or c.s[c.i] != ')') return error.Bad;
        c.i += 1;
        return nodeUnary(c.alloc, .exp, inner);
    }
    if (cp == 'e' and (c.i + 1 >= c.s.len or !std.ascii.isAlphanumeric(c.s[c.i + 1]))) {
        c.i += 1;
        return nodeAtom(c.alloc, 1);
    }
    if (cp == 'x') {
        c.i += 1;
        return nodeAtom(c.alloc, 3);
    }
    if (cp == 'g') {
        if (c.i + 1 >= c.s.len or c.s[c.i + 1] != '(') return error.Bad;
        c.i += 2;
        const start = c.i;
        while (c.i < c.s.len and (std.ascii.isAlphanumeric(c.s[c.i]) or c.s[c.i] == '_')) c.i += 1;
        const nm = c.s[start..c.i];
        if (nm.len == 0) return error.Bad;
        if (c.i >= c.s.len or c.s[c.i] != ')') return error.Bad;
        c.i += 1;
        if (c.greg) |g| {
            for (g.names.items, 0..) |n2, i| {
                if (std.mem.eql(u8, n2, nm)) return nodeAtom(c.alloc, @as(u8, @intCast(5 + i)));
            }
        }
        return error.UnknownGenerator;
    }
    if (std.ascii.isDigit(c.s[c.i]) or c.s[c.i] == '.') {
        // scan the decimal: digits [. digits] [eE [-+] digits]
        var j = c.i;
        while (j < c.s.len and std.ascii.isDigit(c.s[j])) j += 1;
        if (j < c.s.len and c.s[j] == '.') {
            j += 1;
            while (j < c.s.len and std.ascii.isDigit(c.s[j])) j += 1;
        }
        if (j < c.s.len and (c.s[j] == 'e' or c.s[j] == 'E')) {
            var k = j + 1;
            if (k < c.s.len and (c.s[k] == '-' or c.s[k] == '+')) k += 1;
            var had = false;
            while (k < c.s.len and std.ascii.isDigit(c.s[k])) {
                k += 1;
                had = true;
            }
            if (had) j = k;
        }
        var d = decParse(c.alloc, c.s[c.i..j]) catch return error.Bad;
        errdefer decDeinit(&d);
        c.i = j;
        return nodeDec(c.alloc, d);
    }
    if (cp == 'l' and c.i + 3 < c.s.len and c.s[c.i + 1] == 'o' and c.s[c.i + 2] == 'g' and c.s[c.i + 3] == '(') {
        c.i += 4;
        const inner = try parseExpr(c);
        errdefer nodeFree(c.alloc, inner);
        if (c.i >= c.s.len or c.s[c.i] != ')') return error.Bad;
        c.i += 1;
        return nodeUnary(c.alloc, .log, inner);
    }
    if (cp == 'a' and c.i + 4 < c.s.len and c.s[c.i + 1] == 't' and c.s[c.i + 2] == 'a' and c.s[c.i + 3] == 'n' and c.s[c.i + 4] == '(') {
        c.i += 5;
        const inner = try parseExpr(c);
        errdefer nodeFree(c.alloc, inner);
        if (c.i >= c.s.len or c.s[c.i] != ')') return error.Bad;
        c.i += 1;
        return nodeUnary(c.alloc, .atan, inner);
    }
    if (cp == 'i' and c.i + 3 < c.s.len and c.s[c.i + 1] == 'n' and c.s[c.i + 2] == 'v' and c.s[c.i + 3] == '(') {
        c.i += 4;
        const inner = try parseExpr(c);
        errdefer nodeFree(c.alloc, inner);
        if (c.i >= c.s.len or c.s[c.i] != ')') return error.Bad;
        c.i += 1;
        return nodeUnary(c.alloc, .inv, inner);
    }
    if (cp == 'i' and (c.i + 1 >= c.s.len or !std.ascii.isAlphanumeric(c.s[c.i + 1]))) {
        c.i += 1;
        return nodeAtom(c.alloc, 4);
    }
    return error.Bad;
}

// ============================================================================
// Normalization — the NF contract. PURE over the input: reads n and builds a
// fresh normalized tree; the caller keeps and frees the original.
// ============================================================================

fn decZero(alloc: std.mem.Allocator) !Dec {
    return .{ .neg = false, .m = try BI.initSet(alloc, 0), .e = 0 };
}

fn decOneN(alloc: std.mem.Allocator, neg: bool) !Dec {
    return .{ .neg = neg, .m = try BI.initSet(alloc, 1), .e = 0 };
}

fn decIsOne(alloc: std.mem.Allocator, d: *const Dec) !bool {
    var one = try BI.initSet(alloc, 1);
    defer one.deinit();
    return d.m.eql(one) and d.e == 0;
}

// Sort children canonically by rendered bytes (deterministic canon order).
fn sortKids(alloc: std.mem.Allocator, kids: []*SNode) !void {
    const canons = try alloc.alloc([]u8, kids.len);
    defer alloc.free(canons);
    for (kids, 0..) |k, i| canons[i] = try canonOf(alloc, k);
    defer for (canons) |c| alloc.free(c);
    var i: usize = 1;
    while (i < kids.len) : (i += 1) {
        var j = i;
        while (j > 0 and std.mem.order(u8, canons[j], canons[j - 1]) == .lt) : (j -= 1) {
            std.mem.swap(*SNode, &kids[j], &kids[j - 1]);
            std.mem.swap([]u8, &canons[j], &canons[j - 1]);
        }
    }
}

// A node's structural base for sum grouping: the part after stripping a
// leading decimal coefficient. Fresh nodes; coeff is cloned out.
fn splitCoeff(alloc: std.mem.Allocator, n: *const SNode, coeff: *Dec) !*SNode {
    if (n.kind == .dec) {
        coeff.* = .{ .neg = n.dec.neg, .m = try n.dec.m.clone(), .e = n.dec.e };
        return nodeDec(alloc, try decOneN(alloc, false));
    }
    if (n.kind == .mul and n.kids.len >= 2 and n.kids[0].kind == .dec) {
        coeff.* = .{ .neg = n.kids[0].dec.neg, .m = try n.kids[0].dec.m.clone(), .e = n.kids[0].dec.e };
        if (n.kids.len == 2) return nodeClone(alloc, n.kids[1]);
        const rest = try alloc.alloc(*SNode, n.kids.len - 1);
        for (n.kids[1..], 0..) |k, i| rest[i] = try nodeClone(alloc, k);
        return nodeList(alloc, .mul, rest);
    }
    coeff.* = try decOneN(alloc, false);
    return nodeClone(alloc, n);
}

// Build a fresh term node for base * coeff. Borrows both; returns an owned
// node (a clone of base when coeff is +1, else a fresh product).
fn termWithCoeff(alloc: std.mem.Allocator, coeff: *const Dec, base: *const SNode) !*SNode {
    if (!coeff.neg and try decIsOne(alloc, coeff)) {
        return nodeClone(alloc, base);
    }
    const cn = try nodeDec(alloc, .{ .neg = coeff.neg, .m = try coeff.m.clone(), .e = coeff.e });
    errdefer nodeFree(alloc, cn);
    if (base.kind == .mul) {
        const tk = try alloc.alloc(*SNode, base.kids.len + 1);
        tk[0] = cn;
        for (base.kids, 1..) |k, i| tk[i] = try nodeClone(alloc, k);
        return nodeList(alloc, .mul, tk);
    }
    return nodeList(alloc, .mul, try list2(alloc, cn, try nodeClone(alloc, base)));
}

// Q(i) constants: re + im*i with owned Dec limbs. qiConstOf classifies a
// normalized node that provably lives in Q(i): a dec, bare i, c*i, or a sum
// of those. Used by the mul ring-fold and the conjugate lane of inv.
const Qi = struct {
    re: Dec,
    im: Dec,
    fn deinit(z: *Qi) void {
        z.re.m.deinit();
        z.im.m.deinit();
    }
};

fn qiConstOf(alloc: std.mem.Allocator, n: *const SNode) !?Qi {
    switch (n.kind) {
        .dec => return .{ .re = .{ .neg = n.dec.neg, .m = try n.dec.m.clone(), .e = n.dec.e }, .im = try decZero(alloc) },
        .atom => {
            if (n.atom != 4) return null;
            return .{ .re = try decZero(alloc), .im = try decOneN(alloc, false) };
        },
        .mul => {
            if (n.kids.len == 2 and n.kids[0].kind == .dec and n.kids[1].kind == .atom and n.kids[1].atom == 4) {
                return .{ .re = try decZero(alloc), .im = .{ .neg = n.kids[0].dec.neg, .m = try n.kids[0].dec.m.clone(), .e = n.kids[0].dec.e } };
            }
            return null;
        },
        .add => {
            var acc = Qi{ .re = try decZero(alloc), .im = try decZero(alloc) };
            errdefer acc.deinit();
            for (n.kids) |k| {
                var z = (try qiConstOf(alloc, k)) orelse {
                    acc.deinit();
                    return null;
                };
                defer z.deinit();
                const nr = try decAdd(alloc, &acc.re, &z.re);
                const ni = try decAdd(alloc, &acc.im, &z.im);
                acc.re.m.deinit();
                acc.im.m.deinit();
                acc.re = nr;
                acc.im = ni;
            }
            return acc;
        },
        else => return null,
    }
}

// (ar+ai*i)(br+bi*i) = (ar*br - ai*bi) + (ar*bi + ai*br)*i
fn qiMul(alloc: std.mem.Allocator, a: *const Qi, b: *const Qi) !Qi {
    var p1 = try decMul(alloc, &a.re, &b.re);
    var p2 = try decMul(alloc, &a.im, &b.im);
    var p3 = try decMul(alloc, &a.re, &b.im);
    var p4 = try decMul(alloc, &a.im, &b.re);
    if (!p2.m.eqlZero()) p2.neg = !p2.neg;
    defer {
        p1.m.deinit();
        p2.m.deinit();
        p3.m.deinit();
        p4.m.deinit();
    }
    var re = try decAdd(alloc, &p1, &p2);
    errdefer re.m.deinit();
    const im = try decAdd(alloc, &p3, &p4);
    return .{ .re = re, .im = im };
}

// |z|^2 = re^2 + im^2 — always a positive dec for a nonzero Q(i) value.
fn qiNormSq(alloc: std.mem.Allocator, z: *const Qi) !Dec {
    var p1 = try decMul(alloc, &z.re, &z.re);
    defer p1.m.deinit();
    var p2 = try decMul(alloc, &z.im, &z.im);
    defer p2.m.deinit();
    return decAdd(alloc, &p1, &p2);
}

// Two-kid list constructor that CONSUMES a and b on every path — on any
// failure both kids (and the slice) are freed, on success the node owns
// them. Use for raw trees that get normed, where plain errdefers on the
// kids would double-free once the list exists.
fn nodePair(alloc: std.mem.Allocator, kind: NodeKind, a: *SNode, b: *SNode) !*SNode {
    const pair = list2(alloc, a, b) catch |e| {
        nodeFree(alloc, a);
        nodeFree(alloc, b);
        return e;
    };
    errdefer alloc.free(pair);
    return nodeList(alloc, kind, pair) catch |e| {
        nodeFree(alloc, a);
        nodeFree(alloc, b);
        return e;
    };
}

// Emit the canonical node for a Q(i) value. Borrows re/im: dec when im==0,
// c*i (bare i at c=+-1) when re==0, else a const-first two-term sum.
fn qiToNode(alloc: std.mem.Allocator, re: *const Dec, im: *const Dec) !*SNode {
    if (im.m.eqlZero()) {
        return nodeDec(alloc, .{ .neg = re.neg, .m = try re.m.clone(), .e = re.e });
    }
    const in2 = try nodeAtom(alloc, 4);
    defer nodeFree(alloc, in2);
    const it = try termWithCoeff(alloc, im, in2);
    if (re.m.eqlZero()) return it;
    errdefer nodeFree(alloc, it);
    const dn = try nodeDec(alloc, .{ .neg = re.neg, .m = try re.m.clone(), .e = re.e });
    errdefer nodeFree(alloc, dn);
    const pair = try list2(alloc, dn, it);
    errdefer alloc.free(pair);
    return nodeList(alloc, .add, pair);
}

// log of a Q(i) constant: log(a+bi) = (1/2)*log(a^2+b^2) + i*arg(z).
// Pure-imaginary b*i emits log|b| + sign(b)*i*pi/2 directly (cleaner than
// the half-norm form). arg is quadrant-aware: a>0 -> atan(b/a); a<0 ->
// atan(b/a) + sign(b)*pi. Every piece re-norms — atan(1)->pi/4, log(1)->0,
// i*0->0 fold out — so log(i) -> i*pi/2 and log(1+i) -> log(2)/2 + i*pi/4.
fn logQiNode(alloc: std.mem.Allocator, z: *const Qi) !*SNode {
    var re: ?*SNode = null;
    errdefer if (re) |r| nodeFree(alloc, r);
    var arg: ?*SNode = null;
    errdefer if (arg) |t| nodeFree(alloc, t);
    if (z.re.m.eqlZero()) {
        // b*i: re = log|b| (dropped when |b|==1 — decIsOne ignores neg),
        // arg = sign(b)*pi/2
        if (!(try decIsOne(alloc, &z.im))) {
            const ln = try nodeUnary(alloc, .log, try nodeDec(alloc, .{ .neg = false, .m = try z.im.m.clone(), .e = z.im.e }));
            defer nodeFree(alloc, ln);
            re = try norm(alloc, ln);
        }
        const pr = try nodePair(alloc, .mul,
            try nodeDec(alloc, .{ .neg = z.im.neg, .m = try BI.initSet(alloc, 5), .e = -1 }),
            try nodeAtom(alloc, 0));
        defer nodeFree(alloc, pr);
        arg = try norm(alloc, pr);
    } else {
        // re = (1/2)*log(a^2+b^2), dropped when the norm hits log(1)->0
        const s = try qiNormSq(alloc, z);
        var sv = s;
        defer sv.m.deinit();
        const pr = try nodePair(alloc, .mul,
            try nodeDec(alloc, .{ .neg = false, .m = try BI.initSet(alloc, 5), .e = -1 }),
            try nodeUnary(alloc, .log, try nodeDec(alloc, .{ .neg = sv.neg, .m = try sv.m.clone(), .e = sv.e })));
        defer nodeFree(alloc, pr);
        const rn = try norm(alloc, pr);
        if (!(rn.kind == .dec and rn.dec.m.eqlZero())) re = rn else nodeFree(alloc, rn);
        // arg = atan(b*inv(a)) (+ sign(b)*pi when a<0)
        const quo = try nodePair(alloc, .mul,
            try nodeDec(alloc, .{ .neg = z.im.neg, .m = try z.im.m.clone(), .e = z.im.e }),
            try nodeUnary(alloc, .inv, try nodeDec(alloc, .{ .neg = z.re.neg, .m = try z.re.m.clone(), .e = z.re.e })));
        var quo_live = true;
        errdefer if (quo_live) nodeFree(alloc, quo);
        const at = try nodeUnary(alloc, .atan, quo);
        quo_live = false;
        defer nodeFree(alloc, at);
        const atn = try norm(alloc, at);
        var atn_live = true;
        errdefer if (atn_live) nodeFree(alloc, atn);
        if (z.re.neg) {
            const pin = try nodeAtom(alloc, 0);
            defer nodeFree(alloc, pin);
            var sd = try decOneN(alloc, z.im.neg or z.im.m.eqlZero());
            defer sd.m.deinit();
            const pit = try termWithCoeff(alloc, &sd, pin);
            const ad = try nodePair(alloc, .add, atn, pit);
            atn_live = false;
            defer nodeFree(alloc, ad);
            arg = try norm(alloc, ad);
        } else {
            arg = atn;
            atn_live = false;
        }
    }
    // im part: i * arg — dropped when arg norms to 0
    var im: ?*SNode = null;
    errdefer if (im) |t| nodeFree(alloc, t);
    const ipr = try nodePair(alloc, .mul,
        try nodeAtom(alloc, 4),
        try nodeClone(alloc, arg.?));
    defer nodeFree(alloc, ipr);
    const itn = try norm(alloc, ipr);
    if (!(itn.kind == .dec and itn.dec.m.eqlZero())) im = itn else nodeFree(alloc, itn);
    nodeFree(alloc, arg.?);
    arg = null;
    if (re == null and im == null) return nodeDec(alloc, try decZero(alloc));
    if (re == null) {
        const t = im.?;
        im = null;
        return t;
    }
    if (im == null) {
        const t = re.?;
        re = null;
        return t;
    }
    const both = try nodePair(alloc, .add, re.?, im.?);
    re = null;
    im = null;
    defer nodeFree(alloc, both);
    return norm(alloc, both);
}

fn norm(alloc: std.mem.Allocator, n: *const SNode) anyerror!*SNode {
    switch (n.kind) {
        .dec => return nodeDec(alloc, .{ .neg = n.dec.neg, .m = try n.dec.m.clone(), .e = n.dec.e }),
        .atom => return nodeAtom(alloc, n.atom),
        .sq => {
            const inner = try norm(alloc, n.kid);
            var inner_live = true;
            errdefer if (inner_live) nodeFree(alloc, inner);
            if (inner.kind == .dec) {
                if (inner.dec.neg) {
                    // sqrt(-d) -> i*sqrt(|d|): the radicand re-enters through
                    // the Q(i) constant ring. decSqrtExact still folds squares
                    // (sqrt(-4) -> 2i); sqrt(-1) lands on bare i.
                    inner.dec.neg = false;
                    const sqn = try nodeUnary(alloc, .sq, inner);
                    inner_live = false;
                    errdefer nodeFree(alloc, sqn);
                    const pr = try nodePair(alloc, .mul, try nodeAtom(alloc, 4), sqn);
                    defer nodeFree(alloc, pr);
                    return norm(alloc, pr);
                }
                if (try decSqrtExact(alloc, &inner.dec)) |sqd| {
                    nodeFree(alloc, inner);
                    inner_live = false;
                    return nodeDec(alloc, sqd);
                }
            }
            return nodeUnary(alloc, .sq, inner);
        },
        .log => {
            const inner = try norm(alloc, n.kid);
            var inner_live = true;
            errdefer if (inner_live) nodeFree(alloc, inner);
            if (inner.kind == .dec) {
                if (inner.dec.m.eqlZero()) return error.LogZero;
                if (inner.dec.neg) {
                    // log(-d) -> log|d| + i*pi: principal branch, exact in
                    // the Q(i) constant ring. LogNeg stays declared for
                    // callers that want the real-only refusal lane.
                    inner.dec.neg = false;
                    const ln = try nodeUnary(alloc, .log, inner);
                    inner_live = false;
                    errdefer nodeFree(alloc, ln);
                    const ip = try nodePair(alloc, .mul, try nodeAtom(alloc, 4), try nodeAtom(alloc, 0));
                    errdefer nodeFree(alloc, ip);
                    const ad = try nodePair(alloc, .add, ln, ip);
                    defer nodeFree(alloc, ad);
                    return norm(alloc, ad);
                }
                if (try decIsOne(alloc, &inner.dec)) {
                    nodeFree(alloc, inner);
                    inner_live = false;
                    return nodeDec(alloc, try decZero(alloc));
                }
            }
            if (inner.kind == .atom and inner.atom == 1) {
                // log(e) = 1
                nodeFree(alloc, inner);
                inner_live = false;
                return nodeDec(alloc, try decOneN(alloc, false));
            }
            if (try qiConstOf(alloc, inner)) |zc| {
                var zv = zc;
                if (zv.im.m.eqlZero()) {
                    // real constant — the plain log node stays (log(4) must
                    // not route through the complex emitter and regress).
                    zv.deinit();
                } else {
                    // log of a Q(i) constant over the complex principal
                    // branch: (1/2)log(a^2+b^2) + i*arg.
                    nodeFree(alloc, inner);
                    inner_live = false;
                    const out = try logQiNode(alloc, &zv);
                    zv.deinit();
                    return out;
                }
            }
            return nodeUnary(alloc, .log, inner);
        },
        .atan => {
            const inner = try norm(alloc, n.kid);
            var inner_live = true;
            errdefer if (inner_live) nodeFree(alloc, inner);
            if (inner.kind == .dec) {
                if (inner.dec.m.eqlZero()) {
                    nodeFree(alloc, inner);
                    inner_live = false;
                    return nodeDec(alloc, try decZero(alloc));
                }
                var dabs = inner.dec;
                dabs.neg = false;
                if (try decIsOne(alloc, &dabs)) {
                    // atan(+-1) -> +-(pi/4): the sign rides the dec coeff.
                    var q = Dec{ .neg = inner.dec.neg, .m = try BI.initSet(alloc, 25), .e = -2 };
                    defer decDeinit(&q);
                    const pin = try nodeAtom(alloc, 0);
                    defer nodeFree(alloc, pin);
                    const t = try termWithCoeff(alloc, &q, pin);
                    nodeFree(alloc, inner);
                    inner_live = false;
                    return t;
                }
                if (inner.dec.neg) {
                    // atan(-d) -> -1*atan(|d|): odd function, sign on coeff.
                    inner.dec.neg = false;
                    const mn = try nodeDec(alloc, try decOneN(alloc, true));
                    errdefer nodeFree(alloc, mn);
                    const at = try nodeUnary(alloc, .atan, inner);
                    errdefer nodeFree(alloc, at);
                    inner_live = false;
                    const pair = try list2(alloc, mn, at);
                    errdefer alloc.free(pair);
                    return nodeList(alloc, .mul, pair);
                }
            }
            return nodeUnary(alloc, .atan, inner);
        },
        .exp => {
            const inner = try norm(alloc, n.kid);
            var inner_live = true;
            errdefer if (inner_live) nodeFree(alloc, inner);
            if (inner.kind == .dec) {
                if (inner.dec.m.eqlZero()) {
                    nodeFree(alloc, inner);
                    inner_live = false;
                    return nodeDec(alloc, try decOneN(alloc, false));
                }
                if (!inner.dec.neg and try decIsOne(alloc, &inner.dec)) {
                    // exp(1) = e — the atom carries it.
                    nodeFree(alloc, inner);
                    inner_live = false;
                    return nodeAtom(alloc, 1);
                }
            }
            if (inner.kind == .log) {
                // exp(log u) = u on log's range — the inverse law folds.
                const u = try nodeClone(alloc, inner.kid);
                nodeFree(alloc, inner);
                inner_live = false;
                return u;
            }
            if (inner.kind == .mul and inner.kids.len == 2 and
                inner.kids[0].kind == .dec and inner.kids[1].kind == .log) {
                // exp(c*log u) -> u^c as a product for small |c| (the canon
                // has no pow node); negative c wraps the product in inv.
                const cd = &inner.kids[0].dec;
                const cs: []u8 = cd.m.toString(alloc, 10, .lower) catch return error.Bad;
                defer alloc.free(cs);
                const mv = std.fmt.parseInt(i64, cs, 10) catch -1;
                const cv: i64 = if (cd.neg) -mv else mv;
                if (cd.e == 0 and @abs(cv) >= 2 and @abs(cv) <= 8) {
                    var kk = try std.ArrayList(*SNode).initCapacity(alloc, @intCast(@abs(cv)));
                    errdefer {
                        for (kk.items) |f| nodeFree(alloc, f);
                        kk.deinit(alloc);
                    }
                    var ci2: i64 = 0;
                    while (ci2 < @abs(cv)) : (ci2 += 1) {
                        try kk.append(alloc, try nodeClone(alloc, inner.kids[1].kid));
                    }
                    const kslice = try kk.toOwnedSlice(alloc);
                    const pr = nodeList(alloc, .mul, kslice) catch |e| {
                        for (kslice) |f| nodeFree(alloc, f);
                        alloc.free(kslice);
                        return e;
                    };
                    defer nodeFree(alloc, pr);
                    nodeFree(alloc, inner);
                    inner_live = false;
                    var rn = try norm(alloc, pr);
                    if (cv < 0) {
                        const iv = try nodeUnary(alloc, .inv, rn);
                        defer nodeFree(alloc, iv);
                        rn = try norm(alloc, iv);
                    }
                    return rn;
                }
            }
            return nodeUnary(alloc, .exp, inner);
        },
        .inv => {
            const inner = try norm(alloc, n.kid);
            var inner_live = true;
            errdefer if (inner_live) nodeFree(alloc, inner);
            if (inner.kind == .dec) {
                if (inner.dec.m.eqlZero()) return error.DivZero;
                if (try decRecipExact(alloc, &inner.dec)) |rd| {
                    nodeFree(alloc, inner);
                    inner_live = false;
                    return nodeDec(alloc, rd);
                }
                if (inner.dec.neg) {
                    // inv(-d) -> -1*inv(|d|): the sign lives on the coefficient,
                    // so literal inv(-3e0) and 1/-3 land on one canon.
                    inner.dec.neg = false;
                    const mn = try nodeDec(alloc, try decOneN(alloc, true));
                    errdefer nodeFree(alloc, mn);
                    const iv = try nodeUnary(alloc, .inv, inner);
                    errdefer nodeFree(alloc, iv);
                    inner_live = false;
                    const pair = try list2(alloc, mn, iv);
                    errdefer alloc.free(pair);
                    return nodeList(alloc, .mul, pair);
                }
            }
            if (inner.kind == .atom and inner.atom == 4) {
                // inv(i) = -i — the sign rides a -1 coefficient on i.
                nodeFree(alloc, inner);
                inner_live = false;
                const mn = try nodeDec(alloc, try decOneN(alloc, true));
                errdefer nodeFree(alloc, mn);
                const in2 = try nodeAtom(alloc, 4);
                errdefer nodeFree(alloc, in2);
                const pair = try list2(alloc, mn, in2);
                errdefer alloc.free(pair);
                return nodeList(alloc, .mul, pair);
            }
            if (inner.kind == .add or inner.kind == .mul) {
                if (try qiConstOf(alloc, inner)) |zc| {
                    // inv(a+bi) = (a-bi)*inv(a^2+b^2): conjugate times the
                    // norm's reciprocal. Raw tree through one norm — inv(4e0)
                    // folds 25e-2, non-2/5 norms stay symbolic inv facs.
                    var zv = zc;
                    defer zv.deinit();
                    var nim = zv.im;
                    nim.neg = !nim.neg;
                    if (nim.m.eqlZero()) nim.neg = false;
                    const s = try qiNormSq(alloc, &zv);
                    var sv = s;
                    defer sv.m.deinit();
                    const iv = try nodeUnary(alloc, .inv, try nodeDec(alloc, .{ .neg = sv.neg, .m = try sv.m.clone(), .e = sv.e }));
                    errdefer nodeFree(alloc, iv);
                    const pr = try nodePair(alloc, .mul, try qiToNode(alloc, &zv.re, &nim), iv);
                    defer nodeFree(alloc, pr);
                    nodeFree(alloc, inner);
                    inner_live = false;
                    return norm(alloc, pr);
                }
            }
            if (inner.kind == .exp) {
                // inv(exp u) -> exp(-u)
                const ne = try nodePair(alloc, .mul,
                    try nodeDec(alloc, try decOneN(alloc, true)),
                    try nodeClone(alloc, inner.kid));
                errdefer nodeFree(alloc, ne);
                const eu = try nodeUnary(alloc, .exp, ne);
                defer nodeFree(alloc, eu);
                nodeFree(alloc, inner);
                inner_live = false;
                return norm(alloc, eu);
            }
            if (inner.kind == .inv) {
                // inv(inv(x)) -> x
                const x = try nodeClone(alloc, inner.kid);
                nodeFree(alloc, inner);
                inner_live = false;
                return x;
            }
            if (inner.kind == .mul) {
                // inv(x*y) -> inv(x)*inv(y) so pairs can cancel downstream
                var kids = try std.ArrayList(*SNode).initCapacity(alloc, inner.kids.len);
                errdefer {
                    for (kids.items) |kk| nodeFree(alloc, kk);
                    kids.deinit(alloc);
                }
                for (inner.kids) |k| {
                    const iv = try nodeUnary(alloc, .inv, try nodeClone(alloc, k));
                    const nv = norm(alloc, iv) catch |err| {
                        nodeFree(alloc, iv);
                        return err;
                    };
                    errdefer nodeFree(alloc, nv);
                    nodeFree(alloc, iv);
                    try kids.append(alloc, nv);
                }
                nodeFree(alloc, inner);
                inner_live = false;
                const kids_slice = try kids.toOwnedSlice(alloc);
                errdefer {
                    for (kids_slice) |kk| nodeFree(alloc, kk);
                    alloc.free(kids_slice);
                }
                return nodeList(alloc, .mul, kids_slice);
            }
            return nodeUnary(alloc, .inv, inner);
        },
        .add => {
            var flat = std.ArrayList(*SNode){};
            defer flat.deinit(alloc);
            var fi: usize = 0;
            errdefer for (flat.items[fi..]) |x| nodeFree(alloc, x);
            for (n.kids) |k| {
                const nk = try norm(alloc, k);
                if (nk.kind == .add) {
                    for (nk.kids, 0..) |kk, ki| {
                        flat.append(alloc, kk) catch |e| {
                            for (nk.kids[ki..]) |kk2| nodeFree(alloc, kk2);
                            alloc.free(nk.kids);
                            alloc.destroy(nk);
                            return e;
                        };
                    }
                    alloc.free(nk.kids);
                    alloc.destroy(nk);
                } else {
                    flat.append(alloc, nk) catch |e| {
                        nodeFree(alloc, nk);
                        return e;
                    };
                }
            }
            // group children by structural base; sum coefficients
            var bases = std.ArrayList(*SNode){};
            defer bases.deinit(alloc);
            defer for (bases.items) |x| nodeFree(alloc, x);
            var coeffs = std.ArrayList(Dec){};
            defer coeffs.deinit(alloc);
            defer for (coeffs.items) |*x| x.m.deinit();
            for (flat.items) |k| {
                var coeff: Dec = undefined;
                const base = try splitCoeff(alloc, k, &coeff);
                nodeFree(alloc, k);
                fi += 1;
                const bc = canonOf(alloc, base) catch |e| {
                    nodeFree(alloc, base);
                    coeff.m.deinit();
                    return e;
                };
                defer alloc.free(bc);
                var found = false;
                for (bases.items, 0..) |b, bi| {
                    const oc = canonOf(alloc, b) catch |e| {
                        nodeFree(alloc, base);
                        coeff.m.deinit();
                        return e;
                    };
                    defer alloc.free(oc);
                    if (std.mem.eql(u8, oc, bc)) {
                        const nc = decAdd(alloc, &coeffs.items[bi], &coeff) catch |e| {
                            nodeFree(alloc, base);
                            coeff.m.deinit();
                            return e;
                        };
                        coeffs.items[bi].m.deinit();
                        coeffs.items[bi] = nc;
                        coeff.m.deinit();
                        nodeFree(alloc, base);
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    bases.append(alloc, base) catch |e| {
                        nodeFree(alloc, base);
                        coeff.m.deinit();
                        return e;
                    };
                    coeffs.append(alloc, coeff) catch |e| {
                        coeff.m.deinit();
                        return e;
                    };
                }
            }
            // rebuild terms: constant term (base == dec 1) first
            var out_kids = std.ArrayList(*SNode){};
            defer out_kids.deinit(alloc);
            errdefer for (out_kids.items) |x| nodeFree(alloc, x);
            var const_term: ?*SNode = null;
            errdefer if (const_term) |ct| nodeFree(alloc, ct);
            for (bases.items, 0..) |b, bi| {
                if (coeffs.items[bi].m.eqlZero()) continue;
                const is_const = b.kind == .dec and b.dec.e == 0 and !b.dec.neg and blk: {
                    var one = try BI.initSet(alloc, 1);
                    defer one.deinit();
                    break :blk b.dec.m.eql(one);
                };
                if (is_const) {
                    const_term = try nodeDec(alloc, .{ .neg = coeffs.items[bi].neg, .m = try coeffs.items[bi].m.clone(), .e = coeffs.items[bi].e });
                } else {
                    try out_kids.append(alloc, try termWithCoeff(alloc, &coeffs.items[bi], b));
                }
            }
            try sortKids(alloc, out_kids.items);
            if (const_term) |ct| {
                try out_kids.insert(alloc, 0, ct);
                const_term = null;
            }
            const kids_slice = try out_kids.toOwnedSlice(alloc);
            var slice_live = true;
            errdefer if (slice_live) {
                for (kids_slice) |x| nodeFree(alloc, x);
                alloc.free(kids_slice);
            };
            if (kids_slice.len == 0) {
                alloc.free(kids_slice);
                slice_live = false;
                return nodeDec(alloc, try decZero(alloc));
            }
            if (kids_slice.len == 1) {
                const only = kids_slice[0];
                alloc.free(kids_slice);
                slice_live = false;
                return only;
            }
            return nodeList(alloc, .add, kids_slice);
        },
        .mul => {
            var flat = std.ArrayList(*SNode){};
            defer flat.deinit(alloc);
            var fi: usize = 0;
            errdefer for (flat.items[fi..]) |x| nodeFree(alloc, x);
            for (n.kids) |k| {
                const nk = try norm(alloc, k);
                if (nk.kind == .mul) {
                    for (nk.kids, 0..) |kk, ki| {
                        flat.append(alloc, kk) catch |e| {
                            for (nk.kids[ki..]) |kk2| nodeFree(alloc, kk2);
                            alloc.free(nk.kids);
                            alloc.destroy(nk);
                            return e;
                        };
                    }
                    alloc.free(nk.kids);
                    alloc.destroy(nk);
                } else {
                    flat.append(alloc, nk) catch |e| {
                        nodeFree(alloc, nk);
                        return e;
                    };
                }
            }
            // fold decimal factors into one coefficient
            var coeff = try decOneN(alloc, false);
            var coeff_live = true;
            errdefer if (coeff_live) coeff.m.deinit();
            var facs = std.ArrayList(*SNode){};
            defer facs.deinit(alloc);
            errdefer for (facs.items) |x| nodeFree(alloc, x);
            while (fi < flat.items.len) : (fi += 1) {
                const k = flat.items[fi];
                if (k.kind == .dec) {
                    const nc = try decMul(alloc, &coeff, &k.dec);
                    coeff.m.deinit();
                    coeff = nc;
                    nodeFree(alloc, k);
                } else {
                    try facs.append(alloc, k);
                }
            }
            if (coeff.m.eqlZero()) {
                for (facs.items) |f| nodeFree(alloc, f);
                facs.clearRetainingCapacity();
                coeff.m.deinit();
                return nodeDec(alloc, try decZero(alloc));
            }
            // coeff*inv(dec) rational reduction: (m_c*10^e_c)/(m_d*10^e_d)
            // in lowest integer terms — den==1 folds fully into coeff, else
            // the denominator rewrites to the reduced canon dec. This lands
            // 3*inv(3e0) on 1e0 and 4*inv(6e1) on inv(1.5e1) — the same canon
            // a fresh "1/15" produces, keeping equiv = string equality honest.
            var ii: usize = 0;
            while (ii < facs.items.len) {
                const f = facs.items[ii];
                if (f.kind != .inv or f.kid.kind != .dec) {
                    ii += 1;
                    continue;
                }
                var num = try coeff.m.clone();
                errdefer num.deinit();
                var den = try f.kid.dec.m.clone();
                errdefer den.deinit();
                const de_diff = coeff.e - f.kid.dec.e;
                if (de_diff > 0) {
                    var p = try pow10(alloc, de_diff);
                    defer p.deinit();
                    try num.mul(&num, &p);
                } else if (de_diff < 0) {
                    var p = try pow10(alloc, -de_diff);
                    defer p.deinit();
                    try den.mul(&den, &p);
                }
                var g = try biGcd(alloc, &num, &den);
                errdefer g.deinit();
                var numr = try BI.init(alloc);
                errdefer numr.deinit();
                var rem = try BI.init(alloc);
                errdefer rem.deinit();
                try numr.divTrunc(&rem, &num, &g);
                var denr = try BI.init(alloc);
                errdefer denr.deinit();
                var rem2 = try BI.init(alloc);
                errdefer rem2.deinit();
                try denr.divTrunc(&rem2, &den, &g);
                num.deinit();
                den.deinit();
                g.deinit();
                rem.deinit();
                rem2.deinit();
                // canon dec mantissas carry no trailing zeros — strip them
                // from numr/denr the same way decFromDigits does at parse.
                var ten = try BI.initSet(alloc, 10);
                defer ten.deinit();
                var ce: i64 = 0;
                while (true) {
                    var q = try BI.init(alloc);
                    var r = try BI.init(alloc);
                    try q.divTrunc(&r, &numr, &ten);
                    if (!r.eqlZero() or numr.eqlZero()) {
                        q.deinit();
                        r.deinit();
                        break;
                    }
                    r.deinit();
                    numr.deinit();
                    numr = q;
                    ce += 1;
                }
                var dx: i64 = 0;
                while (true) {
                    var q = try BI.init(alloc);
                    var r = try BI.init(alloc);
                    try q.divTrunc(&r, &denr, &ten);
                    if (!r.eqlZero()) {
                        q.deinit();
                        r.deinit();
                        break;
                    }
                    r.deinit();
                    denr.deinit();
                    denr = q;
                    dx += 1;
                }
                const drop = denr.toConst().orderAgainstScalar(@as(u64, 1)) == .eq;
                coeff.neg = coeff.neg != f.kid.dec.neg;
                coeff.m.deinit();
                coeff.m = numr;
                coeff.e = ce;
                if (drop) {
                    denr.deinit();
                    nodeFree(alloc, f);
                    _ = facs.orderedRemove(ii);
                } else {
                    f.kid.dec.m.deinit();
                    f.kid.dec.m = denr;
                    f.kid.dec.e = dx;
                    f.kid.dec.neg = false;
                    ii += 1;
                }
            }
            // Q(i) constant ring fold: every factor that provably lives in
            // Q(i) — bare i, c*i, or a sum re+c*i — multiplies inside the ring.
            // >=2 participants collapse to one canonical Q(i) node; a dec
            // result joins coeff, im-only becomes c*i, re+im a two-term sum.
            // i*i -> -1e0 is the smallest case; i*i*x -> -1e0*x rides coeff.
            var qi_idx = std.ArrayList(usize){};
            defer qi_idx.deinit(alloc);
            var qi_vals = std.ArrayList(Qi){};
            defer {
                for (qi_vals.items) |*z| z.deinit();
                qi_vals.deinit(alloc);
            }
            for (facs.items, 0..) |f, idx| {
                if (try qiConstOf(alloc, f)) |z| {
                    try qi_idx.append(alloc, idx);
                    try qi_vals.append(alloc, z);
                }
            }
            if (qi_vals.items.len >= 2) {
                var acc = Qi{ .re = try decOneN(alloc, false), .im = try decZero(alloc) };
                defer acc.deinit();
                for (qi_vals.items) |*z| {
                    const na = try qiMul(alloc, &acc, z);
                    acc.deinit();
                    acc = na;
                }
                var ri = qi_idx.items.len;
                while (ri > 0) {
                    ri -= 1;
                    nodeFree(alloc, facs.items[qi_idx.items[ri]]);
                    _ = facs.orderedRemove(qi_idx.items[ri]);
                }
                const qn = try qiToNode(alloc, &acc.re, &acc.im);
                if (qn.kind == .dec) {
                    const nc = try decMul(alloc, &coeff, &qn.dec);
                    coeff.m.deinit();
                    coeff = nc;
                    nodeFree(alloc, qn);
                    if (coeff.m.eqlZero()) {
                        for (facs.items) |f| nodeFree(alloc, f);
                        facs.clearRetainingCapacity();
                        coeff.m.deinit();
                        return nodeDec(alloc, try decZero(alloc));
                    }
                } else {
                    try facs.append(alloc, qn);
                }
            }
            // merge exp factors: exp(u)*exp(v) -> exp(u+v) — always valid.
            // The summed argument re-norms: exp(0)->1 ejects it entirely,
            // exp(log u)->u can unfold to any kind (dec joins coeff, mul
            // splices its kids back into facs).
            var exp_idx = std.ArrayList(usize){};
            defer exp_idx.deinit(alloc);
            for (facs.items, 0..) |f, idx| {
                if (f.kind == .exp) try exp_idx.append(alloc, idx);
            }
            if (exp_idx.items.len >= 2) {
                var args = try std.ArrayList(*SNode).initCapacity(alloc, exp_idx.items.len);
                defer args.deinit(alloc);
                errdefer for (args.items) |x| nodeFree(alloc, x);
                for (exp_idx.items) |idx| try args.append(alloc, try nodeClone(alloc, facs.items[idx].kid));
                const ad = try nodeList(alloc, .add, try args.toOwnedSlice(alloc));
                var ad_live = true;
                errdefer if (ad_live) nodeFree(alloc, ad);
                const eu = try nodeUnary(alloc, .exp, ad);
                ad_live = false;
                defer nodeFree(alloc, eu);
                var mn = try norm(alloc, eu);
                var ri = exp_idx.items.len;
                while (ri > 0) {
                    ri -= 1;
                    nodeFree(alloc, facs.items[exp_idx.items[ri]]);
                    _ = facs.orderedRemove(exp_idx.items[ri]);
                }
                if (mn.kind == .dec) {
                    const nc = try decMul(alloc, &coeff, &mn.dec);
                    coeff.m.deinit();
                    coeff = nc;
                    nodeFree(alloc, mn);
                    if (coeff.m.eqlZero()) {
                        for (facs.items) |f| nodeFree(alloc, f);
                        facs.clearRetainingCapacity();
                        coeff.m.deinit();
                        return nodeDec(alloc, try decZero(alloc));
                    }
                } else if (mn.kind == .mul) {
                    for (mn.kids) |k| try facs.append(alloc, k);
                    alloc.free(mn.kids);
                    alloc.destroy(mn);
                } else {
                    try facs.append(alloc, mn);
                }
            }
            // pair-cancel f with inv(f): scan, on hit remove both, restart
            var ci: usize = 0;
            while (ci < facs.items.len) {
                const f = facs.items[ci];
                if (f.kind != .inv) {
                    ci += 1;
                    continue;
                }
                const fc = try canonOf(alloc, f.kid);
                defer alloc.free(fc);
                var removed = false;
                var j: usize = 0;
                while (j < facs.items.len) : (j += 1) {
                    if (j == ci) continue;
                    const g = facs.items[j];
                    if (g.kind == .inv) continue;
                    const gc = try canonOf(alloc, g);
                    defer alloc.free(gc);
                    if (std.mem.eql(u8, gc, fc)) {
                        nodeFree(alloc, f);
                        nodeFree(alloc, g);
                        _ = facs.orderedRemove(@max(ci, j));
                        _ = facs.orderedRemove(@min(ci, j));
                        removed = true;
                        break;
                    }
                }
                if (!removed) ci += 1;
            }
            // pair equal sqrt factors into their radicand (provably nonneg)
            ci = 0;
            while (ci < facs.items.len) {
                const f = facs.items[ci];
                if (f.kind != .sq) {
                    ci += 1;
                    continue;
                }
                const nonneg = switch (f.kid.kind) {
                    .dec => !f.kid.dec.neg,
                    .atom => true,
                    else => false,
                };
                if (!nonneg) {
                    ci += 1;
                    continue;
                }
                const fc = try canonOf(alloc, f);
                defer alloc.free(fc);
                var replaced = false;
                var j: usize = ci + 1;
                while (j < facs.items.len) : (j += 1) {
                    const g = facs.items[j];
                    if (g.kind != .sq) continue;
                    const gc = try canonOf(alloc, g);
                    defer alloc.free(gc);
                    if (std.mem.eql(u8, gc, fc)) {
                        const rad = try nodeClone(alloc, f.kid);
                        nodeFree(alloc, f);
                        nodeFree(alloc, g);
                        _ = facs.orderedRemove(j);
                        facs.items[ci] = rad;
                        replaced = true;
                        break;
                    }
                }
                if (!replaced) ci += 1;
            }
            // sort factors, then prepend coefficient unless it's 1
            try sortKids(alloc, facs.items);
            const is_one = try decIsOne(alloc, &coeff) and !coeff.neg;
            if (!is_one) {
                const cn = try nodeDec(alloc, coeff);
                coeff_live = false;
                try facs.insert(alloc, 0, cn);
            } else {
                coeff.m.deinit();
                coeff_live = false;
            }
            const kids_slice = try facs.toOwnedSlice(alloc);
            var slice_live = true;
            errdefer if (slice_live) {
                for (kids_slice) |x| nodeFree(alloc, x);
                alloc.free(kids_slice);
            };
            if (kids_slice.len == 0) {
                alloc.free(kids_slice);
                slice_live = false;
                return nodeDec(alloc, try decOneN(alloc, false));
            }
            if (kids_slice.len == 1) {
                const only = kids_slice[0];
                alloc.free(kids_slice);
                slice_live = false;
                return only;
            }
            return nodeList(alloc, .mul, kids_slice);
        },
    }
}

// ============================================================================
// Symbolic differentiation — w.r.t. the free variable x (atom 3).
// dec -> 0; const atoms -> 0; x -> 1; add -> termwise; mul -> product
// rule over the factor list; inv(f) -> -f'·inv(f)·inv(f);
// sq(f) -> f'·(1/2)·inv(sq f). Built raw, normalized once at the top.
// ============================================================================

fn deriveNode(alloc: std.mem.Allocator, n: *const SNode) anyerror!*SNode {
    return deriveNodeG(alloc, n, null);
}

fn deriveNodeG(alloc: std.mem.Allocator, n: *const SNode, greg: ?*const GReg) anyerror!*SNode {
    switch (n.kind) {
        .dec => return nodeDec(alloc, try decZero(alloc)),
        .atom => {
            if (n.atom == 3) return nodeDec(alloc, try decOneN(alloc, false));
            if (n.atom < 5) return nodeDec(alloc, try decZero(alloc));
            const gi = n.atom - 5;
            if (greg) |g| {
                if (gi < g.laws.items.len) {
                    if (g.laws.items[gi]) |law| return nodeClone(alloc, law);
                    return error.Lawless;
                }
            }
            return error.Opaque;
        },
        .add => {
            var kids = try std.ArrayList(*SNode).initCapacity(alloc, n.kids.len);
            errdefer {
                for (kids.items) |k| nodeFree(alloc, k);
                kids.deinit(alloc);
            }
            for (n.kids) |k| try kids.append(alloc, try deriveNodeG(alloc, k, greg));
            const kids_slice = try kids.toOwnedSlice(alloc);
            errdefer {
                for (kids_slice) |f| nodeFree(alloc, f);
                alloc.free(kids_slice);
            }
            return nodeList(alloc, .add, kids_slice);
        },
        .mul => {
            var terms = try std.ArrayList(*SNode).initCapacity(alloc, n.kids.len);
            errdefer {
                for (terms.items) |t| nodeFree(alloc, t);
                terms.deinit(alloc);
            }
            for (n.kids, 0..) |k, i| {
                const dk = try deriveNodeG(alloc, k, greg);
                var dk_live = true;
                errdefer if (dk_live) nodeFree(alloc, dk);
                if (dk.kind == .dec and dk.dec.m.eqlZero()) {
                    nodeFree(alloc, dk);
                    dk_live = false;
                    continue;
                }
                var kids = try std.ArrayList(*SNode).initCapacity(alloc, n.kids.len);
                errdefer {
                    for (kids.items) |f| nodeFree(alloc, f);
                    kids.deinit(alloc);
                }
                try kids.append(alloc, dk);
                dk_live = false;
                for (n.kids, 0..) |k2, j| {
                    if (j == i) continue;
                    try kids.append(alloc, try nodeClone(alloc, k2));
                }
                const kids_slice = try kids.toOwnedSlice(alloc);
                var sl_live = true;
                errdefer if (sl_live) {
                    for (kids_slice) |f| nodeFree(alloc, f);
                    alloc.free(kids_slice);
                };
                const mn = try nodeList(alloc, .mul, kids_slice);
                sl_live = false;
                errdefer nodeFree(alloc, mn);
                try terms.append(alloc, mn);
            }
            if (terms.items.len == 0) {
                terms.deinit(alloc);
                return nodeDec(alloc, try decZero(alloc));
            }
            if (terms.items.len == 1) {
                const t = terms.items[0];
                terms.deinit(alloc);
                return t;
            }
            const terms_slice = try terms.toOwnedSlice(alloc);
            errdefer {
                for (terms_slice) |t| nodeFree(alloc, t);
                alloc.free(terms_slice);
            }
            return nodeList(alloc, .add, terms_slice);
        },
        .inv => {
            const dk = try deriveNodeG(alloc, n.kid, greg);
            var dk_live = true;
            errdefer if (dk_live) nodeFree(alloc, dk);
            if (dk.kind == .dec and dk.dec.m.eqlZero()) {
                nodeFree(alloc, dk);
                dk_live = false;
                return nodeDec(alloc, try decZero(alloc));
            }
            var kids = try std.ArrayList(*SNode).initCapacity(alloc, 4);
            errdefer {
                for (kids.items) |f| nodeFree(alloc, f);
                kids.deinit(alloc);
            }
            try kids.append(alloc, try nodeDec(alloc, try decOneN(alloc, true)));
            try kids.append(alloc, dk);
            dk_live = false;
            try kids.append(alloc, try nodeUnary(alloc, .inv, try nodeClone(alloc, n.kid)));
            try kids.append(alloc, try nodeUnary(alloc, .inv, try nodeClone(alloc, n.kid)));
            const kids_slice = try kids.toOwnedSlice(alloc);
            errdefer {
                for (kids_slice) |f| nodeFree(alloc, f);
                alloc.free(kids_slice);
            }
            return nodeList(alloc, .mul, kids_slice);
        },
        .sq => {
            const dk = try deriveNodeG(alloc, n.kid, greg);
            var dk_live = true;
            errdefer if (dk_live) nodeFree(alloc, dk);
            if (dk.kind == .dec and dk.dec.m.eqlZero()) {
                nodeFree(alloc, dk);
                dk_live = false;
                return nodeDec(alloc, try decZero(alloc));
            }
            var kids = try std.ArrayList(*SNode).initCapacity(alloc, 3);
            errdefer {
                for (kids.items) |f| nodeFree(alloc, f);
                kids.deinit(alloc);
            }
            try kids.append(alloc, try nodeDec(alloc, try decFromDigits(alloc, "5", -1, false)));
            try kids.append(alloc, dk);
            dk_live = false;
            try kids.append(alloc, try nodeUnary(alloc, .inv, try nodeUnary(alloc, .sq, try nodeClone(alloc, n.kid))));
            const kids_slice = try kids.toOwnedSlice(alloc);
            errdefer {
                for (kids_slice) |f| nodeFree(alloc, f);
                alloc.free(kids_slice);
            }
            return nodeList(alloc, .mul, kids_slice);
        },
        .log => {
            const dk = try deriveNodeG(alloc, n.kid, greg);
            var dk_live = true;
            errdefer if (dk_live) nodeFree(alloc, dk);
            if (dk.kind == .dec and dk.dec.m.eqlZero()) {
                nodeFree(alloc, dk);
                dk_live = false;
                return nodeDec(alloc, try decZero(alloc));
            }
            var kids = try std.ArrayList(*SNode).initCapacity(alloc, 2);
            errdefer {
                for (kids.items) |f| nodeFree(alloc, f);
                kids.deinit(alloc);
            }
            try kids.append(alloc, dk);
            dk_live = false;
            try kids.append(alloc, try nodeUnary(alloc, .inv, try nodeClone(alloc, n.kid)));
            const kids_slice = try kids.toOwnedSlice(alloc);
            errdefer {
                for (kids_slice) |f| nodeFree(alloc, f);
                alloc.free(kids_slice);
            }
            return nodeList(alloc, .mul, kids_slice);
        },
        .exp => {
            const dk = try deriveNodeG(alloc, n.kid, greg);
            var dk_live = true;
            errdefer if (dk_live) nodeFree(alloc, dk);
            if (dk.kind == .dec and dk.dec.m.eqlZero()) {
                nodeFree(alloc, dk);
                dk_live = false;
                return nodeDec(alloc, try decZero(alloc));
            }
            var kids = try std.ArrayList(*SNode).initCapacity(alloc, 2);
            errdefer {
                for (kids.items) |f| nodeFree(alloc, f);
                kids.deinit(alloc);
            }
            try kids.append(alloc, dk);
            dk_live = false;
            try kids.append(alloc, try nodeUnary(alloc, .exp, try nodeClone(alloc, n.kid)));
            const kids_slice = try kids.toOwnedSlice(alloc);
            errdefer {
                for (kids_slice) |f| nodeFree(alloc, f);
                alloc.free(kids_slice);
            }
            return nodeList(alloc, .mul, kids_slice);
        },
        .atan => {
            const dk = try deriveNodeG(alloc, n.kid, greg);
            var dk_live = true;
            errdefer if (dk_live) nodeFree(alloc, dk);
            if (dk.kind == .dec and dk.dec.m.eqlZero()) {
                nodeFree(alloc, dk);
                dk_live = false;
                return nodeDec(alloc, try decZero(alloc));
            }
            var kids = try std.ArrayList(*SNode).initCapacity(alloc, 3);
            errdefer {
                for (kids.items) |f| nodeFree(alloc, f);
                kids.deinit(alloc);
            }
            try kids.append(alloc, dk);
            dk_live = false;
            var uu = try std.ArrayList(*SNode).initCapacity(alloc, 2);
            errdefer {
                for (uu.items) |f| nodeFree(alloc, f);
                uu.deinit(alloc);
            }
            try uu.append(alloc, try nodeDec(alloc, try decOneN(alloc, false)));
            var pr = try std.ArrayList(*SNode).initCapacity(alloc, 2);
            errdefer {
                for (pr.items) |f| nodeFree(alloc, f);
                pr.deinit(alloc);
            }
            try pr.append(alloc, try nodeClone(alloc, n.kid));
            try pr.append(alloc, try nodeClone(alloc, n.kid));
            const pr_slice = try pr.toOwnedSlice(alloc);
            var pr_live = true;
            errdefer if (pr_live) {
                for (pr_slice) |f| nodeFree(alloc, f);
                alloc.free(pr_slice);
            };
            const prod = try nodeList(alloc, .mul, pr_slice);
            pr_live = false;
            errdefer nodeFree(alloc, prod);
            try uu.append(alloc, prod);
            const uu_slice = try uu.toOwnedSlice(alloc);
            var uu_live = true;
            errdefer if (uu_live) {
                for (uu_slice) |f| nodeFree(alloc, f);
                alloc.free(uu_slice);
            };
            const den = try nodeList(alloc, .add, uu_slice);
            uu_live = false;
            errdefer nodeFree(alloc, den);
            try kids.append(alloc, try nodeUnary(alloc, .inv, den));
            const kids_slice = try kids.toOwnedSlice(alloc);
            errdefer {
                for (kids_slice) |f| nodeFree(alloc, f);
                alloc.free(kids_slice);
            }
            return nodeList(alloc, .mul, kids_slice);
        },
    }
}

fn symDeriv(alloc: std.mem.Allocator, a: []const u8) ![]u8 {
    const ta = try parseTree(alloc, a);
    defer nodeFree(alloc, ta);
    const dt = try deriveNode(alloc, ta);
    defer nodeFree(alloc, dt);
    const nt = try norm(alloc, dt);
    defer nodeFree(alloc, nt);
    return canonOf(alloc, nt);
}

// ============================================================================
// Boundary helpers
// ============================================================================

fn parseTree(alloc: std.mem.Allocator, s: []const u8) !*SNode {
    return parseTreeG(alloc, s, null);
}

fn parseTreeG(alloc: std.mem.Allocator, s: []const u8, greg: ?*GReg) !*SNode {
    var ctx = ParseCtx{ .alloc = alloc, .s = s, .greg = greg };
    const t = try parseExpr(&ctx);
    if (ctx.i != s.len) {
        nodeFree(alloc, t);
        return error.Bad;
    }
    return t;
}

fn normCanon(alloc: std.mem.Allocator, s: []const u8) ![]u8 {
    const t = try parseTree(alloc, s);
    defer nodeFree(alloc, t);
    const nt = try norm(alloc, t);
    defer nodeFree(alloc, nt);
    return canonOf(alloc, nt);
}

const BinOp = enum { add, sub, mul, div };

fn symCompose(alloc: std.mem.Allocator, a: []const u8, b: []const u8, op: BinOp) ![]u8 {
    const ta = try parseTree(alloc, a);
    defer nodeFree(alloc, ta);
    const tb = try parseTree(alloc, b);
    defer nodeFree(alloc, tb);
    var top: *SNode = undefined;
    switch (op) {
        .add => top = try nodeList(alloc, .add, try list2(alloc, try nodeClone(alloc, ta), try nodeClone(alloc, tb))),
        .sub => {
            const nb = try negNode(alloc, try nodeClone(alloc, tb));
            top = try nodeList(alloc, .add, try list2(alloc, try nodeClone(alloc, ta), nb));
        },
        .mul => top = try nodeList(alloc, .mul, try list2(alloc, try nodeClone(alloc, ta), try nodeClone(alloc, tb))),
        .div => {
            const ib = try nodeUnary(alloc, .inv, try nodeClone(alloc, tb));
            top = try nodeList(alloc, .mul, try list2(alloc, try nodeClone(alloc, ta), ib));
        },
    }
    defer nodeFree(alloc, top);
    const nt = try norm(alloc, top);
    defer nodeFree(alloc, nt);
    return canonOf(alloc, nt);
}

fn symNegate(alloc: std.mem.Allocator, a: []const u8) ![]u8 {
    const ta = try parseTree(alloc, a);
    defer nodeFree(alloc, ta);
    const top = try negNode(alloc, try nodeClone(alloc, ta));
    defer nodeFree(alloc, top);
    const nt = try norm(alloc, top);
    defer nodeFree(alloc, nt);
    return canonOf(alloc, nt);
}

fn symSqrt(alloc: std.mem.Allocator, a: []const u8) ![]u8 {
    const ta = try parseTree(alloc, a);
    defer nodeFree(alloc, ta);
    const top = try nodeUnary(alloc, .sq, try nodeClone(alloc, ta));
    defer nodeFree(alloc, top);
    const nt = try norm(alloc, top);
    defer nodeFree(alloc, nt);
    return canonOf(alloc, nt);
}

// n-fold symbolic power: a flat .mul list of clones through the normalizer.
// Negative exponents wrap in inv — inv(0) refusals surface as DivZero.
fn symPow(alloc: std.mem.Allocator, a: []const u8, n: i64) ![]u8 {
    const ta = try parseTree(alloc, a);
    defer nodeFree(alloc, ta);
    var top: *SNode = undefined;
    if (n == 0) {
        var d = try decOneN(alloc, false);
        errdefer decDeinit(&d);
        top = try nodeDec(alloc, d);
    } else {
        const ml = blk: {
            const an: usize = @intCast(@abs(n));
            const kids = try alloc.alloc(*SNode, an);
            errdefer alloc.free(kids);
            var built: usize = 0;
            errdefer for (kids[0..built]) |k| nodeFree(alloc, k);
            for (kids) |*k| {
                k.* = try nodeClone(alloc, ta);
                built += 1;
            }
            break :blk try nodeList(alloc, .mul, kids);
        };
        top = if (n < 0) blk: {
            errdefer nodeFree(alloc, ml);
            break :blk try nodeUnary(alloc, .inv, ml);
        } else ml;
    }
    defer nodeFree(alloc, top);
    const nt = try norm(alloc, top);
    defer nodeFree(alloc, nt);
    return canonOf(alloc, nt);
}

fn symFree(s: []const u8) void {
    koru_allocator().free(s);
}

fn ownedCopy(s: []const u8) []u8 {
    return koru_allocator().dupe(u8, s) catch @panic("std/sym: out of memory");
}

// ============================================================================
// Tors. Canon strings ride <sexpr!>; ops consume linearly.
// ============================================================================

// Literal / trusted parse: lit(π), lit(e*π), lit(√(2)), lit(1/3)...
// expr: captures the arg's source text verbatim — authored math quotes
// instead of evaluating. Runtime text goes through ingest/parse, not lit.
~pub tor lit { expr: Expression }
| exact string<sexpr!>
| bad

~proc lit|zig {
    var src = expr;
    // an unlabeled string literal lands on expr too, captured verbatim —
    // quotes included. Unquoting recovers the string the caller spelled.
    if (src.len >= 2 and src[0] == '"' and src[src.len - 1] == '"') src = src[1 .. src.len - 1];
    const c = normCanon(koru_allocator(), src) catch return .{ .bad = .{} };
    return .{ .exact = c };
}

// External boundary: outside text -> <sexpr-external!>, only parse discharges.
~pub tor ingest { s: string } -> string<sexpr-external!>

~proc ingest|zig {
    return ownedCopy(s);
}

~pub tor parse { s: string<!sexpr-external> }
| exact string<sexpr!>
| bad string<std/io:allocated!>

~proc parse|zig {
    const c = normCanon(koru_allocator(), s) catch return .{ .bad = s };
    symFree(s);
    return .{ .exact = c };
}

~pub tor add { a: string<!sexpr>, b: string<!sexpr> } -> string<sexpr!>

~proc add|zig {
    defer symFree(a);
    defer symFree(b);
    return symCompose(koru_allocator(), a, b, .add) catch @panic("std/sym:add: malformed operand");
}

~pub tor sub { a: string<!sexpr>, b: string<!sexpr> } -> string<sexpr!>

~proc sub|zig {
    defer symFree(a);
    defer symFree(b);
    return symCompose(koru_allocator(), a, b, .sub) catch @panic("std/sym:sub: malformed operand");
}

~pub tor mul { a: string<!sexpr>, b: string<!sexpr> } -> string<sexpr!>

~proc mul|zig {
    defer symFree(a);
    defer symFree(b);
    return symCompose(koru_allocator(), a, b, .mul) catch @panic("std/sym:mul: malformed operand");
}

~pub tor div { a: string<!sexpr>, b: string<!sexpr> }
| exact string<sexpr!>
| div-zero

~proc div|zig {
    defer symFree(a);
    defer symFree(b);
    const r = symCompose(koru_allocator(), a, b, .div) catch |err| switch (err) {
        error.DivZero => return .{ .div_zero = .{} },
        else => @panic("std/sym:div: malformed operand"),
    };
    return .{ .exact = r };
}

~pub tor neg { a: string<!sexpr> } -> string<sexpr!>

~proc neg|zig {
    defer symFree(a);
    return symNegate(koru_allocator(), a) catch @panic("std/sym:neg: malformed operand");
}

~pub tor sqrt { a: string<!sexpr> }
| exact string<sexpr!>
| neg-root

~proc sqrt|zig {
    defer symFree(a);
    const r = symSqrt(koru_allocator(), a) catch |err| switch (err) {
        error.NegRadicand => return .{ .neg_root = .{} },
        else => @panic("std/sym:sqrt: malformed operand"),
    };
    return .{ .exact = r };
}

// Equivalence is canonical string equality — borrows both.
~pub tor equiv { a: string<sexpr>, b: string<sexpr> }
| same
| diff

~proc equiv|zig {
    if (std.mem.eql(u8, a, b)) return .{ .same = .{} };
    return .{ .diff = .{} };
}

~pub tor free { n: string<!sexpr> }

~proc free|zig {
    symFree(n);
}

~pub tor render { n: string<!sexpr> } -> string<std/io:allocated!>

~proc render|zig {
    return n;
}

~pub tor dup { n: string<!sexpr> } -> { a: string<sexpr!>, b: string<sexpr!> }

~proc dup|zig {
    defer symFree(n);
    return .{ .a = ownedCopy(n), .b = ownedCopy(n) };
}


// ============================================================================
// Cross-tower lanes
// ============================================================================

// Re-issue a canonical decimal as a symbolic leaf. The bytes are already
// canonical sexpr — numeric leaves share the decimal alphabet — so this is
// a mark move, not a conversion.
~pub tor of-dec { n: string<std/num:!exact> } -> string<sexpr!>

~proc of-dec|zig {
    return n;
}

// Integer power by repeated symbolic multiply: pow(x,3) -> (x*x*x),
// pow(x,-2) -> inv((x*x)), pow(x,0) -> 1e0. pow(0,-1) -> | div-zero,
// riding inv's own zero guard.
~pub tor pow { a: string<!sexpr>, n: i64 }
| exact string<sexpr!>
| div-zero

~proc pow|zig {
    defer symFree(a);
    const r = symPow(koru_allocator(), a, n) catch |err| switch (err) {
        error.DivZero => return .{ .div_zero = .{} },
        else => @panic("std/sym:pow: malformed operand"),
    };
    return .{ .exact = r };
}

// d/dx of a canonical sexpr — structural rules over the NF, result
// normalized through the same norm, so deriv lands canon.
~pub tor deriv { a: string<!sexpr> } -> string<sexpr!>

~proc deriv|zig {
    defer symFree(a);
    return symDeriv(koru_allocator(), a) catch @panic("std/sym:deriv: malformed operand");
}
