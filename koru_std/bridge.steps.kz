// Koru Standard Library: the `steps` part of bridge.kz — the multi-item
// turn's per-step loop. Joined via `~part steps` in bridge.kz; merged into
// the bridge module at load.

/// What a multi-item turn's step run produced: the report + counters.
const StepRun = struct {
    report: []const u8,
    all_residue: bool,
    wire_failures: u32,
    used: u64,
    ran: u32,
    total: u32,
};

/// Unwrap the `abandoned` marker's payload — `{"branch":"abandoned","value":"<reason>"}`
/// is the exact shape hostAbandon emits; the reason sits between the fixed
/// prefix and the closing `"}`.
fn abandonReason(payload: []const u8) []const u8 {
    const prefix = "{\"branch\":\"abandoned\",\"value\":\"";
    if (!std.mem.startsWith(u8, payload, prefix)) return payload;
    const rest = payload[prefix.len..];
    if (rest.len >= 2 and std.mem.endsWith(u8, rest, "\"}")) return rest[0 .. rest.len - 2];
    return rest;
}

// runSteps moved to the `runsteps` part — the per-step loop beside the
// report machinery it feeds.
