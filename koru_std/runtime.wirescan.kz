// Koru Standard Library: the `wirescan` part of runtime — the wire
// scanner and parse.wire's proc. Joined via `~part wirescan` in
// runtime.kz; merged into the runtime module at load.
//
// The wire is one grammar: `verb(field: value)` with `|` arms. A value is
// a double-quoted string or a bare Koru expression — literal, bound name,
// field path, or computed (`n * 2`) — judged by the expression parser,
// not by a field's declared type. There is no capture channel: Expression
// and Source are comptime types the wire does not speak. The post-`)`
// region (balanced bare-value capture, the two arm shapes and their
// commitment rule) lives in the `wiretail` part; the character
// predicates, rejection builders, and line/column diagnostic live in
// `wirelex`.

const WireScan = union(enum) {
    ok: []const u8, // normalized wire — typed positions re-quoted
    reject: WireRejection,
};

// The dispatch-side half of the pair: canonicalize what the gate admitted.
// A refused line passes through unchanged — the flow parser refuses it
// downstream with its own diagnostic, so normalization never hides a verdict.
pub fn wireNormalize(allocator: std.mem.Allocator, s: []const u8, input_fn: ?InputLookupFn, host_input_fn: ?InputLookupFn) []const u8 {
    return switch (wireScan(allocator, s, input_fn, host_input_fn)) {
        .ok => |w| w,
        .reject => s,
    };
}

fn wireScan(allocator: std.mem.Allocator, s: []const u8, input_fn: ?InputLookupFn, host_input_fn: ?InputLookupFn) WireScan {
    if (s.len == 0) return .{ .reject = wireReject("the reply carried no invocation — a reply is one or more invocations, one per line", .{}, 0) };

    // The normalized text must outlive this call — caller arena or the same
    // never-freed page tolerance the wire layer already carries.
    var out = std.ArrayList(u8){};

    var i: usize = 0;
    if (!wireIdentStart(s[0])) return .{ .reject = wireRejectResidue("not an invocation: a wire line is verb(field: \"value\") and starts with a verb name, not '{c}'", .{s[0]}, 0) };
    while (i < s.len and wireIdentChar(s[i])) i += 1;
    const verb = s[0..i];
    _ = input_fn;
    _ = host_input_fn;
    while (i < s.len and (s[i] == ' ' or s[i] == '\t')) i += 1;

    if (i >= s.len or s[i] != '(') return .{ .reject = wireRejectResidue("not an invocation: after the verb '{s}' comes '(' — calls are `verb(field: ...)` and `vocabulary()` lists every verb", .{verb}, i) };
    out.appendSlice(allocator, s[0 .. i + 1]) catch unreachable;
    i += 1;

    while (true) {
        while (i < s.len and (s[i] == ' ' or s[i] == '\t')) i += 1;
        if (i < s.len and s[i] == ')') {
            out.append(allocator, ')') catch unreachable;
            i += 1;
            break;
        }
        if (i >= s.len or !wireIdentStart(s[i])) return .{ .reject = wireReject("arguments are name: \"value\" pairs — expected a field name here", .{}, i) };
        const field_start = i;
        while (i < s.len and wireIdentChar(s[i])) i += 1;
        const field = s[field_start..i];
        while (i < s.len and (s[i] == ' ' or s[i] == '\t')) i += 1;
        if (i >= s.len or s[i] != ':') return .{ .reject = wireReject("in your '{s}' call: expected ':' after the field '{s}' — '{s}' was inside bare prose that stops at ',' or ')' — wrap punctuation or newlines in \"double quotes\"", .{ verb, field, field }, i) };
        i += 1;
        while (i < s.len and (s[i] == ' ' or s[i] == '\t')) i += 1;
        out.appendSlice(allocator, s[field_start..i]) catch unreachable;
        if (i < s.len and s[i] == '"') {
            const quote_start = i;
            i += 1;
            var closed = false;
            while (i < s.len) {
                const c = s[i];
                if (c == '\\') {
                    i = if (i + 1 < s.len) i + 2 else s.len;
                    continue;
                }
                if (c == '"') {
                    closed = true;
                    i += 1;
                    break;
                }
                i += 1;
            }
            if (!closed) return .{ .reject = wireReject("unterminated string for the field '{s}' — the reply looks truncated", .{field}, i) };
            // A quoted value with raw newlines isn't canonical — verbatim copies eval to "" downstream.
            const quoted = s[quote_start..i];
            const canon = if (std.mem.indexOfAny(u8, quoted, "\r\n") == null) quoted else
                std.mem.replaceOwned(u8, allocator, std.mem.replaceOwned(u8, allocator, quoted, "\n", "\\n") catch unreachable, "\r", "\\r") catch unreachable;
            out.appendSlice(allocator, canon) catch unreachable;
        } else {
            // A bare value is one Koru expression — a literal (`5`,
            // `true`), a bound name (`r9`), a field path (`r9.flights`),
            // or computed (`n * 2`, `r3.total > 50`). Captured balanced to
            // ',' or ')'; the expression parser must accept it whole, so
            // prose and data shapes refuse here instead of leaking into a
            // field as literal text.
            const raw = std.mem.trim(u8, wireScanCaptured(s, &i), " \t");
            if (raw.len == 0) return .{ .reject = wireReject("the field '{s}' needs a value — a \"double-quoted string\", a literal, a bound name, or an expression like `n * 2`", .{field}, i) };
            if (!wireExprParses(allocator, raw)) return .{ .reject = wireReject("the value of '{s}' is not a Koru expression — write a bound name, a field path, an operation (`n * 2`), or \"quote it\" for literal text", .{field}, i) };
            out.appendSlice(allocator, raw) catch unreachable;
        }
        while (i < s.len and (s[i] == ' ' or s[i] == '\t')) i += 1;
        if (i < s.len and s[i] == ',') {
            out.append(allocator, ',') catch unreachable;
            i += 1;
            continue;
        }
        if (i < s.len and s[i] == ')') {
            out.append(allocator, ')') catch unreachable;
            i += 1;
            break;
        }
        return .{ .reject = wireReject("after the value of '{s}' comes ',' or ')' — text must be \"double-quoted\"; a bare word reads as a bound name", .{field}, i) };
    }

    // The tail — nothing, an inline `|` chain, or indented `|` arm lines —
    // is judged in the `wiretail` part, which owns the two arm shapes and
    // the single-line commitment between them.
    if (wireArmTail(s, i)) |rej| return .{ .reject = rej };
    out.appendSlice(allocator, s[i..]) catch unreachable;
    return .{ .ok = out.items };
}

// parse.wire's proc — the tor is declared in the `parsewire` part. The scan
// runs first (typed positions normalize to canonical quoted wire); the arms'
// grammar is still the interpreter's own parser, so the wire can never accept
// a chain eval would execute differently.
~proc parse.wire|zig {
    const interpreter_mod = @import("root").koru_std.koru_interpreter;

    const s = std.mem.trim(u8, source, " \t\r\n");
    const wire = switch (wireScan(std.heap.page_allocator, s, input_fn, host_input_fn)) {
        .reject => |rejection| {
            const pos = wireLineColumn(s, rejection.byte);
            return .{ .parse_error = .{
                .message = rejection.message,
                .line = pos.line,
                .column = pos.column,
                .not_invocation = rejection.not_invocation,
            } };
        },
        .ok => |w| w,
    };

    // A page-backed arena, intentionally never freed: the returned Flow must
    // outlive this call, and a few pages per parse are tolerated exactly like
    // the interpreter's own parse-error messages (and scope-vocabulary's
    // render above).
    var arena_state = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    const allocator = arena_state.allocator();
    return switch (interpreter_mod.parse_event.handler(.{
        .source = wire,
        .allocator = allocator,
    })) {
        .flow => |f| .{ .parsed = .{ .flow = f, .wire = wire } },
        .parse_error => |e| .{ .parse_error = .{
            .message = e.message,
            .line = e.line,
            .column = e.column,
            .not_invocation = false,
        } },
    };
}
