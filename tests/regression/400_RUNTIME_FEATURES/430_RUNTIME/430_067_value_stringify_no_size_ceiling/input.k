// VALUE STRINGIFICATION HAS NO SIZE CEILING — `value.stringify` renders the
// full JSON of a bound result no matter the payload size. The run binds a
// 5000-byte string; the printed line must contain the whole value, never an
// empty string (a fixed scratch buffer inside the serializer once made
// payloads past its capacity render as "").
import std/runtime
import std/interpreter
import std/io

pub tor big {} -> string

big -> ""

std/runtime:register(scope: "test") {
    big
}

std/runtime:get-scope(name: "test")
| scope s |> std/interpreter:run(source: "big() |> result", s.dispatcher)
    | result r |> std/interpreter:value.stringify(r.value): j
        |> std/io:print.ln("{{ j:s }}")
    | unhandled-branch _ |> std/io:print.ln("FAIL: unhandled_branch")
    | exhausted e |> std/io:print.ln("EXHAUSTED: {{ e.last_event:s }}")
    | parse-error e |> std/io:print.ln("PARSE ERROR: {{ e.message:s }}")
    | validation-error e |> std/io:print.ln("VALIDATION ERROR: {{ e:s }}")
    | dispatch-error e |> std/io:print.ln("DISPATCH ERROR: {{ e.message:s }}")
| not-found |> std/io:print.ln("SCOPE NOT FOUND")
