// std/env - Environment variable access
//
// Simple, safe access to environment variables.

const std = @import("std");

// ============================================================================
// Get environment variable
// ============================================================================

~pub tor get { name: string }
| ok string
| not-set

~proc get|zig {
    // getEnvVarOwned — the cross-platform env door; std.posix.getenv does
    // not exist on Windows. page_allocator: the returned value outlives
    // this proc, it is handed to the caller.
    const value = std.process.getEnvVarOwned(std.heap.page_allocator, name) catch {
        return .{ .not_set = .{} };
    };
    return .{ .ok = value };
}

// Get with default value
~pub tor get.or { name: string, default: string } -> string

~proc get.or|zig {
    const value = std.process.getEnvVarOwned(std.heap.page_allocator, name) catch return default;
    return value;
}

// Check if variable is set
~pub tor is-set { name: string }
| yes
| no

~proc is-set|zig {
    if (std.process.getEnvVarOwned(std.heap.page_allocator, name) catch null) |v| {
        std.heap.page_allocator.free(v);
        return .{ .yes = .{} };
    }
    return .{ .no = .{} };
}

// Require - fail loudly if not set (for critical config)
~pub tor require { name: string }
| ok string
| missing string

~proc require|zig {
    const value = std.process.getEnvVarOwned(std.heap.page_allocator, name) catch {
        return .{ .missing = name };
    };
    return .{ .ok = value };
}
