~proc compute|cs {
    __koru_stdout_write($"compute({x})\n");
    return x * 2;
}
~proc format|cs {
    __koru_stdout_write($"format({value})\n");
    // Allocate temporary string for testing
    var text = "formatted";
    return text;
}
~proc display|cs {
    __koru_stdout_write($"Final: {text}\n");
}