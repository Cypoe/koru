// Koru Standard Library: fleet — nodes that share one `world`.
//
//   std/fleet:claim(world: "cells", id: "room-42", node: "node-a")
//     | claimed e |> ...            // e is the granted epoch
//     | held-by o |> ...            // o is the owning node's id
//     | failed e |> ...
//
// A fleet is not a resource — it is a PROTOCOL over the world directory,
// the same role the object-store bucket plays in celld: the shared floor
// is the only coordinator, so there is no membership protocol to write.
// Layout under `<world>/.fleet/`:
//
//   owners/<id>   exists iff the cell is owned. `node=<nid>\nepoch=<n>`.
//                 Written by createNew (claim — the CAS) or tmp+rename
//                 (seize — the atomic takeover commit).
//   epochs/<id>   persistent counter, survives `release`. Every claim and
//                 seize bumps it, so a stale epoch can never collide with a
//                 fresh one — that is what makes `guard` a fence.
//
//   std/fleet:guard(world:, id:, node:, epoch:)     // the write-time fence
//     | owner |> ...                // record still names this node+epoch
//     | fenced e |> ...             // e is the epoch now on record
//     | free |> ...                 // no owner record at all
//
// celld-alignment, honest limits: `claim` is the conditional-write analog,
// `seize` is takeover-after-crash (the health check is the caller's, so far
// always "operator decided"), `guard` is the epoch fence enforced where
// celld enforces it — at the write. Leases/TTL, peer routing, and
// durability tiering are not spelled: `std/net` is a refusal surface, so
// routing waits on a wire. True multi-process races on the epoch counter
// are serialized only within a single seize lock dir; the fence itself
// (node-id + epoch on record) is what carries correctness.

const std = @import("std");

// ============================================================================
// RECORD HELPERS — owner record `node=<nid>\nepoch=<n>` under
// `<world>/.fleet/owners/<id>`; epoch counter under `.fleet/epochs/<id>`.
// ============================================================================

fn ownerPath(buf: []u8, world: []const u8, id: []const u8) ?[]const u8 {
    return std.fmt.bufPrint(buf, "{s}/.fleet/owners/{s}", .{ world, id }) catch null;
}

fn epochPath(buf: []u8, world: []const u8, id: []const u8) ?[]const u8 {
    return std.fmt.bufPrint(buf, "{s}/.fleet/epochs/{s}", .{ world, id }) catch null;
}

fn ensureDirs(world: []const u8) !void {
    var pb: [1024]u8 = undefined;
    try std.fs.cwd().makePath(try std.fmt.bufPrint(&pb, "{s}/.fleet/owners", .{world}));
    try std.fs.cwd().makePath(try std.fmt.bufPrint(&pb, "{s}/.fleet/epochs", .{world}));
    try std.fs.cwd().makePath(try std.fmt.bufPrint(&pb, "{s}/.fleet/locks", .{world}));
}

const OwnerRecord = struct { node: []const u8, epoch: u32 };

// Allocation-free read: the record is two short lines, so it parses out of a
// stack buffer and the node id is copied into `nodebuf`. null = absent or
// unreadable; callers distinguish via the arms they offer.
fn ownerRead(world: []const u8, id: []const u8, nodebuf: []u8) ?OwnerRecord {
    var pb: [1024]u8 = undefined;
    const p = ownerPath(&pb, world, id) orelse return null;
    const f = std.fs.cwd().openFile(p, .{}) catch return null;
    defer f.close();
    var buf: [4096]u8 = undefined;
    const n = f.read(&buf) catch return null;
    var rec = OwnerRecord{ .node = "", .epoch = 0 };
    var it = std.mem.splitScalar(u8, buf[0..n], '\n');
    while (it.next()) |line| {
        if (std.mem.startsWith(u8, line, "node=")) {
            const v = line["node=".len..];
            if (v.len > nodebuf.len) return null;
            @memcpy(nodebuf[0..v.len], v);
            rec.node = nodebuf[0..v.len];
        }
        if (std.mem.startsWith(u8, line, "epoch=")) rec.epoch =
            std.fmt.parseInt(u32, line["epoch=".len..], 10) catch 0;
    }
    if (rec.node.len == 0) return null;
    return rec;
}

fn epochRead(world: []const u8, id: []const u8) u32 {
    var pb: [1024]u8 = undefined;
    const p = epochPath(&pb, world, id) orelse return 0;
    var buf: [32]u8 = undefined;
    const f = std.fs.cwd().openFile(p, .{}) catch return 0;
    defer f.close();
    const n = f.read(&buf) catch return 0;
    const s = std.mem.trim(u8, buf[0..n], " \n\t");
    return std.fmt.parseInt(u32, s, 10) catch 0;
}

// Atomic counter bump: write tmp + rename. `next` is what the caller writes
// into its owner record — monotone because the counter never shrinks and
// `release` never deletes it.
fn epochBump(world: []const u8, id: []const u8) u32 {
    const next = epochRead(world, id) + 1;
    var pb: [1024]u8 = undefined;
    const p = epochPath(&pb, world, id) orelse return next;
    var tb: [1024]u8 = undefined;
    const tmp = std.fmt.bufPrint(&tb, "{s}.tmp", .{p}) catch return next;
    var cb: [16]u8 = undefined;
    const body = std.fmt.bufPrint(&cb, "{d}\n", .{next}) catch return next;
    std.fs.cwd().writeFile(.{ .sub_path = tmp, .data = body }) catch return next;
    std.fs.cwd().rename(tmp, p) catch {};
    return next;
}

fn ownerWrite(world: []const u8, id: []const u8, node: []const u8, epoch: u32) !void {
    var pb: [1024]u8 = undefined;
    const p = ownerPath(&pb, world, id) orelse return error.PathTooLong;
    var tb: [1024]u8 = undefined;
    const tmp = std.fmt.bufPrint(&tb, "{s}.tmp", .{p}) catch return error.PathTooLong;
    var cb: [1024]u8 = undefined;
    const body = std.fmt.bufPrint(&cb, "node={s}\nepoch={d}\n", .{ node, epoch }) catch
        return error.PathTooLong;
    try std.fs.cwd().writeFile(.{ .sub_path = tmp, .data = body });
    try std.fs.cwd().rename(tmp, p);
}

// ============================================================================
// CLAIM — the conditional write. createNew is the CAS: exactly one caller
// wins the record for a free id; the loser reads who holds it. A won claim
// bumps the persistent counter so its epoch can never repeat. Shared with
// `std/node` through the acquire part below.
// ============================================================================

~pub tor claim { world: string, id: string, node: string }
| claimed u32
| held-by string
| failed string

~proc claim|zig {
    var nb: [256]u8 = undefined;
    switch (fleetAcquire(world, id, node, &nb)) {
        .held => |e| return .{ .claimed = e },
        .foreign => |o| return .{ .held_by = std.heap.page_allocator.dupe(u8, o) catch
            return .{ .failed = "out of memory" } },
        .failed => return .{ .failed = "claim failed" },
    }
}

// ============================================================================
// OWNER — the routing probe: who holds this id, if anyone. celld answers
// this from its bucket records; we answer it from the same shared floor.
// ============================================================================

~pub tor owner { world: string, id: string }
| owned-by string
| free
| failed string

~proc owner|zig {
    var nb: [256]u8 = undefined;
    if (ownerRead(world, id, &nb)) |rec|
        return .{ .owned_by = std.heap.page_allocator.dupe(u8, rec.node) catch
            return .{ .failed = "out of memory" } };
    return .free;
}

// ============================================================================
// SEIZE — takeover: a peer claims an owned id after its owner is judged
// dead (the health check is upstream — here it is always operator-decided).
// Serialized by a lock dir so two seizers cannot interleave the bump; the
// record commits atomically via tmp+rename at a fresh epoch.
// ============================================================================

~pub tor seize { world: string, id: string, node: string }
| seized u32
| free
| contended
| failed string

~proc seize|zig {
    ensureDirs(world) catch return .{ .failed = "cannot create .fleet dirs" };
    var lb: [1024]u8 = undefined;
    const lock = std.fmt.bufPrint(&lb, "{s}/.fleet/locks/{s}", .{ world, id }) catch
        return .{ .failed = "path too long" };
    std.fs.cwd().makeDir(lock) catch |err| {
        if (err == error.PathAlreadyExists) return .contended;
        return .{ .failed = "cannot take seize lock" };
    };
    defer std.fs.cwd().deleteDir(lock) catch {};
    var nb: [256]u8 = undefined;
    if (ownerRead(world, id, &nb) == null) return .free;
    const epoch = epochBump(world, id);
    ownerWrite(world, id, node, epoch) catch return .{ .failed = "seize write failed" };
    return .{ .seized = epoch };
}

// ============================================================================
// RELEASE — graceful handoff: only the record's owner may clear it. The
// epoch counter stays, so a stale claim token is fenced forever after.
// ============================================================================

~pub tor release { world: string, id: string, node: string }
| released
| not-owner
| free
| failed string

~proc release|zig {
    var nb: [256]u8 = undefined;
    const rec = ownerRead(world, id, &nb) orelse return .free;
    if (!std.mem.eql(u8, rec.node, node)) return .{ .not_owner = .{} };
    var pb: [1024]u8 = undefined;
    const p = ownerPath(&pb, world, id) orelse return .{ .failed = "path too long" };
    std.fs.cwd().deleteFile(p) catch return .{ .failed = "release failed" };
    return .released;
}

// ============================================================================
// GUARD — the fence at the write. celld's invariant as a runtime check:
// a holder presents its node-id + granted epoch; both must still be on the
// record or the holder is stale and the write must not proceed.
// ============================================================================

~pub tor guard { world: string, id: string, node: string, epoch: u32 }
| owner
| fenced u32
| free
| failed string

~proc guard|zig {
    var nb: [256]u8 = undefined;
    const rec = ownerRead(world, id, &nb) orelse return .free;
    if (std.mem.eql(u8, rec.node, node) and rec.epoch == epoch) return .owner;
    return .{ .fenced = rec.epoch };
}

// ============================================================================
// RESET — operator/test hook: drop the whole `.fleet` directory. Not part
// of the protocol; exists so tests and tools can re-slate a world.
// ============================================================================

~pub tor reset { world: string }
| cleared
| failed string

~proc reset|zig {
    var pb: [1024]u8 = undefined;
    const p = std.fmt.bufPrint(&pb, "{s}/.fleet", .{world}) catch
        return .{ .failed = "path too long" };
    std.fs.cwd().deleteTree(p) catch {};
    return .cleared;
}
~part acquire
~part fence
