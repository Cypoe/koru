// Koru Standard Library: std/witness — the proof-carrying obligation surface.
//
// Design: docs/koru-callsite-proofs-draft.md + docs/koru-c-lane-test-plan.md
// (branch verify-path). One rule governs every surface in this module: the
// user surface may *observe* and *invoke* — never author a witness, never
// suppress a check. Witnesses themselves are solver-produced receipts
// riding .marks; nothing here is a place to write one.
//
// Surfaces, scaffold rung:
//   ~std/witness:enforce { } — program-wide [comptime] declaration in the
//       std/build:variants family. Presence means "witnesses required for
//       the proven fragment." This rung: validates the declaration and
//       reports the program's obligation census. The pass-injection
//       machinery lands with the checker — until then `enforced` reports
//       what it measured, not what it verified.
//   koruc <program> witness — the [command] rendering the obligation and
//       routing census: `!` arms by family, |c / |c[verified] proc bodies,
//       enforce declaration sites.

~import std/compiler

const ast_find = @import("ast");

~std/compiler:command.declare {
    "name": "witness",
    "description": "Report the program's obligation + verified-lane census"
}

// ============================================================
// The census fold — shared by `enforce` and the `witness` command.
// Walks top-level items and module_decl children: `!` effect
// continuations by arm name, proc_decl target tags, enforce sites.
// ============================================================

const WCensus = struct {
    const std = @import("std");

    discharge: usize = 0,
    inserted: usize = 0,
    removed: usize = 0,
    step: usize = 0,
    wait: usize = 0,
    other_effect: usize = 0,
    c_bodies: usize = 0,
    c_verified: usize = 0,
    other_tags: usize = 0,
    enforce_sites: usize = 0,
    // Prepared-witness marks minted by transforms (rung 1: stored-write
    // numeric checks). They ride `.marks` — pass-produced, unauthorable —
    // on the lowered write invocations, so they exist only on the
    // post-transform AST: `enforce` sees them, the `witness` command's
    // seed-AST census does not.
    w_lossless: usize = 0,
    w_deferred: usize = 0,
    w_non_numeric: usize = 0,
    w_refused: usize = 0,

    fn obligationSites(self: *const WCensus) usize {
        return self.discharge + self.inserted + self.removed +
            self.step + self.wait + self.other_effect;
    }

    fn witnessSites(self: *const WCensus) usize {
        return self.w_lossless + self.w_deferred + self.w_non_numeric + self.w_refused;
    }

    // @witness("kind","site","d<-s","verdict") — the verdict is the last
    // quoted field. Anything not carrying the prefix is not a witness.
    fn witnessVerdict(mark: []const u8) ?[]const u8 {
        if (!std.mem.startsWith(u8, mark, "@witness(")) return null;
        const close = std.mem.lastIndexOf(u8, mark, "\")") orelse return null;
        const open = std.mem.lastIndexOf(u8, mark[0..close], "\"") orelse return null;
        return mark[open + 1 .. close];
    }

    fn foldMarks(self: *WCensus, inv: *const ast_find.Invocation) void {
        for (inv.marks) |m| {
            const v = witnessVerdict(m) orelse continue;
            if (std.mem.eql(u8, v, "lossless")) {
                self.w_lossless += 1;
            } else if (std.mem.eql(u8, v, "deferred")) {
                self.w_deferred += 1;
            } else if (std.mem.eql(u8, v, "non-numeric")) {
                self.w_non_numeric += 1;
            } else if (std.mem.eql(u8, v, "refused")) {
                self.w_refused += 1;
            }
        }
    }

    fn foldContinuation(self: *WCensus, cont: *const ast_find.Continuation) void {
        if (cont.node) |*node| {
            if (node.* == .invocation) self.foldMarks(&node.invocation);
        }
        for (cont.continuations) |*c| self.foldContinuation(c);
    }

    fn fold(self: *WCensus, items: []const ast_find.Item) void {
        for (items) |*entry| {
            switch (entry.*) {
                .module_decl => |*m| self.fold(m.items),
                .proc_decl => |*p| {
                    const tag = p.target orelse continue;
                    if (std.mem.eql(u8, tag, "c")) {
                        self.c_bodies += 1;
                    } else if (std.mem.eql(u8, tag, "c[verified]")) {
                        self.c_verified += 1;
                    } else if (!std.mem.eql(u8, tag, "zig")) {
                        self.other_tags += 1;
                    }
                },
                .flow => |*fl| {
                    if (fl.body.node) |*node| {
                        if (node.* == .invocation) {
                            const inv = &node.invocation;
                            if (inv.path.module_qualifier) |mq| {
                                if (std.mem.indexOf(u8, mq, "witness") != null and
                                    inv.path.segments.len > 0 and
                                    std.mem.eql(u8, inv.path.segments[0], "enforce"))
                                {
                                    self.enforce_sites += 1;
                                }
                            }
                        }
                    }
                    self.foldContinuation(&fl.body);
                    for (fl.body.continuations) |*c| {
                        if (c.kind != .effect) continue;
                        const bname = std.mem.trim(u8, c.branch, " ");
                        if (std.mem.eql(u8, bname, "discharge")) {
                            self.discharge += 1;
                        } else if (std.mem.eql(u8, bname, "inserted")) {
                            self.inserted += 1;
                        } else if (std.mem.eql(u8, bname, "removed")) {
                            self.removed += 1;
                        } else if (std.mem.eql(u8, bname, "step")) {
                            self.step += 1;
                        } else if (std.mem.eql(u8, bname, "wait")) {
                            self.wait += 1;
                        } else {
                            self.other_effect += 1;
                        }
                    }
                },
                else => {},
            }
        }
    }
};

// ============================================================
// enforce — program-wide declaration (std/build:variants family).
// ~[build("debug")]std/witness:enforce { } form lands when the
// build() annotation matching ships (310_051 debt); annotations are
// accepted but not yet honored at this rung.
// ============================================================

~[comptime]pub tor enforce { meta: InvocationMeta, source: Source, program: std/compiler:Program }
| enforced usize
| skipped string
| refused string

~proc enforce|zig {
    const std = @import("std");
    _ = meta;
    _ = source;
    var census = WCensus{};
    census.fold(program.items);
    // The marks census — the prepared-witness channel made enumerable. One
    // stable line, pinned by expected_comptime.txt: it is the verbatim
    // record a later checker consumes from backend output. comptime_main
    // runs twice per compile (2.3.5 pre-transform prime, 2.5 post-transform)
    // — silence the zero row so the only line emitted is the real census.
    if (census.witnessSites() > 0) {
        std.debug.print("[witness] stored-write-numeric: lossless={d} deferred={d} non-numeric={d} refused={d}\n", .{ census.w_lossless, census.w_deferred, census.w_non_numeric, census.w_refused });
    }
    return .{ .enforced = census.obligationSites() };
}

// ============================================================
// witness — the command: koruc <program> witness
// ============================================================

~[comptime|command]pub tor witness {
    program: *const std/compiler:Program,
    allocator: __koru_std.mem.Allocator,
    argv: []string,
}

~proc witness|zig {
    const std = @import("std");
    _ = argv;
    _ = allocator;

    var census = WCensus{};
    census.fold(program.items);

    std.debug.print("📋 witness — obligation + routing census\n", .{});
    std.debug.print("  ! arms   discharge={d} inserted={d} removed={d} step={d} wait={d} other={d}\n", .{
        census.discharge, census.inserted, census.removed,
        census.step, census.wait, census.other_effect,
    });
    std.debug.print("  procs    |c={d} |c[verified]={d} other-tag={d}\n", .{
        census.c_bodies, census.c_verified, census.other_tags,
    });
    std.debug.print("  enforce  declarations={d}\n", .{census.enforce_sites});
    if (census.obligationSites() == 0 and census.c_bodies + census.c_verified == 0) {
        std.debug.print("  (nothing for the witness layer to see — pure flows only)\n", .{});
    }
}
