// Koru Standard Library: the `tail` part of store.preorder.kz — the preorder
// site's continuation split and replacement assembly.
// Joined via `~part tail` in store.preorder.kz; merged into the module at load.

const PTail = struct {
    const ast = @import("ast");
    const H = struct {
        const mkPathH = @import("emitter_helpers").mkPathH;
    };

    /// `flow.body.continuations` carries two different things. The NAMED
    /// `! preorder` arm is this site's vocabulary — its body was already
    /// transplanted into qbody by the coordinator, so the arm itself is
    /// claimed and consumed. Every BRANCHLESS continuation is the caller's
    /// `|>` sequel, which still belongs to the caller: the replacement
    /// re-roots it under the sweep call — the same contract query's siteTail
    /// splice honors (690_366). A NAMED arm the site does not claim can
    /// never run — refuse it by name (695_008).
    fn sweepSite(
        alloc: std.mem.Allocator,
        reporter: anytype,
        flow: *const ast.Flow,
        store_name: []const u8,
        home_ns: []const u8,
        qsweep_name: []const u8,
    ) ast.SiteResult {
        var tail = std.ArrayList(ast.Continuation).initCapacity(alloc, 4) catch unreachable;
        for (flow.body.continuations) |c| {
            const bname = std.mem.trim(u8, c.branch, " \t");
            if (bname.len == 0 and !c.is_catchall) {
                tail.append(alloc, c) catch unreachable;
                continue;
            }
            if (std.mem.eql(u8, bname, "preorder")) continue;
            return ast.refuse(alloc, reporter, .KORU161, flow.location, flow.module, "std/store:preorder({s}): the '{s}' branch is not one a preorder site answers — `! preorder <row>` is the site's arm; an arm the site does not claim can never run", .{ store_name, bname });
        }
        const sweep_inv = ast.Invocation{
            .path = H.mkPathH(alloc, home_ns, qsweep_name),
            .args = &[_]ast.Arg{},
        };
        return .{ .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(sweep_inv, tail.items, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of, // preserved: the site may BE an impl flow's head
            .super_shape = null,
            .inline_body = null,
            .preamble_code = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = alloc.dupe(u8, flow.module) catch unreachable,
        } }, .consumed_arms = &.{"preorder"} };
    }
};
