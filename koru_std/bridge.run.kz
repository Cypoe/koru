// Koru Standard Library: the `run` part of bridge.kz.
// Joined via `~part run` in bridge.kz; merged into the bridge module at load.

// ============================================================================
// RUN - Execute a turn against the session's resources
// ============================================================================
//
// The verb the bridge existed without: `std/runtime:run` takes a `handle_pool`
// and a `scope`, and a bridge is exactly that pairing outliving a single turn.
//
// The branch set MIRRORS `std/runtime:run` plus ONE bridge-only branch below.
// `?partial` is where the mirror ends: sequencing is the agent channel's
// demand (frag-partial-programs), not `runtime:run`'s contract, which stays
// single (orisha's endpoint depends on it). A multi-item turn reports here,
// always, even fully green — one shape for "a turn ran steps".
//
// Two of that tor's parameters are deliberately not forwarded:
//
// - `budget` — metering is PARKED. It earns its keep on a public-facing API.
// - `auto_discharge` — always false, and it must be. A bridge-managed pool
//   outlives the run BY DESIGN; `close` is what releases.

~pub tor run { br: *Bridge, source: string }
| result { value: @import("root").koru_std.koru_interpreter.Value, used: u64, handles: u32 }
| defined string
| unhandled-branch { branch: string, payload: string, handles: string }
| exhausted { used: u64, last_event: string, handles: u32 }
| parse-error { message: string, line: u32, column: u32 }
| validation-error string
| shape-error { branch: string, field: ?string, message: string }
| event-denied string
| dispatch-error { event_name: string, message: string }
| ?partial { ran: u32, total: u32, used: u64, handles: u32, report: string }
| scope-not-found string

~proc run|zig {
    const rt = @import("root").koru_std.koru_runtime;
    const interp = @import("root").koru_std.koru_interpreter;

    br.touch();

    // SEQUENCING (frag-partial-programs): a turn is a run of items, each
    // routed by the same rules below. One item takes the exact historical
    // path (discrimination, wire gate, single dispatch) — every current
    // caller is a one-item turn and observes zero change. Several items
    // each run through their existing single path in order and the turn
    // reports one structured line per step under `partial`, continuing
    // past refusal: a partial program RUNS, and the model learns every
    // step's outcome in one observation instead of discovering failures
    // one turn at a time. Mis-segmentation below can only fail LOUD —
    // every slice still passes the single paths' validators.
    const items = segmentTurn(br.allocator, source) catch {
        return .{ .parse_error = .{ .message = "OOM segmenting turn", .line = 0, .column = 0 } };
    };
    defer br.allocator.free(items);
    if (items.len < 2) {
        // RUN DISCRIMINATION (the REPL rule): a declaration is not a dispatch.
        // If the source is a subflow definition (`tor name { args }` +
        // `name = <body>`, identifiable by its leading `tor`), install it into
        // the session's durable defined-flows table and report `defined <name>`
        // instead of routing it into the dispatcher where it would parse-error
        // as an invocation. One verb, two meanings — exactly as a REPL's def.
        // This is the R1 rung of KOPIUM_RUNTIME.md: the bridge run loop is a REPL.
        {
            const trimmed = std.mem.trim(u8, source, " \t\r\n");
            if (std.mem.startsWith(u8, trimmed, "tor ")) {
                return switch (interp.define_event.handler(.{
                    .source = source,
                    .defined = br.defined,
                })) {
                    .defined => |d| .{ .defined = d },
                    .parse_error => |e| .{ .parse_error = .{
                        .message = e.message,
                        .line = e.line,
                        .column = e.column,
                    } },
                };
            }
        }

        // THE SINGLE-ITEM WIRE GATE: a one-item turn is ONE invocation and
        // nothing else. `std/runtime:parse.wire` is the strict grammar —
        // prose, chains, trailing text and truncated strings are refused
        // here as parse-error ("that was not Koru"), before the dispatcher
        // ever sees them. What passes still runs the full path below: scope
        // membership (event-denied), field shapes (validation-error),
        // possession, budget.
        if (wireGate(source)) |e| return .{ .parse_error = .{
            .message = e.message, .line = e.line, .column = e.column,
        } };

        const result = rt.run_event.handler(.{
            .source = source,
            .scope = br.scope,
            .handle_pool = &br.pool,
            .auto_discharge = false,
            .defined = br.defined,
            .lenient = true,
        });

        return switch (result) {
            .result => |r| .{ .result = .{ .value = r.value, .used = r.used, .handles = r.handles } },
            .unhandled_branch => |u| .{ .unhandled_branch = .{ .branch = u.branch, .payload = u.payload, .handles = u.handles } },
            .exhausted => |e| .{ .exhausted = .{ .used = e.used, .last_event = e.last_event, .handles = e.handles } },
            .parse_error => |e| .{ .parse_error = .{ .message = e.message, .line = e.line, .column = e.column } },
            .validation_error => |e| .{ .validation_error = e },
            .shape_error => |e| .{ .shape_error = .{ .branch = e.branch, .field = e.field, .message = e.message } },
            .event_denied => |e| .{ .event_denied = e },
            .dispatch_error => |e| .{ .dispatch_error = .{ .event_name = e.event_name, .message = e.message } },
            .scope_not_found => |e| .{ .scope_not_found = e },
        };
    }

    var report = std.ArrayList(u8){};
    defer report.deinit(br.allocator);
    const writer = report.writer(br.allocator);
    var used_total: u64 = 0;
    const total: u32 = @intCast(items.len);
    for (items, 0..) |it, idx| {
        const step: u32 = @intCast(idx + 1);
        const item = std.mem.trim(u8, source[it.start..it.end], " \t\r\n");
        if (isDefineItem(item)) {
            switch (interp.define_event.handler(.{ .source = item, .defined = br.defined })) {
                .defined => |d| writer.print("step {d}/{d} defined: {s}\n", .{ step, total, d }) catch {},
                .parse_error => |e| writer.print("step {d}/{d} parse-error: {s}\n", .{ step, total, e.message }) catch {},
            }
            continue;
        }
        // The wire gate holds per item; a refused slice is a step line.
        if (wireGate(item)) |e| {
            writer.print("step {d}/{d} parse-error: {s}\n", .{ step, total, e.message }) catch {};
            continue;
        }
        const result = rt.run_event.handler(.{
            .source = item,
            .scope = br.scope,
            .handle_pool = &br.pool,
            .auto_discharge = false,
            .defined = br.defined,
            .lenient = true,
        });
        switch (result) {
            .result => |r| {
                used_total += r.used;
                writer.print("step {d}/{d} result: {s}\n", .{ step, total, r.value.toJsonBuf() }) catch {};
            },
            .unhandled_branch => |u| {
                writer.print("step {d}/{d} unhandled-branch: {s} — {s} (held {s})\n", .{ step, total, u.branch, u.payload, u.handles }) catch {};
            },
            .exhausted => |e| {
                used_total += e.used;
                writer.print("step {d}/{d} exhausted: used={d} last={s}\n", .{ step, total, e.used, e.last_event }) catch {};
            },
            .parse_error => |e| writer.print("step {d}/{d} parse-error: {s}\n", .{ step, total, e.message }) catch {},
            .validation_error => |e| writer.print("step {d}/{d} validation-error: {s}\n", .{ step, total, e }) catch {},
            .shape_error => |e| writer.print("step {d}/{d} shape-error {s}: {s}\n", .{ step, total, e.branch, e.message }) catch {},
            .event_denied => |e| writer.print("step {d}/{d} event-denied: {s}\n", .{ step, total, e }) catch {},
            .dispatch_error => |e| writer.print("step {d}/{d} dispatch-error {s}: {s}\n", .{ step, total, e.event_name, e.message }) catch {},
            .scope_not_found => |e| writer.print("step {d}/{d} scope-not-found: {s}\n", .{ step, total, e }) catch {},
        }
    }
    const report_owned = std.heap.page_allocator.dupe(u8, report.items) catch "";
    return .{ .partial = .{
        .ran = total,
        .total = total,
        .used = used_total,
        .handles = br.getHandleCount(),
        .report = report_owned,
    } };
}
