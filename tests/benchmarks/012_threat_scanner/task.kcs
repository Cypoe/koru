// C# facet: the results list + counters are module state standing in for
// custody — same disclosed shim as 010/011 (capture's @typeInfo lowering is
// a measured cs refusal, KORU047). The claim under test is the pipeline:
// filter -> format -> materialize.
//
// collect is ONLY the ToList — `results.Add`. The hits/chars counters stay
// declared (task.k's closing print reads them; on cs they read zero) but
// are NOT touched in the loop: every other arm checksums after the
// stopwatch, and the generated arm's checksum is likewise computed
// post-timer from KoruHost.results by the harness.
using static KoruHost;

static class KoruHost {
    public static long hits = 0;
    public static long chars = 0;
    public static readonly System.Collections.Generic.List<string> results = new();
}

~proc collect|cs { results.Add((string)s); }
