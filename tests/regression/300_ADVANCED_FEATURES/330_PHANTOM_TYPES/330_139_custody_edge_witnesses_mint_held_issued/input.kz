// PINS: the custody-edge witness channel — under std/witness:enforce the
// phantom checker prints one `[witness] site custody-edge` line per
// obligation event it walks in the post-insertion .full pass, then the
// per-op census. This program exercises every op:
//
//   h  — held:   enters spin live through its declared consume param
//       <!owned>; discharged by onward consume into step
//   v  — mint:   the again arm re-binds the obligation; discharged by the
//       @loop jump arg feeding the next iteration's consume input
//   r  — mint:   binds stop's payload; issued: exits live through the
//       declared `-> *Handle<owned!>` return (an `.expression` terminator
//       the branch-constructor escape audit never sees)
//   h0 — mint:   the caller's bare-return bind; discharged into spin
//   hf — mint:   receives spin's issued output; discharged by done
//   h (peek) — borrow: enters peek live through its declared borrow param
//       `<owned>` (no `!`) — custody stays with the caller, the claim is
//       witnessed so the ledger can tell borrowed from never-touched
//
// The .args_only pre-pass (check-phantom-args) walks the same bindings but
// must NOT print — emit_edges is set only when check_mode == .full, or the
// pre-insertion pass would mint a second copy of every edge.

~import std/io
~import std/witness

const std = @import("std");
const Handle = struct { n: i32 };

~tor step { h: *Handle<!owned> }
| again *Handle<owned!>
| stop *Handle<owned!>
~proc step|zig {
    h.n += 1;
    if (h.n < 3) return .{ .again = h };
    return .{ .stop = h };
}

~tor peek { h: *Handle<owned> }
~proc peek|zig {
    std.debug.print("peek n={}\n", .{h.n});
}

~tor done { h: *Handle<!owned> }
~proc done|zig {
    std.debug.print("n={}\n", .{h.n});
    std.heap.page_allocator.destroy(h);
}

~tor spin { h: *Handle<!owned> } -> *Handle<owned!>
~spin = #loop step(h)
| again v |> @loop(h: v)
| stop r -> r

~tor make {} -> *Handle<owned!>
~proc make|zig {
    const h = std.heap.page_allocator.create(Handle) catch unreachable;
    h.* = .{ .n = 0 };
    return h;
}

~std/witness:enforce { }

~make(): h0 |> peek(h: h0) |> spin(h: h0): hf |> done(h: hf)
