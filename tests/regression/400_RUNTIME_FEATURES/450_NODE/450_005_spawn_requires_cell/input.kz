// Test: `std/node:spawn(f, id:)` without `cell:` is refused — a node member
// IS a cell; the shape binding is not optional.

~import std/io
~import std/node
~import std/proto
~import std/runtime

~std/proto(room_state) {
    visits: u32
}

~std/runtime:register(scope: "cell") {
}

~std/node:new(node, scope: "cell", world: "", capacity: 8)

~std/node(node)
| node f |> std/node:spawn(f, id: "room-9")
  | spawned b |> std/io:print.ln("spawned")
  | resident |> std/io:print.ln("resident")
  | refused |> std/io:print.ln("refused")
