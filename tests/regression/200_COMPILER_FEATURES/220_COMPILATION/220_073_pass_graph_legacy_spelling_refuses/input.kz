// PINS: the pre-`contract:` spellings `[requires("x")]`/`[preserves("x")]`/
// `[obliges("x")]` refuse by name — an unnamespaced claim parses but binds
// nothing, so it must not compile into an unchecked contract.
~import std/io
~[requires("setup")]pub tor work { } -> i32
~proc work|zig { return 1; }
~pub tor setup { } -> i32
~proc setup|zig { return 0; }
~setup(): _ |> work(): _ |> std/io:print.ln("done")
