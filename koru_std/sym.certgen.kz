// Koru Standard Library: the `certgen` part of sym.kz — certified series.
//
// Joined via `~part certgen` in sym.kz; merged into the module at load.
// Depends on: sym.kz (parseTree/norm/SNode), supgen (Rat/serFromNode/
//   certWrite/OdeCert), certcomp (Poly/Frac closure algebra, certBridge,
//   recWrite, certClosure).
//
// cert-of derives the ODE STRUCTURALLY — theorem-level, no series
// witness (HolonomicClosure.lean semantics):
//   dec        -> f' = 0
//   x          -> x f' - f = 0
//   a + b      -> certClosure sum
//   a * b      -> certClosure prod
//   inv(a), a order-1  -> q1 g' - q0 g = 0   (g = 1/f)
//   sq(p), p a poly    -> 2p g' - p' g = 0   (g = sqrt(p))
// anything else is a named refusal, never a silent default.
//
// cert-series emits `cser(terms=N,det=1)|a=[...]|ode=...|rec=...`:
// cert-of -> certBridge -> det (Lean h0: q_{K,0} != 0) -> seeds are the
// expression's ACTUAL first R coefficients (exact), tail is generated
// by the recurrence. Every generated coefficient is forced by the ODE
// residual — theorem-correct, not a finite witness. det=0 refuses as
// under-determined carrying the (unpackageable) rec for diagnostics.
// ============================================================================

const CertgenErr = error{ InvHighOrder, SqrtNonPoly, LogNonPoly, AtanNonPoly, ExpNonPoly };

fn biSlice(alloc: std.mem.Allocator, vals: []const i64) ![]BI {
    const out = try alloc.alloc(BI, vals.len);
    var n: usize = 0;
    errdefer {
        for (out[0..n]) |*b| b.deinit();
        alloc.free(out);
    }
    while (n < vals.len) : (n += 1) out[n] = try BI.initSet(alloc, vals[n]);
    return out;
}

fn biPolyClone(alloc: std.mem.Allocator, p: []const BI) ![]BI {
    const out = try alloc.alloc(BI, p.len);
    var n: usize = 0;
    errdefer {
        for (out[0..n]) |*b| b.deinit();
        alloc.free(out);
    }
    while (n < p.len) : (n += 1) out[n] = try p[n].clone();
    return out;
}

fn biPolyNeg(alloc: std.mem.Allocator, p: []const BI) ![]BI {
    const out = try biPolyClone(alloc, p);
    errdefer {
        for (out) |*b| b.deinit();
        alloc.free(out);
    }
    for (out) |*b| b.negate();
    return out;
}

fn biLcm(alloc: std.mem.Allocator, a: *const BI, b: *const BI) !BI {
    var g = try biGcd(alloc, a, b);
    defer g.deinit();
    var prod = try a.clone();
    defer prod.deinit();
    try prod.mul(&prod, b);
    var q = try BI.init(alloc);
    errdefer q.deinit();
    var rem = try BI.init(alloc);
    defer rem.deinit();
    try q.divTrunc(&rem, &prod, &g);
    q.abs();
    return q;
}

// Common-denominator integerization of Rat-coefficient polys.
fn intPolysFromRats(alloc: std.mem.Allocator, polys: []const []const Rat) ![][]BI {
    var L = try BI.initSet(alloc, 1);
    defer L.deinit();
    for (polys) |p| {
        for (p) |*c| {
            if (denIsOne(c)) continue;
            const nl = try biLcm(alloc, &L, &c.d);
            L.deinit();
            L = nl;
        }
    }
    const out = try alloc.alloc([]BI, polys.len);
    var np: usize = 0;
    errdefer {
        for (out[0..np]) |p| {
            for (p) |*b| b.deinit();
            alloc.free(p);
        }
        alloc.free(out);
    }
    for (polys) |p| {
        var tl: usize = 1;
        if (!polyIsZero(p)) tl = polyDegIdx(p) + 1;
        const ip = try alloc.alloc(BI, tl);
        var i: usize = 0;
        errdefer {
            for (ip[0..i]) |*b| b.deinit();
            alloc.free(ip);
        }
        while (i < tl) : (i += 1) {
            if (i >= p.len or ratIsZero(&p[i])) {
                ip[i] = try BI.initSet(alloc, 0);
                continue;
            }
            var scaled = try p[i].n.clone();
            errdefer scaled.deinit();
            var qq = try BI.init(alloc);
            defer qq.deinit();
            var rr = try BI.init(alloc);
            defer rr.deinit();
            var dd = try p[i].d.clone();
            defer dd.deinit();
            try qq.divTrunc(&rr, &L, &dd);
            try scaled.mul(&scaled, &qq);
            ip[i] = scaled;
        }
        out[np] = ip;
        np += 1;
    }
    return out;
}

// Structural polynomial extraction over Q: dec/x/+/* only. Anything
// involving inv or sq (or non-x atoms, which are not rational) is not a
// poly over Q[x] for these purposes.
fn polyOfNode(alloc: std.mem.Allocator, n: *const SNode) anyerror!?[]Rat {
    switch (n.kind) {
        .dec => {
            const p = try alloc.alloc(Rat, 1);
            errdefer alloc.free(p);
            p[0] = try ratFromDec(alloc, &n.dec);
            return p;
        },
        .atom => {
            if (n.atom != 3) return null;
            const p = try alloc.alloc(Rat, 2);
            errdefer alloc.free(p);
            p[0] = try ratFromInt(alloc, 0);
            p[1] = try ratFromInt(alloc, 1);
            return p;
        },
        .add => {
            var acc = try polyEmpty(alloc);
            errdefer polyFree(alloc, acc);
            for (n.kids) |k| {
                const kp = (try polyOfNode(alloc, k)) orelse {
                    polyFree(alloc, acc);
                    return null;
                };
                defer polyFree(alloc, kp);
                const na = try polyAdd(alloc, acc, kp);
                polyFree(alloc, acc);
                acc = na;
            }
            return acc;
        },
        .mul => {
            var acc = (try polyOfNode(alloc, n.kids[0])) orelse return null;
            errdefer polyFree(alloc, acc);
            for (n.kids[1..]) |k| {
                const kp = (try polyOfNode(alloc, k)) orelse {
                    polyFree(alloc, acc);
                    return null;
                };
                defer polyFree(alloc, kp);
                const na = try polyMul(alloc, acc, kp);
                polyFree(alloc, acc);
                acc = na;
            }
            return acc;
        },
        .sq, .inv, .log, .atan, .exp => return null,
    }
}

fn certDegOf(polys: []const []BI) usize {
    var deg: usize = 0;
    for (polys) |p| {
        if (p.len > deg + 1) deg = p.len - 1;
    }
    return deg;
}

fn certLeafConst(alloc: std.mem.Allocator) !OdeCert {
    const polys = try alloc.alloc([]BI, 2);
    errdefer alloc.free(polys);
    polys[0] = try biSlice(alloc, &.{0});
    errdefer {
        for (polys[0]) |*b| b.deinit();
        alloc.free(polys[0]);
    }
    polys[1] = try biSlice(alloc, &.{1});
    return .{ .order = 1, .deg = 0, .polys = polys };
}

fn certLeafVar(alloc: std.mem.Allocator) !OdeCert {
    const polys = try alloc.alloc([]BI, 2);
    errdefer alloc.free(polys);
    polys[0] = try biSlice(alloc, &.{-1});
    errdefer {
        for (polys[0]) |*b| b.deinit();
        alloc.free(polys[0]);
    }
    polys[1] = try biSlice(alloc, &.{ 0, 1 });
    return .{ .order = 1, .deg = 1, .polys = polys };
}

// Structural (theorem-level) ODE derivation.
fn certOfNode(alloc: std.mem.Allocator, n: *const SNode) anyerror!OdeCert {
    switch (n.kind) {
        .dec => return certLeafConst(alloc),
        .atom => return if (n.atom == 3) certLeafVar(alloc) else certLeafConst(alloc),
        .add, .mul => {
            const mode: ClMode = if (n.kind == .add) .sum else .prod;
            var acc = try certOfNode(alloc, n.kids[0]);
            errdefer certFree(alloc, &acc);
            for (n.kids[1..]) |k| {
                var ck = try certOfNode(alloc, k);
                defer certFree(alloc, &ck);
                const nc = try certClosure(alloc, &acc, &ck, mode);
                certFree(alloc, &acc);
                acc = nc;
            }
            return acc;
        },
        .inv => {
            // g = 1/p for a polynomial p satisfies p g' + p' g = 0 — order
            // 1 regardless of p's structure (the companion-basis closure
            // over dependent summands can yield a valid but non-minimal
            // ODE for the inner cert, so the poly path must come first).
            if (try polyOfNode(alloc, n.kid)) |p| {
                defer polyFree(alloc, p);
                const dp = try polyDer(alloc, p);
                defer polyFree(alloc, dp);
                const pp = try polyClone(alloc, p);
                defer polyFree(alloc, pp);
                const rat_polys = [2][]const Rat{ dp, pp };
                const ips = try intPolysFromRats(alloc, &rat_polys);
                return .{ .order = 1, .deg = certDegOf(ips), .polys = ips };
            }
            var inner = try certOfNode(alloc, n.kid);
            defer certFree(alloc, &inner);
            if (inner.order != 1) return CertgenErr.InvHighOrder;
            const polys = try alloc.alloc([]BI, 2);
            errdefer alloc.free(polys);
            polys[0] = try biPolyNeg(alloc, inner.polys[0]);
            errdefer {
                for (polys[0]) |*b| b.deinit();
                alloc.free(polys[0]);
            }
            polys[1] = try biPolyClone(alloc, inner.polys[1]);
            return .{ .order = 1, .deg = certDegOf(polys), .polys = polys };
        },
        .sq => {
            const p = (try polyOfNode(alloc, n.kid)) orelse return CertgenErr.SqrtNonPoly;
            defer polyFree(alloc, p);
            const dp = try polyDer(alloc, p);
            defer polyFree(alloc, dp);
            const ndp = try polyNeg(alloc, dp);
            defer polyFree(alloc, ndp);
            var two = try ratFromInt(alloc, 2);
            defer ratDeinit(&two);
            const tp = try polyScal(alloc, p, &two);
            defer polyFree(alloc, tp);
            const rat_polys = [2][]const Rat{ ndp, tp };
            const ips = try intPolysFromRats(alloc, &rat_polys);
            return .{ .order = 1, .deg = certDegOf(ips), .polys = ips };
        },
        .exp => {
            // y = exp p for poly p:  y' - p' y = 0  ->  p0 = -p', p1 = 1
            const p = (try polyOfNode(alloc, n.kid)) orelse return CertgenErr.ExpNonPoly;
            defer polyFree(alloc, p);
            const dp = try polyDer(alloc, p);
            defer polyFree(alloc, dp);
            const ndp = try polyNeg(alloc, dp);
            defer polyFree(alloc, ndp);
            const one = try polyOne(alloc);
            defer polyFree(alloc, one);
            const rat_polys = [2][]const Rat{ ndp, one };
            const ips = try intPolysFromRats(alloc, &rat_polys);
            return .{ .order = 1, .deg = certDegOf(ips), .polys = ips };
        },
        .log => {
            // y = log p for poly p:  p y' - p' = 0  ->  p0 = -p', p1 = p
            const p = (try polyOfNode(alloc, n.kid)) orelse return CertgenErr.LogNonPoly;
            defer polyFree(alloc, p);
            const dp = try polyDer(alloc, p);
            defer polyFree(alloc, dp);
            const ndp = try polyNeg(alloc, dp);
            defer polyFree(alloc, ndp);
            const rat_polys = [2][]const Rat{ ndp, p };
            const ips = try intPolysFromRats(alloc, &rat_polys);
            return .{ .order = 1, .deg = certDegOf(ips), .polys = ips };
        },
        .atan => {
            // y = atan p:  (1 + p^2) y' - p' = 0  ->  p0 = -p', p1 = 1+p^2
            const p = (try polyOfNode(alloc, n.kid)) orelse return CertgenErr.AtanNonPoly;
            defer polyFree(alloc, p);
            const dp = try polyDer(alloc, p);
            defer polyFree(alloc, dp);
            const ndp = try polyNeg(alloc, dp);
            defer polyFree(alloc, ndp);
            const one = try polyOne(alloc);
            defer polyFree(alloc, one);
            const p2 = try polyMul(alloc, p, p);
            defer polyFree(alloc, p2);
            const p1s = try polyAdd(alloc, one, p2);
            defer polyFree(alloc, p1s);
            const rat_polys = [2][]const Rat{ ndp, p1s };
            const ips = try intPolysFromRats(alloc, &rat_polys);
            return .{ .order = 1, .deg = certDegOf(ips), .polys = ips };
        },
    }
}

// Horner evaluation of a Rat-coefficient poly at integer n.
fn polyEvalRat(alloc: std.mem.Allocator, p: []const Rat, n: i64) !Rat {
    var acc = try ratFromInt(alloc, 0);
    errdefer ratDeinit(&acc);
    var nr = try ratFromInt(alloc, n);
    defer ratDeinit(&nr);
    var j: usize = p.len;
    while (j > 0) {
        j -= 1;
        var t = try ratMul(alloc, &acc, &nr);
        ratDeinit(&acc);
        const s = try ratAdd(alloc, &t, &p[j]);
        ratDeinit(&t);
        acc = s;
    }
    return acc;
}

// Generate `total` coefficients: seeds[0..R) are the actual series
// coefficients; a_m for m >= R is forced by the recurrence
//   sum_{k<R} p'_k(m-R) * a_{m-R+k} + p'_R(m-R) * a_m = 0.
// Callers guarantee det=1 so the denominator never vanishes.
fn certGenSeries(alloc: std.mem.Allocator, rec: *const OdeCert, seeds: []const Rat, total: usize) ![]Rat {
    const R = rec.order;
    const out = try alloc.alloc(Rat, total);
    var filled: usize = 0;
    errdefer {
        for (out[0..filled]) |*r| ratDeinit(r);
        alloc.free(out);
    }
    const shared = @min(R, total);
    while (filled < shared) : (filled += 1) out[filled] = try ratClone(&seeds[filled]);
    const rps = try alloc.alloc([]Rat, rec.polys.len);
    var nrp: usize = 0;
    defer {
        for (rps[0..nrp]) |p| polyFree(alloc, p);
        alloc.free(rps);
    }
    for (rec.polys) |bp| {
        rps[nrp] = try polyFromInts(alloc, bp);
        nrp += 1;
    }
    while (filled < total) : (filled += 1) {
        const nn: i64 = @intCast(filled - R);
        var num = try ratFromInt(alloc, 0);
        defer ratDeinit(&num);
        var k: usize = 0;
        while (k < R) : (k += 1) {
            var ev = try polyEvalRat(alloc, rps[k], nn);
            defer ratDeinit(&ev);
            var t = try ratMul(alloc, &ev, &out[filled - R + k]);
            defer ratDeinit(&t);
            const s = try ratAdd(alloc, &num, &t);
            ratDeinit(&num);
            num = s;
        }
        var den = try polyEvalRat(alloc, rps[R], nn);
        defer ratDeinit(&den);
        if (ratIsZero(&den)) @panic("std/sym:cert-series det violated");
        var neg = try ratNeg(&num);
        defer ratDeinit(&neg);
        out[filled] = try ratDiv(alloc, &neg, &den);
    }
    return out;
}

// cser(terms=N,det=1)|a=[...]|ode=...|rec=...
fn cserWrite(alloc: std.mem.Allocator, total: usize, coeffs: []const Rat, ode_text: []const u8, rec_text: []const u8) ![]u8 {
    var out = std.ArrayList(u8){};
    errdefer out.deinit(alloc);
    const hdr = std.fmt.allocPrint(alloc, "cser(terms={d},det=1)", .{total}) catch return error.OutOfMemory;
    defer alloc.free(hdr);
    try out.appendSlice(alloc, hdr);
    try out.appendSlice(alloc, "|a=[");
    const csv = try ratJoinCsv(alloc, coeffs);
    defer alloc.free(csv);
    const colon = std.mem.indexOfScalar(u8, csv, ':') orelse csv.len;
    try out.appendSlice(alloc, csv[colon + 1 ..]);
    try out.appendSlice(alloc, "]|ode=");
    try out.appendSlice(alloc, ode_text);
    try out.appendSlice(alloc, "|rec=");
    try out.appendSlice(alloc, rec_text);
    return out.toOwnedSlice(alloc);
}

// ============================================================================
// Tors.
// ============================================================================

// Structural ODE derivation — theorem-level, no series witness.
~pub tor cert-of { a: string<!sexpr> }
| exact string<std/io:allocated!>
| not-holonomic string<std/io:allocated!>
| bad string<std/io:allocated!>

~proc cert-of|zig {
    defer symFree(a);
    const alloc = koru_allocator();
    const t = parseTree(alloc, a) catch return .{ .bad = ownedCopy("malformed-expr") };
    defer nodeFree(alloc, t);
    const nt = norm(alloc, t) catch return .{ .bad = ownedCopy("malformed-expr") };
    defer nodeFree(alloc, nt);
    var cert = certOfNode(alloc, nt) catch |e| switch (e) {
        CertgenErr.InvHighOrder => return .{ .not_holonomic = ownedCopy("not-generally-holonomic:inv-order>1") },
        CertgenErr.SqrtNonPoly => return .{ .not_holonomic = ownedCopy("not-generally-holonomic:sqrt-nonpoly") },
        else => @panic("std/sym:cert-of"),
    };
    defer certFree(alloc, &cert);
    if (certPolyZero(cert.polys[cert.order])) return .{ .not_holonomic = ownedCopy("degenerate-leading") };
    const s = certWrite(alloc, cert.order, cert.deg, "of", cert.polys) catch @panic("std/sym:cert-of");
    return .{ .exact = s };
}

// Certified series: the theorem upgrade. cert-of -> bridge -> det ->
// exact seeds -> recurrence-generated tail. The emitted coefficients
// are FORCED by the annihilating ODE (residual zero for all n >= 0 by
// the closure theorems), so the tail is theorem-correct — the finite
// window only seeds it.
~pub tor cert-series { a: string<!sexpr>, terms: i64 }
| exact string<std/io:allocated!>
| under-determined string<std/io:allocated!>
| not-holonomic string<std/io:allocated!>
| non-rational
| non-analytic
| bad

~proc cert-series|zig {
    defer symFree(a);
    const alloc = koru_allocator();
    if (terms < 1 or terms > 1024) return .{ .bad = .{} };
    const t = parseTree(alloc, a) catch return .{ .bad = .{} };
    defer nodeFree(alloc, t);
    const nt = norm(alloc, t) catch return .{ .bad = .{} };
    defer nodeFree(alloc, nt);
    var cert = certOfNode(alloc, nt) catch |e| switch (e) {
        CertgenErr.InvHighOrder => return .{ .not_holonomic = ownedCopy("not-generally-holonomic:inv-order>1") },
        CertgenErr.SqrtNonPoly => return .{ .not_holonomic = ownedCopy("not-generally-holonomic:sqrt-nonpoly") },
        else => @panic("std/sym:cert-series"),
    };
    defer certFree(alloc, &cert);
    if (certPolyZero(cert.polys[cert.order])) return .{ .not_holonomic = ownedCopy("degenerate-leading") };
    var rec = certBridge(alloc, &cert) catch |e| switch (e) {
        error.NonInt => @panic("std/sym:cert-series bridge"),
        else => @panic("std/sym:cert-series"),
    };
    defer certFree(alloc, &rec);
    const det = !cert.polys[cert.order][0].eqlZero();
    const T: usize = @intCast(terms);
    const R = rec.order;
    if (!det) {
        const rt = recWrite(alloc, rec.order, rec.deg, "bridge", false, rec.polys) catch @panic("std/sym:cert-series");
        return .{ .under_determined = rt };
    }
    const seedn = @min(R, T);
    const seeds = serFromNode(alloc, nt, seedn) catch |e| switch (e) {
        error.NonAnalytic => return .{ .non_analytic = .{} },
        error.NonRational => return .{ .non_rational = .{} },
        else => @panic("std/sym:cert-series seeds"),
    };
    defer serFree(alloc, seeds);
    const coeffs = certGenSeries(alloc, &rec, seeds, T) catch @panic("std/sym:cert-series gen");
    defer {
        for (coeffs) |*r| ratDeinit(r);
        alloc.free(coeffs);
    }
    const odet = certWrite(alloc, cert.order, cert.deg, "of", cert.polys) catch @panic("std/sym:cert-series");
    defer alloc.free(odet);
    const rect = recWrite(alloc, rec.order, rec.deg, "bridge", true, rec.polys) catch @panic("std/sym:cert-series");
    defer alloc.free(rect);
    const s = cserWrite(alloc, T, coeffs, odet, rect) catch @panic("std/sym:cert-series");
    return .{ .exact = s };
}

// ============================================================================
// Decision tower — port of the artifact's decide_integral /
// risch_with_trig_rewrite / decide_ode
// (isar_holonomic_closure_algebra.py). Layers: ELEMENTARY (constructed),
// HOLONOMIC_SPECIAL (certified antiderivative via integral-shift),
// UNRESOLVED (named bound/evidence). Rational integrands run the real
// Hermite + Rothstein–Trager lane below: logs and arctans ARE constructed
// over Q and degree-2 residue fields (no i — quadratic disc<0 emits a
// real atan); cofactor degree >=3 names the missing algebraic layer.
// Non-rational integrands still fall to the holonomic lane.
// ============================================================================

// Antiderivative of a polynomial over Q: b_{i+1} = c_i/(i+1), b_0 = 0.
fn polyIntegral(alloc: std.mem.Allocator, p: []const Rat) ![]Rat {
    const out = try alloc.alloc(Rat, p.len + 1);
    var n: usize = 0;
    errdefer {
        for (out[0..n]) |*r| ratDeinit(r);
        alloc.free(out);
    }
    out[0] = try ratFromInt(alloc, 0);
    n = 1;
    var i: usize = 0;
    while (i < p.len) : (i += 1) {
        var d = try ratFromInt(alloc, @as(i64, @intCast(i)) + 1);
        defer ratDeinit(&d);
        out[n] = try ratDiv(alloc, &p[i], &d);
        n += 1;
    }
    return out;
}

// Rational-function extraction: returns a Frac (poly/poly over Q) for
// expressions built from dec/x/+/*/inv. sq and non-x atoms -> null.
fn ratFuncOfNode(alloc: std.mem.Allocator, n: *const SNode) anyerror!?Frac {
    switch (n.kind) {
        .dec => {
            const np = try alloc.alloc(Rat, 1);
            errdefer alloc.free(np);
            np[0] = try ratFromDec(alloc, &n.dec);
            const dp = try polyOne(alloc);
            return try fracNorm(alloc, np, dp);
        },
        .atom => {
            if (n.atom != 3) return null;
            const np = try alloc.alloc(Rat, 2);
            errdefer alloc.free(np);
            np[0] = try ratFromInt(alloc, 0);
            np[1] = try ratFromInt(alloc, 1);
            const dp = try polyOne(alloc);
            return try fracNorm(alloc, np, dp);
        },
        .add => {
            var acc = Frac{ .n = try polyEmpty(alloc), .d = try polyOne(alloc) };
            errdefer fracFree(alloc, &acc);
            for (n.kids) |k| {
                var kf = (try ratFuncOfNode(alloc, k)) orelse {
                    fracFree(alloc, &acc);
                    return null;
                };
                defer fracFree(alloc, &kf);
                const nf = try fracAdd(alloc, &acc, &kf);
                fracFree(alloc, &acc);
                acc = nf;
            }
            return acc;
        },
        .mul => {
            var acc = (try ratFuncOfNode(alloc, n.kids[0])) orelse return null;
            errdefer fracFree(alloc, &acc);
            for (n.kids[1..]) |k| {
                var kf = (try ratFuncOfNode(alloc, k)) orelse {
                    fracFree(alloc, &acc);
                    return null;
                };
                defer fracFree(alloc, &kf);
                const nf = try fracMul(alloc, &acc, &kf);
                fracFree(alloc, &acc);
                acc = nf;
            }
            return acc;
        },
        .inv => {
            var kf = (try ratFuncOfNode(alloc, n.kid)) orelse return null;
            defer fracFree(alloc, &kf);
            if (fracIsZero(&kf)) return null;
            return try fracInv(alloc, &kf);
        },
        .sq, .log, .atan, .exp => return null,
    }
}

// ============================================================================
// Hermite reduction (Horowitz–Ostrogradsky form) over Q(x): for reduced
// N/D, with D- = gcd(D, D') and D* = D/D-,
//   ∫ N/D = ∫ Q + B/D- + ∫ C/D*       (deg B < deg D-, deg C < deg D*)
// where Q is the polynomial part. B, C solve the square linear system
//   R = B'·D* − B·H + C·D-,   H = D*·D-'/D-   (a polynomial)
// The rational part B/D- is the whole rational part of the antiderivative;
// C/D* has a squarefree denominator, so its integral is purely logarithmic
// (Rothstein–Trager). Result is checked exactly: Q + (B/D-)' + C/D* == N/D.
// ============================================================================

const HermiteOut = struct { poly: []Rat, rat: Frac, log: Frac };

fn polyShiftScal(alloc: std.mem.Allocator, p: []const Rat, k: usize, s: i64) ![]Rat {
    const out = try alloc.alloc(Rat, p.len + k);
    var i: usize = 0;
    errdefer {
        for (out[0..i]) |*c| ratDeinit(c);
        alloc.free(out);
    }
    while (i < k) : (i += 1) out[i] = try ratFromInt(alloc, 0);
    while (i < out.len) : (i += 1) out[i] = try ratMulInt(alloc, &p[i - k], s);
    return out;
}

fn hermiteReduce(alloc: std.mem.Allocator, f: *const Frac) !HermiteOut {
    const qr = try polyDivMod(alloc, f.n, f.d);
    defer polyFree(alloc, qr.r);
    errdefer polyFree(alloc, qr.q);
    const dD = try polyDer(alloc, f.d);
    defer polyFree(alloc, dD);
    const dm = try polyGcd(alloc, f.d, dD);
    defer polyFree(alloc, dm);
    const dsq = try polyDivMod(alloc, f.d, dm);
    polyFree(alloc, dsq.r);
    const ds = dsq.q;
    defer polyFree(alloc, ds);
    const dmD = try polyDer(alloc, dm);
    defer polyFree(alloc, dmD);
    const t = try polyMul(alloc, ds, dmD);
    defer polyFree(alloc, t);
    const hq = try polyDivMod(alloc, t, dm);
    polyFree(alloc, hq.r);
    const h = hq.q;
    defer polyFree(alloc, h);

    const m = polyDegIdx(dm);
    const s = polyDegIdx(ds);
    const n = m + s;
    const rows = try alloc.alloc([]Rat, n);
    var built: usize = 0;
    defer {
        for (rows[0..built]) |row| polyFree(alloc, row);
        alloc.free(rows);
    }
    while (built < n) : (built += 1) {
        rows[built] = try alloc.alloc(Rat, n + 1);
        var z: usize = 0;
        errdefer {
            for (rows[built][0..z]) |*c| ratDeinit(c);
            alloc.free(rows[built]);
        }
        while (z < n + 1) : (z += 1) rows[built][z] = try ratFromInt(alloc, 0);
    }
    const setCol = struct {
        fn go(rs: [][]Rat, col: usize, p: []const Rat) !void {
            for (p, 0..) |*c, j| {
                if (ratIsZero(c)) continue;
                if (j >= rs.len) return error.HermiteDegree;
                ratDeinit(&rs[j][col]);
                rs[j][col] = try ratClone(c);
            }
        }
    }.go;
    var i: usize = 0;
    while (i < m) : (i += 1) {
        const t1 = if (i > 0) try polyShiftScal(alloc, ds, i - 1, @intCast(i)) else try polyEmpty(alloc);
        defer polyFree(alloc, t1);
        const t2 = try polyShiftScal(alloc, h, i, 1);
        defer polyFree(alloc, t2);
        const col = try polySub(alloc, t1, t2);
        defer polyFree(alloc, col);
        try setCol(rows, i, col);
    }
    i = 0;
    while (i < s) : (i += 1) {
        const col = try polyShiftScal(alloc, dm, i, 1);
        defer polyFree(alloc, col);
        try setCol(rows, m + i, col);
    }
    const nr = try polyNeg(alloc, qr.r);
    defer polyFree(alloc, nr);
    try setCol(rows, n, nr);

    const sol = (try rrefNullVec(alloc, rows, n + 1)) orelse return error.HermiteSingular;
    defer polyFree(alloc, sol);
    if (!ratIsOne(&sol[n])) return error.HermiteSingular;
    // fracNorm consumes n,d (and frees both on its own error path), so each
    // pair is handed over immediately — no errdefer stays armed across it.
    const bpart = try polyClone(alloc, sol[0..m]);
    const dm2 = polyClone(alloc, dm) catch |e| {
        polyFree(alloc, bpart);
        return e;
    };
    var rat = try fracNorm(alloc, bpart, dm2);
    errdefer fracFree(alloc, &rat);
    const cpart = try polyClone(alloc, sol[m..n]);
    const ds2 = polyClone(alloc, ds) catch |e| {
        polyFree(alloc, cpart);
        return e;
    };
    const logp = try fracNorm(alloc, cpart, ds2);
    return .{ .poly = qr.q, .rat = rat, .log = logp };
}

// Exact check: Q + (B/D-)' + C/D* == f.
fn hermiteCheck(alloc: std.mem.Allocator, f: *const Frac, h: *const HermiteOut) !bool {
    var qf = try fracNorm(alloc, try polyClone(alloc, h.poly), try polyOne(alloc));
    defer fracFree(alloc, &qf);
    var rd = try fracDer(alloc, &h.rat);
    defer fracFree(alloc, &rd);
    var s1 = try fracAdd(alloc, &qf, &rd);
    defer fracFree(alloc, &s1);
    var s2 = try fracAdd(alloc, &s1, &h.log);
    defer fracFree(alloc, &s2);
    var nf = try fracNeg(alloc, f);
    defer fracFree(alloc, &nf);
    var diff = try fracAdd(alloc, &s2, &nf);
    defer fracFree(alloc, &diff);
    return fracIsZero(&diff);
}

// Sexpr text of a polynomial / rational function — fed to normCanon, so
// the shape only has to parse, not be canonical.
fn polyText(alloc: std.mem.Allocator, out: *std.ArrayList(u8), p: []const Rat) !void {
    try out.append(alloc, '(');
    var first = true;
    for (p, 0..) |*c, i| {
        if (ratIsZero(c)) continue;
        if (!first) try out.append(alloc, '+');
        first = false;
        const cs = try ratToString(alloc, c);
        defer alloc.free(cs);
        try out.append(alloc, '(');
        try out.appendSlice(alloc, cs);
        try out.append(alloc, ')');
        var k: usize = 0;
        while (k < i) : (k += 1) try out.appendSlice(alloc, "*x");
    }
    if (first) try out.append(alloc, '0');
    try out.append(alloc, ')');
}

fn fracText(alloc: std.mem.Allocator, out: *std.ArrayList(u8), f: *const Frac) !void {
    if (fracIsZero(f)) return out.appendSlice(alloc, "(0)");
    try polyText(alloc, out, f.n);
    try out.appendSlice(alloc, "*inv(");
    try polyText(alloc, out, f.d);
    try out.append(alloc, ')');
}








// ============================================================================
// Trager log part — the squarefree remainder C/D of Hermite reduction
// integrates to a sum of logs/arctans over the roots of the
// Rothstein-Trager resultant R(t) = res_x(C - t*D', D). Real lane, no i:
//   * rational root c        -> c*log(gcd(C - cD', D))
//   * irreducible t^2+ut+v, disc>0 -> conjugate real pair (rho±w)*log(A±wB)
//   * irreducible t^2+ut+v, disc<0 -> rho*log(A^2+w^2 B^2) + 2w*atan(A/(wB))
//   * residue cofactor deg>=3   -> refused by name (algebraic coeffs
//     beyond quadratics need a real algebraic-number layer we don't have)
// Every constructed term is derivative-checked: the Frac-sum of the term
// derivatives must equal C/D exactly, before anything is emitted.
// ============================================================================

// R(t) = res_x(C - t*D', D) — the formal Sylvester determinant over
// Q[t], computed exactly by Bareiss fraction-free elimination. A's
// x-coefficients are t-affine (a_j = C_j - D'_j * t) at formal degree
// m1 = max(deg C, deg D'); D's are constants. The determinant IS the
// resultant — no evaluation points, no degree bound, no interpolation.
// Bareiss guarantees each intermediate division is exact; a nonzero
// remainder would be an elimination bug, not bad luck.
fn rtResultant(alloc: std.mem.Allocator, C: []const Rat, D: []const Rat) ![]Rat {
    const dD = try polyDer(alloc, D);
    defer polyFree(alloc, dD);
    const m1 = @max(polyDegIdx(C), if (polyIsZero(dD)) @as(usize, 0) else polyDegIdx(dD));
    const n = polyDegIdx(D);
    const N = m1 + n;
    // Sylvester matrix over Q[t]: cell[r*N+c] = ?[]Rat, null = zero poly.
    const cell = try alloc.alloc(?[]Rat, N * N);
    for (cell) |*cl| cl.* = null;
    defer {
        for (cell) |*cl| if (cl.*) |clp| polyFree(alloc, clp);
        alloc.free(cell);
    }
    // n rows of t-affine A coeffs, each shifted right by the row index.
    var r: usize = 0;
    while (r < n) : (r += 1) {
        var j: usize = 0;
        while (j <= m1) : (j += 1) {
            const z0 = j >= C.len or ratIsZero(&C[j]);
            const z1 = j >= dD.len or ratIsZero(&dD[j]);
            if (z0 and z1) continue;
            const pl = try alloc.alloc(Rat, 2);
            pl[0] = if (z0) try ratFromInt(alloc, 0) else try ratClone(&C[j]);
            pl[1] = if (z1) try ratFromInt(alloc, 0) else try ratNeg(&dD[j]);
            cell[r * N + r + j] = pl;
        }
    }
    // m1 rows of constant D coeffs.
    r = 0;
    while (r < m1) : (r += 1) {
        var j: usize = 0;
        while (j <= n) : (j += 1) {
            if (ratIsZero(&D[j])) continue;
            const pl = try alloc.alloc(Rat, 1);
            pl[0] = try ratClone(&D[j]);
            cell[(n + r) * N + r + j] = pl;
        }
    }
    // Bareiss fraction-free elimination: M[i][j] <- (M[k][k]*M[i][j] -
    // M[i][k]*M[k][j]) / M[k-1][k-1], exact in Q[t] by construction.
    var neg = false;
    var prev: ?[]Rat = null; // (k-1)-th pivot; null acts as divisor 1
    defer if (prev) |pp| polyFree(alloc, pp);
    var k: usize = 0;
    while (k + 1 < N) : (k += 1) {
        if (cell[k * N + k] == null) {
            var ir2 = k + 1;
            while (ir2 < N and cell[ir2 * N + k] == null) ir2 += 1;
            if (ir2 == N) return polyEmpty(alloc); // det = 0
            var c2: usize = 0;
            while (c2 < N) : (c2 += 1) {
                const tmp = cell[k * N + c2];
                cell[k * N + c2] = cell[ir2 * N + c2];
                cell[ir2 * N + c2] = tmp;
            }
            neg = !neg;
        }
        var i: usize = k + 1;
        while (i < N) : (i += 1) {
            var j: usize = k + 1;
            while (j < N) : (j += 1) {
                var tA = try polyEmpty(alloc);
                defer polyFree(alloc, tA);
                var tB = try polyEmpty(alloc);
                defer polyFree(alloc, tB);
                if (cell[k * N + k]) |pk| {
                    if (cell[i * N + j]) |pij| {
                        polyFree(alloc, tA);
                        tA = try polyMul(alloc, pk, pij);
                    }
                }
                if (cell[i * N + k]) |pik| {
                    if (cell[k * N + j]) |pkj| {
                        polyFree(alloc, tB);
                        tB = try polyMul(alloc, pik, pkj);
                    }
                }
                const num = try polySub(alloc, tA, tB);
                defer polyFree(alloc, num);
                if (polyIsZero(num)) {
                    if (cell[i * N + j]) |old| polyFree(alloc, old);
                    cell[i * N + j] = null;
                    continue;
                }
                var nv: []Rat = undefined;
                if (prev) |pp| {
                    const dm = try polyDivMod(alloc, num, pp);
                    defer polyFree(alloc, dm.r);
                    if (!polyIsZero(dm.r)) {
                        polyFree(alloc, dm.q);
                        @panic("std/sym: bareiss inexact division — elimination bug");
                    }
                    nv = dm.q;
                } else {
                    nv = try polyClone(alloc, num);
                }
                if (cell[i * N + j]) |old| polyFree(alloc, old);
                cell[i * N + j] = nv;
            }
        }
        // the pivot becomes next step's exact divisor
        if (prev) |pp| polyFree(alloc, pp);
        prev = try polyClone(alloc, cell[k * N + k].?);
    }
    const det = cell[(N - 1) * N + (N - 1)] orelse try polyEmpty(alloc);
    cell[(N - 1) * N + (N - 1)] = null;
    if (neg) for (det) |*cc| cc.n.negate();
    return det;
}

// Divisors of |a| by trial division up to sqrt; CAP keeps a huge
// coefficient a named gap rather than a hang.
fn intDivisors(alloc: std.mem.Allocator, a: *const BI, out: *std.ArrayList(BI)) !void {
    const CAP: i64 = 300000;
    var aa = try a.clone();
    defer aa.deinit();
    aa.abs();
    if (aa.eqlZero()) return;
    var one = try BI.initSet(alloc, 1);
    defer one.deinit();
    var i = try BI.initSet(alloc, 1);
    defer i.deinit();
    var i_sq = try BI.initSet(alloc, 1);
    defer i_sq.deinit();
    var steps: i64 = 0;
    while (i_sq.order(aa) != .gt) {
        if (steps > CAP) return error.RootEnumWide;
        steps += 1;
        var q = try BI.init(alloc);
        defer q.deinit();
        var r = try BI.init(alloc);
        defer r.deinit();
        try q.divTrunc(&r, &aa, &i);
        if (r.eqlZero()) {
            try out.append(alloc, try i.clone());
            if (q.order(i) != .eq) try out.append(alloc, try q.clone());
        }
        try i.add(&i, &one);
        try i_sq.mul(&i, &i);
    }
}

// Evaluate a Rat poly at a Rat point (Horner).
fn polyEvalAtRat(alloc: std.mem.Allocator, p: []const Rat, x: *const Rat) !Rat {
    var acc = try ratFromInt(alloc, 0);
    errdefer ratDeinit(&acc);
    var j: usize = p.len;
    while (j > 0) {
        j -= 1;
        var t = try ratMul(alloc, &acc, x);
        ratDeinit(&acc);
        const s = try ratAdd(alloc, &t, &p[j]);
        ratDeinit(&t);
        acc = s;
    }
    return acc;
}

// Split off all rational roots of R (integerized, rational root theorem):
// returns the found roots; R is divided down to the non-rational cofactor.
fn ratRootSplit(alloc: std.mem.Allocator, R_in: []const Rat, roots: *std.ArrayList(Rat)) ![]Rat {
    var rem = try polyClone(alloc, R_in);
    errdefer polyFree(alloc, rem);
    while (true) {
        const dg = polyDegIdx(rem);
        if (dg == 0) break;
        // pull out t=0 roots first: rem[0] == 0
        if (ratIsZero(&rem[0])) {
            try roots.append(alloc, try ratFromInt(alloc, 0));
            const t = try alloc.alloc(Rat, 2);
            defer alloc.free(t);
            t[0] = try ratFromInt(alloc, 0);
            t[1] = try ratFromInt(alloc, 1);
            defer {
                ratDeinit(&t[0]);
                ratDeinit(&t[1]);
            }
            const dm = try polyDivMod(alloc, rem, t);
            polyFree(alloc, dm.r);
            polyFree(alloc, rem);
            rem = dm.q;
            continue;
        }
        const ips = try intPolysFromRats(alloc, &[_][]const Rat{rem});
        defer {
            for (ips) |ip| {
                for (ip) |*b| b.deinit();
                alloc.free(ip);
            }
            alloc.free(ips);
        }
        const ip = ips[0];
        var pdivs = std.ArrayList(BI){};
        defer {
            for (pdivs.items) |*b| b.deinit();
            pdivs.deinit(alloc);
        }
        var qdivs = std.ArrayList(BI){};
        defer {
            for (qdivs.items) |*b| b.deinit();
            qdivs.deinit(alloc);
        }
        try intDivisors(alloc, &ip[0], &pdivs);
        try intDivisors(alloc, &ip[polyDegIdx(rem)], &qdivs);
        var found = false;
        for (qdivs.items) |*qd| {
            for (pdivs.items) |*pd| {
                var sgn: usize = 0;
                while (sgn < 2) : (sgn += 1) {
                    var cn = try pd.clone();
                    if (sgn == 1) cn.negate();
                    const c = try ratNorm(alloc, cn, try qd.clone());
                    defer ratDeinit(@constCast(&c));
                    var v = try polyEvalAtRat(alloc, rem, &c);
                    const z = ratIsZero(&v);
                    ratDeinit(&v);
                    if (!z) continue;
                    try roots.append(alloc, try ratClone(&c));
                    const t = try alloc.alloc(Rat, 2);
                    defer alloc.free(t);
                    t[0] = try ratNeg(&c);
                    t[1] = try ratFromInt(alloc, 1);
                    defer {
                        ratDeinit(&t[0]);
                        ratDeinit(&t[1]);
                    }
                    const dm = try polyDivMod(alloc, rem, t);
                    polyFree(alloc, dm.r);
                    polyFree(alloc, rem);
                    rem = dm.q;
                    found = true;
                    break;
                }
                if (found) break;
            }
            if (found) break;
        }
        if (!found) break;
    }
    return rem;
}

// ---- K = Q[t]/(t^2 + u t + v) — element {a, b} = a + b t ----
const Quad = struct { a: Rat, b: Rat };

fn qZero(alloc: std.mem.Allocator) !Quad {
    return .{ .a = try ratFromInt(alloc, 0), .b = try ratFromInt(alloc, 0) };
}

fn qIsZero(x: *const Quad) bool {
    return ratIsZero(&x.a) and ratIsZero(&x.b);
}

fn qDeinit(x: *Quad) void {
    ratDeinit(&x.a);
    ratDeinit(&x.b);
}

fn qClone(x: *const Quad) !Quad {
    return .{ .a = try ratClone(&x.a), .b = try ratClone(&x.b) };
}

fn qAdd(alloc: std.mem.Allocator, x: *const Quad, y: *const Quad) !Quad {
    return .{ .a = try ratAdd(alloc, &x.a, &y.a), .b = try ratAdd(alloc, &x.b, &y.b) };
}

fn qSub(alloc: std.mem.Allocator, x: *const Quad, y: *const Quad) !Quad {
    return .{ .a = try ratSub(alloc, &x.a, &y.a), .b = try ratSub(alloc, &x.b, &y.b) };
}

// (a+bt)(c+dt) = (ac - bd v) + (ad + bc - bd u) t   since t^2 = -u t - v
fn qMul(alloc: std.mem.Allocator, u: *const Rat, v: *const Rat, x: *const Quad, y: *const Quad) !Quad {
    var ac = try ratMul(alloc, &x.a, &y.a);
    defer ratDeinit(&ac);
    var bd = try ratMul(alloc, &x.b, &y.b);
    defer ratDeinit(&bd);
    var adv = try ratMul(alloc, &x.a, &y.b);
    defer ratDeinit(&adv);
    var bc = try ratMul(alloc, &x.b, &y.a);
    defer ratDeinit(&bc);
    var bdv = try ratMul(alloc, &bd, v);
    defer ratDeinit(&bdv);
    var bdu = try ratMul(alloc, &bd, u);
    defer ratDeinit(&bdu);
    var s = try ratAdd(alloc, &adv, &bc);
    defer ratDeinit(&s);
    return .{
        .a = try ratSub(alloc, &ac, &bdv),
        .b = try ratSub(alloc, &s, &bdu),
    };
}

// N(a+bt) = a^2 - u a b + v b^2; inverse = (a - u b - b t)/N.
// N = 0 only for the zero element (the modulus is irreducible over Q).
fn qInv(alloc: std.mem.Allocator, u: *const Rat, v: *const Rat, x: *const Quad) !Quad {
    if (qIsZero(x)) return error.DivZero;
    var a2 = try ratMul(alloc, &x.a, &x.a);
    defer ratDeinit(&a2);
    var ab = try ratMul(alloc, &x.a, &x.b);
    defer ratDeinit(&ab);
    var b2 = try ratMul(alloc, &x.b, &x.b);
    defer ratDeinit(&b2);
    var uab = try ratMul(alloc, u, &ab);
    defer ratDeinit(&uab);
    var vb2 = try ratMul(alloc, v, &b2);
    defer ratDeinit(&vb2);
    var t1 = try ratSub(alloc, &a2, &uab);
    defer ratDeinit(&t1);
    var nm = try ratAdd(alloc, &t1, &vb2);
    defer ratDeinit(&nm);
    var ub = try ratMul(alloc, u, &x.b);
    defer ratDeinit(&ub);
    var na = try ratSub(alloc, &x.a, &ub);
    defer ratDeinit(&na);
    var nb = try ratNeg(&x.b);
    defer ratDeinit(&nb);
    return .{
        .a = try ratDiv(alloc, &na, &nm),
        .b = try ratDiv(alloc, &nb, &nm),
    };
}

fn qPolyIsZero(p: []const Quad) bool {
    for (p) |*c| {
        if (!qIsZero(c)) return false;
    }
    return true;
}

fn qPolyDegIdx(p: []const Quad) usize {
    var i: usize = p.len - 1;
    while (i > 0 and qIsZero(&p[i])) i -= 1;
    return i;
}

fn qPolyFree(alloc: std.mem.Allocator, p: []Quad) void {
    for (p) |*c| qDeinit(c);
    alloc.free(p);
}

fn qPolyClone(alloc: std.mem.Allocator, p: []const Quad) ![]Quad {
    const out = try alloc.alloc(Quad, p.len);
    var i: usize = 0;
    errdefer {
        for (out[0..i]) |*c| qDeinit(c);
        alloc.free(out);
    }
    while (i < p.len) : (i += 1) out[i] = try qClone(&p[i]);
    return out;
}

const QPolyDM = struct { q: []Quad, r: []Quad };

fn qPolyDivMod(alloc: std.mem.Allocator, u: *const Rat, v: *const Rat, a_in: []const Quad, b: []const Quad) !QPolyDM {
    const a = try qPolyClone(alloc, a_in);
    errdefer qPolyFree(alloc, a);
    const q = try alloc.alloc(Quad, a_in.len);
    var qi: usize = 0;
    errdefer {
        for (q[0..qi]) |*c| qDeinit(c);
        alloc.free(q);
    }
    while (qi < q.len) : (qi += 1) q[qi] = try qZero(alloc);
    const bd = qPolyDegIdx(b);
    while (true) {
        if (qPolyIsZero(a)) break;
        const ad = qPolyDegIdx(a);
        if (ad < bd) break;
        const shift = ad - bd;
        var cf = try qInv(alloc, u, v, &b[bd]);
        defer qDeinit(&cf);
        const cf2 = try qMul(alloc, u, v, &cf, &a[ad]);
        qDeinit(&cf);
        cf = cf2;
        const nv = try qAdd(alloc, &q[shift], &cf);
        qDeinit(&q[shift]);
        q[shift] = nv;
        var i: usize = 0;
        while (i <= bd) : (i += 1) {
            if (qIsZero(&b[i])) continue;
            var t = try qMul(alloc, u, v, &cf, &b[i]);
            const nv2 = try qSub(alloc, &a[i + shift], &t);
            qDeinit(&t);
            qDeinit(&a[i + shift]);
            a[i + shift] = nv2;
        }
    }
    return .{ .q = q, .r = a };
}

// monic gcd over K[x]
fn qPolyGcd(alloc: std.mem.Allocator, u: *const Rat, v: *const Rat, a_in: []const Quad, b_in: []const Quad) ![]Quad {
    var a = try qPolyClone(alloc, a_in);
    errdefer qPolyFree(alloc, a);
    var b = try qPolyClone(alloc, b_in);
    defer qPolyFree(alloc, b);
    while (!qPolyIsZero(b)) {
        const dm = try qPolyDivMod(alloc, u, v, a, b);
        qPolyFree(alloc, dm.q);
        qPolyFree(alloc, a);
        a = b;
        b = dm.r;
    }
    if (qPolyIsZero(a)) return a;
    const lc = &a[qPolyDegIdx(a)];
    if (!ratIsZero(&lc.b) or !ratIsOne(&lc.a)) {
        var lci = try qInv(alloc, u, v, lc);
        defer qDeinit(&lci);
        for (a) |*c| {
            const nv = try qMul(alloc, u, v, c, &lci);
            qDeinit(c);
            c.* = nv;
        }
    }
    return a;
}

// ============================================================================
// The construction — emits sexpr fragments into `text` and the exact
// derivative Frac of the emitted terms into `check`. null on success, or
// a named refusal string (allocated) otherwise.
// ============================================================================

fn polyTextOf(alloc: std.mem.Allocator, p: []const Rat) ![]u8 {
    var t = std.ArrayList(u8){};
    errdefer t.deinit(alloc);
    try polyText(alloc, &t, p);
    return t.toOwnedSlice(alloc);
}

// c*S'/S as a normalized Frac — derivative of c*log(S).
fn ratLogDeriv(alloc: std.mem.Allocator, c: *const Rat, S: []const Rat) !Frac {
    const dS = try polyDer(alloc, S);
    defer polyFree(alloc, dS);
    const n = try polyScal(alloc, dS, c);
    const d = try polyClone(alloc, S);
    return fracNorm(alloc, n, d);
}

// Frac equality by cross-multiplication (n1*d2 == n2*d1).
fn fracEql(alloc: std.mem.Allocator, a: *const Frac, b: *const Frac) !bool {
    const l = try polyMul(alloc, a.n, b.d);
    defer polyFree(alloc, l);
    const r = try polyMul(alloc, a.d, b.n);
    defer polyFree(alloc, r);
    const d = try polySub(alloc, l, r);
    defer polyFree(alloc, d);
    return polyIsZero(d);
}

// The quadratic-field gcd S(x,t) = S0 + t*S1 decomposed to Rat polys.
const QuadGcd = struct { s0: []Rat, s1: []Rat };

fn quadGcdDecomp(alloc: std.mem.Allocator, u: *const Rat, v: *const Rat, C: []const Rat, D: []const Rat, dD: []const Rat) !QuadGcd {
    const fl = @max(C.len, dD.len);
    const f = try alloc.alloc(Quad, fl);
    var fi: usize = 0;
    errdefer {
        for (f[0..fi]) |*c| qDeinit(c);
        alloc.free(f);
    }
    while (fi < fl) : (fi += 1) {
        f[fi] = .{
            .a = if (fi < C.len) try ratClone(&C[fi]) else try ratFromInt(alloc, 0),
            .b = if (fi < dD.len) try ratNeg(&dD[fi]) else try ratFromInt(alloc, 0),
        };
    }
    const g = try alloc.alloc(Quad, D.len);
    var gi: usize = 0;
    errdefer {
        for (g[0..gi]) |*c| qDeinit(c);
        alloc.free(g);
    }
    while (gi < D.len) : (gi += 1) {
        g[gi] = .{ .a = try ratClone(&D[gi]), .b = try ratFromInt(alloc, 0) };
    }
    const s = try qPolyGcd(alloc, u, v, f, g);
    defer qPolyFree(alloc, s);
    const sd = qPolyDegIdx(s);
    const s0 = try alloc.alloc(Rat, sd + 1);
    var s0i: usize = 0;
    errdefer {
        for (s0[0..s0i]) |*r| ratDeinit(r);
        alloc.free(s0);
    }
    const s1 = try alloc.alloc(Rat, sd + 1);
    var s1i: usize = 0;
    errdefer {
        for (s1[0..s1i]) |*r| ratDeinit(r);
        alloc.free(s1);
    }
    var i: usize = 0;
    while (i <= sd) : (i += 1) {
        s0[i] = try ratClone(&s[i].a);
        s0i += 1;
        s1[i] = try ratClone(&s[i].b);
        s1i += 1;
    }
    qPolyFree(alloc, f);
    qPolyFree(alloc, g);
    return .{ .s0 = s0, .s1 = s1 };
}

// Quadratic residue factor t^2+ut+v: build S(x,t)=S0+t*S1 over K,
//   rho = -u/2, A = s0 + rho*s1, B = s1, w2 = |disc|/4
//   disc > 0: (rho+w)*log(A+wB) + (rho-w)*log(A-wB)
//             derivative: (2 rho E + 2 w2 F)/(A^2 - w2 B^2),
//             E = A'A - w2 B'B, F = B'A - A'B
//   disc < 0: rho*log(A^2 + w2 B^2) + 2w*atan(A/(wB))
//             derivative: (2 rho (AA' + w2 BB') + 2 w2 (A'B - AB'))/(A^2 + w2 B^2)
// (a deg-2 squarefree cofactor is always irreducible — a square disc
// would mean rational roots, which the enumeration already consumed.)
fn quadLane(alloc: std.mem.Allocator, u: *const Rat, v: *const Rat, C: []const Rat, D: []const Rat, dD: []const Rat, text: *std.ArrayList(u8), check: *Frac) !void {
    const gd = try quadGcdDecomp(alloc, u, v, C, D, dD);
    defer {
        polyFree(alloc, gd.s0);
        polyFree(alloc, gd.s1);
    }
    var two_ = try ratFromInt(alloc, 2);
    defer ratDeinit(&two_);
    var four_ = try ratFromInt(alloc, 4);
    defer ratDeinit(&four_);
    var rho = try ratDiv(alloc, u, &two_);
    defer ratDeinit(&rho);
    rho.n.negate();
    const rs1 = try polyScal(alloc, gd.s1, &rho);
    defer polyFree(alloc, rs1);
    const A = try polyAdd(alloc, gd.s0, rs1);
    defer polyFree(alloc, A);
    const B = gd.s1;
    var disc = try ratMul(alloc, u, u);
    defer ratDeinit(&disc);
    var v4 = try ratMul(alloc, v, &four_);
    defer ratDeinit(&v4);
    var disc2 = try ratSub(alloc, &disc, &v4);
    defer ratDeinit(&disc2);
    if (ratIsZero(&disc2)) @panic("std/sym: trager cofactor not squarefree");
    const disc_neg = disc2.n.toConst().orderAgainstScalar(@as(i64, 0)) == .lt;
    var w2 = try ratClone(&disc2);
    defer ratDeinit(&w2);
    if (disc_neg) w2.n.negate();
    var w2q = try ratDiv(alloc, &w2, &four_);
    defer ratDeinit(&w2q);
    const dA = try polyDer(alloc, A);
    defer polyFree(alloc, dA);
    const dB = try polyDer(alloc, B);
    defer polyFree(alloc, dB);
    const pone = try polyOne(alloc);
    defer polyFree(alloc, pone);
    const w2p = try polyScal(alloc, pone, &w2q);
    defer polyFree(alloc, w2p);
    const AA2 = try polyMul(alloc, A, A);
    defer polyFree(alloc, AA2);
    const BB2 = try polyMul(alloc, B, B);
    defer polyFree(alloc, BB2);
    const wBB = try polyMul(alloc, w2p, BB2);
    defer polyFree(alloc, wBB);
    const AA_ = try polyMul(alloc, dA, A);
    defer polyFree(alloc, AA_);
    const BB_ = try polyMul(alloc, dB, B);
    defer polyFree(alloc, BB_);
    const AB_ = try polyMul(alloc, dA, B);
    defer polyFree(alloc, AB_);
    const BA_ = try polyMul(alloc, dB, A);
    defer polyFree(alloc, BA_);
    const rho_t = try ratToString(alloc, &rho);
    defer alloc.free(rho_t);
    const w2_t = try ratToString(alloc, &w2q);
    defer alloc.free(w2_t);
    const At = try polyTextOf(alloc, A);
    defer alloc.free(At);
    const Bt = try polyTextOf(alloc, B);
    defer alloc.free(Bt);
    if (disc_neg) {
        const w2BB_ = try polyMul(alloc, w2p, BB_);
        defer polyFree(alloc, w2BB_);
        const inner1 = try polyAdd(alloc, AA_, w2BB_);
        defer polyFree(alloc, inner1);
        const p1 = try polyScal(alloc, inner1, &two_);
        defer polyFree(alloc, p1);
        const p1r = try polyScal(alloc, p1, &rho);
        defer polyFree(alloc, p1r);
        const F = try polySub(alloc, AB_, BA_);
        defer polyFree(alloc, F);
        const F2 = try polyScal(alloc, F, &two_);
        defer polyFree(alloc, F2);
        const w2F = try polyMul(alloc, w2p, F2);
        defer polyFree(alloc, w2F);
        const num = try polyAdd(alloc, p1r, w2F);
        defer polyFree(alloc, num);
        const den = try polyAdd(alloc, AA2, wBB);
        defer polyFree(alloc, den);
        var cres = try fracNorm(alloc, try polyClone(alloc, num), try polyClone(alloc, den));
        defer fracFree(alloc, &cres);
        const ncheck = try fracAdd(alloc, check, &cres);
        fracFree(alloc, check);
        check.* = ncheck;
        if (!ratIsZero(&rho)) {
            try text.appendSlice(alloc, "+(");
            try text.appendSlice(alloc, rho_t);
            try text.appendSlice(alloc, "*log(");
            try text.appendSlice(alloc, At);
            try text.appendSlice(alloc, "*");
            try text.appendSlice(alloc, At);
            try text.appendSlice(alloc, "+");
            try text.appendSlice(alloc, w2_t);
            try text.appendSlice(alloc, "*");
            try text.appendSlice(alloc, Bt);
            try text.appendSlice(alloc, "*");
            try text.appendSlice(alloc, Bt);
            try text.appendSlice(alloc, "))");
        }
        try text.appendSlice(alloc, "+((2)*\xE2\x88\x9A(");
        try text.appendSlice(alloc, w2_t);
        try text.appendSlice(alloc, "))*atan(");
        try text.appendSlice(alloc, At);
        try text.appendSlice(alloc, "*inv(\xE2\x88\x9A(");
        try text.appendSlice(alloc, w2_t);
        try text.appendSlice(alloc, ")*");
        try text.appendSlice(alloc, Bt);
        try text.appendSlice(alloc, "))");
    } else {
        const w2BB2 = try polyMul(alloc, w2p, BB_);
        defer polyFree(alloc, w2BB2);
        const E = try polySub(alloc, AA_, w2BB2);
        defer polyFree(alloc, E);
        const E2 = try polyScal(alloc, E, &two_);
        defer polyFree(alloc, E2);
        const p1 = try polyScal(alloc, E2, &rho);
        defer polyFree(alloc, p1);
        const F = try polySub(alloc, BA_, AB_);
        defer polyFree(alloc, F);
        const F2 = try polyScal(alloc, F, &two_);
        defer polyFree(alloc, F2);
        const w2F = try polyMul(alloc, w2p, F2);
        defer polyFree(alloc, w2F);
        const num = try polyAdd(alloc, p1, w2F);
        defer polyFree(alloc, num);
        const den = try polySub(alloc, AA2, wBB);
        defer polyFree(alloc, den);
        var cres = try fracNorm(alloc, try polyClone(alloc, num), try polyClone(alloc, den));
        defer fracFree(alloc, &cres);
        const ncheck = try fracAdd(alloc, check, &cres);
        fracFree(alloc, check);
        check.* = ncheck;
        try text.appendSlice(alloc, "+((");
        try text.appendSlice(alloc, rho_t);
        try text.appendSlice(alloc, ")+\xE2\x88\x9A(");
        try text.appendSlice(alloc, w2_t);
        try text.appendSlice(alloc, "))*log(");
        try text.appendSlice(alloc, At);
        try text.appendSlice(alloc, "+\xE2\x88\x9A(");
        try text.appendSlice(alloc, w2_t);
        try text.appendSlice(alloc, ")*");
        try text.appendSlice(alloc, Bt);
        try text.appendSlice(alloc, ")");
        try text.appendSlice(alloc, "+((");
        try text.appendSlice(alloc, rho_t);
        try text.appendSlice(alloc, ")-\xE2\x88\x9A(");
        try text.appendSlice(alloc, w2_t);
        try text.appendSlice(alloc, "))*log(");
        try text.appendSlice(alloc, At);
        try text.appendSlice(alloc, "-\xE2\x88\x9A(");
        try text.appendSlice(alloc, w2_t);
        try text.appendSlice(alloc, ")*");
        try text.appendSlice(alloc, Bt);
        try text.appendSlice(alloc, ")");
    }
}

// Full log part for the squarefree remainder C/D. Emits sexpr fragments
// ("+(...)" each) into text and accumulates the exact derivative check
// into check. null on success, or a refusal note (allocated) otherwise.
fn logPartConstruct(alloc: std.mem.Allocator, C: []const Rat, D: []const Rat, text: *std.ArrayList(u8), check: *Frac) !?[]u8 {
    const dD = try polyDer(alloc, D);
    defer polyFree(alloc, dD);
    const R = try rtResultant(alloc, C, D);
    defer polyFree(alloc, R);
    if (polyIsZero(R)) @panic("std/sym: trager resultant identically zero");
    if (polyDegIdx(R) == 0) @panic("std/sym: trager resultant constant — inconsistent with nonzero squarefree integrand");
    const dR = try polyDer(alloc, R);
    defer polyFree(alloc, dR);
    const gR = try polyGcd(alloc, R, dR);
    defer polyFree(alloc, gR);
    const Rsf = if (polyDegIdx(gR) == 0) try polyClone(alloc, R) else blk: {
        const dm = try polyDivMod(alloc, R, gR);
        polyFree(alloc, dm.r);
        break :blk dm.q;
    };
    defer polyFree(alloc, Rsf);
    var roots = std.ArrayList(Rat){};
    defer {
        for (roots.items) |*r| ratDeinit(r);
        roots.deinit(alloc);
    }
    const rem = ratRootSplit(alloc, Rsf, &roots) catch |e| switch (e) {
        error.RootEnumWide => return try alloc.dupe(u8, "residue-root-enumeration-wide"),
        else => return e,
    };
    defer polyFree(alloc, rem);
    for (roots.items) |*c| {
        if (ratIsZero(c)) continue; // c*log(S) with c = 0 contributes nothing
        const sc = try polyScal(alloc, dD, c);
        defer polyFree(alloc, sc);
        const Cc = try polySub(alloc, C, sc);
        defer polyFree(alloc, Cc);
        const S = try polyGcd(alloc, Cc, D);
        defer polyFree(alloc, S);
        if (polyDegIdx(S) == 0) continue; // extraneous root: log(1) = 0
        var cres = try ratLogDeriv(alloc, c, S);
        defer fracFree(alloc, &cres);
        const ncheck = try fracAdd(alloc, check, &cres);
        fracFree(alloc, check);
        check.* = ncheck;
        const ct = try ratToString(alloc, c);
        defer alloc.free(ct);
        const St = try polyTextOf(alloc, S);
        defer alloc.free(St);
        try text.appendSlice(alloc, "+(");
        try text.appendSlice(alloc, ct);
        try text.appendSlice(alloc, "*log");
        try text.appendSlice(alloc, St);
        try text.appendSlice(alloc, ")");
    }
    const rd = polyDegIdx(rem);
    if (rd == 0) return null;
    if (rd == 1) @panic("std/sym: degree-1 residue cofactor missed by rational enumeration");
    if (rd > 2) {
        return try std.fmt.allocPrint(alloc, "residue-factor-deg{d}-needs-algebraic-coeffs(not-constructed)", .{rd});
    }
    var lc = try ratClone(&rem[2]);
    defer ratDeinit(&lc);
    var v = try ratDiv(alloc, &rem[0], &lc);
    defer ratDeinit(&v);
    var u = try ratDiv(alloc, &rem[1], &lc);
    defer ratDeinit(&u);
    try quadLane(alloc, &u, &v, C, D, dD, text, check);
    return null;
}

// ============ Risch exp-monomial: F*exp(G) -> R*exp(G) ============
// The ansatz integral = R*exp(G) yields the adjoint equation R' + G'R = F.
// For polynomial F, G with G' != 0 a rational R is forced polynomial: a
// pole of order m in R appears at order m+1 in R' and cannot cancel
// against G'R's order m.  Degree then forces deg R = deg F - deg G',
// coefficients solve top-down from the equation at degree k + deg G',
// and the equations at degrees < deg G' are residual consistency checks:
// a failure proves no R exists, hence a non-elementary integrand.

// True iff the subtree carries the integration variable (atom 3) or a
// named generator (atom >= 5); anything else is a constant factor for
// the integration lanes.
fn nodeHasVar(n: *const SNode) bool {
    switch (n.kind) {
        .atom => return n.atom == 3 or n.atom >= 5,
        .dec => return false,
        .add, .mul => {
            for (n.kids) |k| if (nodeHasVar(k)) return true;
            return false;
        },
        .sq, .inv, .log, .atan, .exp => return nodeHasVar(n.kid),
    }
}

// Multiply an emitted antiderivative text by the stripped constant
// factors (canon "(anti*consts)"); consumes `anti` either way.
fn antiWithConst(alloc: std.mem.Allocator, anti: []u8, ct: ?[]const u8) ![]u8 {
    const c = ct orelse return anti;
    defer alloc.free(anti);
    var buf = std.ArrayList(u8){};
    defer buf.deinit(alloc);
    try buf.append(alloc, '(');
    try buf.appendSlice(alloc, anti);
    try buf.append(alloc, '*');
    try buf.appendSlice(alloc, c);
    try buf.append(alloc, ')');
    return normCanon(alloc, buf.items);
}

// Exact triangular solve of R' + G'R = F for polynomial R.  Returns
// null when the degree bound or a residual equation fails — a proof
// that no rational R exists.  G' == 0 degenerates to R' = F.
fn rischDESolve(alloc: std.mem.Allocator, F: []const Rat, dG: []const Rat) !?[]Rat {
    if (polyIsZero(dG)) return try polyIntegral(alloc, F);
    const dd = polyDegIdx(dG);
    const df = polyDegIdx(F);
    if (df < dd) return null;
    const dr = df - dd;
    const R = try alloc.alloc(Rat, dr + 1);
    var lo: usize = dr + 1; // R[lo..dr+1] is the filled region (descending fill)
    errdefer {
        for (R[lo .. dr + 1]) |*r| ratDeinit(r);
        alloc.free(R);
    }
    const lead = &dG[dd];
    var k: usize = dr + 1;
    while (k > 0) {
        k -= 1;
        const m = k + dd;
        var acc = try ratClone(&F[m]);
        errdefer ratDeinit(&acc);
        if (m + 1 <= dr) {
            var t = try ratMulInt(alloc, &R[m + 1], @intCast(m + 1));
            defer ratDeinit(&t);
            const acc2 = try ratSub(alloc, &acc, &t);
            ratDeinit(&acc);
            acc = acc2;
        }
        var j = k + 1;
        const jhi = @min(dr, m);
        while (j <= jhi) : (j += 1) {
            var t1 = try ratMul(alloc, &dG[m - j], &R[j]);
            defer ratDeinit(&t1);
            const acc2 = try ratSub(alloc, &acc, &t1);
            ratDeinit(&acc);
            acc = acc2;
        }
        R[k] = try ratDiv(alloc, &acc, lead);
        ratDeinit(&acc);
        lo = k;
    }
    // residual equations at degrees m < dd: all r are already determined,
    // so these must hold as identities or there is no solution at all.
    var m: usize = 0;
    while (m < dd) : (m += 1) {
        var acc = try ratFromInt(alloc, 0);
        defer ratDeinit(&acc);
        if (m + 1 <= dr) {
            var t = try ratMulInt(alloc, &R[m + 1], @intCast(m + 1));
            defer ratDeinit(&t);
            const acc2 = try ratAdd(alloc, &acc, &t);
            ratDeinit(&acc);
            acc = acc2;
        }
        var j: usize = 0;
        const jhi = @min(dr, m);
        while (j <= jhi) : (j += 1) {
            var t1 = try ratMul(alloc, &dG[m - j], &R[j]);
            defer ratDeinit(&t1);
            const acc2 = try ratAdd(alloc, &acc, &t1);
            ratDeinit(&acc);
            acc = acc2;
        }
        var diff = try ratSub(alloc, &acc, &F[m]);
        defer ratDeinit(&diff);
        if (!ratIsZero(&diff)) {
            for (R[lo .. dr + 1]) |*r| ratDeinit(r);
            alloc.free(R);
            return null;
        }
    }
    return R;
}

// decide(layer=L)|field=value|field=value — fixed set of decision-level
// segment names; decide-field extracts one by name.
const DECIDE_FIELDS = [_][]const u8{ "integral", "integrand", "antiderivative", "rational-part", "log-integrand", "seed", "note", "r", "form" };

fn decideFieldBounds(blob: []const u8, name: []const u8) ?struct { s: usize, e: usize } {
    var i: usize = 0;
    while (i + name.len + 2 <= blob.len) : (i += 1) {
        if (blob[i] == '|' and std.mem.startsWith(u8, blob[i + 1 ..], name) and blob[i + 1 + name.len] == '=') {
            const s = i + 2 + name.len;
            var e = blob.len;
            var j = s;
            while (j < blob.len) : (j += 1) {
                if (blob[j] != '|') continue;
                for (DECIDE_FIELDS) |f| {
                    if (std.mem.startsWith(u8, blob[j + 1 ..], f) and j + 1 + f.len < blob.len and blob[j + 1 + f.len] == '=') {
                        e = j;
                        break;
                    }
                }
                if (e == j) break;
            }
            return .{ .s = s, .e = e };
        }
    }
    return null;
}

fn decideIntegNote(layer: []const u8, note: []const u8, integrand: ?[]const u8, antiderivative: ?[]const u8) ![]u8 {
    const alloc = koru_allocator();
    var out = std.ArrayList(u8){};
    errdefer out.deinit(alloc);
    const hdr = std.fmt.allocPrint(alloc, "decide(layer={s})|note={s}", .{ layer, note }) catch return error.OutOfMemory;
    defer alloc.free(hdr);
    try out.appendSlice(alloc, hdr);
    if (integrand) |v| {
        try out.appendSlice(alloc, "|integrand=");
        try out.appendSlice(alloc, v);
    }
    if (antiderivative) |v| {
        try out.appendSlice(alloc, "|antiderivative=");
        try out.appendSlice(alloc, v);
    }
    return out.toOwnedSlice(alloc);
}

// decide-integral: elementary construction for polynomial integrands;
// otherwise the holonomic-special lane — structural cert-of preferred
// (theorem-grade), bounded derive-ode as the discovery fallback
// (witness-grade seed, flagged). Matches the artifact's layer order:
// elementary-construct first, certified antiderivative via
// integral-shift second, unresolved with named evidence last.
~pub tor decide-integral { a: string<!sexpr>, max-order: i64, max-deg: i64 }
| elementary string<std/io:allocated!>
| holonomic-special string<std/io:allocated!>
| unresolved string<std/io:allocated!>
| not-holonomic string<std/io:allocated!>
| non-rational
| non-analytic
| bad

~proc decide-integral|zig {
    defer symFree(a);
    const alloc = koru_allocator();
    if (max_order < 0 or max_order > 8 or max_deg < 0 or max_deg > 12) return .{ .bad = .{} };
    const t = parseTree(alloc, a) catch return .{ .bad = .{} };
    defer nodeFree(alloc, t);
    const nt = norm(alloc, t) catch return .{ .bad = .{} };
    defer nodeFree(alloc, nt);
    // Constant-factor split: factors that do not carry the integration
    // variable (i, exp(2), pi, sqrt(2), Q(i) sums, ...) are pulled out and
    // multiplied back onto the emitted antiderivative — i*(1/x) then
    // integrates as i*log(x) and exp(2)*x as exp(2)*x^2/2.
    var const_txt: ?[]u8 = null;
    defer if (const_txt) |ct| alloc.free(ct);
    var nt_var: *SNode = nt;
    var nt_var_owned: ?*SNode = null;
    defer if (nt_var_owned) |v| nodeFree(alloc, v);
    if (!nodeHasVar(nt)) {
        const xn = nodeAtom(alloc, 3) catch @panic("std/sym:decide-integral");
        const prod = nodePair(alloc, .mul, nodeClone(alloc, nt) catch @panic("std/sym:decide-integral"), xn) catch @panic("std/sym:decide-integral");
        defer nodeFree(alloc, prod);
        const anti = canonOf(alloc, prod) catch @panic("std/sym:decide-integral");
        defer alloc.free(anti);
        const blob = std.fmt.allocPrint(alloc, "decide(layer=elementary)|antiderivative={s}|note=constant-integrand", .{anti}) catch @panic("std/sym:decide-integral");
        return .{ .elementary = blob };
    }
    if (nt.kind == .mul) {
        var const_kids = std.ArrayList(*SNode){};
        defer const_kids.deinit(alloc);
        var var_kids = std.ArrayList(*SNode){};
        defer var_kids.deinit(alloc);
        for (nt.kids) |k| {
            if (nodeHasVar(k)) {
                var_kids.append(alloc, k) catch @panic("std/sym:decide-integral");
            } else {
                const_kids.append(alloc, k) catch @panic("std/sym:decide-integral");
            }
        }
        if (const_kids.items.len > 0 and var_kids.items.len > 0) {
            var ck_owned: ?*SNode = null;
            defer if (ck_owned) |v| nodeFree(alloc, v);
            const ck: *SNode = if (const_kids.items.len == 1) const_kids.items[0] else blk: {
                var cl = std.ArrayList(*SNode){};
                defer cl.deinit(alloc);
                for (const_kids.items) |k| cl.append(alloc, nodeClone(alloc, k) catch @panic("std/sym:decide-integral")) catch @panic("std/sym:decide-integral");
                ck_owned = nodeList(alloc, .mul, cl.items) catch @panic("std/sym:decide-integral");
                break :blk ck_owned.?;
            };
            const_txt = canonOf(alloc, ck) catch @panic("std/sym:decide-integral");
            if (var_kids.items.len == 1) {
                nt_var = var_kids.items[0];
            } else {
                var cl = std.ArrayList(*SNode){};
                defer cl.deinit(alloc);
                for (var_kids.items) |k| cl.append(alloc, nodeClone(alloc, k) catch @panic("std/sym:decide-integral")) catch @panic("std/sym:decide-integral");
                nt_var_owned = nodeList(alloc, .mul, cl.items) catch @panic("std/sym:decide-integral");
                nt_var = nt_var_owned.?;
            }
        }
    }
    const maybe_poly = polyOfNode(alloc, nt_var) catch @panic("std/sym:decide-integral poly");
    if (maybe_poly) |p| {
        defer polyFree(alloc, p);
        const integ = polyIntegral(alloc, p) catch @panic("std/sym:decide-integral");
        defer {
            for (integ) |*r| ratDeinit(r);
            alloc.free(integ);
        }
        const csv = ratJoinCsv(alloc, integ) catch @panic("std/sym:decide-integral");
        defer alloc.free(csv);
        if (const_txt != null) {
            const ptxt = polyTextOf(alloc, integ) catch @panic("std/sym:decide-integral");
            const anti = antiWithConst(alloc, ptxt, const_txt) catch @panic("std/sym:decide-integral");
            defer alloc.free(anti);
            const blob = std.fmt.allocPrint(alloc, "decide(layer=elementary)|antiderivative={s}|note=polynomial-termwise-constructed;const-factored", .{anti}) catch @panic("std/sym:decide-integral");
            return .{ .elementary = blob };
        }
        const colon = std.mem.indexOfScalar(u8, csv, ':') orelse csv.len;
        const blob = std.fmt.allocPrint(alloc, "decide(layer=elementary)|integral=[{s}]|note=polynomial-termwise-constructed", .{csv[colon + 1 ..]}) catch @panic("std/sym:decide-integral");
        return .{ .elementary = blob };
    }
    // Rational integrand: always elementary (Liouville). Hermite builds the
    // full rational part; a nonzero squarefree remainder is the log part.
    if (ratFuncOfNode(alloc, nt_var) catch @panic("std/sym:decide-integral rf")) |rf_in| {
        var rf = rf_in;
        defer fracFree(alloc, &rf);
        var hr = hermiteReduce(alloc, &rf) catch @panic("std/sym:decide-integral hermite");
        defer {
            polyFree(alloc, hr.poly);
            fracFree(alloc, &hr.rat);
            fracFree(alloc, &hr.log);
        }
        if (!(hermiteCheck(alloc, &rf, &hr) catch @panic("std/sym:decide-integral check")))
            @panic("std/sym:decide-integral: hermite reduction failed its exact check");
        var txt = std.ArrayList(u8){};
        defer txt.deinit(alloc);
        const pint = polyIntegral(alloc, hr.poly) catch @panic("std/sym:decide-integral");
        defer polyFree(alloc, pint);
        polyText(alloc, &txt, pint) catch @panic("std/sym:decide-integral");
        txt.append(alloc, '+') catch @panic("std/sym:decide-integral");
        fracText(alloc, &txt, &hr.rat) catch @panic("std/sym:decide-integral");
        const anti0 = normCanon(alloc, txt.items) catch @panic("std/sym:decide-integral canon");
        const anti = antiWithConst(alloc, anti0, const_txt) catch @panic("std/sym:decide-integral canon");
        defer alloc.free(anti);
        if (fracIsZero(&hr.log)) {
            const blob = std.fmt.allocPrint(alloc, "decide(layer=elementary)|antiderivative={s}|note=hermite-constructed;checked-exact", .{anti}) catch @panic("std/sym:decide-integral");
            return .{ .elementary = blob };
        }
        // log part: Trager construction over the real lane, verified by
        // summing each emitted term's exact derivative-Frac against C/D.
        var ltxt = std.ArrayList(u8){};
        defer ltxt.deinit(alloc);
        var check = Frac{ .n = polyEmpty(alloc) catch @panic("std/sym:decide-integral"), .d = polyOne(alloc) catch @panic("std/sym:decide-integral") };
        defer fracFree(alloc, &check);
        const refuse = logPartConstruct(alloc, hr.log.n, hr.log.d, &ltxt, &check) catch |e| switch (e) {
            else => @panic("std/sym:decide-integral logpart"),
        };
        if (refuse) |reason| {
            defer alloc.free(reason);
            var l2txt = std.ArrayList(u8){};
            defer l2txt.deinit(alloc);
            fracText(alloc, &l2txt, &hr.log) catch @panic("std/sym:decide-integral");
            const logc0 = normCanon(alloc, l2txt.items) catch @panic("std/sym:decide-integral canon");
            const logc = antiWithConst(alloc, logc0, const_txt) catch @panic("std/sym:decide-integral canon");
            defer alloc.free(logc);
            const blob = std.fmt.allocPrint(alloc, "decide(layer=elementary)|rational-part={s}|log-integrand={s}|note=hermite-reduced;checked-exact;log-part-{s}", .{ anti, logc, reason }) catch @panic("std/sym:decide-integral");
            return .{ .elementary = blob };
        }
        if (!(fracEql(alloc, &check, &hr.log) catch @panic("std/sym:decide-integral eql")))
            @panic("std/sym:decide-integral: trager construction failed its exact check");
        var ftxt = std.ArrayList(u8){};
        defer ftxt.deinit(alloc);
        ftxt.append(alloc, '(') catch @panic("std/sym:decide-integral");
        ftxt.appendSlice(alloc, anti) catch @panic("std/sym:decide-integral");
        ftxt.appendSlice(alloc, ltxt.items) catch @panic("std/sym:decide-integral");
        ftxt.append(alloc, ')') catch @panic("std/sym:decide-integral");
        const full0 = normCanon(alloc, ftxt.items) catch @panic("std/sym:decide-integral canon");
        const full = antiWithConst(alloc, full0, const_txt) catch @panic("std/sym:decide-integral canon");
        defer alloc.free(full);
        const blob = std.fmt.allocPrint(alloc, "decide(layer=elementary)|antiderivative={s}|note=hermite+trager-constructed;checked-exact", .{full}) catch @panic("std/sym:decide-integral");
        return .{ .elementary = blob };
    }
    // Risch exp-monomial lane: integrand F*exp(G) with F rational and G
    // polynomial integrates as R*exp(G) exactly when R' + G'R = F has a
    // solution — rischDESolve either constructs it or proves none exists.
    // Other exp shapes fall through to the certificate path with a named
    // lane tag rather than a wrong answer.
    var de_proven: ?[]const u8 = null;
    var lane_extra: ?[]const u8 = null;
    exp_lane: {
        var exk: ?*SNode = null;
        var fnode: ?*SNode = null;
        var fnode_owned: ?*SNode = null;
        defer if (fnode_owned) |v| nodeFree(alloc, v);
        if (nt_var.kind == .exp) {
            exk = nt_var;
        } else if (nt_var.kind == .mul) {
            var others = std.ArrayList(*SNode){};
            defer others.deinit(alloc);
            for (nt_var.kids) |k| {
                if (k.kind == .exp) {
                    exk = k;
                } else {
                    others.append(alloc, k) catch break :exp_lane;
                }
            }
            if (exk == null or others.items.len == 0) break :exp_lane;
            if (others.items.len == 1) {
                fnode = others.items[0];
            } else {
                var cl = std.ArrayList(*SNode){};
                defer cl.deinit(alloc);
                for (others.items) |k| cl.append(alloc, nodeClone(alloc, k) catch @panic("std/sym:decide-integral")) catch break :exp_lane;
                fnode_owned = nodeList(alloc, .mul, cl.toOwnedSlice(alloc) catch break :exp_lane) catch break :exp_lane;
                fnode = fnode_owned.?;
            }
        } else break :exp_lane;
        const ex = exk.?;
        var rf = if (fnode) |f| (ratFuncOfNode(alloc, f) catch @panic("std/sym:decide-integral")) orelse break :exp_lane else fracOne(alloc) catch @panic("std/sym:decide-integral");
        defer fracFree(alloc, &rf);
        const Gp = polyOfNode(alloc, ex.kid) catch @panic("std/sym:decide-integral") orelse {
            lane_extra = "risch-exp-inner-nonpoly";
            break :exp_lane;
        };
        defer polyFree(alloc, Gp);
        if (polyDegIdx(rf.d) != 0) {
            lane_extra = "risch-de-rational-denominator";
            break :exp_lane;
        }
        var d0inv = ratInv(alloc, &rf.d[0]) catch @panic("std/sym:decide-integral");
        defer ratDeinit(&d0inv);
        const Fp = polyScal(alloc, rf.n, &d0inv) catch @panic("std/sym:decide-integral");
        defer polyFree(alloc, Fp);
        const dG = polyDer(alloc, Gp) catch @panic("std/sym:decide-integral");
        defer polyFree(alloc, dG);
        const R = (rischDESolve(alloc, Fp, dG) catch @panic("std/sym:decide-integral")) orelse {
            de_proven = "no-rational-R:degree-argument";
            break :exp_lane;
        };
        defer polyFree(alloc, R);
        // exact check: R' + G'R == F as polynomials — internal-impossible
        // class (panic, not a named refusal) if the solver lied.
        const dR = polyDer(alloc, R) catch @panic("std/sym:decide-integral");
        defer polyFree(alloc, dR);
        const gR = polyMul(alloc, dG, R) catch @panic("std/sym:decide-integral");
        defer polyFree(alloc, gR);
        const lhs = polyAdd(alloc, dR, gR) catch @panic("std/sym:decide-integral");
        defer polyFree(alloc, lhs);
        const res = polySub(alloc, lhs, Fp) catch @panic("std/sym:decide-integral");
        defer polyFree(alloc, res);
        if (!polyIsZero(res)) @panic("std/sym:decide-integral: risch DE failed its exact check");
        const rtxt = polyTextOf(alloc, R) catch @panic("std/sym:decide-integral");
        defer alloc.free(rtxt);
        const etxt = canonOf(alloc, ex) catch @panic("std/sym:decide-integral");
        defer alloc.free(etxt);
        var buf = std.ArrayList(u8){};
        defer buf.deinit(alloc);
        buf.append(alloc, '(') catch @panic("std/sym:decide-integral");
        buf.appendSlice(alloc, rtxt) catch @panic("std/sym:decide-integral");
        buf.append(alloc, '*') catch @panic("std/sym:decide-integral");
        buf.appendSlice(alloc, etxt) catch @panic("std/sym:decide-integral");
        buf.append(alloc, ')') catch @panic("std/sym:decide-integral");
        const anti0 = normCanon(alloc, buf.items) catch @panic("std/sym:decide-integral canon");
        const anti = antiWithConst(alloc, anti0, const_txt) catch @panic("std/sym:decide-integral canon");
        defer alloc.free(anti);
        const blob = std.fmt.allocPrint(alloc, "decide(layer=elementary)|antiderivative={s}|note=risch-exp-monomial-constructed;checked-exact", .{anti}) catch @panic("std/sym:decide-integral");
        return .{ .elementary = blob };
    }
    var structural_refusal: ?[]const u8 = null;
    var cert = certOfNode(alloc, nt) catch |e| blk: {
        switch (e) {
            CertgenErr.InvHighOrder => structural_refusal = "inv-order>1",
            CertgenErr.SqrtNonPoly => structural_refusal = "sqrt-nonpoly",
            CertgenErr.LogNonPoly => structural_refusal = "log-nonpoly",
            CertgenErr.AtanNonPoly => structural_refusal = "atan-nonpoly",
            CertgenErr.ExpNonPoly => structural_refusal = "exp-nonpoly",
            else => @panic("std/sym:decide-integral"),
        }
        // discovery fallback within declared bounds (witness-grade seed)
        const found = symDeriveOde(alloc, a, max_order, max_deg) catch |err| switch (err) {
            error.NonAnalytic => return .{ .non_analytic = .{} },
            error.NonRational => return .{ .non_rational = .{} },
            else => @panic("std/sym:decide-integral derive"),
        } orelse {
            const lane_suffix = if (lane_extra) |x| (std.fmt.allocPrint(alloc, ";lane={s}", .{x}) catch @panic("std/sym:decide-integral")) else ownedCopy("");
            defer alloc.free(lane_suffix);
            const msg = std.fmt.allocPrint(alloc, "decide(layer=unresolved)|note=no-holonomic-certificate-within-bounds(order<={d},deg<={d});structural={s}{s}", .{ max_order, max_deg, structural_refusal.?, lane_suffix }) catch @panic("std/sym:decide-integral");
            return .{ .unresolved = msg };
        };
        defer alloc.free(found);
        const parsed = certParse(alloc, found) catch @panic("std/sym:decide-integral parse");
        break :blk parsed;
    };
    defer certFree(alloc, &cert);
    if (certPolyZero(cert.polys[cert.order])) return .{ .not_holonomic = ownedCopy("degenerate-leading") };
    var shifted = certShifted(alloc, &cert) catch @panic("std/sym:decide-integral shift");
    defer certFree(alloc, &shifted);
    const via_seed = if (structural_refusal == null) "of" else "verified";
    const odet = certWrite(alloc, cert.order, cert.deg, via_seed, cert.polys) catch @panic("std/sym:decide-integral");
    defer alloc.free(odet);
    const st = certWrite(alloc, shifted.order, shifted.deg, "shift", shifted.polys) catch @panic("std/sym:decide-integral");
    defer alloc.free(st);
    var note_buf: ?[]u8 = null;
    defer if (note_buf) |b| alloc.free(b);
    const note: []const u8 = if (de_proven) |p| blk: {
        note_buf = std.fmt.allocPrint(alloc, "risch-de-proven-non-elementary:{s};integrand-cert-theorem-grade", .{p}) catch @panic("std/sym:decide-integral");
        break :blk note_buf.?;
    } else if (lane_extra) |x| blk: {
        const base = if (structural_refusal == null)
            "no-risch-elementary-form-not-constructed;integrand-cert-theorem-grade"
        else
            "no-risch-elementary-form-not-constructed;seed-finite-witness";
        note_buf = std.fmt.allocPrint(alloc, "{s};lane={s}", .{ base, x }) catch @panic("std/sym:decide-integral");
        break :blk note_buf.?;
    } else if (structural_refusal == null)
        "no-risch-elementary-form-not-constructed;integrand-cert-theorem-grade"
    else
        "no-risch-elementary-form-not-constructed;seed-finite-witness";
    const blob = decideIntegNote("holonomic-special", note, odet, st) catch @panic("std/sym:decide-integral");
    return .{ .holonomic_special = blob };
}

// Pole multiplicities of a reduced r = n/d are the root multiplicities of
// d, read exactly over Q by the gcd tower c_k = gcd(c_{k-1}, c_{k-1}'):
// deg c_{k-1} - deg c_k counts the distinct roots of multiplicity >= k.
// Bit m of the result is set iff some pole has order exactly m.
fn poleOrderMask(alloc: std.mem.Allocator, d: []const Rat) !u64 {
    var mask: u64 = 0;
    var c = try polyClone(alloc, d);
    defer polyFree(alloc, c);
    var prev_ge: usize = 0;
    var k: usize = 1;
    while (!polyIsZero(c) and polyDegIdx(c) > 0) : (k += 1) {
        const dc = try polyDer(alloc, c);
        defer polyFree(alloc, dc);
        const g = try polyGcd(alloc, c, dc);
        const ge = polyDegIdx(c) - (if (polyIsZero(g)) 0 else polyDegIdx(g));
        if (k > 1 and prev_ge > ge and k - 1 < 64) mask |= @as(u64, 1) << @intCast(k - 1);
        prev_ge = ge;
        polyFree(alloc, c);
        c = g;
    }
    if (prev_ge > 0 and k - 1 < 64) mask |= @as(u64, 1) << @intCast(k - 1);
    return mask;
}

// decide-ode: Kovacic (J. Symbolic Computation 1986) for y'' = r(x) y.
// Constant r is solved outright (constant-coefficient form). Otherwise the
// three cases' NECESSARY conditions are checked on pole orders and the
// order at infinity o = deg d - deg n:
//   case 1: every pole of order 1 or even; o even or o > 2
//   case 2: some pole of order 2 or of odd order > 2
//   case 3: every pole of order <= 2; o >= 2
// All three failing is a proof of no Liouvillian solution. Any surviving
// case is NOT a proof either way — the case algorithms themselves (which
// need the poles' algebraic roots) are not run, so the arm is
// `unclassifiable` naming the open cases rather than a guess.
~pub tor decide-ode { r: string<!sexpr> }
| liouvillian string<std/io:allocated!>
| holonomic-special string<std/io:allocated!>
| unclassifiable string<std/io:allocated!>
| bad string<std/io:allocated!>

~proc decide-ode|zig {
    defer symFree(r);
    const alloc = koru_allocator();
    const t = parseTree(alloc, r) catch return .{ .bad = ownedCopy("malformed-expr") };
    defer nodeFree(alloc, t);
    const nt = norm(alloc, t) catch return .{ .bad = ownedCopy("malformed-expr") };
    defer nodeFree(alloc, nt);
    var f = (ratFuncOfNode(alloc, nt) catch @panic("std/sym:decide-ode")) orelse
        return .{ .unclassifiable = ownedCopy("r-not-rational-function") };
    defer fracFree(alloc, &f);
    const den_const = !polyIsZero(f.d) and (polyIsZero(f.d) or polyDegIdx(f.d) == 0);
    const num_deg: i64 = if (polyIsZero(f.n)) 0 else @intCast(polyDegIdx(f.n));
    const den_deg: i64 = if (polyIsZero(f.d)) 0 else @intCast(polyDegIdx(f.d));
    const bounded = den_const and num_deg <= den_deg;
    if (!bounded) {
        const mask = poleOrderMask(alloc, f.d) catch @panic("std/sym:decide-ode poles");
        const o_inf = den_deg - num_deg;
        const ODD_GT2: u64 = 0xAAAAAAAAAAAAAAA8; // bits 3,5,7,...
        const EVEN_OR_1: u64 = 0x5555555555555556; // bits 1,2,4,6,...
        const case1 = (mask & ~EVEN_OR_1) == 0 and (@mod(o_inf, 2) == 0 or o_inf > 2);
        const case2 = (mask & ((@as(u64, 1) << 2) | ODD_GT2)) != 0;
        const case3 = (mask >> 3) == 0 and o_inf >= 2;
        if (!case1 and !case2 and !case3) {
            const blob = decideIntegNote("holonomic-special", "kovacic-necessary-conditions-fail-all-cases:proven-no-liouvillian-solution", null, null) catch @panic("std/sym:decide-ode");
            return .{ .holonomic_special = blob };
        }
        const open = std.fmt.allocPrint(alloc, "kovacic-necessary-conditions-met:open-cases={s}{s}{s}:case-algorithms-not-run", .{
            if (case1) "1" else "",
            if (case2) (if (case1) ",2" else "2") else "",
            if (case3) (if (case1 or case2) ",3" else "3") else "",
        }) catch @panic("std/sym:decide-ode");
        return .{ .unclassifiable = open };
    }
    // bounded => r constant; emit the constant-coefficient solution form
    const c = if (f.n.len > 0) f.n[0] else ratFromInt(alloc, 0) catch @panic("std/sym:decide-ode");
    const cs = ratToString(alloc, &c) catch @panic("std/sym:decide-ode");
    defer alloc.free(cs);
    const form = if (ratIsZero(&c))
        "y=C1+C2*x"
    else if (c.n.toConst().orderAgainstScalar(@as(i64, 0)) == .lt)
        "y=C1*cos(sqrt(|r|)*x)+C2*sin(sqrt(|r|)*x)"
    else
        "y=C1*exp(sqrt(r)*x)+C2*exp(-sqrt(r)*x)";
    const blob = std.fmt.allocPrint(alloc, "decide(layer=liouvillian)|r={s}|form={s}|note=kovacic-check-bounded", .{ cs, form }) catch @panic("std/sym:decide-ode");
    return .{ .liouvillian = blob };
}

// Generic `|name=` segment extractor over decision/cert blobs — the
// composition seam that lets decide-* outputs feed cert-reg-put without
// record-payload arms.
~pub tor decide-field { blob: string<*>, name: string }
| exact string<std/io:allocated!>
| not-found

~proc decide-field|zig {
    const alloc = koru_allocator();
    const bounds = decideFieldBounds(blob, name) orelse return .{ .not_found = .{} };
    const out = alloc.dupe(u8, blob[bounds.s..bounds.e]) catch @panic("std/sym:decide-field");
    return .{ .exact = out };
}
