// Test: `std/node:spawn(f, id:, cell: nosuch)` — the shape name must resolve
// to a declared std/proto at comptime. An unknown shape is a refusal, not a
// runtime miss — same contract as `std/cell:open`.

~import std/io
~import std/node
~import std/proto
~import std/runtime

~std/proto(room_state) {
    visits: u32
}

~std/runtime:register(scope: "cell") {
}

~std/node:new(node, scope: "cell", world: "", capacity: 8)

~std/node(node)
| node f |> std/node:spawn(f, id: "room-9", cell: nosuch)
  | spawned b |> std/io:print.ln("spawned")
  | resident |> std/io:print.ln("resident")
  | refused |> std/io:print.ln("refused")
