// std/env - Environment variable access
//
// Simple, safe access to environment variables.

const std = @import("std");

// Windows-host: std.posix.getenv is a compileError on Windows (WTF-16 env).
// page_allocator getEnvVarOwned is the cross-platform read — bounded leak
// per call, deliberately outside koru_allocator's exit meter (a METER, not
// a mop: env values are program-lifetime, tracking them would fail every
// leak check for memory nobody could discharge).
fn __koruEnvGet(name: []const u8) ?[]const u8 {
    if (comptime @import("builtin").os.tag == .windows) {
        return std.process.getEnvVarOwned(std.heap.page_allocator, name) catch return null;
    }
    return std.posix.getenv(name);
}

// ============================================================================
// Get environment variable
// ============================================================================

~pub tor get { name: string }
| ok string
| not-set

~proc get|zig {
    const value = __koruEnvGet(name) orelse {
        return .{ .not_set = .{} };
    };
    return .{ .ok = value };
}

// Get with default value
~pub tor get.or { name: string, default: string } -> string

~proc get.or|zig {
    const value = __koruEnvGet(name) orelse default;
    return value;
}

// Check if variable is set
~pub tor is-set { name: string }
| yes
| no

~proc is-set|zig {
    if (__koruEnvGet(name)) |_| {
        return .{ .yes = .{} };
    }
    return .{ .no = .{} };
}

// Require - fail loudly if not set (for critical config)
~pub tor require { name: string }
| ok string
| missing string

~proc require|zig {
    const value = __koruEnvGet(name) orelse {
        return .{ .missing = name };
    };
    return .{ .ok = value };
}
