// Koru Standard Library: the `walk` part of grid.kz.
// Joined via `~part walk` in grid.kz; merged into the grid module at load.
//
//   std/grid:walk { s: inp.b, 2, d: enc.c, 3 }
//   ! each |> ... s[k] ... stored { d[k]: v } ...
//   | tail |> ... leftover window ...
//   | done |> ...
//
// A RESLICING window walk: each labeled arg names a cursor (borrowed off
// `grid.field` like a `slice` decl) and the positional after it is its
// stride. The driver emits moving-base cursors and ONE guard at the loop
// head — `while (s.len >= 2 and d.len >= 3)` — so every `s[k]`/`d[k]` in
// the body is a raw slice access whose bound was already proven. This is
// the shape LLVM auto-vectorizes (fixed-offset reads/writes on advancing
// bases) — the same shape Goose's `s = s[3..]` loops emit — where an
// indexed `for (0..n) |q| g[4*q]` keeps per-element structure the
// vectorizer cannot see through.
//
// The borrow contract carries over from `std/grid:slice`: the program
// asked for the raw view, so the per-access __koru_at floor is declined
// and Zig's own slice checks still run in Debug. `| tail` fires once with
// whatever remains (`s.len < stride`); the remainder is the program's to
// write — a codec's partial group lives there, never silently dropped.
// `| done` chains after the walk, unlowered.
//
// Zig only this rung: a JS reslice is `s.slice(n)` — a COPY — and writes
// through it never reach the grid, which is a silently-wrong lowering no
// honest surface may ship.

~[comptime|transform|claims_descendants]pub tor walk {
    source: Source,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc walk|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");

    if (item.* != .flow) @panic("grid:walk transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    if (std.mem.eql(u8, CompilerEnv.lang, "js")) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk is zig-only this rung: a JS reslice is `s.slice(n)` — a copy — and writes through it never reach the grid", .{}) };
    }

    // THE CURSOR LIST IS `{ label: grid.field, stride, label: grid.field,
    // stride, ... }` — a labeled item opens a cursor, the next positional is
    // its stride. Source arrives unbraced; the split is on TOP-LEVEL commas
    // (a `:` inside is the label's, a deeper comma belongs to the column or
    // stride text and is not ours).
    var src_text: ?[]const u8 = null;
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "source")) src_text = arg.value;
    }
    const stext = src_text orelse {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk requires a cursor block: walk {{ s: grid.field, stride, d: grid.field, stride }}", .{}) };
    };
    const Cursor = struct { name: []const u8, grid: []const u8, field: []const u8, stride: []const u8, ty: []const u8, ns: []const u8 };
    var cursors = std.ArrayList(Cursor).initCapacity(allocator, 4) catch unreachable;
    {
        var k: usize = 0;
        while (k <= stext.len) {
            var depth: usize = 0;
            var j = k;
            while (j < stext.len and !(stext[j] == ',' and depth == 0)) : (j += 1) {
                const c = stext[j];
                if (c == '(' or c == '[' or c == '{') depth += 1;
                if (c == ')' or c == ']' or c == '}') depth -= 1;
            }
            const piece = std.mem.trim(u8, stext[k..@min(j, stext.len)], " ");
            k = j + 1;
            if (piece.len == 0) continue;
            if (std.mem.indexOfScalar(u8, piece, ':')) |colon| {
                const nm = std.mem.trim(u8, piece[0..colon], " ");
                const col = std.mem.trim(u8, piece[colon + 1 ..], " ");
                const dot = std.mem.indexOfScalar(u8, col, '.') orelse {
                    return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk({s}): a cursor names a column — `{s}: <grid>.<field>`", .{ nm, nm }) };
                };
                cursors.append(allocator, Cursor{ .name = nm, .grid = std.mem.trim(u8, col[0..dot], " "), .field = std.mem.trim(u8, col[dot + 1 ..], " "), .stride = "", .ty = "", .ns = "" }) catch unreachable;
            } else {
                if (cursors.items.len == 0 or cursors.items[cursors.items.len - 1].stride.len != 0) {
                    return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk({s}): a stride belongs right after its cursor — `{s}: <grid>.<field>, <stride>`", .{ piece, piece }) };
                }
                cursors.items[cursors.items.len - 1].stride = piece;
            }
            if (k > stext.len) break;
        }
    }
    if (cursors.items.len == 0) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk needs at least one cursor pair: {{ s: grid.field, stride, ... }}", .{}) };
    }
    for (cursors.items) |c| {
        if (c.stride.len == 0) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk({s}): every cursor needs its stride — `{s}: <grid>.<field>, <stride>`", .{ c.name, c.name }) };
        }
    }

    var swept = std.ArrayList(grid_read.GridRef).initCapacity(allocator, 4) catch unreachable;
    grid_read.collect(allocator, program, &swept);
    for (cursors.items) |*c| {
        const ref = grid_read.find(swept.items, c.grid) orelse {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk({s}): no grid named '{s}' is declared in this program", .{ c.name, c.grid }) };
        };
        if (ref.pool) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk({s}): '{s}' is a pool — its column is a heap slice whose extent arrives at alloc, so the borrow contract's window cannot be proven at compile time", .{ c.name, c.grid }) };
        }
        c.ty = grid_read.columnType(allocator, program.items, c.grid, c.field) orelse {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk({s}): grid '{s}' has no field '{s}'", .{ c.name, c.grid, c.field }) };
        };
        c.ns = ref.ns;
        // The label IS a borrow: register it so `stored { s[k]: v }` in the
        // cloned body resolves through the slice-write path — the original
        // walk flow is replaced by the time those sites lower, so `collect`
        // cannot see it and the name must already be registered.
        grid_slice.register(c.name, c.ty);
    }

    // ARMS: `! each` carries the stepped body (bindingless — cursors are
    // named by their labels); `| tail` is the leftover window; `| done`
    // continues after the walk. Anything else is a refusal, not a guess.
    var each_arm: ?*const ast.Continuation = null;
    var tail_arm: ?*const ast.Continuation = null;
    var done_arm: ?*const ast.Continuation = null;
    for (flow.body.continuations) |*c| {
        const b = std.mem.trim(u8, @constCast(c).branch, " ");
        if (std.mem.eql(u8, b, "each")) {
            each_arm = c;
        } else if (std.mem.eql(u8, b, "tail")) {
            tail_arm = c;
        } else if (std.mem.eql(u8, b, "done")) {
            done_arm = c;
        } else {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk: unknown branch `! {s}` — the vocabulary is `! each`, `| tail`, `| done`", .{b}) };
        }
    }
    const arm = each_arm orelse {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk: the step body is spelled `! each |> ...` — cursors are named by their labels in the block, not bound here", .{}) };
    };
    if (arm.binding != null) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk: `! each` binds nothing — cursors are named by their labels in the `walk {{ ... }}` block", .{}) };
    }
    if (tail_arm) |t| {
        if (t.binding != null) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk: `| tail` binds nothing — it sees the same cursor names, holding the leftover", .{}) };
        }
    }

    if (ast.refuseUncrossable(allocator, reporter, "grid:walk", "walk", "each", arm, flow.module)) |r| return .{ .transformed = r };

    // Nested grid loops double-fire their generated units through the clone
    // — same hole `grid:for` names a runner limitation; refuse loudly.
    const N = struct {
        fn has(cont: *const ast.Continuation) bool {
            if (cont.node) |*n| {
                if (n.* == .invocation) {
                    const inv = n.invocation;
                    if (inv.path.module_qualifier) |mq| {
                        if (std.mem.eql(u8, mq, "std.grid") and inv.path.segments.len == 1 and
                            (std.mem.eql(u8, inv.path.segments[0], "for") or std.mem.eql(u8, inv.path.segments[0], "sweep") or std.mem.eql(u8, inv.path.segments[0], "walk")))
                            return true;
                    }
                }
            }
            for (cont.continuations) |*k| {
                if (has(@constCast(k))) return true;
            }
            return false;
        }
    };

    // Each arm becomes a generated event + proc pair; the cursors ride in as
    // `[]<ty>` input fields, the way every slice write threads its target.
    const line = flow.location.line;
    const home_ns = blk_home: {
        const Find = struct {
            fn in(its: []const ast.Item, want: []const u8, enclosing: ?[]const u8) ?[]const u8 {
                for (its) |pi| {
                    switch (pi) {
                        .flow => |f| {
                            if (std.mem.eql(u8, f.module, want)) return enclosing;
                        },
                        .module_decl => |m| {
                            if (in(m.items, want, m.logical_name)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        break :blk_home Find.in(program.items, flow.module, null) orelse flow.module;
    };
    const emit_ns = if (home_ns.len == 0 or std.mem.eql(u8, home_ns, program.main_module_name))
        "main_module."
    else
        std.fmt.allocPrint(allocator, "{s}.", .{codegen_utils_grid.buildKoruModulePath(allocator, home_ns) catch unreachable}) catch unreachable;

    const mk = struct {
        fn path(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    var appended = std.ArrayList(ast.Item).initCapacity(allocator, 6) catch unreachable;
    const retain_ann = blk_ret: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk_ret anns;
    };
    const bin = allocator.alloc(ast.Field, cursors.items.len) catch unreachable;
    for (cursors.items, 0..) |c, ci| {
        bin[ci] = ast.Field{ .name = allocator.dupe(u8, c.name) catch unreachable, .type = std.fmt.allocPrint(allocator, "[]{s}", .{c.ty}) catch unreachable };
    }
    var call_fields = std.ArrayList(u8).initCapacity(allocator, 96) catch unreachable;
    for (cursors.items) |c| {
        call_fields.appendSlice(allocator, std.fmt.allocPrint(allocator, ".{s} = {s}, ", .{ c.name, c.name }) catch unreachable) catch unreachable;
    }
    const call_input = std.mem.trimRight(u8, call_fields.items, " ,");

    for (0..2) |ai| {
        const src_arm = if (ai == 0) arm else (tail_arm orelse break);
        const cloned = ast_functional.cloneContinuation(allocator, src_arm) catch unreachable;
        if (N.has(&cloned)) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk: a nested grid loop in the body double-fires its generated units — hoist it into a tor and call it", .{}) };
        }
        const aname = std.fmt.allocPrint(allocator, "__grid_walk{s}_L{d}", .{ if (ai == 0) "body" else "tail", line }) catch unreachable;
        appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = mk.path(allocator, home_ns, aname),
            .input = ast.Shape{ .fields = bin },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        const bnode = cloned.node orelse {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk: the {s} arm needs a body (`|> ...`)", .{if (ai == 0) "each" else "tail"}) };
        };
        if (bnode != .invocation) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:walk: the {s} body must start with an invocation this rung", .{if (ai == 0) "each" else "tail"}) };
        }
        appended.append(allocator, ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(bnode.invocation, cloned.continuations, flow.location),
            .pre_label = null,
            .impl_of = mk.path(allocator, home_ns, aname),
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
    }

    // THE DRIVER: cursors reslice, the bound rides the loop head. `while
    // (s.len >= 2 and d.len >= 3)` is the one proof the whole body leans on.
    var drv = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;
    for (cursors.items) |c| {
        drv.appendSlice(allocator, std.fmt.allocPrint(allocator, "var {s}: []{s} = {s}__koru_grid_{s}.{s}[0..];\n", .{ c.name, c.ty, c.ns, c.grid, c.field }) catch unreachable) catch unreachable;
    }
    drv.appendSlice(allocator, "while (") catch unreachable;
    for (cursors.items, 0..) |c, ci| {
        if (ci > 0) drv.appendSlice(allocator, " and ") catch unreachable;
        drv.appendSlice(allocator, std.fmt.allocPrint(allocator, "{s}.len >= ({s})", .{ c.name, c.stride }) catch unreachable) catch unreachable;
    }
    drv.appendSlice(allocator, ") {\n    ") catch unreachable;
    drv.appendSlice(allocator, std.fmt.allocPrint(allocator, "{s}__grid_walkbody_L{d}_event.handler(.{{ {s} }});\n", .{ emit_ns, line, call_input }) catch unreachable) catch unreachable;
    for (cursors.items) |c| {
        drv.appendSlice(allocator, std.fmt.allocPrint(allocator, "    {s} = {s}[({s})..];\n", .{ c.name, c.name, c.stride }) catch unreachable) catch unreachable;
    }
    drv.appendSlice(allocator, "}\n") catch unreachable;
    if (tail_arm != null) {
        drv.appendSlice(allocator, std.fmt.allocPrint(allocator, "{s}__grid_walktail_L{d}_event.handler(.{{ {s} }});\n", .{ emit_ns, line, call_input }) catch unreachable) catch unreachable;
    }
    drv.appendSlice(allocator, "return;") catch unreachable;

    const driver_name = std.fmt.allocPrint(allocator, "__grid_walk_L{d}", .{line}) catch unreachable;
    appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = mk.path(allocator, home_ns, driver_name),
        .input = ast.Shape{ .fields = &[_]ast.Field{} },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;
    appended.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
        .path = mk.path(allocator, home_ns, driver_name),
        .body = ast.Source{ .text = drv.items, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
        .annotations = &[_][]const u8{},
        .target = allocator.dupe(u8, "zig") catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    var tail = std.ArrayList(ast.Continuation).initCapacity(allocator, 2) catch unreachable;
    if (done_arm) |d| {
        var dc = d.*;
        dc.branch = "";
        dc.binding = null;
        tail.append(allocator, dc) catch unreachable;
    }

    const call = ast.Invocation{ .path = mk.path(allocator, home_ns, driver_name), .args = &[_]ast.Arg{} };
    return .{ .transformed = .{
        .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(call, tail.toOwnedSlice(allocator) catch unreachable, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } },
        .appended = appended.toOwnedSlice(allocator) catch unreachable,
    } };
}
