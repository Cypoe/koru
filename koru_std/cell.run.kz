// Koru Standard Library: the `run` part of cell — turn dispatch and the
// two-tier error surface. Joined via `~part run` in cell.kz; merged into
// the cell module at load.

/// One arm for every failure class a turn can end in. `kind` names the
/// variant the fine-grained outcome list would have fired; the rest is the
/// lossless union of every variant's payload — zero/empty when the kind
/// doesn't carry it. `error-decode` routes `kind` back to the typed arms
/// when a caller distinguishes between failure classes.
pub const RunError = struct {
    kind: []const u8,
    message: []const u8,
    branch: []const u8,
    field: []const u8,
    event_name: []const u8,
    last_event: []const u8,
    trace: []const u8,
    used: u64,
    handles: u32,
    line: u32,
    column: u32,
};

fn mkErr(kind: []const u8, message: []const u8) RunError {
    return .{
        .kind = kind, .message = message, .branch = "", .field = "",
        .event_name = "", .last_event = "", .trace = "",
        .used = 0, .handles = 0, .line = 0, .column = 0,
    };
}

// ============================================================================
// RUN — dispatch a source turn into the cell's session over `std/bridge:run`,
// re-tiered to two required arms: `| result` when the turn completes, and a
// single `| error` carrying every failure class — the lossless union in
// RunError, `kind` naming the variant. The turn-completed findings
// (`defined`/`unhandled-branch`/`residue`/`partial`) stay armable as
// optionals; a caller who distinguishes failure classes sends `e` through
// `error-decode` instead of spelling nine arms at every call.
// ============================================================================

~pub tor run { c: *Cell<cell>, source: string<*> }
| result { value: @import("root").koru_std.koru_interpreter.Value, used: u64, handles: u32, bound: string, trace: string }
| error RunError
| ?defined string
| ?unhandled-branch { branch: string, payload: string, handles: string }
| ?residue { report: string, observer: bool, bound: string, text: string }
| ?partial { ran: u32, total: u32, used: u64, handles: u32, report: string, wire_failures: u32 }

~proc run|zig {
    const r = Br.run_event.handler(.{ .br = c.br, .source = source });
    // Same union shape, different nominal structs — copy field by field.
    return switch (r) {
        .result => |v| .{ .result = .{ .value = v.value, .used = v.used, .handles = v.handles, .bound = v.bound, .trace = v.trace } },
        .defined => |v| .{ .defined = v },
        .unhandled_branch => |v| .{ .unhandled_branch = .{ .branch = v.branch, .payload = v.payload, .handles = v.handles } },
        .residue => |v| .{ .residue = .{ .report = v.report, .observer = v.observer, .bound = v.bound, .text = v.text } },
        .partial => |v| .{ .partial = .{ .ran = v.ran, .total = v.total, .used = v.used, .handles = v.handles, .report = v.report, .wire_failures = v.wire_failures } },
        .exhausted => |v| blk: {
            var e = mkErr("exhausted", "the turn exhausted its cost budget");
            e.used = v.used; e.last_event = v.last_event; e.handles = v.handles;
            break :blk .{ .error = e };
        },
        .parse_error => |v| blk: {
            var e = mkErr("parse-error", v.message);
            e.line = v.line; e.column = v.column;
            break :blk .{ .error = e };
        },
        .validation_error => |v| .{ .error = mkErr("validation-error", v) },
        .shape_error => |v| blk: {
            var e = mkErr("shape-error", v.message);
            e.branch = v.branch; e.field = v.field orelse "";
            break :blk .{ .error = e };
        },
        .event_denied => |v| .{ .error = mkErr("event-denied", v) },
        .dispatch_error => |v| blk: {
            var e = mkErr("dispatch-error", v.message);
            e.event_name = v.event_name; e.trace = v.trace;
            break :blk .{ .error = e };
        },
        .scope_not_found => |v| .{ .error = mkErr("scope-not-found", v) },
    };
}

// ============================================================================
// ERROR-DECODE — the fine-grained arm set for callers that distinguish
// failure classes. `e` is the RunError a `run`'s `| error` arm bound; each
// optional arm fires for exactly one `kind`, carrying that variant's typed
// payload. A `kind` outside the known set routes to `unknown-error`; nothing
// here is required — the caller already answered the error once.
// ============================================================================

~pub tor error-decode { e: RunError }
| ?exhausted { used: u64, last_event: string, handles: u32 }
| ?parse-error { message: string, line: u32, column: u32 }
| ?validation-error string
| ?shape-error { branch: string, field: ?string, message: string }
| ?event-denied string
| ?dispatch-error { event_name: string, message: string, trace: string }
| ?scope-not-found string
| ?unknown-error { kind: string, message: string }

~proc error-decode|zig {
    if (std.mem.eql(u8, e.kind, "exhausted"))
        return .{ .exhausted = .{ .used = e.used, .last_event = e.last_event, .handles = e.handles } };
    if (std.mem.eql(u8, e.kind, "parse-error"))
        return .{ .parse_error = .{ .message = e.message, .line = e.line, .column = e.column } };
    if (std.mem.eql(u8, e.kind, "validation-error"))
        return .{ .validation_error = e.message };
    if (std.mem.eql(u8, e.kind, "shape-error"))
        return .{ .shape_error = .{ .branch = e.branch, .field = if (e.field.len == 0) null else e.field, .message = e.message } };
    if (std.mem.eql(u8, e.kind, "event-denied"))
        return .{ .event_denied = e.message };
    if (std.mem.eql(u8, e.kind, "dispatch-error"))
        return .{ .dispatch_error = .{ .event_name = e.event_name, .message = e.message, .trace = e.trace } };
    if (std.mem.eql(u8, e.kind, "scope-not-found"))
        return .{ .scope_not_found = e.message };
    return .{ .unknown_error = .{ .kind = e.kind, .message = e.message } };
}
