// PINS: [requires("setup")] satisfied by the chain ordering — the declared
// edge and the observed order agree, so the program compiles and runs.
~import std/io
~[requires("setup")]pub tor work { } -> i32
~proc work|zig { return 1; }
~pub tor setup { } -> i32
~proc setup|zig { return 0; }
~setup(): _ |> work(): _ |> std/io:print.ln("done")
