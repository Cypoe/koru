// Koru Standard Library: the `error` part of bridge — the two-tier error
// surface for `run`. Joined via `~part error` in bridge.kz; merged into
// the bridge module at load. `Runtime` is imported in the `bind` part.

/// One arm for every failure class a turn can end in. `kind` names the
/// variant the fine-grained outcome list would have fired; the rest is the
/// lossless union of every variant's payload — zero/empty when the kind
/// doesn't carry it. `error-decode` routes `kind` back to the typed arms
/// when a caller distinguishes between failure classes.
pub const RunError = struct {
    kind: []const u8,
    message: []const u8,
    branch: []const u8,
    field: []const u8,
    event_name: []const u8,
    last_event: []const u8,
    trace: []const u8,
    used: u64,
    handles: u32,
    line: u32,
    column: u32,
};

fn mkErr(kind: []const u8, message: []const u8) RunError {
    return .{
        .kind = kind, .message = message, .branch = "", .field = "",
        .event_name = "", .last_event = "", .trace = "",
        .used = 0, .handles = 0, .line = 0, .column = 0,
    };
}

// The single-item dispatch boundary: copy the interpreter's fine-grained
// outcome into run's two-tier shape — findings pass through verbatim, and
// every failure class packs into RunError with `kind` naming the variant.
fn runOutcome(br: *Bridge, r: Runtime.run_event.Output, comptime Out: type) Out {
    return switch (r) {
        .result => |v| .{ .result = .{
            .value = v.value, .used = v.used, .handles = v.handles,
            // The terminal dispatch bound itself via the trace; a turn
            // that dispatched nothing (pure flow) still needs a name.
            .bound = if (v.bound.len > 0) v.bound else bindResult(br, v.value),
            .trace = v.trace,
        } },
        .unhandled_branch => |u| .{ .unhandled_branch = .{ .branch = u.branch, .payload = u.payload, .handles = u.handles, .bound = u.bound } },
        .exhausted => |e| blk: {
            var err = mkErr("exhausted", "the turn exhausted its cost budget");
            err.used = e.used; err.last_event = e.last_event; err.handles = e.handles;
            break :blk .{ .@"error" = err };
        },
        .parse_error => |e| blk: {
            var err = mkErr("parse-error", e.message);
            err.line = e.line; err.column = e.column;
            break :blk .{ .@"error" = err };
        },
        .validation_error => |e| .{ .@"error" = mkErr("validation-error", e) },
        .shape_error => |e| blk: {
            var err = mkErr("shape-error", e.message);
            err.branch = e.branch; err.field = e.field orelse "";
            break :blk .{ .@"error" = err };
        },
        .event_denied => |e| .{ .@"error" = mkErr("event-denied", e) },
        .dispatch_error => |e| blk: {
            var err = mkErr("dispatch-error", e.message);
            err.event_name = e.event_name; err.trace = e.trace;
            break :blk .{ .@"error" = err };
        },
        .scope_not_found => |e| .{ .@"error" = mkErr("scope-not-found", e) },
    };
}

// ============================================================================
// ERROR-DECODE — the fine-grained arm set for callers that distinguish
// failure classes. `e` is the RunError a `run`'s `| error` arm bound; each
// optional arm fires for exactly one `kind`, carrying that variant's typed
// payload. A `kind` outside the known set routes to `unknown-error`; nothing
// here is required — the caller already answered the error once.
// ============================================================================

~pub tor error-decode { e: RunError }
| ?exhausted { used: u64, last_event: string, handles: u32 }
| ?parse-error { message: string, line: u32, column: u32 }
| ?validation-error string
| ?shape-error { branch: string, field: ?string, message: string }
| ?event-denied string
| ?dispatch-error { event_name: string, message: string, trace: string }
| ?scope-not-found string
| ?unknown-error { kind: string, message: string }

~proc error-decode|zig {
    if (std.mem.eql(u8, e.kind, "exhausted"))
        return .{ .exhausted = .{ .used = e.used, .last_event = e.last_event, .handles = e.handles } };
    if (std.mem.eql(u8, e.kind, "parse-error"))
        return .{ .parse_error = .{ .message = e.message, .line = e.line, .column = e.column } };
    if (std.mem.eql(u8, e.kind, "validation-error"))
        return .{ .validation_error = e.message };
    if (std.mem.eql(u8, e.kind, "shape-error"))
        return .{ .shape_error = .{ .branch = e.branch, .field = if (e.field.len == 0) null else e.field, .message = e.message } };
    if (std.mem.eql(u8, e.kind, "event-denied"))
        return .{ .event_denied = e.message };
    if (std.mem.eql(u8, e.kind, "dispatch-error"))
        return .{ .dispatch_error = .{ .event_name = e.event_name, .message = e.message, .trace = e.trace } };
    if (std.mem.eql(u8, e.kind, "scope-not-found"))
        return .{ .scope_not_found = e.message };
    return .{ .unknown_error = .{ .kind = e.kind, .message = e.message } };
}
