// ============================================================================
// Test 210_083: FRONTEND_COMPILE_ERROR — `|? Transition _ |> _` refuses
//                          at parse.
//
// Metatype, binding, and body are all irrelevant: the arm is judged by
// its spelling, and the spelling does not exist. `Transition`/`Profile`/
// `Audit` remain legitimate declaration-side metatypes; they were never
// a license for a callsite residual case.
// ============================================================================

~tor process { value: u32 }
| success u32
| ?warning string
| ?debug string

~proc process|zig {
    return .{ .success = value * 2 };
}

~process(value: 10)
| success _ |> _
|? Transition _ |> _
