// Koru Standard Library: Reactive Stores — the `writecheck` part.
// Joined via `~part writecheck` in store.kz; merged into the store module at load.
// Proven-width check on stored writes: the numeric verdict, literal-exactness oracle, and the @witness mark minted per write (690_160).
// ============================================================================
// proven-width check — koru owns the narrowing refusal (690_160)
// ============================================================================
//
// A stored write's target column type is declared; its RHS is minted text.
// Until this check, EVERY expression's type discipline was borrowed from
// whichever backend happened to typecheck the emitted host text — zig
// refused f64→f32 ("expected type 'f32', found 'f64'") while C's implicit
// conversions silently compiled it and js never saw the difference. Koru's
// semantics have to stand upright on every host, so the refusal lives
// here, in the transform, before any host sees the write.
//
// Conservative by construction: it fires only when it can PROVE the
// value's class cannot land in the column — same-class narrowing or a
// float↔int crossing. Everything unproven defers to the backend exactly
// as before: literals coerce at comptime, and calls, bindings, and
// non-store heads carry no type this rung. It can only refuse what every
// host already refused.

const expression_parser_wc = @import("expression_parser");

const WriteNumClass = enum { si, fl };
const WriteNumInfo = struct { cls: WriteNumClass, rank: u8, name: []const u8 };

fn writeNumInfoOf(ftype: []const u8) ?WriteNumInfo {
    if (std.mem.eql(u8, ftype, "i64")) return .{ .cls = .si, .rank = 2, .name = "i64" };
    if (std.mem.eql(u8, ftype, "i32")) return .{ .cls = .si, .rank = 1, .name = "i32" };
    if (std.mem.eql(u8, ftype, "f64")) return .{ .cls = .fl, .rank = 2, .name = "f64" };
    if (std.mem.eql(u8, ftype, "f32")) return .{ .cls = .fl, .rank = 1, .name = "f32" };
    return null;
}

fn writeColNumInfo(alloc: std.mem.Allocator, prog: *const ast_find.Program, store: []const u8, field: []const u8) ?WriteNumInfo {
    const ty = storeColType(alloc, prog, store, field) orelse return null;
    return writeNumInfoOf(ty);
}

// The store a `x.f` / `x[r].f` / `__koru_store_x.f` head reads — the
// lowered spelling (a sweep arm's `.live` rewrite mints it) and the
// source spelling both land here. Anything else is not a store read.
fn writeStoreNameOf(alloc: std.mem.Allocator, prog: *const ast_find.Program, obj: *const ast_find.Expression) ?[]const u8 {
    const nm: []const u8 = switch (obj.node) {
        .identifier => |n| n,
        .array_index => |ai| switch (ai.object.node) {
            .identifier => |n| n,
            else => return null,
        },
        else => return null,
    };
    if (std.mem.startsWith(u8, nm, "__koru_store_")) return nm["__koru_store_".len..];
    for (storeAllNames(alloc, prog)) |sn| {
        if (std.mem.eql(u8, sn, nm)) return sn;
    }
    return null;
}

// A bound name to proven numeric info. Phantom (`<...>`) and pointer (`*`)
// types are never a numeric column; "unknown" is the parser placeholder -
// all defer, they never refuse.
fn writeScopeNumInfo(scope: []const ast_find.ScopeBinding, name: []const u8) ?WriteNumInfo {
    for (scope) |b| {
        if (!std.mem.eql(u8, b.name, name) and !std.mem.eql(u8, b.value_ref, name)) continue;
        const ty = std.mem.trim(u8, b.type, " ");
        if (ty.len == 0 or std.mem.eql(u8, ty, "unknown")) return null;
        if (std.mem.indexOfAny(u8, ty, "<*") != null) return null;
        return writeNumInfoOf(ty);
    }
    return null;
}

/// `name` binds a row record of which store? Two decodes, each honest:
/// the binding's declared type names `__KoruStoreRow_<S>` or an
/// `[entity(Alias)]` alias (take `| item`, impl inputs), or — when the
/// type is empty, a multi-field record payload — the bind's origin is a
/// `| row`/`inserted`/`removed` arm under a store op, resolved by
/// emitter_helpers.rowBindStoreAtSite over the same site scopeAtSite
/// walked.
fn writeRowStoreOf(
    alloc: std.mem.Allocator,
    prog: *const ast_find.Program,
    scope: []const ast_find.ScopeBinding,
    row_flow: ?*const ast_find.Flow,
    name: []const u8,
) ?[]const u8 {
    for (scope) |b| {
        if (!std.mem.eql(u8, b.name, name) and !std.mem.eql(u8, b.value_ref, name)) continue;
        var ty = std.mem.trim(u8, b.type, " ");
        while (ty.len > 0 and ty[0] == '*') ty = ty[1..];
        if (std.mem.indexOfScalar(u8, ty, '<')) |lt| ty = ty[0..lt];
        if (std.mem.lastIndexOfScalar(u8, ty, ':')) |c| ty = ty[c + 1 ..];
        if (std.mem.startsWith(u8, ty, "__KoruStoreRow_")) return ty["__KoruStoreRow_".len..];
        if (ty.len > 0) {
            if (entityStoreOf(alloc, prog, ty)) |s| return s;
        }
        // A scalar type here is not a verdict: the same-named `| row`
        // index branch's payload shadows `! row`'s record bind on the
        // decl, so `e` can wear `usize` while binding a record. The
        // origin walk re-checks arm kind — it cannot map a name no row
        // arm ever bound.
        break;
    }
    const fl = row_flow orelse return null;
    const eh = @import("emitter_helpers");
    return eh.rowBindStoreAtSite(alloc, prog.items, fl, fl.inv(), name);
}

/// Which store's `[entity(Alias)]` declares `alias`? store.new.kz mints
/// `pub const Alias = __KoruStoreRow_<S>` from the `new` flow's
/// `entity(<raw>)` annotation (first letter capitalized).
fn entityStoreOf(alloc: std.mem.Allocator, prog: *const ast_find.Program, alias: []const u8) ?[]const u8 {
    for (storeAllNames(alloc, prog)) |sn| {
        if (storeEntityAlias(alloc, prog, sn)) |a| {
            if (std.mem.eql(u8, a, alias)) return sn;
        }
    }
    return null;
}

/// The capitalized `entity(<raw>)` text on store `sn`'s `new` flow.
fn storeEntityAlias(alloc: std.mem.Allocator, prog: *const ast_find.Program, store: []const u8) ?[]const u8 {
    const stripQuotes2 = @import("emitter_helpers").stripQuotes;
    for (flatItems(alloc, prog.items)) |pi| {
        if (pi.* != .flow) continue;
        const f = &pi.flow;
        const inv = f.inv();
        if (inv.path.segments.len != 1 or !std.mem.eql(u8, inv.path.segments[0], "new")) continue;
        const mq = inv.path.module_qualifier orelse continue;
        if (!std.mem.eql(u8, mq, "std.store")) continue;
        var matches = false;
        for (inv.args) |a| {
            if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, stripQuotes2(a.value), store)) matches = true;
        }
        if (!matches) continue;
        for (f.annotations) |ann| {
            if (std.mem.startsWith(u8, ann, "entity(") and ann.len > "entity(".len + 1 and ann[ann.len - 1] == ')') {
                const raw = ann["entity(".len .. ann.len - 1];
                const cap = alloc.alloc(u8, raw.len) catch unreachable;
                @memcpy(cap, raw);
                cap[0] = std.ascii.toUpper(cap[0]);
                return cap;
            }
        }
        return null;
    }
    return null;
}

// The proven numeric class of a value expression, or null = unknown.
// `null` is never a verdict — it is "defer to the host backend".
fn writeExprNumInfo(alloc: std.mem.Allocator, prog: *const ast_find.Program, expr: *const ast_find.Expression, scope: []const ast_find.ScopeBinding, row_flow: ?*const ast_find.Flow) ?WriteNumInfo {
    switch (expr.node) {
        .literal => return null,
        .identifier => |n| {
            if (writeScopeNumInfo(scope, n)) |info| return info;
            // `! inserted|removed { f }` binds by pun — `f` IS column `S.f`
            // of the arm's store (user type text on these fields is
            // refused, so the binding always arrives untyped). `! updated
            // { old, new }` binds the written field's images — the decl
            // enforces uniform columns before that arm may bind, so both
            // names take the store's column type. emitter_helpers walks
            // the same site ancestry scopeAtSite walked.
            if (row_flow) |fl| {
                const eh = @import("emitter_helpers");
                if (eh.lifecyclePunAtSite(alloc, prog.items, fl, fl.inv(), n)) |pun| {
                    switch (pun) {
                        .col_pun => |sn| return writeColNumInfo(alloc, prog, sn, n),
                        .updated_image => |sn| {
                            // The decl enforces uniform columns, so any
                            // column's type is the image type — take the
                            // first in declaration order (apply branches or
                            // seed block, whichever transform ran).
                            if (storeFieldOrder(alloc, prog, sn)) |flds| {
                                if (flds.len > 0) return writeColNumInfo(alloc, prog, sn, flds[0]);
                            }
                            return null;
                        },
                    }
                }
            }
            return null;
        },
        .unary => |u| return writeExprNumInfo(alloc, prog, u.operand, scope, row_flow),
        .grouped => |g| return writeExprNumInfo(alloc, prog, g, scope, row_flow),
        .binary => |b| {
            switch (b.op) {
                .add, .subtract, .multiply, .divide, .modulo => {},
                else => return null, // comparisons and logic yield bool
            }
            const l = writeExprNumInfo(alloc, prog, b.left, scope, row_flow);
            const r = writeExprNumInfo(alloc, prog, b.right, scope, row_flow);
            if (l != null and r != null) {
                if (l.?.cls != r.?.cls) return null; // mixed family — defer
                return if (l.?.rank >= r.?.rank) l.? else r.?;
            }
            if (l == null and r == null) return null;
            // A lone literal operand adopts its typed peer — Zig's own peer
            // resolution: the comptime literal coerces iff the value is
            // exactly representable there, so a host refuses anything else.
            const lit_expr = if (l == null) b.left else b.right;
            const peer = if (l == null) r.? else l.?;
            const text = numericLiteralText(alloc, lit_expr) orelse return null;
            const exact = literalExactIn(text, peer.name) orelse return null;
            return if (exact) peer else null;
        },
        .field_access => |fa| {
            if (writeStoreNameOf(alloc, prog, fa.object)) |sn| {
                return writeColNumInfo(alloc, prog, sn, fa.field);
            }
            // `e.f` on a bound row: the binding's type names the row record
            // (take/impl payloads), or the bind's origin is a `| row e`/
            // interceptor arm under a store op (query/sweep bodies).
            if (fa.object.node == .identifier) {
                const rn = fa.object.node.identifier;
                if (writeRowStoreOf(alloc, prog, scope, row_flow, rn)) |sn| {
                    return writeColNumInfo(alloc, prog, sn, fa.field);
                }
            }
            return null;
        },
        .builtin_call => |bc| {
            // @as(T, e) is the author's own coercion - Zig refuses a lossy
            // one, so a numeric T here is proven. Any other builtin defers.
            if (std.mem.eql(u8, bc.name, "as") and bc.args.len == 2) {
                if (bc.args[0].node == .identifier) {
                    return writeNumInfoOf(bc.args[0].node.identifier);
                }
            }
            return null;
        },
        .array_index => |ai| {
            // `s.f[row]` parses as the index over the field access; a bare
            // `s[row]` is a row value, not a column read — defer. The
            // `(&s.f)[r]` shape (zig's handle-read spelling) unwraps through
            // its grouping to the same field access.
            var obj = ai.object;
            while (true) {
                if (obj.node == .grouped) {
                    obj = obj.node.grouped;
                    continue;
                }
                if (obj.node == .unary) {
                    obj = obj.node.unary.operand;
                    continue;
                }
                break;
            }
            if (obj.node == .field_access) {
                if (writeStoreNameOf(alloc, prog, obj.node.field_access.object)) |sn| {
                    return writeColNumInfo(alloc, prog, sn, obj.node.field_access.field);
                }
            }
            return null;
        },
        else => return null,
    }
}

// The numeric verdict for one stored write — the solver's receipt for the
// site: which column type it resolved, which RHS type it could prove, and
// whether the write is thereby refused. Callers mint a @witness mark from
// this record, so the verdict rides the lowered invocation instead of being
// reconstructed from emitted text downstream (prepared-witness channel).
pub const StoredWriteVerdict = struct {
    site: []const u8 = "", // "store.field" — identifies the obligation inside the mark
    dest: ?[]const u8 = null, // column numeric type name; null = non-numeric or unresolved column
    src: ?[]const u8 = null, // proven RHS numeric type name; null = unproven
    literal: ?[]const u8 = null, // RHS literal text (leading '-' when negated); null = not a bare literal
    literal_exact: bool = false, // literal is exactly representable in dest
    narrows: bool = false, // proven lossy — the write refuses

    // The mark payload's verdict token. `refused` never survives minting —
    // the program dies at the refusal — but the vocabulary stays uniform.
    pub fn tag(self: StoredWriteVerdict) []const u8 {
        if (self.narrows) return "refused";
        if (self.dest == null) return "non-numeric";
        if (self.literal != null) return if (self.literal_exact) "lossless" else "rounds";
        if (self.src == null) return "deferred";
        return "lossless";
    }
};

// A bare numeric literal the checker cannot type: the literal text (with a
// leading '-' when it arrived wrapped in unary minus), or null. Only
// digits[.digits] text counts — anything richer (exponent, hex, '_',
// suffix) stays "unproven" and defers exactly as before.
fn numericLiteralText(alloc: std.mem.Allocator, expr: *const ast_find.Expression) ?[]const u8 {
    switch (expr.node) {
        .literal => |l| switch (l) {
            .number => |n| return if (validLiteralDigits(n)) n else null,
            else => return null,
        },
        .unary => |u| {
            if (u.op != .negate) return null;
            switch (u.operand.node) {
                .literal => |l| switch (l) {
                    .number => |n| return if (validLiteralDigits(n))
                        std.fmt.allocPrint(alloc, "-{s}", .{n}) catch unreachable
                    else
                        null,
                    else => return null,
                },
                else => return null,
            }
        },
        else => return null,
    }
}

fn validLiteralDigits(n: []const u8) bool {
    var dots: usize = 0;
    var digits: usize = 0;
    for (n) |c| {
        if (c == '.') {
            dots += 1;
        } else if (std.ascii.isDigit(c)) {
            digits += 1;
        } else {
            return false;
        }
    }
    if (dots > 1 or digits == 0) return false;
    if (dots == 1 and (n[0] == '.' or n[n.len - 1] == '.')) return false;
    return true;
}

// Exact representability of a digits[.digits] literal in a numeric
// destination, decided with integer arithmetic only — no float casts,
// because a decimal that happens to roundtrip through f64/f32 is not
// thereby exact (Zig literals are arbitrary-precision; 0.1 is not exact
// in f64 either). Returns null when the text is not a recognized literal
// or its digits overflow u128 — the caller then leaves the site deferred.
//
// Let N = all digits as one integer, k = fraction digit count, neg = sign:
//   int dest width w:  exact iff N = q·10^k with q ≤ 2^(w-1)-1 (!neg)
//                      or q ≤ 2^(w-1) (neg).
//   float dest (p, emin, emax; value form m·2^e, |m| < 2^p):  exact iff
//                      N = M·5^k; writing M = odd·2^t, e0 = t - k and
//                      b = bit length of odd, some e in [emin, emax] fits:
//                      max(0, e0-emax) ≤ min(p-b, e0-emin).
fn literalExactIn(text: []const u8, dest_name: []const u8) ?bool {
    const tinfo = writeNumInfoOf(dest_name) orelse return null;
    var s = text;
    var neg = false;
    if (s.len > 0 and s[0] == '-') {
        neg = true;
        s = s[1..];
    }
    if (!validLiteralDigits(s)) return null;
    var int_part = s;
    var frac_part: []const u8 = "";
    if (std.mem.indexOfScalar(u8, s, '.')) |d| {
        int_part = s[0..d];
        frac_part = s[d + 1 ..];
    }
    var n: u128 = 0;
    for (int_part) |c| {
        n = std.math.mul(u128, n, 10) catch return null;
        n = std.math.add(u128, n, c - '0') catch return null;
    }
    for (frac_part) |c| {
        n = std.math.mul(u128, n, 10) catch return null;
        n = std.math.add(u128, n, c - '0') catch return null;
    }
    if (n == 0) return true;
    const k: u32 = @intCast(frac_part.len);
    switch (tinfo.cls) {
        .si => {
            const p10 = std.math.powi(u128, 10, k) catch return false;
            if (n % p10 != 0) return false;
            const q = n / p10;
            const w: u7 = if (tinfo.rank == 1) 32 else 64;
            const pos_lim = (@as(u128, 1) << (w - 1)) - 1;
            const neg_lim = @as(u128, 1) << (w - 1);
            return if (neg) q <= neg_lim else q <= pos_lim;
        },
        .fl => {
            const p5 = std.math.powi(u128, 5, k) catch return false;
            if (n % p5 != 0) return false;
            const m = n / p5;
            const t: i64 = @intCast(@ctz(m));
            const odd = m >> @intCast(t);
            const e0 = t - @as(i64, k);
            const b: i64 = @intCast(128 - @clz(odd));
            const p: i64 = if (tinfo.rank == 1) 24 else 53;
            const emin: i64 = if (tinfo.rank == 1) -149 else -1074;
            const emax: i64 = if (tinfo.rank == 1) 104 else 971;
            const lo = @max(0, e0 - emax);
            const hi = @min(p - b, e0 - emin);
            return lo <= hi;
        },
    }
}

// Runs the numeric check and returns the verdict record — never refuses on
// its own. Unproven stays unproven: neither safe nor refused.
fn storedWriteCheck(alloc: std.mem.Allocator, prog: *const ast_find.Program, store: []const u8, field: []const u8, value_text: []const u8, scope: []const ast_find.ScopeBinding, row_flow: ?*const ast_find.Flow) StoredWriteVerdict {
    var v = StoredWriteVerdict{ .site = std.fmt.allocPrint(alloc, "{s}.{s}", .{ store, field }) catch unreachable };
    const tinfo = writeColNumInfo(alloc, prog, store, field) orelse return v;
    v.dest = tinfo.name;
    // The lowered row read `(&__koru_store_S.f)[i]` is a compiler-internal
    // spelling, not expression grammar: `&` has no unary form here and a
    // grouped primary takes no postfix, so `(x)[i]` cannot parse. Both
    // artifacts are normalized away — the address-of wrapper and the
    // parens that exist only to parenthesize it — leaving `S.f[i]`.
    // `&&` is preserved verbatim.
    var cleaned = value_text;
    if (std.mem.indexOfScalar(u8, value_text, '&') != null) {
        var cb = std.ArrayList(u8).initCapacity(alloc, value_text.len) catch unreachable;
        var ci: usize = 0;
        var drop_close_depth: i32 = 0;
        while (ci < value_text.len) : (ci += 1) {
            const ch = value_text[ci];
            if (ch == '&') {
                if (ci + 1 < value_text.len and value_text[ci + 1] == '&') {
                    cb.appendSlice(alloc, "&&") catch unreachable;
                    ci += 1;
                    continue;
                }
                // `(&` — the paren only groups the address-of artifact:
                // both go, and the group close is dropped on the way out.
                if (cb.items.len > 0 and cb.items[cb.items.len - 1] == '(') {
                    _ = cb.pop();
                    drop_close_depth = 1;
                }
                continue;
            }
            if (drop_close_depth > 0) {
                if (ch == '(') {
                    drop_close_depth += 1;
                } else if (ch == ')') {
                    drop_close_depth -= 1;
                    if (drop_close_depth == 0) continue;
                }
            }
            cb.append(alloc, ch) catch unreachable;
        }
        cleaned = cb.items;
    }
    var parser = expression_parser_wc.ExpressionParser.init(alloc, cleaned);
    const expr = parser.parseAll() catch return v;
    const rinfo = writeExprNumInfo(alloc, prog, expr, scope, row_flow) orelse {
        // A lone literal's representability is decidable from its text;
        // the mark carries it verbatim so a downstream checker can re-decide.
        if (numericLiteralText(alloc, expr)) |text| {
            if (literalExactIn(text, tinfo.name)) |exact| {
                v.literal = text;
                v.literal_exact = exact;
            }
        }
        return v;
    };
    v.src = rinfo.name;
    v.narrows = if (rinfo.cls == tinfo.cls)
        rinfo.rank > tinfo.rank
    else
        true;
    return v;
}

// The write-side refusal: the diagnostic text when the RHS's proven class
// cannot land in the column, null when it can or nothing is proven.
// Cross-class is refused both ways — no host coerces float↔int silently.
fn storedWriteNarrowing(alloc: std.mem.Allocator, prog: *const ast_find.Program, store: []const u8, field: []const u8, value_text: []const u8, scope: []const ast_find.ScopeBinding, row_flow: ?*const ast_find.Flow) ?[]const u8 {
    const v = storedWriteCheck(alloc, prog, store, field, value_text, scope, row_flow);
    if (!v.narrows) return null;
    return std.fmt.allocPrint(alloc, "std/store:stored: column '{s}.{s}' is {s} but the write is provably {s} — a write that loses bits is refused, never silently rounded (690_160)", .{ store, field, v.dest.?, v.src.? }) catch unreachable;
}

// The prepared-witness spelling for one checked write. Rides `.marks` —
// compiler-internal, unauthorable by surface syntax — on the lowered write
// invocation, which is the obligation site the emitters actually see.
fn storedWriteWitnessMark(alloc: std.mem.Allocator, v: StoredWriteVerdict) []const u8 {
    const src = if (v.literal) |l|
        std.fmt.allocPrint(alloc, "literal:{s}", .{l}) catch unreachable
    else
        v.src orelse "unproven";
    return std.fmt.allocPrint(alloc, "@witness(\"stored-write-numeric\",\"{s}\",\"{s}<-{s}\",\"{s}\")", .{ v.site, v.dest orelse "unresolved", src, v.tag() }) catch unreachable;
}
