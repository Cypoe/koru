// Test 355_005: Optional Branches - All Branches Optional (Edge Case)
//
// Verifies:
// 1. Event with NO required branches — all optional
// 2. Every arm is still a named arm: | success, | warning, | err
// 3. Edge case: zero required branches — omitting everything is also legal

~import std/io

// Event with ONLY optional branches
~tor process { value: u32 }
| ?success u32
| ?warning string
| ?err string

~proc process|zig {
    if (value == 0) {
        return .{ .err = "Zero value" };
    }
    if (value > 100) {
        return .{ .warning = "Large value" };
    }
    return .{ .success = value * 2 };
}

// All named — optional branches are handled the same way required ones are
~process(value: 10)
| success _ |> std/io:print.ln("SUCCESS FIRED")
| warning _ |> std/io:print.ln("WARNING FIRED")
| err _ |> std/io:print.ln("ERR FIRED")

~process(value: 150)
| success _ |> std/io:print.ln("SUCCESS FIRED")
| warning _ |> std/io:print.ln("WARNING FIRED")
| err _ |> std/io:print.ln("ERR FIRED")

~process(value: 0)
| success _ |> std/io:print.ln("SUCCESS FIRED")
| warning _ |> std/io:print.ln("WARNING FIRED")
| err _ |> std/io:print.ln("ERR FIRED")
