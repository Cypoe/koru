// ============================================================================
// Test 210_082: FRONTEND_COMPILE_ERROR — bare `!? |> _` refuses at parse.
//
// Symmetric with 210_081 on the effect side. `! ?warning` is the
// producer's optional mark — an unnamed optional effect lowers to
// nothing with zero consumer syntax. There is no `!?` arm to write.
// ============================================================================

~pub tor tokenize { source: string }
! token string
! ?warning string
! ?debug string
| done usize

~pub tor consume-token { t: string }
~pub tor end-run { n: usize }

~tokenize(source: "x")
! token t |> consume-token(t)
!? |> _
| done n |> end-run(n)
