// Koru Standard Library: target — the backend target catalog.
//
// Companion to `compiler:emission` (the overwritable coordinate tor): this
// module owns the DECLARED half of a backend — the data rows its dispatch
// arms consume. `std/emit` (the walker) owns the engine half; this file is
// policy-free: it defines the row vocabulary and the catalog merge, never
// which targets exist or what a spelling means.
//
// Mirrors std/realize: data lives in the AST as `[comptime|norun]` sites,
// harvested after the parse by the command/emission consumer. A target is
// a catalog entry, not a module — the ruling is
// concepts/frag-a-target-is-a-catalog-entry-not-a-module.md and the shape
// is docs/std-target.md.
//
// Declaration shape (the invariants idiom):
//
//   ~std/target:target(c) { "facet": ".kc", "artifact": "output_emitted.c",
//                           "toolchain": "ccomp -fstruct-passing" }
//   ~std/target:type(c)    { "i64": "long long", "u8": "uint8_t",
//                            "string": "const char *" }
//   ~std/target:name(c)    { "member": "kebab->_", "payload_tag": "__ktag" }
//   ~std/target:builtin(c) { "@max": "__koru_max_ll", "@min": "__koru_min_ll" }
//   ~std/target:prelude(c) { ...preamble text... }
//   ~std/target:fragment(c){ "refuses": ["resumable-!", "host-lines", ...] }
//
// Each row verb is keyed on the target name in its site arg — the same
// site-arg idiom `row` uses for `iface`. Rows with the same (verb, target)
// MERGE; contradictory bindings on one key refuse loudly, never pick a
// winner silently.

~[comptime]

// A backend target's identity — arm name, facet extension, emitted
// artifact name, and the toolchain string the oracle runs. One row per
// target; a duplicate `target(<name>)` site with a different value on the
// same key is a contradiction refusal, not a merge.
~[comptime|norun]pub tor target { name: Expression, source: Source }

// The type table: Koru type text -> host spelling. Cell-minting schemes
// live here too as entries whose value names a mint rule (`*X` ->
// `struct X *`, `[]T` -> `__koru_slice_<tag>{ptr,len}`, `i128` ->
// `{lo,hi}`) — a rule name, not expanded text; the walker owns expansion.
~[comptime|norun]pub tor type { name: Expression, source: Source }

// Naming scheme rows: mangle/member/payload conventions as key->rule
// data. `kebab->_` means cMemberName's fold, `__ktag` means the payload
// tag member's spelling — the walker names the convention; the catalog
// names the lane's choice.
~[comptime|norun]pub tor name { name: Expression, source: Source }

// Builtin table: `@foo` -> spelling-or-rule, including refusal-shaped
// entries (`"*%": "refuse-unless-declared-width"` — the boundary is data).
~[comptime|norun]pub tor builtin { name: Expression, source: Source }

// The preamble: includes + helper bodies, verbatim host text. One block
// per target — a second `prelude(<name>)` site appends, order-declared.
~[comptime|norun]pub tor prelude { name: Expression, source: Source }

// The promise boundary: which constructs this target names as refusals.
// The catalog keeps these explicit — a fragment row is the arm's honest
// scope, and the walker's KORU047 diagnostics should read like them.
~[comptime|norun]pub tor fragment { name: Expression, source: Source }

const std = @import("std");
const ast = @import("ast");

// ============================================================================
// CATALOG TYPES — the declared target vocabulary
// ============================================================================

pub const TargetDecl = struct {
    name: []const u8 = "",        // arm key: "c", "cs", "js", "zig"
    facet: []const u8 = "",       // ".kc"
    artifact: []const u8 = "",    // "output_emitted.c"
    toolchain: []const u8 = "",   // "ccomp -fstruct-passing"
};

// One row verb's bindings for one target — a string->string table because
// every row is a lookup, and the lookup's VALUE is either literal spelling
// or a rule name the walker interprets. Keeping values opaque strings is
// the realize lesson: the catalog stays honest about what is data and
// what is mechanism.
pub const RowTable = struct {
    target: []const u8,
    verb: []const u8,   // "type" | "name" | "builtin" | "prelude" | "fragment"
    entries: std.StringArrayHashMap([]const u8),
    order: std.ArrayList([]const u8), // source order — prelude appends ride it
};

pub const Catalog = struct {
    targets: std.StringArrayHashMap(TargetDecl),
    rows: std.ArrayList(RowTable),
};

// ============================================================================
// THE c ARM — the first declared target, mirroring c_emitter.zig
// ============================================================================
//
// These rows are the c lane declared as data. The emitter still answers
// from its own tables — the catalog currently DUAL-ANSWERS beside it
// (drift prints, the emitter wins) until the corpus proves the rows, at
// which point the flip rung makes the catalog the sole source.

~std/target:target(c) {
    "facet": ".kc",
    "artifact": "output_emitted.c",
    "toolchain": "ccomp -fstruct-passing"
}

// The flat spelling table — codegen_utils.cTypeOf verbatim. Constructive
// spellings (`*X`, `[]T`, `{...}` records, proto `struct Name`) are rule
// names a later row declares; this table is only the literal map.
~std/target:type(c) {
    "string": "const char *",
    "[]const u8": "const char *",
    "[:0]u8": "const char *",
    "i64": "long long",
    "int": "long long",
    "number": "long long",
    "i32": "int32_t",
    "i16": "int16_t",
    "i8": "int8_t",
    "u64": "uint64_t",
    "u32": "uint32_t",
    "u16": "uint16_t",
    "u8": "uint8_t",
    "u6": "uint8_t",
    "usize": "uintptr_t",
    "isize": "intptr_t",
    "f64": "double",
    "f32": "double",
    "float": "double",
    "bool": "int"
}

// The fragment boundary the c lane already names — keep refusing, keep
// naming. `i128` spells a two-word cell but its arithmetic is refused;
// store watches lower since f74a16bcf while interceptors and the
// tree/index/entity/owned/ref column families stay out (690_386-392).
~std/target:fragment(c) {
    "refuses": [
        "resumable-!",
        "raw-host-lines",
        "destructure",
        "missing-target-proc-body",
        "unregistered-assignment-target",
        "i128-arithmetic",
        "concurrency-runtime",
        "store-interceptors",
        "store-tree-index-entity-owned-ref-columns"
    ]
}

// Naming conventions — logical name -> emitted constant. Generative
// families carry their prefix (`__koru_slice_` mints `__koru_slice_<tag>`);
// helper spellings are literals. The emitter dual-answers each at its
// mint site — a renamed constant that never updated the row drifts loud.
~std/target:name(c) {
    "slice_prefix": "__koru_slice_",
    "rec_prefix": "__koru_rec_",
    "cap_prefix": "__koru_cap_",
    "res_prefix": "__koru_res_",
    "raise_prefix": "__koru_raise_",
    "inline_prefix": "__koru_inline_",
    "continue_prefix": "__koru_continue_",
    "comptime_prefix": "__koru_comptime_",
    "store_prefix": "__koru_store_",
    "snap_name": "__koru_snap",
    "idx_marker": "__koru_idx",
    "i128_cell": "__koru_i128",
    "u128_cell": "__koru_u128"
}

// The builtin boundary — `@name` -> lowered | refused. The check lives
// at the UnsupportedBuiltin refusal: a refusal the catalog calls
// "lowered" is drift (overpromise), a refusal the catalog does not name
// at all is drift too (the boundary stays declared, fragment-style).
~std/target:builtin(c) {
    "@as": "lowered",
    "@intCast": "lowered",
    "@floatFromInt": "lowered",
    "@intFromFloat": "lowered",
    "@floatCast": "lowered",
    "@intFromBool": "lowered",
    "@divTrunc": "lowered",
    "@rem": "lowered",
    "@mod": "lowered",
    "@max": "lowered",
    "@min": "lowered",
    "@panic": "refused",
    "@ptrCast": "refused",
    "@bitCast": "refused",
    "@embedFile": "refused",
    "@compileError": "refused",
    "@import": "refused",
    "@enumFromInt": "refused",
    "@intFromEnum": "refused",
    "@truncate": "refused",
    "@divExact": "refused",
    "@divFloor": "refused",
    "@popCount": "refused",
    "@exp2": "refused",
    "@sqrt": "refused",
    "@sin": "refused",
    "@cos": "refused",
    "@tan": "refused",
    "@exp": "refused",
    "@log": "refused",
    "@log2": "refused",
    "@log10": "refused",
    "@floor": "refused",
    "@ceil": "refused",
    "@trunc": "refused",
    "@abs": "refused"
}

// The preamble — includes and the static helper surface the lowering
// and |c transforms write against, as lists (the text itself stays in
// the emitter until the walker owns expansion). Post-emit, every
// `#include <x>` and `static ... __koru_<name>(` definition reaching
// output must appear here — the emitted set is a subset of the
// declared set, never the other way.
~std/target:prelude(c) {
    "includes": ["stdio.h", "stdlib.h", "string.h", "stdint.h", "stdbool.h", "errno.h"],
    "helpers": [
        "__koru_concat",
        "__koru_stdout_write",
        "__koru_stderr_write",
        "__koru_len_str",
        "__koru_streq",
        "__koru_str_i64",
        "__koru_stdout_write_i64",
        "__koru_stderr_write_i64",
        "__koru_stdout_write_f64",
        "__koru_stderr_write_f64",
        "__koru_stdout_write_f64_prec",
        "__koru_stderr_write_f64_prec",
        "__koru_unreachable",
        "__koru_intcast",
        "__koru_intcast_u",
        "__koru_max_ll",
        "__koru_min_ll"
    ],
    "state": [
        "__koru_argc",
        "__koru_argv",
        "__koru_readln_buf",
        "__koru_comptime_Expression",
        "__koru_comptime_Source"
    ]
}

// ============================================================================
// CONSTRUCT INDEX — which std surfaces the c arm covers
// ============================================================================
//
// A construct row names a capability the lane claims. Checked one way at
// the NoCProcBody refusal: a claimed construct that refuses is catalog
// overpromise (drift). The reverse — an unclaimed construct that lowers —
// is invisible to refusal hooks; the walker owns that direction when it
// arrives.

~[comptime|norun]pub tor construct { name: Expression, source: Source }

// Canonical names post-transform: `print.ln`/`eprint.ln` both reroute to
// `std.io:print.impl` at the site — the name the emitted C actually
// invokes. The walker sees the post-transform AST, so the canonical name
// is the one its positive check can answer. (Rows are a strict JSON map —
// no comments inside the braces or the whole family silently voids.)

~std/target:construct(c) {
    "std/io:print.ln": "supported",
    "std/io:eprint.ln": "supported",
    "std/io:print.impl": "supported",
    "std/store:new": "supported",
    "std/store:insert": "supported",
    "std/store:stored": "supported",
    "std/store:watch": "supported",
    "std/switch:char": "supported"
}
