// Koru Standard Library: the `example` part of runtime.kz.
// Joined via `~part example` in runtime.kz; merged into the runtime
// module at load.
// ============================================================================
// PARSE.WIRE.EXAMPLE - the chain rule's worked example, derived per scope
// ============================================================================
//
// The shape rules in WIRE_GRAMMAR_TEXT are fixed prose — they describe the
// grammar itself, which is one law for every scope. The chain rule's worked
// EXAMPLE is different: it names verbs, and verbs belong to a scope. A fixed
// cast teaches notes on every register (kopium hole 9: on calc, `open` and
// `append` are event-denied and nothing mints a handle). So the cast is
// synthesized from the scope's own manifest — the same record the dispatcher
// and the vocabulary render are minted from — and a scope with nothing
// provably chainable gets the rule with no fabricated example.

// `{s}` is the worked example `scope-grammar` derives from the scope's own
// verbs; the binding it narrates is the `v` the derivation always uses.
const WIRE_CHAIN_RULE_EXAMPLE =
    \\- Chain fresh outcomes with arms: `{s}` — the arm's binding `v` is what the call just issued. Never invent one, never predict one: bind it.
;

const WIRE_CHAIN_RULE_NO_EXAMPLE =
    \\- Chain fresh outcomes with arms — a `| branch name |>` arm binds `name` to what the call just issued. Never invent one, never predict one: bind it.
;

// The grammar's rules block as one scope-true render: the fixed shape
// rules plus the chain rule carrying THIS scope's worked example.
// `scope-grammar` emits it above the vocabulary lines.
fn wireGrammarRules(allocator: std.mem.Allocator, m: ?*const ScopeManifest) []const u8 {
    var out = std.ArrayList(u8).initCapacity(allocator, 768) catch unreachable;
    out.appendSlice(allocator, WIRE_GRAMMAR_TEXT) catch unreachable;
    out.append(allocator, '\n') catch unreachable;
    if (m) |manifest| {
        if (scopeChainExample(allocator, manifest)) |example| {
            const line = std.fmt.allocPrint(allocator, WIRE_CHAIN_RULE_EXAMPLE, .{example}) catch unreachable;
            out.appendSlice(allocator, line) catch unreachable;
            return out.toOwnedSlice(allocator) catch unreachable;
        }
    }
    out.appendSlice(allocator, WIRE_CHAIN_RULE_NO_EXAMPLE) catch unreachable;
    return out.toOwnedSlice(allocator) catch unreachable;
}

// The chain rule's worked example, synthesized from the scope's own
// manifest — the only cast that cannot drift from what the wall enforces.
// The head is the first verb that provably hands a value to an arm: a
// branch carrying a payload field (required beats optional), or a bare
// return minting an obligation on `__type_ref` — which the wire meets
// branchless, as `ok`. The chain target is the possession edge when one
// exists (the verb that discharges what the head mints); on a handle-free
// scope it is the lightest sink that can carry the binding. Returns null
// when nothing is provably chainable — the caller renders the rule with
// no fabricated example.
fn scopeChainExample(allocator: std.mem.Allocator, m: *const ScopeManifest) ?[]const u8 {
    var head: ?*const ManifestEvent = null;
    var arm: []const u8 = "";
    for ([2]bool{ false, true }) |allow_optional| {
        for (m.events) |*ev| {
            for (ev.branches) |*br| {
                if (br.fields.len > 0 and (allow_optional or !br.is_optional)) {
                    head = ev;
                    arm = br.name;
                    break;
                }
            }
            if (head != null) break;
        }
        if (head != null) break;
    }
    if (head == null) {
        for (m.events) |*ev| {
            for (ev.creates) |c| {
                if (c.branch == null and std.mem.eql(u8, c.field, "__type_ref")) {
                    head = ev;
                    arm = "ok";
                    break;
                }
            }
            if (head != null) break;
        }
    }
    const h = head orelse return null;

    var target: ?*const ManifestEvent = null;
    var bound_arg: []const u8 = "";
    for (h.creates) |c| {
        if (c.branch != null and !std.mem.eql(u8, c.branch.?, arm)) continue;
        for (m.events) |*ev| {
            if (ev == h) continue;
            for (ev.discharges) |d| {
                if (std.mem.eql(u8, d.obligation, c.obligation) and std.mem.eql(u8, d.module, c.module)) {
                    target = ev;
                    bound_arg = d.arg;
                    break;
                }
            }
            if (target != null) break;
        }
        if (target != null) break;
    }
    if (target == null) {
        for ([2]bool{ true, false }) |want_sink| {
            for (m.events) |*ev| {
                if (ev == h or ev.args.len == 0) continue;
                if (want_sink and ev.branches.len != 0) continue;
                if (target == null or ev.args.len < target.?.args.len) {
                    target = ev;
                    bound_arg = ev.args[0].name;
                }
            }
            if (target != null) break;
        }
    }
    const t = target orelse return null;

    var ex = std.ArrayList(u8).initCapacity(allocator, 96) catch return null;
    var lit: usize = 0;
    var first = true;
    ex.appendSlice(allocator, h.name) catch return null;
    ex.append(allocator, '(') catch return null;
    for (h.args) |a| {
        if (a.is_optional) continue;
        if (!first) ex.appendSlice(allocator, ", ") catch return null;
        first = false;
        lit += 1;
        const piece = std.fmt.allocPrint(allocator, "{s}: \"{d}\"", .{ a.name, lit }) catch return null;
        ex.appendSlice(allocator, piece) catch return null;
    }
    ex.appendSlice(allocator, ") | ") catch return null;
    ex.appendSlice(allocator, arm) catch return null;
    ex.appendSlice(allocator, " v |> ") catch return null;
    ex.appendSlice(allocator, t.name) catch return null;
    ex.append(allocator, '(') catch return null;
    first = true;
    var bound_written = false;
    for (t.args) |a| {
        const is_bound = std.mem.eql(u8, a.name, bound_arg);
        if (a.is_optional and !is_bound) continue;
        if (!first) ex.appendSlice(allocator, ", ") catch return null;
        first = false;
        if (is_bound) {
            bound_written = true;
            ex.appendSlice(allocator, a.name) catch return null;
            ex.appendSlice(allocator, ": v") catch return null;
        } else {
            lit += 1;
            const piece = std.fmt.allocPrint(allocator, "{s}: \"{d}\"", .{ a.name, lit }) catch return null;
            ex.appendSlice(allocator, piece) catch return null;
        }
    }
    ex.append(allocator, ')') catch return null;
    // A discharge record naming an arg the verb no longer takes would emit
    // a chain that doesn't bind — refuse the example rather than lie.
    if (!bound_written) return null;
    return ex.toOwnedSlice(allocator) catch return null;
}
