// std/num — arbitrary-precision decimal numbers, taint-sourced.
//
// Koru has no numeric tower: bare literals are raw expression text handed to
// the host. This module is the tower. A `num` is a CANONICAL decimal string
// — `[-]d[.ddd]e[-]E`, one nonzero leading digit, no trailing zeros, zero is
// `0e0` — so value-equivalence is string equality (`num:equiv` is the honest
// form of that law: `314e0` ≡ `3.14e2` ≡ `0.314e3`).
//
// Taint (the 330_089 mechanism applied to numbers — "tainted for real"):
//   <external!>  issued by `ingest`/`ingest-owned` on outside text. Marks the
//                value as unvalidated input; nothing but `parse` may consume
//                it. `ingest-owned` additionally discharges <allocated!> —
//                the buffer becomes num-owned.
//   <exact!>     issued by `parse`/`lit` and every op. A REAL obligation:
//                ops consume <!exact> linearly (each operand dies into the
//                result — `dup` is the lawful fork), `free` discharges by
//                deallocating, `render` swaps it to <allocated!> for print.
//                A bare `string` cannot reach `add` — it must pass the gate.
//
//   The marks are phantoms: zero runtime cost, all checking at compile time.
//   At runtime a num is just a []const u8 the module owns; every num-owned
//   buffer is allocator-freed exactly once, at consume time.
//
// Arithmetic: mantissa is an arbitrary-precision integer (std.math.big), the
// exponent is decimal. Exact for +,-,*,pow; `div`/`sqrt` take an explicit
// significant-digit `prec` because a decimal expansion need not terminate.
//
// Port source: isa-physics `plex/lib/symbolic/arbitrary_precision.py`
// (sign + decimal-position + digit nibbles) and the ISAR QuantityKernel
// MetricExpr exact-rational layer; the quantity/dimension half lives in
// std/quantity.

~import std/io

const std = @import("std");
const big = std.math.big;
const BI = std.math.big.int.Managed;
const Limb = std.math.big.Limb;
const DoubleLimb = std.math.big.DoubleLimb;

// ============================================================================
// Canonical decimal: value = (neg ? -1 : 1) * m * 10^e, m >= 0, no trailing
// zeros in m unless m == 0. Canon strings: "0e0" | "[-]D[.DDD]e[-]E".
// ============================================================================

const Dec = struct {
    neg: bool,
    m: BI,
    e: i64,
};

fn decInit(alloc: std.mem.Allocator, m_val: i64, e: i64) !Dec {
    const m = try BI.initSet(alloc, m_val);
    return .{ .neg = m_val < 0, .m = m, .e = e };
}

fn decDeinit(d: *Dec) void {
    d.m.deinit();
}

// Parse "[-]DDD[.DDD][eE[-]DDD]" into a Dec. Caller owns the result.
fn decParse(alloc: std.mem.Allocator, s: []const u8) !Dec {
    var t = std.mem.trim(u8, s, " \t\r\n");
    if (t.len == 0) return error.BadNumber;

    var neg = false;
    if (t[0] == '+' or t[0] == '-') {
        neg = t[0] == '-';
        t = t[1..];
    }
    if (t.len == 0) return error.BadNumber;

    var sci: i64 = 0;
    if (std.mem.indexOfAny(u8, t, "eE")) |ei| {
        const es = t[ei + 1 ..];
        t = t[0..ei];
        if (es.len == 0) return error.BadNumber;
        sci = std.fmt.parseInt(i64, es, 10) catch return error.BadNumber;
    }

    var frac_len: i64 = 0;
    var digits = std.ArrayList(u8).initCapacity(alloc, t.len) catch return error.OutOfMemory;
    defer digits.deinit(alloc);

    var seen_dot = false;
    var seen_digit = false;
    for (t) |c| {
        if (c == '.') {
            if (seen_dot) return error.BadNumber;
            seen_dot = true;
            continue;
        }
        if (!std.ascii.isDigit(c)) return error.BadNumber;
        try digits.append(alloc, c);
        seen_digit = true;
        if (seen_dot) frac_len += 1;
    }
    if (!seen_digit) return error.BadNumber;

    return decFromDigits(alloc, digits.items, sci - frac_len, neg);
}

// Build canonical Dec from a raw digit string and base-10 exponent.
// Strips leading zeros (exp unaffected) and trailing zeros (exp += count).
fn decFromDigits(alloc: std.mem.Allocator, raw: []const u8, e: i64, neg: bool) !Dec {
    var start: usize = 0;
    while (start < raw.len and raw[start] == '0') start += 1;
    var end: usize = raw.len;
    while (end > start and raw[end - 1] == '0') end -= 1;

    if (start == end) {
        // canonical zero
        const m = try BI.initSet(alloc, 0);
        return .{ .neg = false, .m = m, .e = 0 };
    }

    const stripped_trailing = raw.len - end;
    var m = try biFromDigits(alloc, raw[start..end]);
    errdefer m.deinit();
    return .{ .neg = neg, .m = m, .e = e + @as(i64, @intCast(stripped_trailing)) };
}

// Render a Dec to canonical text. Caller owns the returned slice.
fn decToString(alloc: std.mem.Allocator, d: *const Dec) ![]u8 {
    if (d.m.eqlZero()) return alloc.dupe(u8, "0e0");

    const ds = try biToDigits(alloc, &d.m);
    defer alloc.free(ds);

    // adjusted exponent: value = ds[0].ds[1..] * 10^adj
    const adj: i64 = d.e + @as(i64, @intCast(ds.len)) - 1;

    var out = std.ArrayList(u8).initCapacity(alloc, ds.len + 24) catch return error.OutOfMemory;
    errdefer out.deinit(alloc);
    if (d.neg) try out.append(alloc, '-');
    try out.append(alloc, ds[0]);
    if (ds.len > 1) {
        try out.append(alloc, '.');
        try out.appendSlice(alloc, ds[1..]);
    }
    try out.append(alloc, 'e');
    var buf: [24]u8 = undefined;
    const es = std.fmt.bufPrint(&buf, "{d}", .{adj}) catch unreachable;
    try out.appendSlice(alloc, es);
    return out.toOwnedSlice(alloc);
}

// r = a * 10^k (k >= 0), into a fresh Managed.
fn pow10(alloc: std.mem.Allocator, k: i64) !BI {
    if (k <= 0) return BI.initSet(alloc, 1);
    var ten = try BI.initSet(alloc, 10);
    defer ten.deinit();
    return biPowFast(alloc, &ten, @intCast(k));
}

// r = a + b. Caller owns result.
fn decAdd(alloc: std.mem.Allocator, a: *const Dec, b: *const Dec) !Dec {
    const e_min = @min(a.e, b.e);
    var am = try a.m.clone();
    defer am.deinit();
    var bm = try b.m.clone();
    defer bm.deinit();
    if (a.e > e_min) {
        var p = try pow10(alloc, a.e - e_min);
        defer p.deinit();
        try mulFast(&am, &am, &p);
    }
    if (b.e > e_min) {
        var p = try pow10(alloc, b.e - e_min);
        defer p.deinit();
        try mulFast(&bm, &bm, &p);
    }
    if (a.neg) am.negate();
    if (b.neg) bm.negate();
    var r = try BI.init(alloc);
    defer r.deinit();
    try r.add(&am, &bm);

    const rneg = !r.isPositive();
    var m_abs = try r.clone();
    m_abs.abs();
    defer m_abs.deinit();
    const ds = try biToDigits(alloc, &m_abs);
    defer alloc.free(ds);
    return decFromDigits(alloc, ds, e_min, rneg);
}


// ---------------------------------------------------------------------------
// Limb-level multiplication — own algorithm, not Zig's primitives.
// std.math.big Managed.mul is schoolbook O(n^2) unconditionally; below
// KARA_MIN limbs it stays the path (proven, small), above it the Karatsuba
// split takes over: z0=x0y0, z2=x1y1, z1=(x0+x1)(y0+y1)-z0-z2. Recursion
// allocs ride a per-call arena — thousands of small scratch frees are one
// deinit. Measured threshold: 016_num_precision_race.
// ---------------------------------------------------------------------------
const KARA_MIN: usize = 24;

fn ltrim(x: []Limb) []Limb {
    var n = x.len;
    while (n > 0 and x[n - 1] == 0) n -= 1;
    return x[0..n];
}

// x + y, normalized (little-endian, no leading zero limbs). empty == 0.
fn addL(alloc: std.mem.Allocator, x: []const Limb, y: []const Limb) ![]Limb {
    const a = if (x.len >= y.len) x else y;
    const b = if (x.len >= y.len) y else x;
    var r = try alloc.alloc(Limb, a.len + 1);
    var carry: Limb = 0;
    var i: usize = 0;
    while (i < b.len) : (i += 1) {
        const s = @addWithOverflow(a[i], b[i]);
        const s2 = @addWithOverflow(s[0], carry);
        r[i] = s2[0];
        carry = @as(Limb, s[1]) + s2[1];
    }
    while (i < a.len) : (i += 1) {
        const s = @addWithOverflow(a[i], carry);
        r[i] = s[0];
        carry = s[1];
    }
    r[a.len] = carry;
    return ltrim(r);
}

// x - y, requires x >= y. normalized.
fn subL(alloc: std.mem.Allocator, x: []const Limb, y: []const Limb) ![]Limb {
    var r = try alloc.alloc(Limb, x.len);
    var borrow: Limb = 0;
    var i: usize = 0;
    while (i < x.len) : (i += 1) {
        const yi: Limb = if (i < y.len) y[i] else 0;
        const d = @subWithOverflow(x[i], yi);
        const d2 = @subWithOverflow(d[0], borrow);
        r[i] = d2[0];
        borrow = @as(Limb, d[1]) + d2[1];
    }
    return ltrim(r);
}

// dst += src in place. dst must have room (the caller's bound guarantees
// the sum fits; carry past dst.len is a proof violation -> panic).
fn addInto(dst: []Limb, src: []const Limb) void {
    var carry: Limb = 0;
    var i: usize = 0;
    while (i < src.len) : (i += 1) {
        const s = @addWithOverflow(dst[i], src[i]);
        const s2 = @addWithOverflow(s[0], carry);
        dst[i] = s2[0];
        carry = @as(Limb, s[1]) + s2[1];
    }
    while (carry != 0) : (i += 1) {
        if (i >= dst.len) @panic("std/num kara: carry overflow");
        const s = @addWithOverflow(dst[i], carry);
        dst[i] = s[0];
        carry = s[1];
    }
}

fn mulSB(alloc: std.mem.Allocator, x: []const Limb, y: []const Limb) ![]Limb {
    if (x.len == 0 or y.len == 0) return alloc.alloc(Limb, 0);
    var r = try alloc.alloc(Limb, x.len + y.len);
    @memset(r, 0);
    var i: usize = 0;
    while (i < x.len) : (i += 1) {
        var carry: DoubleLimb = 0;
        var j: usize = 0;
        while (j < y.len) : (j += 1) {
            const t = @as(DoubleLimb, x[i]) * y[j] + r[i + j] + carry;
            r[i + j] = @truncate(t);
            carry = t >> @bitSizeOf(Limb);
        }
        var k = i + y.len;
        while (carry != 0) {
            const t = @as(DoubleLimb, r[k]) + carry;
            r[k] = @truncate(t);
            carry = t >> @bitSizeOf(Limb);
            k += 1;
        }
    }
    return ltrim(r);
}

// karatsuba over the arena. x.len >= y.len is not required; both orders work.
fn mulL(alloc: std.mem.Allocator, xin: []const Limb, yin: []const Limb) ![]Limb {
    var x = xin;
    var y = yin;
    if (x.len < y.len) {
        const t = x;
        x = y;
        y = t;
    }
    if (y.len == 0) return alloc.alloc(Limb, 0);
    if (x.len <= KARA_MIN or y.len <= KARA_MIN) return mulSB(alloc, x, y);

    const m = x.len / 2;
    const x0 = x[0..m];
    const x1 = x[m..];
    const y0 = y[0..@min(m, y.len)];
    const y1 = if (y.len > m) y[m..] else y[0..0];

    const z0 = try mulL(alloc, x0, y0);
    const z2 = try mulL(alloc, x1, y1);
    const sx = try addL(alloc, x0, x1);
    const sy = try addL(alloc, y0, y1);
    const zt = try mulL(alloc, sx, sy);
    const w = try subL(alloc, zt, z0);
    const z1 = try subL(alloc, w, z2);

    var r = try alloc.alloc(Limb, x.len + y.len);
    @memset(r, 0);
    @memcpy(r[0..z0.len], z0);
    addInto(r[m..], z1);
    addInto(r[2 * m ..], z2);
    return ltrim(r);
}


// ---------------------------------------------------------------------------
// Limb-level division — own algorithm, not Zig's primitives.
// Small divisors: Knuth Algorithm D (TAOCP 4.3.1) over normalized limbs —
// the only hardware divide used is 2-by-1 limb estimation. Large divisors
// (>= NEWTON_MIN limbs): one reciprocal R = floor(beta^(3n)/B) by Newton
// iteration R' = 2R - (B*R^2 >> 3n limbs), seeded from B's top two limbs and
// converged to |R' - R| <= 1, then bounded correction. The whole quotient is
// (A*R) >> 3n limbs in one multiply when A fits 3n limbs; wider dividends
// take ~n quotient limbs per step off a 2n-limb window. Prototyped and
// differential-tested before landing — see tests/benchmarks/016. Threshold
// measured on the same rig.
// ---------------------------------------------------------------------------
const NEWTON_MIN: usize = 512;

fn cmpL(x: []const Limb, y: []const Limb) i8 {
    const lx = ltrimc(x).len;
    const ly = ltrimc(y).len;
    if (lx != ly) return if (lx < ly) -1 else 1;
    var i = lx;
    while (i > 0) {
        i -= 1;
        if (x[i] != y[i]) return if (x[i] < y[i]) -1 else 1;
    }
    return 0;
}

fn ltrimc(x: []const Limb) []const Limb {
    var n = x.len;
    while (n > 0 and x[n - 1] == 0) n -= 1;
    return x[0..n];
}

// x << (s bits), s in 0..63. Returns normalized.
fn shlBitsL(alloc: std.mem.Allocator, x: []const Limb, s: u6) ![]Limb {
    if (x.len == 0) return alloc.alloc(Limb, 0);
    var r = try alloc.alloc(Limb, x.len + 1);
    var carry: Limb = 0;
    for (x, 0..) |v, i| {
        r[i] = (v << s) | carry;
        carry = if (s == 0) 0 else v >> @as(u6, @intCast(64 - @as(u7, s)));
    }
    r[x.len] = carry;
    return ltrim(r);
}

// x >> (s bits), s in 0..63. Returns normalized.
fn shrBitsL(alloc: std.mem.Allocator, x: []const Limb, s: u6) ![]Limb {
    if (x.len == 0) return alloc.alloc(Limb, 0);
    var r = try alloc.alloc(Limb, x.len);
    var i = x.len;
    var carry: Limb = 0;
    while (i > 0) {
        i -= 1;
        r[i] = (x[i] >> s) | carry;
        carry = if (s == 0) 0 else x[i] << @as(u6, @intCast(64 - @as(u7, s)));
    }
    return ltrim(r);
}

// dst -= src. Requires dst >= src (proof violation -> panic).
fn subInto(dst: []Limb, src: []const Limb) void {
    var borrow: Limb = 0;
    var i: usize = 0;
    while (i < dst.len) : (i += 1) {
        const sv: Limb = if (i < src.len) src[i] else 0;
        const d = @subWithOverflow(dst[i], sv);
        const d2 = @subWithOverflow(d[0], borrow);
        dst[i] = d2[0];
        borrow = d[1] + d2[1];
    }
    if (borrow != 0) @panic("std/num div: subInto borrow out");
}

// x << limbs: dst[0..shift] = 0, dst[shift..] = x.
fn limbShift(alloc: std.mem.Allocator, x: []const Limb, shift: usize) ![]Limb {
    var r = try alloc.alloc(Limb, x.len + shift);
    @memset(r[0..shift], 0);
    @memcpy(r[shift..], x);
    return r;
}

// x / d for single-limb d -> {q, r}. r is a limb.
const DivQR = struct { q: []Limb, r: []Limb };

fn div1L(alloc: std.mem.Allocator, x: []const Limb, d: Limb) error{OutOfMemory}!struct { q: []Limb, r: Limb } {
    var q = try alloc.alloc(Limb, x.len);
    var rem: DoubleLimb = 0;
    var i = x.len;
    while (i > 0) {
        i -= 1;
        const cur = (rem << 64) | x[i];
        q[i] = @intCast(cur / d);
        rem = cur % d;
    }
    return .{ .q = ltrim(q), .r = @intCast(rem) };
}

// Knuth Algorithm D, a >= b > 0, b.len >= 2.
fn divSB(alloc: std.mem.Allocator, a_in: []const Limb, b_in: []const Limb) error{OutOfMemory}!DivQR {
    const n = b_in.len;
    const s: u6 = @intCast(@clz(b_in[n - 1]));
    const v = try shlBitsL(alloc, b_in, s);
    const un0 = try shlBitsL(alloc, a_in, s);
    var u = try alloc.alloc(Limb, un0.len + 1);
    @memcpy(u[0..un0.len], un0);
    u[un0.len] = 0;

    const m = u.len - v.len; // quotient limb count
    var q = try alloc.alloc(Limb, m);
    var j = m;
    while (j > 0) {
        j -= 1;
        const hi: DoubleLimb = (@as(DoubleLimb, u[j + n]) << 64) | u[j + n - 1];
        var qhat: DoubleLimb = hi / v[n - 1];
        var rhat: DoubleLimb = hi % v[n - 1];
        // qhat >= beta folds the clamp into the loop (Knuth D3). The
        // rhat < beta guard is load-bearing: with rhat >= beta the test is
        // certainly false AND (rhat << 64) would wrap u128 — Zig << truncates
        // silently, which produced qhat one too small when qhat0 == beta.
        while (qhat >= (@as(DoubleLimb, 1) << 64) or
            (n >= 2 and rhat < (@as(DoubleLimb, 1) << 64) and
                qhat * v[n - 2] > ((rhat << 64) | u[j + n - 2])))
        {
            qhat -= 1;
            rhat += v[n - 1];
        }
        const qh: Limb = @intCast(qhat);

        // u[j..j+n] -= qh * v
        var mul_carry: DoubleLimb = 0;
        var sub_carry: Limb = 0;
        var i: usize = 0;
        while (i < n) : (i += 1) {
            const prod = @as(DoubleLimb, qh) * v[i] + mul_carry;
            mul_carry = prod >> 64;
            const d1 = @subWithOverflow(u[j + i], @as(Limb, @truncate(prod)));
            const d2 = @subWithOverflow(d1[0], sub_carry);
            u[j + i] = d2[0];
            sub_carry = d1[1] + d2[1];
        }
        const d1 = @subWithOverflow(u[j + n], @as(Limb, @truncate(mul_carry)));
        const d2 = @subWithOverflow(d1[0], sub_carry);
        u[j + n] = d2[0];
        const neg = d1[1] + d2[1] != 0;

        if (neg) {
            // rare: qhat was one too big; add v back.
            q[j] = qh - 1;
            var carry: Limb = 0;
            i = 0;
            while (i < n) : (i += 1) {
                const a1 = @addWithOverflow(u[j + i], v[i]);
                const a2 = @addWithOverflow(a1[0], carry);
                u[j + i] = a2[0];
                carry = a1[1] + a2[1];
            }
            u[j + n] +%= carry;
        } else {
            q[j] = qh;
        }
    }
    const rl = try shrBitsL(alloc, u[0..n], s);
    return .{ .q = ltrim(q), .r = rl };
}

// R = floor(beta^(3n)/B) for n-limb B, top limb nonzero.
// Newton R' = 2R - (B*R^2 >> 3n limbs). Seed: beta^6 / top-2-limbs of B,
// shifted to ~2n limbs — relative error < 1/beta, squares per step.
// Terminates on |R' - R| <= 1, then bounded correction to the exact floor.
fn recipL(alloc: std.mem.Allocator, b: []const Limb) error{OutOfMemory}![]Limb {
    const n = b.len;
    std.debug.assert(n >= 2 and b[n - 1] != 0);
    if (n <= 4) {
        // exact: beta^(3n) / B via Knuth D — numerator is 1 followed by 3n limbs of 0.
        var num = try alloc.alloc(Limb, 3 * n + 1);
        @memset(num, 0);
        num[3 * n] = 1;
        const qr = try divAnyL(alloc, num, b);
        return qr.q;
    }
    // stage sizes: 4, 8, ..., n. R_i = floor(beta^(3i)/B_i) on the top i
    // limbs; stage 2i seeds R_i << 2i limbs (beta^(3·2i)/B_2i ~ R_i·beta^2i)
    // and Newton converges in ~2 steps. Base: exact small division.
    var stage: usize = 4;
    const bt4 = b[n - stage ..];
    var num0 = try alloc.alloc(Limb, 3 * stage + 1);
    @memset(num0, 0);
    num0[3 * stage] = 1;
    const qr0 = try divSB(alloc, num0, bt4);
    var r = qr0.q;
    while (stage < n) {
        const ns = @min(2 * stage, n);
        const bsub = b[n - ns ..];
        var rseed = try limbShift(alloc, r, 2 * (ns - stage));
        // Newton at stage-ns size: X' = 2X - (Bsub*X^2 >> 3*ns limbs)
        var it: usize = 0;
        while (it < 64) : (it += 1) {
            const bx = try mulL(alloc, bsub, rseed);
            const bx2 = try mulL(alloc, bx, rseed);
            const t2 = ltrimc(bx2)[@min(3 * ns, ltrimc(bx2).len)..];
            var r2v = try alloc.alloc(Limb, rseed.len + 1);
            @memset(r2v, 0);
            @memcpy(r2v[0..rseed.len], rseed);
            addInto(r2v, rseed);
            if (cmpL(r2v, t2) < 0) @panic("std/num div: newton underflow");
            const r2 = try subL(alloc, r2v, t2);
            const diff = if (cmpL(r2, rseed) >= 0) try subL(alloc, r2, rseed) else try subL(alloc, rseed, r2);
            rseed = r2;
            if (cmpL(diff, &[_]Limb{1}) <= 0) break;
        }
        r = rseed;
        stage = ns;
    }


    // bounded correction to the exact floor: 0 <= (beta^(3n) - B*R) < 2*B.
    var t = try alloc.alloc(Limb, 3 * n + 1);
    @memset(t, 0);
    t[3 * n] = 1;
    var corr: usize = 0;
    while (true) {
        const br = try mulL(alloc, b, r);
        const c = cmpL(br, t);
        if (c > 0) {
            // R too big
            r = try subL(alloc, r, &[_]Limb{1});
            corr += 1;
        } else {
            const br1 = try addL(alloc, br, b);
            if (cmpL(br1, t) <= 0) {
                r = try addL(alloc, r, &[_]Limb{1});
                corr += 1;
            } else break;
        }
        if (corr > 4) @panic("std/num div: recip correction bound exceeded");
    }
    return ltrim(r);
}

// a / b over limbs, any sizes. q and r normalized; a < b -> {0, a}.
fn divAnyL(alloc: std.mem.Allocator, a_in: []const Limb, b_in: []const Limb) error{OutOfMemory}!DivQR {
    const b = ltrimc(b_in);
    const a = ltrimc(a_in);
    if (b.len == 0) @panic("std/num div: division by zero");
    if (cmpL(a, b) < 0) {
        const z = try alloc.alloc(Limb, 0);
        return .{ .q = z, .r = try limbShift(alloc, a, 0) };
    }
    if (b.len == 1) {
        const qr = try div1L(alloc, a, b[0]);
        var rr = try alloc.alloc(Limb, 1);
        rr[0] = qr.r;
        return .{ .q = qr.q, .r = ltrim(rr) };
    }
    // Newton pays only when the reciprocal amortizes over a huge quotient:
    // measured 016 + divbench, recipL costs ~4-14 mulL at ~5n limbs while
    // schoolbook does (a.len - n) passes at n limbs — schoolbook wins at
    // every operand size we exercise (<= 3000 limbs). The gate below is the
    // documented ceiling: Newton needs short products (top-limb-only
    // B*R^2 per iteration) before it earns its slot.
    if (b.len < NEWTON_MIN or a.len < 3 * b.len) return divSB(alloc, a, b);

    const n = b.len;
    const x = try recipL(alloc, b);

    if (a.len <= 3 * n) {
        // one-shot: q = (A * R) >> 3n limbs
        const p = try mulL(alloc, a, x);
        var qhat = try limbShift(alloc, ltrimc(p)[@min(3 * n, ltrimc(p).len)..], 0);
        const qb = try mulL(alloc, qhat, b);
        var r = try subL(alloc, a, qb);
        var corr: usize = 0;
        while (cmpL(r, b) >= 0) {
            r = try subL(alloc, r, b);
            qhat = try addL(alloc, qhat, &[_]Limb{1});
            corr += 1;
            if (corr > 3) @panic("std/num div: one-shot correction bound exceeded");
        }
        return .{ .q = ltrim(qhat), .r = ltrim(r) };
    }

    // chunked: ~n quotient limbs per step off the top 2n limbs of u.
    var q = try alloc.alloc(Limb, 0);
    var u = try limbShift(alloc, a, 0);
    while (cmpL(u, b) >= 0) {
        const un = ltrimc(u).len;
        const w = @min(2 * n, un);
        const m = un - w;
        const uu = ltrimc(u[m..]);
        var qhat: []Limb = undefined;
        if (uu.len <= n) {
            const qr = try divSB(alloc, uu, b);
            qhat = qr.q;
        } else {
            const p = try mulL(alloc, uu, x);
            qhat = try limbShift(alloc, ltrimc(p)[@min(3 * n, ltrimc(p).len)..], 0);
            if (qhat.len == 0) {
                const qr = try divSB(alloc, uu, b);
                qhat = qr.q;
            }
        }
        // r = u - qhat*B*beta^m, correcting down on negative.
        var qb = try mulL(alloc, qhat, b);
        var qbm = try limbShift(alloc, qb, m);
        var corr: usize = 0;
        while (cmpL(u, qbm) < 0) {
            qhat = try subL(alloc, qhat, &[_]Limb{1});
            qb = try mulL(alloc, qhat, b);
            qbm = try limbShift(alloc, qb, m);
            corr += 1;
            if (corr > 3) @panic("std/num div: chunk correction bound exceeded");
        }
        var r = try subL(alloc, u, qbm);
        while (cmpL(r, try limbShift(alloc, b, m)) >= 0 and corr <= 3) {
            const bm = try limbShift(alloc, b, m);
            r = try subL(alloc, r, bm);
            qhat = try addL(alloc, qhat, &[_]Limb{1});
            corr += 1;
        }
        if (corr > 3) @panic("std/num div: chunk correction bound exceeded");
        const qm = try limbShift(alloc, qhat, m);
        q = try addL(alloc, q, qm);
        u = r;
    }
    return .{ .q = ltrim(q), .r = ltrim(u) };
}

// ---------------------------------------------------------------------------
// Limb-level integer square root — recursive-seed Newton, own algorithm
// dogfooding divAnyL. Seed: isqrt(top half) + 1 shifted (dropped limbs * 32
// bits) — a strict overestimate, so Newton descends monotonically and the
// fixup needs <= a few unit steps. Prototyped + differential-tested vs
// math.isqrt on 6000 randomized shapes incl. unnormalized top limbs.
// ---------------------------------------------------------------------------

// floor(isqrt(x)) for x: u128, Newton with monotone descent from a
// bit-length overestimate.
fn isqrt128(x: u128) u64 {
    if (x == 0) return 0;
    // bits can be 128 for x >= 2^127 — wider than u7 holds.
    const bits: u8 = @intCast(128 - @clz(x));
    var s: u128 = @as(u128, 1) << @as(u7, @intCast((bits + 1) / 2 + 1));
    while (true) {
        const s2 = (s + x / s) >> 1;
        if (s2 >= s) break;
        s = s2;
    }
    while (s * s > x) s -= 1;
    while ((s + 1) * (s + 1) <= x) s += 1;
    return @intCast(s);
}

// floor(isqrt(a)) over limbs.
fn isqrtL(alloc: std.mem.Allocator, a_in: []const Limb) error{OutOfMemory}![]Limb {
    const a = ltrimc(a_in);
    const n = a.len;
    if (n == 0) return alloc.alloc(Limb, 0);
    if (n <= 2) {
        var v: u128 = 0;
        var i = a.len;
        while (i > 0) {
            i -= 1;
            v = (v << 64) | a[i];
        }
        const r = isqrt128(v);
        var out = try alloc.alloc(Limb, 1);
        out[0] = r;
        return ltrim(out);
    }
    // recursive seed: isqrt(top ceil(n/2) limbs) + 1, shifted (n - h) * 32
    // bits — A < (H+1)*beta^drop so sqrt(A) < (isqrt(H)+1)*2^(32*drop).
    const h = (n + 1) / 2;
    const drop = n - h;
    const s1 = try isqrtL(alloc, a[drop..]);
    const s1p = try addL(alloc, s1, &[_]Limb{1});
    const sh: u6 = @intCast((32 * drop) % 64);
    const sl = try shlBitsL(alloc, s1p, sh);
    var cur: []Limb = try limbShift(alloc, sl, drop / 2);
    var steps: usize = 0;
    while (steps < 128) : (steps += 1) {
        const qr = try divAnyL(alloc, a, cur);
        var nxt = try addL(alloc, qr.q, cur);
        nxt = (try shrBitsL(alloc, nxt, 1));
        if (cmpL(nxt, cur) >= 0) break;
        cur = nxt;
    }
    var corr: usize = 0;
    while (true) {
        const c2 = try mulL(alloc, cur, cur);
        if (cmpL(c2, a) <= 0) {
            const cp1 = try addL(alloc, cur, &[_]Limb{1});
            const c2p = try mulL(alloc, cp1, cp1);
            if (cmpL(c2p, a) > 0) break;
            cur = cp1;
        } else {
            cur = try subL(alloc, cur, &[_]Limb{1});
        }
        corr += 1;
        if (corr > 4) @panic("std/num sqrt: correction bound exceeded");
    }
    return ltrim(cur);
}

// ---------------------------------------------------------------------------
// Radix conversion, both directions divide-and-conquer — replaces Zig's
// per-digit quadratic setString/toString (measured 231ms + 35ms on the
// 47713-digit w2 operand). Below RADIX_DNC_MIN digits the schoolbook paths
// chunk 19 digits per limb step.
// ---------------------------------------------------------------------------

const RADIX_DNC_MIN: usize = 600;

const POW10_U64 = [20]Limb{
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000,
    1000000000, 10000000000, 100000000000, 1000000000000,
    10000000000000, 100000000000000, 1000000000000000,
    10000000000000000, 100000000000000000, 1000000000000000000,
    10000000000000000000,
};

// m = x*s + c in one pass (s, c single limbs).
fn mulAddSmall(alloc: std.mem.Allocator, x: []const Limb, s: Limb, c: Limb) error{OutOfMemory}![]Limb {
    var r = try alloc.alloc(Limb, x.len + 1);
    var carry: DoubleLimb = c;
    for (x, 0..) |v, i| {
        const prod = @as(DoubleLimb, v) * s + carry;
        r[i] = @truncate(prod);
        carry = prod >> 64;
    }
    r[x.len] = @intCast(carry);
    return ltrim(r);
}

// digits -> limbs, schoolbook: 19-digit chunks, m = m*10^chunk + c.
fn digitsToLimbsSB(alloc: std.mem.Allocator, digs: []const u8) error{OutOfMemory}![]Limb {
    var m: []Limb = try alloc.alloc(Limb, 0);
    var i: usize = 0;
    while (i < digs.len) {
        const chunk = @min(19, digs.len - i);
        var c: Limb = 0;
        for (digs[i .. i + chunk]) |ch| c = c * 10 + (ch - '0');
        m = try mulAddSmall(alloc, m, POW10_U64[chunk], c);
        i += chunk;
    }
    return ltrim(m);
}

// limbs -> digits, schoolbook: divmod by 10^19, little-endian chunks.
fn limbsToDigitsSB(alloc: std.mem.Allocator, x_in: []const Limb) error{OutOfMemory}![]u8 {
    if (x_in.len == 0) return alloc.dupe(u8, "0");
    var rem = try limbShift(alloc, x_in, 0); // scratch copy
    // x < 2^(64*len) -> at most 20*len digits -> chunks bound len*20 + 19.
    var buf = try alloc.alloc(u8, x_in.len * 20 + 19);
    var n_chunks: usize = 0;
    while (rem.len > 0) {
        const qr = try div1L(alloc, rem, POW10_U64[19]);
        rem = qr.q;
        var c = qr.r;
        var k: usize = 19;
        const base = n_chunks * 19;
        while (k > 0) : (k -= 1) {
            buf[base + k - 1] = '0' + @as(u8, @intCast(c % 10));
            c /= 10;
        }
        n_chunks += 1;
    }
    // chunks are least-significant-first: reverse by 19-digit blocks,
    // then strip leading zeros of the most significant block.
    var out = try alloc.alloc(u8, n_chunks * 19);
    var i: usize = 0;
    while (i < n_chunks) : (i += 1) {
        @memcpy(out[i * 19 .. i * 19 + 19],
            buf[(n_chunks - 1 - i) * 19 .. (n_chunks - i) * 19]);
    }
    var start: usize = 0;
    while (start + 1 < out.len and out[start] == '0') start += 1;
    return out[start..];
}

// 10^k over limbs by binary exponentiation on mulL.
fn pow10L(alloc: std.mem.Allocator, k: usize) error{OutOfMemory}![]Limb {
    var r: []Limb = try alloc.dupe(Limb, &[_]Limb{1});
    var b: []Limb = try alloc.dupe(Limb, &[_]Limb{10});
    var e = k;
    while (e > 0) {
        if (e & 1 == 1) r = try mulL(alloc, r, b);
        if (e > 1) b = try mulL(alloc, b, b);
        e >>= 1;
    }
    return ltrim(r);
}

// digits -> limbs: val(hi)*10^lo.len + val(lo), recursively.
fn digitsToLimbs(alloc: std.mem.Allocator, digs: []const u8) error{OutOfMemory}![]Limb {
    if (digs.len == 0) return alloc.alloc(Limb, 0);
    if (digs.len <= RADIX_DNC_MIN) return digitsToLimbsSB(alloc, digs);
    const lo_len = digs.len / 2;
    const hi = digs[0 .. digs.len - lo_len];
    const lo = digs[digs.len - lo_len ..];
    const p10 = try pow10L(alloc, lo_len);
    const lohi = try digitsToLimbs(alloc, hi);
    const lolo = try digitsToLimbs(alloc, lo);
    const prod = try mulL(alloc, lohi, p10);
    return addL(alloc, prod, lolo);
}

// limbs -> digits: split x = q*10^split + r, recurse, pad r to `split`.
fn limbsToDigits(alloc: std.mem.Allocator, x_in: []const Limb) error{OutOfMemory}![]u8 {
    const x = ltrimc(x_in);
    if (x.len == 0) return alloc.dupe(u8, "0");
    // decimal-digit estimate: bits*log10(2), upper bound, off by <=1.
    const bits: usize = 64 * (x.len - 1) + (64 - @clz(x[x.len - 1]));
    const nd: usize = @as(usize, @intFromFloat(@floor(@as(f64, @floatFromInt(bits)) * 0.3010299956639812))) + 1;
    if (nd <= RADIX_DNC_MIN) return limbsToDigitsSB(alloc, x);
    const split = nd / 2;
    const p10 = try pow10L(alloc, split);
    if (cmpL(x, p10) < 0) return limbsToDigitsSB(alloc, x); // estimate edge (x < 10^split: only tiny cases)
    const qr = try divAnyL(alloc, x, p10);
    const hi_s = try limbsToDigits(alloc, qr.q);
    const lo_s = try limbsToDigits(alloc, qr.r);
    var out = try alloc.alloc(u8, hi_s.len + split);
    @memcpy(out[0..hi_s.len], hi_s);
    if (lo_s.len > split) @panic("std/num radix: low half overflow");
    const pad = split - lo_s.len;
    @memset(out[hi_s.len .. hi_s.len + pad], '0');
    @memcpy(out[hi_s.len + pad ..], lo_s);
    return out;
}

// BI wrapper: decimal digit string of x's magnitude (caller owns).
fn biToDigits(alloc: std.mem.Allocator, x: *const BI) ![]u8 {
    var arena = std.heap.ArenaAllocator.init(alloc);
    defer arena.deinit();
    const ds = try limbsToDigits(arena.allocator(), x.toConst().limbs);
    return try alloc.dupe(u8, ds);
}

// BI from limbs (positive magnitude).
fn biFromLimbs(alloc: std.mem.Allocator, r: []const Limb) !BI {
    var ss = try BI.initCapacity(alloc, @max(r.len, 1));
    errdefer ss.deinit();
    if (r.len == 0) {
        ss.limbs[0] = 0;
        ss.setLen(1);
    } else {
        @memcpy(ss.limbs[0..r.len], r);
        ss.setLen(r.len);
    }
    ss.setSign(true);
    return ss;
}

// decimal digit string -> BI (magnitude), D&C.
fn biFromDigits(alloc: std.mem.Allocator, digs: []const u8) !BI {
    var arena = std.heap.ArenaAllocator.init(alloc);
    defer arena.deinit();
    const lm = try digitsToLimbs(arena.allocator(), digs);
    return biFromLimbs(alloc, lm);
}

// Managed wrapper: s = floor(sqrt(x)); x must be nonnegative — matches
// Managed.sqrt semantics on the magnitude lane.
fn sqrtFast(s: *BI, x: *const BI) !void {
    const alloc = s.allocator;
    std.debug.assert(x.toConst().positive);
    var arena = std.heap.ArenaAllocator.init(alloc);
    defer arena.deinit();
    const r = try isqrtL(arena.allocator(), x.toConst().limbs);

    var ss = try BI.initCapacity(alloc, @max(r.len, 1));
    errdefer ss.deinit();
    if (r.len == 0) {
        ss.limbs[0] = 0;
        ss.setLen(1);
    } else {
        @memcpy(ss.limbs[0..r.len], r);
        ss.setLen(r.len);
    }
    ss.setSign(true);
    s.deinit();
    s.* = ss;
}

// Managed wrapper: truncated division, sign(q) = a.sign != b.sign,
// sign(r) = a.sign — matches Managed.divTrunc exactly.
fn divFast(q: *BI, r: *BI, a: *const BI, b: *const BI) !void {
    const alloc = q.allocator;
    if (b.eqlZero()) @panic("division by zero");
    var arena = std.heap.ArenaAllocator.init(alloc);
    defer arena.deinit();
    const qr = try divAnyL(arena.allocator(), a.toConst().limbs, b.toConst().limbs);

    var qq = try BI.initCapacity(alloc, @max(qr.q.len, 1));
    errdefer qq.deinit();
    if (qr.q.len == 0) {
        qq.limbs[0] = 0;
        qq.setLen(1);
        qq.setSign(true);
    } else {
        @memcpy(qq.limbs[0..qr.q.len], qr.q);
        qq.setLen(qr.q.len);
        qq.setSign(a.toConst().positive == b.toConst().positive);
    }
    var rr = try BI.initCapacity(alloc, @max(qr.r.len, 1));
    errdefer rr.deinit();
    if (qr.r.len == 0) {
        rr.limbs[0] = 0;
        rr.setLen(1);
        rr.setSign(true);
    } else {
        @memcpy(rr.limbs[0..qr.r.len], qr.r);
        rr.setLen(qr.r.len);
        rr.setSign(a.toConst().positive);
    }
    q.deinit();
    q.* = qq;
    r.deinit();
    r.* = rr;
}

// Managed wrapper: below cutoff Zig's schoolbook stays (proven path);
// above it our limbs run under one arena.
fn mulBI(alloc: std.mem.Allocator, a: *const BI, b: *const BI) !BI {
    const xl = a.toConst().limbs;
    const yl = b.toConst().limbs;
    if (xl.len <= KARA_MIN or yl.len <= KARA_MIN) {
        var r = try BI.init(alloc);
        errdefer r.deinit();
        try BI.mul(&r, a, b);
        return r;
    }
    var arena = std.heap.ArenaAllocator.init(alloc);
    defer arena.deinit();
    const z = try mulL(arena.allocator(), xl, yl);
    var r = try BI.initCapacity(alloc, @max(z.len, 1));
    errdefer r.deinit();
    if (z.len == 0) {
        r.limbs[0] = 0;
        r.setLen(1);
    } else {
        @memcpy(r.limbs[0..z.len], z);
        r.setLen(z.len);
        // limbs are magnitude — the sign lives in metadata and is ours to keep.
        r.setSign(a.toConst().positive == b.toConst().positive);
    }
    return r;
}

// r = a * b, drop-in for r.mul(&a, &b) — result may alias a/b.
fn mulFast(r: *BI, a: *const BI, b: *const BI) !void {
    const z = try mulBI(r.allocator, a, b);
    r.deinit();
    r.* = z;
}

// base^e, binary exponentiation over mulBI (BI.pow muls stay schoolbook).
fn biPowFast(alloc: std.mem.Allocator, base: *const BI, e0: u64) !BI {
    var r = try BI.initSet(alloc, 1);
    errdefer r.deinit();
    var acc = try base.clone();
    defer acc.deinit();
    var e = e0;
    while (e > 0) {
        if (e & 1 == 1) try mulFast(&r, &r, &acc);
        e >>= 1;
        if (e > 0) try mulFast(&acc, &acc, &acc);
    }
    return r;
}

fn decMul(alloc: std.mem.Allocator, a: *const Dec, b: *const Dec) !Dec {
    var r = try BI.init(alloc);
    defer r.deinit();
    try mulFast(&r, &a.m, &b.m);
    const ds = try biToDigits(alloc, &r);
    defer alloc.free(ds);
    return decFromDigits(alloc, ds, a.e + b.e, a.neg != b.neg);
}

// First `prec` digits of a digit string (floor-magnitude) and the exponent
// bump for the digits dropped.
const Trimmed = struct { digits: []const u8, e_adj: i64 };

fn trimDigits(ds: []const u8, prec: i64) Trimmed {
    const L: i64 = @intCast(ds.len);
    const keep = @max(prec, 1);
    if (L <= keep) return .{ .digits = ds, .e_adj = 0 };
    return .{ .digits = ds[0..@intCast(keep)], .e_adj = L - keep };
}

// a truncated to `prec` significant digits (floor-magnitude).
fn decTrunc(alloc: std.mem.Allocator, a: *const Dec, prec: i64) !Dec {
    const ds = try biToDigits(alloc, &a.m);
    defer alloc.free(ds);
    const t = trimDigits(ds, prec);
    return decFromDigits(alloc, t.digits, a.e + t.e_adj, a.neg);
}

// a / b to exactly `prec` significant digits (floor-magnitude, then renorm).
fn decDiv(alloc: std.mem.Allocator, a: *const Dec, b: *const Dec, prec: i64) !Dec {
    if (b.m.eqlZero()) return error.DivZero;
    if (a.m.eqlZero()) return decInit(alloc, 0, 0);

    // an m-digit by n-digit integer quotient has m-n or m-n+1 digits; scale A
    // so m-n = prec, then trim to prec.
    const la = try biToDigits(alloc, &a.m);
    defer alloc.free(la);
    const lb = try biToDigits(alloc, &b.m);
    defer alloc.free(lb);
    var k: i64 = prec - @as(i64, @intCast(la.len)) + @as(i64, @intCast(lb.len));
    if (k < 0) k = 0;

    var num = try a.m.clone();
    defer num.deinit();
    var p = try pow10(alloc, k);
    defer p.deinit();
    try mulFast(&num, &num, &p);

    var q = try BI.init(alloc);
    defer q.deinit();
    var rem = try BI.init(alloc);
    defer rem.deinit();
    try divFast(&q, &rem, &num, &b.m);

    const qs = try biToDigits(alloc, &q);
    defer alloc.free(qs);
    const t = trimDigits(qs, prec);
    return decFromDigits(alloc, t.digits, a.e - b.e - k + t.e_adj, a.neg != b.neg);
}

// sqrt(a) to exactly `prec` significant digits (floor-magnitude). a < 0
// refuses at the tor level.
fn decSqrt(alloc: std.mem.Allocator, a: *const Dec, prec: i64) !Dec {
    if (a.m.eqlZero()) return decInit(alloc, 0, 0);

    // Want r = sqrt(A * 10^E). Compute s = isqrt(A * 10^k) with k = E (mod 2)
    // and len(A) + k >= 2*prec, so s has >= prec digits; result = s * 10^((E - k)/2).
    const la = try biToDigits(alloc, &a.m);
    defer alloc.free(la);
    var k: i64 = 2 * @max(prec, 1) - @as(i64, @intCast(la.len));
    if (k < 0) k = 0;
    if (@mod(k - a.e, 2) != 0) k += 1;

    var x = try a.m.clone();
    defer x.deinit();
    var p = try pow10(alloc, k);
    defer p.deinit();
    try mulFast(&x, &x, &p);

    var s = try BI.init(alloc);
    defer s.deinit();
    try sqrtFast(&s, &x);

    const ss = try biToDigits(alloc, &s);
    defer alloc.free(ss);
    const t = trimDigits(ss, prec);
    return decFromDigits(alloc, t.digits, @divExact(a.e - k, 2) + t.e_adj, false);
}

// |a|, |b| compare by absolute value: -1, 0, 1.
fn decCmpAbs(alloc: std.mem.Allocator, a: *const Dec, b: *const Dec) !i8 {
    const e_min = @min(a.e, b.e);
    var am = try a.m.clone();
    defer am.deinit();
    var bm = try b.m.clone();
    defer bm.deinit();
    if (a.e > e_min) {
        var p = try pow10(alloc, a.e - e_min);
        defer p.deinit();
        try mulFast(&am, &am, &p);
    }
    if (b.e > e_min) {
        var p = try pow10(alloc, b.e - e_min);
        defer p.deinit();
        try mulFast(&bm, &bm, &p);
    }
    return switch (am.order(bm)) {
        .lt => -1,
        .eq => 0,
        .gt => 1,
    };
}

// ============================================================================
// Fixed-point layer for the transcendentals. An FX value is a signed bigint X
// standing for X * 10^-w with the width w ambient per call. Series loops
// terminate because terms eventually truncate to zero. GUARD digits absorb
// the per-step truncation; results truncate (floor-magnitude) like div/sqrt.
// ============================================================================

const GUARD: i64 = 12;
// exp cap: refuse when the result would exceed ~10^4 decimal digits — honest
// |overflow, not a silent multi-minute Debug-mode multiply.
const EXP_DIGCAP: i64 = 4;

fn fxFromDec(alloc: std.mem.Allocator, d: *const Dec, w: i64) !BI {
    const k = d.e + w;
    var x = try d.m.clone();
    errdefer x.deinit();
    if (k >= 0) {
        var p = try pow10(alloc, k);
        defer p.deinit();
        try mulFast(&x, &x, &p);
    } else {
        var p = try pow10(alloc, -k);
        defer p.deinit();
        var rem = try BI.init(alloc);
        defer rem.deinit();
        var q = try BI.init(alloc);
        try divFast(&q, &rem, &x, &p);
        x.deinit();
        x = q;
    }
    if (d.neg) x.negate();
    return x;
}

// X * 10^-w -> canonical Dec at `prec` significant digits (truncated).
fn fxToDec(alloc: std.mem.Allocator, x: *const BI, w: i64, prec: i64) !Dec {
    var xa = try x.clone();
    defer xa.deinit();
    const neg = !xa.isPositive() and !xa.eqlZero();
    xa.abs();
    const ds = try biToDigits(alloc, &xa);
    defer alloc.free(ds);
    const t = trimDigits(ds, prec);
    return decFromDigits(alloc, t.digits, -w + t.e_adj, neg);
}

// a * b / 10^w
fn fxMul(alloc: std.mem.Allocator, a: *const BI, b: *const BI, w: i64) !BI {
    var p = try BI.init(alloc);
    defer p.deinit();
    try mulFast(&p, a, b);
    var d = try pow10(alloc, w);
    defer d.deinit();
    var q = try BI.init(alloc);
    errdefer q.deinit();
    var rem = try BI.init(alloc);
    defer rem.deinit();
    try divFast(&q, &rem, &p, &d);
    return q;
}

// a / b in FX: a * 10^w / b (truncated).
fn fxDiv(alloc: std.mem.Allocator, a: *const BI, b: *const BI, w: i64) !BI {
    var n = try a.clone();
    defer n.deinit();
    var p = try pow10(alloc, w);
    defer p.deinit();
    try mulFast(&n, &n, &p);
    var q = try BI.init(alloc);
    errdefer q.deinit();
    var rem = try BI.init(alloc);
    defer rem.deinit();
    try divFast(&q, &rem, &n, b);
    return q;
}

// sqrt(X * 10^-w) = isqrt(X * 10^w)
fn fxSqrt(alloc: std.mem.Allocator, x: *const BI, w: i64) !BI {
    var n = try x.clone();
    defer n.deinit();
    var p = try pow10(alloc, w);
    defer p.deinit();
    try mulFast(&n, &n, &p);
    var s = try BI.init(alloc);
    errdefer s.deinit();
    try sqrtFast(&s, &n);
    return s;
}

fn fxConst(alloc: std.mem.Allocator, v: i64, w: i64) !BI {
    var r = try BI.initSet(alloc, v);
    errdefer r.deinit();
    var p = try pow10(alloc, w);
    defer p.deinit();
    try mulFast(&r, &r, &p);
    return r;
}

// atan(1/k) * SCALE via the alternating series sum (-1)^j / ((2j+1) k^(2j+1)).
// Plain-bigint terms: term_j = SCALE / (k^(2j+1) * (2j+1)), stops at zero.
fn fxAtanInv(alloc: std.mem.Allocator, k: i64, w: i64) !BI {
    var sum = try BI.init(alloc);
    var kk = try BI.initSet(alloc, k * k);
    defer kk.deinit();
    var pk = try BI.initSet(alloc, k);
    defer pk.deinit();
    var unit = try pow10(alloc, w);
    defer unit.deinit();
    var j: i64 = 0;
    var neg = false;
    while (true) : (j += 1) {
        var den = try pk.clone();
        defer den.deinit();
        var dj = try BI.initSet(alloc, 2 * j + 1);
        defer dj.deinit();
        try mulFast(&den, &den, &dj);
        var q = try BI.init(alloc);
        defer q.deinit();
        var rem = try BI.init(alloc);
        defer rem.deinit();
        try divFast(&q, &rem, &unit, &den);
        if (q.eqlZero()) break;
        if (neg) q.negate();
        try sum.add(&sum, &q);
        neg = !neg;
        try mulFast(&pk, &pk, &kk);
    }
    return sum;
}

// pi * SCALE via Machin: pi = 16 atan(1/5) - 4 atan(1/239).
fn fxPi(alloc: std.mem.Allocator, w: i64) !BI {
    var a5 = try fxAtanInv(alloc, 5, w);
    defer a5.deinit();
    var a239 = try fxAtanInv(alloc, 239, w);
    defer a239.deinit();
    var c16 = try BI.initSet(alloc, 16);
    defer c16.deinit();
    var c4 = try BI.initSet(alloc, 4);
    defer c4.deinit();
    try mulFast(&a5, &a5, &c16);
    try mulFast(&a239, &a239, &c4);
    var r = try BI.init(alloc);
    errdefer r.deinit();
    try r.sub(&a5, &a239);
    return r;
}

// exp(r) * SCALE for |r| <= 1/16 by Taylor; terms truncate to zero to stop.
fn fxExpSmall(alloc: std.mem.Allocator, r: *const BI, w: i64) !BI {
    var sum = try pow10(alloc, w);
    var term = try pow10(alloc, w);
    defer term.deinit();
    var n: i64 = 1;
    while (!term.eqlZero()) : (n += 1) {
        var t = try fxMul(alloc, &term, r, w);
        defer t.deinit();
        var dn = try BI.initSet(alloc, n);
        defer dn.deinit();
        var rem = try BI.init(alloc);
        defer rem.deinit();
        term.deinit();
        term = try BI.init(alloc);
        try divFast(&term, &rem, &t, &dn);
        try sum.add(&sum, &term);
    }
    return sum;
}

fn decExp(alloc: std.mem.Allocator, a: *const Dec, prec: i64) !Dec {
    if (a.m.eqlZero()) return decFromDigits(alloc, "1", 0, false);
    // Overflow gate: result digits ~ x * log10(e); cap at 10^EXP_DIGCAP digits.
    if (!a.neg) {
        var le = try decParse(alloc, "4.3429448190325182765e-1");
        defer decDeinit(&le);
        var prod = try decMul(alloc, a, &le);
        defer decDeinit(&prod);
        const ps = try biToDigits(alloc, &prod.m);
        defer alloc.free(ps);
        if (prod.e + @as(i64, @intCast(ps.len)) > EXP_DIGCAP) return error.Overflow;
    }
    const w = prec + GUARD + @max(@as(i64, 0), a.e) + 8;
    var x = try fxFromDec(alloc, a, w);
    defer x.deinit();
    // k = smallest halving count with |x| / 2^k <= SCALE/16
    var k: usize = 0;
    {
        var bound = try pow10(alloc, w);
        defer bound.deinit();
        var c16 = try BI.initSet(alloc, 16);
        defer c16.deinit();
        var rem = try BI.init(alloc);
        defer rem.deinit();
        try divFast(&bound, &rem, &bound, &c16);
        var ax = try x.clone();
        defer ax.deinit();
        ax.abs();
        while (ax.order(bound) == .gt) : (k += 1) {
            var two = try BI.initSet(alloc, 2);
            defer two.deinit();
            try mulFast(&bound, &bound, &two);
        }
    }
    var p2 = try BI.initSet(alloc, 1);
    defer p2.deinit();
    {
        var i: usize = 0;
        var two = try BI.initSet(alloc, 2);
        defer two.deinit();
        while (i < k) : (i += 1) try mulFast(&p2, &p2, &two);
    }
    var r = try BI.init(alloc);
    defer r.deinit();
    var rem = try BI.init(alloc);
    defer rem.deinit();
    try divFast(&r, &rem, &x, &p2);
    var e = try fxExpSmall(alloc, &r, w);
    defer e.deinit();
    var i: usize = 0;
    while (i < k) : (i += 1) {
        const e2 = try fxMul(alloc, &e, &e, w);
        e.deinit();
        e = e2;
    }
    return fxToDec(alloc, &e, w, prec);
}

// ln(f) * SCALE for f in [1,10): 3 sqrt-reductions then 2*atanh(u).
fn fxLnF(alloc: std.mem.Allocator, f: *const BI, w: i64) !BI {
    var g = try f.clone();
    defer g.deinit();
    var unit = try pow10(alloc, w);
    defer unit.deinit();
    var i: usize = 0;
    while (i < 3) : (i += 1) {
        const g2 = try fxSqrt(alloc, &g, w);
        g.deinit();
        g = g2;
    }
    var num = try BI.init(alloc);
    defer num.deinit();
    try num.sub(&g, &unit);
    var den = try BI.init(alloc);
    defer den.deinit();
    try den.add(&g, &unit);
    var u = try fxDiv(alloc, &num, &den, w);
    defer u.deinit();
    var usq = try fxMul(alloc, &u, &u, w);
    defer usq.deinit();
    var term = try u.clone();
    defer term.deinit();
    var sum = try BI.init(alloc);
    defer sum.deinit();
    var n: i64 = 1;
    while (!term.eqlZero()) : (n += 1) {
        var dn = try BI.initSet(alloc, 2 * n - 1);
        defer dn.deinit();
        var q = try BI.init(alloc);
        defer q.deinit();
        var rem = try BI.init(alloc);
        defer rem.deinit();
        try divFast(&q, &rem, &term, &dn);
        try sum.add(&sum, &q);
        const t2 = try fxMul(alloc, &term, &usq, w);
        term.deinit();
        term = t2;
    }
    var c16 = try BI.initSet(alloc, 16);
    defer c16.deinit();
    var res = try BI.init(alloc);
    errdefer res.deinit();
    try mulFast(&res, &sum, &c16);
    return res;
}

fn fxLnTen(alloc: std.mem.Allocator, w: i64) !BI {
    var ten = try fxConst(alloc, 10, w);
    defer ten.deinit();
    return fxLnF(alloc, &ten, w);
}

// ln(a) for a > 0. a = f * 10^t with f in [1,10): ln = ln(f) + t*ln(10).
fn decLn(alloc: std.mem.Allocator, a: *const Dec, prec: i64) !Dec {
    const w = prec + GUARD + 8;
    const ms = try biToDigits(alloc, &a.m);
    defer alloc.free(ms);
    const L: i64 = @intCast(ms.len);
    var fdec = Dec{ .neg = false, .m = try a.m.clone(), .e = 1 - L };
    defer fdec.m.deinit();
    var f = try fxFromDec(alloc, &fdec, w);
    defer f.deinit();
    var lnf = try fxLnF(alloc, &f, w);
    defer lnf.deinit();
    var ln10 = try fxLnTen(alloc, w);
    defer ln10.deinit();
    var tt = try BI.initSet(alloc, a.e + L - 1);
    defer tt.deinit();
    var tterm = try fxMul(alloc, &tt, &ln10, w);
    defer tterm.deinit();
    var res = try BI.init(alloc);
    defer res.deinit();
    try res.add(&lnf, &tterm);
    return fxToDec(alloc, &res, w, prec);
}

// sin(u) * SCALE by Taylor on the folded argument u in [0, pi/2].
fn fxSinSmall(alloc: std.mem.Allocator, u: *const BI, w: i64) !BI {
    var usq = try fxMul(alloc, u, u, w);
    defer usq.deinit();
    var term = try u.clone();
    defer term.deinit();
    var sum = try u.clone();
    errdefer sum.deinit();
    var n: i64 = 1;
    while (!term.eqlZero()) : (n += 1) {
        var t = try fxMul(alloc, &term, &usq, w);
        defer t.deinit();
        var dn = try BI.initSet(alloc, (2 * n) * (2 * n + 1));
        defer dn.deinit();
        var rem = try BI.init(alloc);
        defer rem.deinit();
        term.deinit();
        term = try BI.init(alloc);
        try divFast(&term, &rem, &t, &dn);
        term.negate();
        try sum.add(&sum, &term);
    }
    return sum;
}

// cos(u) * SCALE by Taylor on u in [0, pi/2].
fn fxCosSmall(alloc: std.mem.Allocator, u: *const BI, w: i64) !BI {
    var usq = try fxMul(alloc, u, u, w);
    defer usq.deinit();
    var term = try pow10(alloc, w);
    defer term.deinit();
    var sum = try term.clone();
    errdefer sum.deinit();
    var n: i64 = 1;
    while (!term.eqlZero()) : (n += 1) {
        var t = try fxMul(alloc, &term, &usq, w);
        defer t.deinit();
        var dn = try BI.initSet(alloc, (2 * n - 1) * (2 * n));
        defer dn.deinit();
        var rem = try BI.init(alloc);
        defer rem.deinit();
        term.deinit();
        term = try BI.init(alloc);
        try divFast(&term, &rem, &t, &dn);
        term.negate();
        try sum.add(&sum, &term);
    }
    return sum;
}

// Reduce x mod 2pi and fold to u in [0, pi/2]; reports the sin sign and the
// cos flip that the fold implies.
fn decTrig(alloc: std.mem.Allocator, a: *const Dec, prec: i64, want_sin: bool) !Dec {
    const w = prec + GUARD + @max(@as(i64, 0), a.e) + 8;
    var pi = try fxPi(alloc, w);
    defer pi.deinit();
    var two_pi = try BI.init(alloc);
    defer two_pi.deinit();
    var two = try BI.initSet(alloc, 2);
    defer two.deinit();
    try mulFast(&two_pi, &pi, &two);
    var half_pi = try BI.init(alloc);
    defer half_pi.deinit();
    var rem = try BI.init(alloc);
    defer rem.deinit();
    try divFast(&half_pi, &rem, &pi, &two);
    var x = try fxFromDec(alloc, a, w);
    defer x.deinit();
    // q = round(x / 2pi), r = x - q*2pi in [-pi, pi]
    var qf = try fxDiv(alloc, &x, &two_pi, w);
    defer qf.deinit();
    {
        var half = try pow10(alloc, w);
        defer half.deinit();
        try divFast(&half, &rem, &half, &two);
        if (qf.isPositive()) {
            try qf.add(&qf, &half);
        } else {
            try qf.sub(&qf, &half);
        }
    }
    var unit = try pow10(alloc, w);
    defer unit.deinit();
    var qi = try BI.init(alloc);
    defer qi.deinit();
    try divFast(&qi, &rem, &qf, &unit);
    var qt = try BI.init(alloc);
    defer qt.deinit();
    try mulFast(&qt, &qi, &two_pi);
    var r = try BI.init(alloc);
    defer r.deinit();
    try r.sub(&x, &qt);
    // fold to [0, pi/2]
    var u = try r.clone();
    defer u.deinit();
    const neg_r = !u.isPositive() and !u.eqlZero();
    u.abs();
    var flip_cos = false;
    if (u.order(half_pi) == .gt) {
        var usq = try BI.init(alloc);
        defer usq.deinit();
        try usq.sub(&pi, &u);
        u.deinit();
        u = try usq.clone();
        flip_cos = true;
    }
    var res = if (want_sin)
        try fxSinSmall(alloc, &u, w)
    else
        try fxCosSmall(alloc, &u, w);
    defer res.deinit();
    if ((want_sin and neg_r) or (!want_sin and flip_cos)) res.negate();
    return fxToDec(alloc, &res, w, prec);
}

// atan(a) * SCALE->Dec: reduce to |x| <= 1 (atan x = pi/2 - atan(1/x)),
// then 3 argument halvings atan x = 2 atan(x/(1+sqrt(1+x^2))), then Taylor.
fn decAtan(alloc: std.mem.Allocator, a: *const Dec, prec: i64) !Dec {
    const w = prec + GUARD + @max(@as(i64, 0), a.e) + 8;
    var x = try fxFromDec(alloc, a, w);
    defer x.deinit();
    const neg = !x.isPositive() and !x.eqlZero();
    x.abs();
    var unit = try pow10(alloc, w);
    defer unit.deinit();
    var inv = false;
    if (x.order(unit) == .gt) {
        const xi = try fxDiv(alloc, &unit, &x, w);
        x.deinit();
        x = xi;
        inv = true;
    }
    var i: usize = 0;
    while (i < 3) : (i += 1) {
        var x2 = try fxMul(alloc, &x, &x, w);
        defer x2.deinit();
        var s = try BI.init(alloc);
        defer s.deinit();
        try s.add(&x2, &unit);
        var sq = try fxSqrt(alloc, &s, w);
        defer sq.deinit();
        var den = try BI.init(alloc);
        defer den.deinit();
        try den.add(&sq, &unit);
        const nx = try fxDiv(alloc, &x, &den, w);
        x.deinit();
        x = nx;
    }
    // Taylor atan x = x - x^3/3 + x^5/5 - ...
    var x2 = try fxMul(alloc, &x, &x, w);
    defer x2.deinit();
    var term = try x.clone();
    defer term.deinit();
    var sum = try x.clone();
    defer sum.deinit();
    var n: i64 = 1;
    while (!term.eqlZero()) : (n += 1) {
        var t = try fxMul(alloc, &term, &x2, w);
        defer t.deinit();
        var dn = try BI.initSet(alloc, 2 * n + 1);
        defer dn.deinit();
        var num2 = try BI.initSet(alloc, 2 * n - 1);
        defer num2.deinit();
        try mulFast(&t, &t, &num2);
        var rem = try BI.init(alloc);
        defer rem.deinit();
        term.deinit();
        term = try BI.init(alloc);
        try divFast(&term, &rem, &t, &dn);
        term.negate();
        try sum.add(&sum, &term);
    }
    var c8 = try BI.initSet(alloc, 8);
    defer c8.deinit();
    try mulFast(&sum, &sum, &c8);
    if (inv) {
        var pi = try fxPi(alloc, w);
        defer pi.deinit();
        var two = try BI.initSet(alloc, 2);
        defer two.deinit();
        var hp = try BI.init(alloc);
        defer hp.deinit();
        var rem = try BI.init(alloc);
        defer rem.deinit();
        try divFast(&hp, &rem, &pi, &two);
        try sum.sub(&hp, &sum);
    }
    if (neg) sum.negate();
    return fxToDec(alloc, &sum, w, prec);
}

// Exact remainder: r = a - b*trunc(a/b) at the finer exponent — C-style
// trunc-mod, sign follows the dividend. Exact for any Dec pair; b != 0.
fn decMod(alloc: std.mem.Allocator, a: *const Dec, b: *const Dec) !Dec {
    const e = @min(a.e, b.e);
    var am = try a.m.clone();
    defer am.deinit();
    var bm = try b.m.clone();
    defer bm.deinit();
    var p1 = try pow10(alloc, a.e - e);
    defer p1.deinit();
    try mulFast(&am, &am, &p1);
    var p2 = try pow10(alloc, b.e - e);
    defer p2.deinit();
    try mulFast(&bm, &bm, &p2);
    var q = try BI.init(alloc);
    defer q.deinit();
    var r = try BI.init(alloc);
    defer r.deinit();
    try divFast(&q, &r, &am, &bm);
    const rs = try biToDigits(alloc, &r);
    defer alloc.free(rs);
    // r >= 0 as a magnitude; sign follows the dividend (trunc-mod).
    return decFromDigits(alloc, rs, e, a.neg and !r.eqlZero());
}

fn ownedCopy(s: []const u8) []u8 {
    return koru_allocator().dupe(u8, s) catch @panic("std/num: out of memory");
}

fn numFree(s: []const u8) void {
    koru_allocator().free(s);
}

// ============================================================================
// Boundary: mark outside text as <external!>.
// ============================================================================

// Mark outside text as unvalidated input. Copies into a num-owned buffer so
// `parse` may free it unconditionally at consume time.
~pub tor ingest { s: string } -> string<external!>

~proc ingest|zig {
    return ownedCopy(s);
}

// Mark outside text that arrives under an <allocated!> obligation — the
// buffer is consumed and becomes num-owned; the allocated obligation is
// discharged by taking ownership (the buffer is returned, marked external).
~pub tor ingest-owned { s: string<!allocated> } -> string<external!>

~proc ingest-owned|zig {
    return s;
}

// ============================================================================
// The gate: text -> canonical num (<exact!>).
// ============================================================================

// Parse and normalize external text. Consumes <external!>: on success the
// input buffer is freed. Malformed text lands on |bad with the offending
// buffer itself — ownership transfers to the receiver under <allocated!>,
// disposed via std/io:free.
~pub tor parse { s: string<!external> }
| exact string<exact!>
| bad string<std/io:allocated!>

~proc parse|zig {
    var d = decParse(koru_allocator(), s) catch |err| switch (err) {
        error.OutOfMemory => @panic("std/num: out of memory"),
        else => return .{ .bad = s },
    };
    defer decDeinit(&d);
    numFree(s);
    const canon = decToString(koru_allocator(), &d) catch @panic("std/num: out of memory");
    return .{ .exact = canon };
}

// Parse trusted in-program text — a literal. Same gate, no taint to consume.
// `bad` returns the offending slice.
~pub tor lit { s: string }
| exact string<exact!>
| bad string

~proc lit|zig {
    var d = decParse(koru_allocator(), s) catch |err| switch (err) {
        error.OutOfMemory => @panic("std/num: out of memory"),
        else => return .{ .bad = s },
    };
    defer decDeinit(&d);
    const canon = decToString(koru_allocator(), &d) catch @panic("std/num: out of memory");
    return .{ .exact = canon };
}

// ============================================================================
// Arithmetic — linear: operands are consumed (<!exact>) into the result.
// ============================================================================

~pub tor add { a: string<!exact>, b: string<!exact> } -> string<exact!>

~proc add|zig {
    defer numFree(a);
    defer numFree(b);
    var da = decParse(koru_allocator(), a) catch @panic("std/num:add: malformed operand");
    defer decDeinit(&da);
    var db = decParse(koru_allocator(), b) catch @panic("std/num:add: malformed operand");
    defer decDeinit(&db);
    var r = decAdd(koru_allocator(), &da, &db) catch @panic("std/num:add: out of memory");
    defer decDeinit(&r);
    return decToString(koru_allocator(), &r) catch @panic("std/num:add: out of memory");
}

~pub tor sub { a: string<!exact>, b: string<!exact> } -> string<exact!>

~proc sub|zig {
    defer numFree(a);
    defer numFree(b);
    var da = decParse(koru_allocator(), a) catch @panic("std/num:sub: malformed operand");
    defer decDeinit(&da);
    var db = decParse(koru_allocator(), b) catch @panic("std/num:sub: malformed operand");
    defer decDeinit(&db);
    db.neg = !db.neg;
    if (db.m.eqlZero()) db.neg = false;
    var r = decAdd(koru_allocator(), &da, &db) catch @panic("std/num:sub: out of memory");
    defer decDeinit(&r);
    return decToString(koru_allocator(), &r) catch @panic("std/num:sub: out of memory");
}

~pub tor mul { a: string<!exact>, b: string<!exact> } -> string<exact!>

~proc mul|zig {
    defer numFree(a);
    defer numFree(b);
    var da = decParse(koru_allocator(), a) catch @panic("std/num:mul: malformed operand");
    defer decDeinit(&da);
    var db = decParse(koru_allocator(), b) catch @panic("std/num:mul: malformed operand");
    defer decDeinit(&db);
    var r = decMul(koru_allocator(), &da, &db) catch @panic("std/num:mul: out of memory");
    defer decDeinit(&r);
    return decToString(koru_allocator(), &r) catch @panic("std/num:mul: out of memory");
}

// a / b to `prec` significant digits. Division by zero lands on |div-zero
// (operands are still consumed — the marks are discharged before the branch).
~pub tor div { a: string<!exact>, b: string<!exact>, prec: i64 }
| exact string<exact!>
| div-zero

~proc div|zig {
    defer numFree(a);
    defer numFree(b);
    var da = decParse(koru_allocator(), a) catch @panic("std/num:div: malformed operand");
    defer decDeinit(&da);
    var db = decParse(koru_allocator(), b) catch @panic("std/num:div: malformed operand");
    defer decDeinit(&db);
    var r = decDiv(koru_allocator(), &da, &db, prec) catch |err| switch (err) {
        error.DivZero => return .{ .div_zero = .{} },
        else => @panic("std/num:div: out of memory"),
    };
    defer decDeinit(&r);
    return .{ .exact = decToString(koru_allocator(), &r) catch @panic("std/num:div: out of memory") };
}

~pub tor neg { a: string<!exact> } -> string<exact!>

~proc neg|zig {
    var d = decParse(koru_allocator(), a) catch @panic("std/num:neg: malformed operand");
    defer decDeinit(&d);
    numFree(a);
    if (!d.m.eqlZero()) d.neg = !d.neg;
    return decToString(koru_allocator(), &d) catch @panic("std/num:neg: out of memory");
}

~pub tor abs { a: string<!exact> } -> string<exact!>

~proc abs|zig {
    var d = decParse(koru_allocator(), a) catch @panic("std/num:abs: malformed operand");
    defer decDeinit(&d);
    numFree(a);
    d.neg = false;
    return decToString(koru_allocator(), &d) catch @panic("std/num:abs: out of memory");
}

// a^n for n >= 0. A negative exponent is not a num op (it is div(1, pow))
// and lands on |neg-exp.
~pub tor pow { a: string<!exact>, n: i64 }
| exact string<exact!>
| neg-exp

~proc pow|zig {
    defer numFree(a);
    if (n < 0) return .{ .neg_exp = .{} };
    var d = decParse(koru_allocator(), a) catch @panic("std/num:pow: malformed operand");
    defer decDeinit(&d);
    // mantissa^n, e*n — then renorm through the digit string.
    var r = BI.initSet(koru_allocator(), 1) catch @panic("std/num:pow: out of memory");
    defer r.deinit();
    if (n > std.math.maxInt(u32)) @panic("std/num:pow: exponent too large");
    {
        const pr = biPowFast(koru_allocator(), &d.m, @intCast(n)) catch @panic("std/num:pow: out of memory");
        r.deinit();
        r = pr;
    }
    const ds = r.toString(koru_allocator(), 10, .lower) catch @panic("std/num:pow: out of memory");
    defer koru_allocator().free(ds);
    var out = decFromDigits(koru_allocator(), ds, d.e * n, d.neg and @mod(n, 2) != 0) catch @panic("std/num:pow: out of memory");
    defer decDeinit(&out);
    return .{ .exact = decToString(koru_allocator(), &out) catch @panic("std/num:pow: out of memory") };
}

// a truncated to `prec` significant digits (floor-magnitude); unchanged if it already has <= prec.
~pub tor trunc { a: string<!exact>, prec: i64 } -> string<exact!>

~proc trunc|zig {
    defer numFree(a);
    var da = decParse(koru_allocator(), a) catch @panic("std/num:trunc: malformed operand");
    defer decDeinit(&da);
    var r = decTrunc(koru_allocator(), &da, prec) catch @panic("std/num:trunc: out of memory");
    defer decDeinit(&r);
    return decToString(koru_allocator(), &r) catch @panic("std/num:trunc: out of memory");
}

// sqrt(a^2 + b^2) to `prec` significant digits — quadrature addition. The
// sum of two squares cannot be negative, so there is no lawful failure arm:
// the op is total by construction.
~pub tor qadd { a: string<!exact>, b: string<!exact>, prec: i64 } -> string<exact!>

~proc qadd|zig {
    defer numFree(a);
    defer numFree(b);
    var da = decParse(koru_allocator(), a) catch @panic("std/num:qadd: malformed operand");
    defer decDeinit(&da);
    var db = decParse(koru_allocator(), b) catch @panic("std/num:qadd: malformed operand");
    defer decDeinit(&db);
    var sa = decMul(koru_allocator(), &da, &da) catch @panic("std/num:qadd: out of memory");
    defer decDeinit(&sa);
    var sb = decMul(koru_allocator(), &db, &db) catch @panic("std/num:qadd: out of memory");
    defer decDeinit(&sb);
    var s = decAdd(koru_allocator(), &sa, &sb) catch @panic("std/num:qadd: out of memory");
    defer decDeinit(&s);
    var r = decSqrt(koru_allocator(), &s, prec) catch @panic("std/num:qadd: out of memory");
    defer decDeinit(&r);
    return decToString(koru_allocator(), &r) catch @panic("std/num:qadd: out of memory");
}

// isqrt to `prec` significant digits. Negative input lands on |negative.
~pub tor sqrt { a: string<!exact>, prec: i64 }
| exact string<exact!>
| negative

~proc sqrt|zig {
    defer numFree(a);
    var d = decParse(koru_allocator(), a) catch @panic("std/num:sqrt: malformed operand");
    defer decDeinit(&d);
    if (d.neg) return .{ .negative = .{} };
    var r = decSqrt(koru_allocator(), &d, prec) catch @panic("std/num:sqrt: out of memory");
    defer decDeinit(&r);
    return .{ .exact = decToString(koru_allocator(), &r) catch @panic("std/num:sqrt: out of memory") };
}

// ============================================================================
// Predicates and equivalents — borrowing: operands keep their <exact> mark.
// ============================================================================

// Total order: | lt | eq | gt. The equivalence law — canonical form makes
// value-equality and string-equality coincide, so | eq is *the* lawful eq.
~pub tor cmp { a: string<exact>, b: string<exact> }
| lt
| eq
| gt

~proc cmp|zig {
    var da = decParse(koru_allocator(), a) catch @panic("std/num:cmp: malformed operand");
    defer decDeinit(&da);
    var db = decParse(koru_allocator(), b) catch @panic("std/num:cmp: malformed operand");
    defer decDeinit(&db);
    if (da.neg and !db.neg) return .{ .lt = .{} };
    if (!da.neg and db.neg) return .{ .gt = .{} };
    const c = decCmpAbs(koru_allocator(), &da, &db) catch @panic("std/num:cmp: out of memory");
    const s: i8 = if (da.neg) -c else c;
    if (s < 0) return .{ .lt = .{} };
    if (s > 0) return .{ .gt = .{} };
    return .{ .eq = .{} };
}

// equiv: the equivalence law. Canonical nums are string-equal iff equal.
~pub tor equiv { a: string<exact>, b: string<exact> }
| same
| diff

~proc equiv|zig {
    if (std.mem.eql(u8, a, b)) return .{ .same = .{} };
    return .{ .diff = .{} };
}

// ============================================================================
// Linearity management
// ============================================================================

// Fork one num into two (the lawful copy — a num is a linear resource).
// Canonical zero check — borrows the operand.
~pub tor is-zero { n: string<exact> }
| zero
| nonzero

~proc is-zero|zig {
    var d = decParse(koru_allocator(), n) catch @panic("std/num:is-zero: malformed operand");
    defer decDeinit(&d);
    if (d.m.eqlZero()) return .{ .zero = .{} };
    return .{ .nonzero = .{} };
}

~pub tor dup { n: string<!exact> } -> { a: string<exact!>, b: string<exact!> }

~proc dup|zig {
    const cp = ownedCopy(n);
    return .{ .a = n, .b = cp };
}

// Discharge <exact!>: the buffer is freed, the number is gone.
~pub tor free { n: string<!exact> }

~proc free|zig {
    numFree(n);
}

// Discharge an <external!> obligation WITHOUT validating — the lawful way
// out when a sibling field already failed and this one never reaches parse.
~pub tor drop { s: string<!external> }

~proc drop|zig {
    numFree(s);
}

// i64 -> canonical decimal. The bridge from host counters into the tower.
~pub tor from-int { i: i64 } -> string<exact!>

~proc from-int|zig {
    var buf: [24]u8 = undefined;
    const s = std.fmt.bufPrint(&buf, "{d}", .{i}) catch @panic("std/num:from-int: overflow");
    var d = decParse(koru_allocator(), s) catch @panic("std/num:from-int: parse");
    defer decDeinit(&d);
    return decToString(koru_allocator(), &d) catch @panic("std/num: out of memory");
}

// Swap <exact!> to <allocated!>: hands the canonical text out for printing
// or formatting. The buffer stays allocator-owned — discharge with
// `std/io:free` (the `allocated` state is io's vocabulary, issued qualified).
~pub tor render { n: string<!exact> } -> string<std/io:allocated!>

~proc render|zig {
    return n;
}

// ============================================================================
// Transcendentals — fixed-point series over the Dec core (rung: bc -l parity).
// exp/ln/sin/cos/atan take  significant digits and refuse on named axes:
// huge results overflow, non-positive ln arguments are non-pos, huge trig
// arguments overflow. powf is x^e for real e via exp(e*ln x): x<0 is
// |neg-base (complex, out of scope), x<=0 with e<=0 is |non-pos.
// ============================================================================

~pub tor exp { a: string<!exact>, prec: i64 }
| exact string<exact!>
| overflow

~proc exp|zig {
    defer numFree(a);
    var d = decParse(koru_allocator(), a) catch @panic("std/num:exp: malformed operand");
    defer decDeinit(&d);
    var r = decExp(koru_allocator(), &d, prec) catch |err| switch (err) {
        error.Overflow => return .{ .overflow = .{} },
        else => @panic("std/num:exp: out of memory"),
    };
    defer decDeinit(&r);
    return .{ .exact = decToString(koru_allocator(), &r) catch @panic("std/num: out of memory") };
}

~pub tor ln { a: string<!exact>, prec: i64 }
| exact string<exact!>
| non-pos

~proc ln|zig {
    defer numFree(a);
    var d = decParse(koru_allocator(), a) catch @panic("std/num:ln: malformed operand");
    defer decDeinit(&d);
    if (d.neg or d.m.eqlZero()) return .{ .non_pos = .{} };
    var r = decLn(koru_allocator(), &d, prec) catch @panic("std/num:ln: out of memory");
    defer decDeinit(&r);
    return .{ .exact = decToString(koru_allocator(), &r) catch @panic("std/num: out of memory") };
}

~pub tor sin { a: string<!exact>, prec: i64 }
| exact string<exact!>
| overflow

~proc sin|zig {
    defer numFree(a);
    var d = decParse(koru_allocator(), a) catch @panic("std/num:sin: malformed operand");
    defer decDeinit(&d);
    const ms = d.m.toString(koru_allocator(), 10, .lower) catch @panic("std/num: out of memory");
    defer koru_allocator().free(ms);
    if (d.e + @as(i64, @intCast(ms.len)) > 500) return .{ .overflow = .{} };
    var r = decTrig(koru_allocator(), &d, prec, true) catch @panic("std/num:sin: out of memory");
    defer decDeinit(&r);
    return .{ .exact = decToString(koru_allocator(), &r) catch @panic("std/num: out of memory") };
}

~pub tor cos { a: string<!exact>, prec: i64 }
| exact string<exact!>
| overflow

~proc cos|zig {
    defer numFree(a);
    var d = decParse(koru_allocator(), a) catch @panic("std/num:cos: malformed operand");
    defer decDeinit(&d);
    const ms = d.m.toString(koru_allocator(), 10, .lower) catch @panic("std/num: out of memory");
    defer koru_allocator().free(ms);
    if (d.e + @as(i64, @intCast(ms.len)) > 500) return .{ .overflow = .{} };
    var r = decTrig(koru_allocator(), &d, prec, false) catch @panic("std/num:cos: out of memory");
    defer decDeinit(&r);
    return .{ .exact = decToString(koru_allocator(), &r) catch @panic("std/num: out of memory") };
}

~pub tor atan { a: string<!exact>, prec: i64 } -> string<exact!>

~proc atan|zig {
    defer numFree(a);
    var d = decParse(koru_allocator(), a) catch @panic("std/num:atan: malformed operand");
    defer decDeinit(&d);
    var r = decAtan(koru_allocator(), &d, prec) catch @panic("std/num:atan: out of memory");
    defer decDeinit(&r);
    return decToString(koru_allocator(), &r) catch @panic("std/num: out of memory");
}

// a^e for real e: exp(e * ln a). a < 0 -> |neg-base (complex plane is out of
// scope); a == 0 -> e>0 gives exact 0, e<=0 lands on |non-pos.
~pub tor powf { a: string<!exact>, e: string<!exact>, prec: i64 }
| exact string<exact!>
| neg-base
| non-pos
| overflow

~proc powf|zig {
    defer numFree(a);
    defer numFree(e);
    var da = decParse(koru_allocator(), a) catch @panic("std/num:powf: malformed base");
    defer decDeinit(&da);
    var de = decParse(koru_allocator(), e) catch @panic("std/num:powf: malformed exponent");
    defer decDeinit(&de);
    if (da.neg) return .{ .neg_base = .{} };
    if (da.m.eqlZero()) {
        if (de.neg or de.m.eqlZero()) return .{ .non_pos = .{} };
        return .{ .exact = ownedCopy("0e0") };
    }
    // Integral non-negative exponents take the exact pow path; the log route
    // would only truncate what pow computes exactly.
    if (de.e >= 0 and !de.neg) {
        var en = de.m.clone() catch @panic("std/num:powf: out of memory");
        defer en.deinit();
        var pe = pow10(koru_allocator(), de.e) catch @panic("std/num:powf: out of memory");
        defer pe.deinit();
        mulFast(&en, &en, &pe) catch @panic("std/num:powf: out of memory");
        const n64 = en.toConst().toInt(i64) catch -1;
        if (n64 < 0 or n64 > std.math.maxInt(u32)) return .{ .overflow = .{} };
        var r = BI.initSet(koru_allocator(), 1) catch @panic("std/num:powf: out of memory");
        defer r.deinit();
        {
            const pr = biPowFast(koru_allocator(), &da.m, @intCast(n64)) catch @panic("std/num:powf: out of memory");
            r.deinit();
            r = pr;
        }
        const ds = r.toString(koru_allocator(), 10, .lower) catch @panic("std/num:powf: out of memory");
        defer koru_allocator().free(ds);
        var out = decFromDigits(koru_allocator(), ds, da.e * n64, false) catch @panic("std/num:powf: out of memory");
        defer decDeinit(&out);
        return .{ .exact = decToString(koru_allocator(), &out) catch @panic("std/num:powf: out of memory") };
    }
    var la = decLn(koru_allocator(), &da, prec + GUARD) catch @panic("std/num:powf: out of memory");
    defer decDeinit(&la);
    var t = decMul(koru_allocator(), &la, &de) catch @panic("std/num:powf: out of memory");
    defer decDeinit(&t);
    var r = decExp(koru_allocator(), &t, prec) catch |err| switch (err) {
        error.Overflow => return .{ .overflow = .{} },
        else => @panic("std/num:powf: out of memory"),
    };
    defer decDeinit(&r);
    return .{ .exact = decToString(koru_allocator(), &r) catch @panic("std/num: out of memory") };
}

// ============================================================================
// Rung 2: mod, length/scale introspection, base conversion.
// ============================================================================

// Exact remainder a mod b = a - b*trunc(a/b); sign follows the dividend.
// |div-zero when b == 0.
~pub tor mod { a: string<!exact>, b: string<!exact> }
| exact string<exact!>
| div-zero

~proc mod|zig {
    defer numFree(a);
    defer numFree(b);
    var da = decParse(koru_allocator(), a) catch @panic("std/num:mod: malformed operand");
    defer decDeinit(&da);
    var db = decParse(koru_allocator(), b) catch @panic("std/num:mod: malformed operand");
    defer decDeinit(&db);
    if (db.m.eqlZero()) return .{ .div_zero = .{} };
    var r = decMod(koru_allocator(), &da, &db) catch @panic("std/num:mod: out of memory");
    defer decDeinit(&r);
    return .{ .exact = decToString(koru_allocator(), &r) catch @panic("std/num: out of memory") };
}

// Significant-digit count of the mantissa (bc's length()). Borrows.
~pub tor length { a: string<exact> } -> i64

~proc length|zig {
    var d = decParse(koru_allocator(), a) catch @panic("std/num:length: malformed operand");
    defer decDeinit(&d);
    const ms = d.m.toString(koru_allocator(), 10, .lower) catch @panic("std/num: out of memory");
    defer koru_allocator().free(ms);
    return @intCast(ms.len);
}

// Digits after the decimal point (bc's scale()). Canonical form has no
// trailing zeros, so scale = max(0, -e). Borrows.
~pub tor scale { a: string<exact> } -> i64

~proc scale|zig {
    var d = decParse(koru_allocator(), a) catch @panic("std/num:scale: malformed operand");
    defer decDeinit(&d);
    return if (d.e < 0) -d.e else 0;
}

// Render an integral value in base 2..36 (bc's obase, honest about scope:
// non-integers refuse rather than emitting bc's digit-vector notation).
~pub tor to-base { a: string<!exact>, base: i64 }
| exact string<exact!>
| non-int
| bad-base

~proc to-base|zig {
    defer numFree(a);
    if (base < 2 or base > 36) return .{ .bad_base = .{} };
    var d = decParse(koru_allocator(), a) catch @panic("std/num:to-base: malformed operand");
    defer decDeinit(&d);
    if (d.e < 0) return .{ .non_int = .{} };
    var v = d.m.clone() catch @panic("std/num: out of memory");
    defer v.deinit();
    var p = pow10(koru_allocator(), d.e) catch @panic("std/num: out of memory");
    defer p.deinit();
    mulFast(&v, &v, &p) catch @panic("std/num: out of memory");
    const b8: u8 = @intCast(base);
    const s = v.toString(koru_allocator(), b8, .lower) catch @panic("std/num: out of memory");
    if (d.neg and !v.eqlZero()) {
        var out = koru_allocator().alloc(u8, s.len + 1) catch @panic("std/num: out of memory");
        out[0] = '-';
        @memcpy(out[1..], s);
        koru_allocator().free(s);
        return .{ .exact = out };
    }
    return .{ .exact = s };
}

// Parse digits in base 2..36 into an integer value (bc's ibase; lit-lane —
// the text is trusted, same contract as lit). Upper and lower case both
// accepted; '_' separators refused, a leading '-' negates.
~pub tor from-base { s: string, base: i64 }
| exact string<exact!>
| bad-digit
| bad-base

~proc from-base|zig {
    if (base < 2 or base > 36) return .{ .bad_base = .{} };
    var i: usize = 0;
    var neg = false;
    if (s.len > 0 and s[0] == '-') {
        neg = true;
        i = 1;
    }
    if (i >= s.len) return .{ .bad_digit = .{} };
    var v = BI.initSet(koru_allocator(), 0) catch @panic("std/num: out of memory");
    defer v.deinit();
    var bb = BI.initSet(koru_allocator(), base) catch @panic("std/num: out of memory");
    defer bb.deinit();
    while (i < s.len) : (i += 1) {
        const c = s[i];
        const dig: i64 = if (c >= '0' and c <= '9')
            c - '0'
        else if (c >= 'a' and c <= 'z')
            c - 'a' + 10
        else if (c >= 'A' and c <= 'Z')
            c - 'A' + 10
        else
            return .{ .bad_digit = .{} };
        if (dig >= base) return .{ .bad_digit = .{} };
        var dd = BI.initSet(koru_allocator(), dig) catch @panic("std/num: out of memory");
        defer dd.deinit();
        mulFast(&v, &v, &bb) catch @panic("std/num: out of memory");
        v.add(&v, &dd) catch @panic("std/num: out of memory");
    }
    const ds = v.toString(koru_allocator(), 10, .lower) catch @panic("std/num: out of memory");
    defer koru_allocator().free(ds);
    var out = decFromDigits(koru_allocator(), ds, 0, neg and !v.eqlZero()) catch @panic("std/num: out of memory");
    defer decDeinit(&out);
    return .{ .exact = decToString(koru_allocator(), &out) catch @panic("std/num: out of memory") };
}

