// std/args — C implementation facet.
//
// Events are declared in the `args.k` companion (merged at import). This
// file holds the `|c` proc bodies: the host-C text runs verbatim after the
// emitFieldBindings prologue (`const <ct> <field> = __koru_in.<field>;`),
// and argv lands in `__koru_argc`/`__koru_argv` — statics main() fills.
// Index 0 is the program name, matching the Zig facet's std.os.argv shape.
//
// `all`/`rest` return `[][:0]u8` — the fat `struct __koru_slice_const_char`
// cell (`const char * *ptr` + `uintptr_t len`), spanning the process's own
// argv memory like the Zig facet's std.os.argv cache. The `char **` →
// `const char **` step takes an explicit cast: C's const-correctness will
// not walk a pointer level on its own.

~proc all|c {
    return (struct __koru_slice_const_char){ .ptr = (const char **)__koru_argv, .len = (uintptr_t)__koru_argc };
}

~proc count|c {
    return (uintptr_t)__koru_argc;
}

~proc get|c {
    if (index >= (uintptr_t)__koru_argc) {
        return (struct std_args_get_res){ .tag = std_args_get_tag_out_of_bounds };
    }
    return (struct std_args_get_res){ .tag = std_args_get_tag_arg, .arg = __koru_argv[index] };
}

~proc rest|c {
    if (__koru_argc <= 1) {
        return (struct __koru_slice_const_char){ .ptr = (const char **)__koru_argv, .len = 0 };
    }
    return (struct __koru_slice_const_char){ .ptr = (const char **)__koru_argv + 1, .len = (uintptr_t)(__koru_argc - 1) };
}
