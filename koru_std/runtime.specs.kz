// Koru Standard Library: the `specs` part of runtime — the branch/input/
// scope metadata types the generated dispatchers and the shape checker
// speak. Joined via `~part specs` in runtime.kz; merged into the
// runtime module at load.
//
// The definitions were uplifted to std/spec — the descriptor vocabulary is
// the spec of a surface, not a runtime concern. Aliased here so the emitted
// `koru_std.koru_runtime.*` references generated code writes keep resolving
// to the one definition.

pub const BranchField = @import("root").koru_std.koru_spec.BranchField;
pub const BranchSpec = @import("root").koru_std.koru_spec.BranchSpec;
pub const InputFieldSpec = @import("root").koru_std.koru_spec.InputFieldSpec;
pub const ScopeEvent = @import("root").koru_std.koru_spec.ScopeEvent;
pub const ScopeDescriptor = @import("root").koru_std.koru_spec.ScopeDescriptor;
