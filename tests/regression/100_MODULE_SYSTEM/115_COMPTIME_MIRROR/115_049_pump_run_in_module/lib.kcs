using static KoruHost;

static class KoruHost {
    public static long count = 0;
    public static long budget = 3;
}

~proc step|cs {
    if ($mod.count >= $mod.budget) return 0;
    $mod.count += 1;
    stepped($mod.count);
    return 1;
}
~proc live|cs {
    return @intFromBool($mod.count < $mod.budget);
}
~proc wait|cs {
    _ = i;
    return 3_000_000;
}