// Koru Standard Library: the `contracts` part of interpreter — the
// dispatcher and obligation-spec type surface. Joined via `~part contracts`
// in interpreter.kz; merged into the interpreter module at load.
//
// Everything here is declaration-level types: the host-dispatch contract
// (HostView / HostDispatchFn / the dispatch-detail channel), the fn-ptr
// vocabulary the runtime generates dispatchers against, and the
// obligation CreateSpec/DischargeSpec specs.

// DISPATCHER TYPE - Function signature for scope dispatchers
// ============================================================================

pub const Invocation = ast.Invocation;
// The dispatcher signature + obligation-spec vocabulary was uplifted to
// std/spec — aliased back so `koru_std.koru_interpreter.*` keeps resolving.
pub const DispatchFn = @import("root").koru_std.koru_spec.DispatchFn;
// The slice of interpreter state a host verb may see: which scope it sits
// under, the session's defined table, an allocator for its render, and the
// error channel it teaches through. Deliberately NOT *InterpreterContext —
// a fn-ptr type naming the struct that stores it is a dependency loop.
pub const HostView = struct {
    scope_name: []const u8,
    defined: ?*DefinedFlows,
    allocator: std.mem.Allocator,
    error_detail: *?[]const u8,
    // The session's durable binding table — a host verb that persists a
    // value (the bridge's `bind`) writes here. null = no session.
    session_env: ?*Environment = null,
    // The opaque context the pool's custody witness was armed with —
    // null when no `on_custody` callback is installed (a worldless
    // bridge, a bare interpreter run). The armer owns the type: the
    // bridge passes itself and its host verbs cast back to *Bridge to
    // reach the world. Opaque because contracts cannot name bridge.
    custody_ctx: ?*anyopaque = null,
    // The session's mounted scopes — a vocabulary render must see them.
    mounted: ?[]const @import("root").koru_std.koru_runtime.ScopeRuntime = null,
};
// Dispatch-detail/dispatch-pool channels moved to the `resdispatch` part —
// the threadlocals a generated dispatcher reports and resolves through.

// Host-provided verbs, consulted only when the scope's dispatcher returns
// EventDenied: session-level capabilities (vocabulary, grammar) not part of
// the registered scope but still dispatched like any call — parsed, armed,
// refused. Returns error.EventDenied when the host does not claim the name.
pub const HostDispatchFn = *const fn(
    name: []const u8,
    inv: *const ast.Invocation,
    view: *const HostView,
    out: *DispatchResult,
) anyerror!void;
pub const CostFn = @import("root").koru_std.koru_spec.CostFn;
// Obligation functions - tors can create/discharge multiple obligations
pub const ObligationsArrayFn = @import("root").koru_std.koru_spec.ObligationsArrayFn;
pub const DischargeEventFn = @import("root").koru_std.koru_spec.DischargeEventFn;

// CreateSpec/DischargeSpec describe obligations created by an tor's output
// field / discharged by its input arg — defined in std/spec.
pub const CreateSpec = @import("root").koru_std.koru_spec.CreateSpec;
pub const DischargeSpec = @import("root").koru_std.koru_spec.DischargeSpec;

// Spec lookup functions - return full specs with field/arg names
pub const CreatesSpecFn = @import("root").koru_std.koru_spec.CreatesSpecFn;
pub const DischargesSpecFn = @import("root").koru_std.koru_spec.DischargesSpecFn;

// Input-field lookup - an tor's declared argument vocabulary. Null means
// the name is not this scope's verb at all (vocabulary membership answers
// first); an empty list means the verb takes no fields, so ANY named field
// is foreign.
pub const InputFieldSpec = @import("root").koru_std.koru_spec.InputFieldSpec;
pub const InputLookupFn = @import("root").koru_std.koru_spec.InputLookupFn;

// Outcome lookup — an tor's declared branch vocabulary; what an arm word
// must spell. Empty means the single anonymous outcome, spelled `ok` on
// the wire. The scope's table answers empty for a non-member name too,
// so arm-word checks ride under the input_fn membership answer.
pub const BranchSpec = @import("root").koru_std.koru_spec.BranchSpec;
pub const BranchesLookupFn = @import("root").koru_std.koru_spec.BranchesLookupFn;
