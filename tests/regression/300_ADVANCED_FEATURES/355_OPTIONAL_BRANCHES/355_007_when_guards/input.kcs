~proc process|cs {
    // Return warning with different levels based on value
    if (value > 100) {
        return new Output { tag = "warning", warning = new warning_payload { msg = "Very large", level = 10 } };
    }

    if (value > 50) {
        return new Output { tag = "warning", warning = new warning_payload { msg = "Moderately large", level = 4 } };
    }

    if (value > 20) {
        return new Output { tag = "warning", warning = new warning_payload { msg = "Slightly large", level = 1 } };
    }

    return new Output { tag = "success", success = value * 2 };
}