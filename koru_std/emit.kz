// Koru Standard Library: emit — the generic emission walker.
//
// Companion to `std/target` (the catalog): target owns the DECLARED half —
// what a backend target says about itself as data rows; this module owns
// the ENGINE half — the target-blind traversal that asks the catalog
// questions in source order and writes what it answers. The ruling is
// concepts/frag-a-target-is-a-catalog-entry-not-a-module.md and
// docs/std-target.md: one walker, many arms.
//
// Mirrors std/realize the way target.kz does: vocabulary declared first,
// consumer second. The walk's engine is src/emit_walk.zig while the
// bootstrap compiler is Zig; this file is the pipeline's address for it —
// target-of routes the compile target onto per-target emit tors the way
// compiler.materialize.kz does upstream, and emit-c is the C lane's arm.
//
// The walk the engine performs (the visitor_emitter shape, generalized):
//
//   program → items → module_decl | event_decl | proc_decl | impl | flow
//   flow    → invocation | continuations | inline_body
//   site    → produce | call | assign | guard | branch | text
//
// At each node the walker asks the catalog:
//   emit.type(name)    — std/target:type     — how a Koru type spells here
//   emit.name(key)     — std/target:name     — which minted constant
//   emit.builtin(name) — std/target:builtin  — lowered, or refused?
//   emit.prelude()     — std/target:prelude  — the static surface
//   emit.fragment(k)   — std/target:fragment — is this construct refused?
//   emit.construct(p)  — std/target:construct— does this proc exist here?
//
// A query the catalog cannot answer is a refusal-shaped null, never a
// guess — the same contract the c emitter enforces today, made generic.

// The node kinds the walker visits — one per walk level above. Declared
// as data so a second arm (a JS walker, a pretty-printer) rides the same
// traversal without re-deriving the shape from code.
pub const WalkNode = struct {
    kind: []const u8,   // "item" | "decl" | "flow" | "site"
    name: []const u8,   // "event_decl", "produce", …
};

// A catalog query the walker performs at a node — the walk-shape's own
// rows: which verb it asks, with what key material, and what an
// unanswered query means at this point in the walk (refuse | skip | raw).
pub const WalkQuery = struct {
    node: []const u8,        // the WalkNode that asks
    verb: []const u8,        // "type" | "name" | "builtin" | "prelude" | "fragment" | "construct"
    key: []const u8,         // "field.type", "inv.segments[0]", …
    on_miss: []const u8,     // "refuse" | "skip" | "raw-text"
};

// The walk itself: an ordered list of (node, query) obligations. The
// engine's correctness IS this table — the catalog answers data, the
// walk table owns the order questions get asked in.
pub const Walk = struct {
    nodes: std.ArrayList(WalkNode),
    queries: std.ArrayList(WalkQuery),
};

const std = @import("std");
const ast = @import("ast");

// Route the compile target onto an emission arm — the per-target emit tor
// is selected by arm tag, not by an if-chain inside one proc. `other` is
// not a fallback: only declared targets land here.
~[comptime] pub tor target-of { ctx: std/compiler:CompilerContext }
| zig
| js
| cs
| c
| other

~proc target-of|zig {
    _ = ctx;
    if (std.mem.eql(u8, CompilerEnv.lang, "js")) return .{ .js = .{} };
    if (std.mem.eql(u8, CompilerEnv.lang, "cs")) return .{ .cs = .{} };
    if (std.mem.eql(u8, CompilerEnv.lang, "c")) return .{ .c = .{} };
    if (std.mem.eql(u8, CompilerEnv.lang, "zig")) return .{ .zig = .{} };
    return .{ .other = .{} };
}

// The C lane's pipeline address — selected under --lang=c. The engine is
// src/c_emitter.zig (+ src/emit_walk.zig for the event/driver walk); a
// refusal is a program outside the verified fragment, never a Zig
// fallback — same fail-loud contract the other lanes keep.
~[comptime] pub tor emit-c { ctx: std/compiler:CompilerContext } -> { ctx: std/compiler:CompilerContext, code: string }

~proc emit-c|zig {
    const c_emitter = @import("c_emitter");
    const code = c_emitter.emit(ctx.allocator, ctx.ast, CompilerEnv.library) catch |err| {
        std.debug.print("error[KORU047]: C emission failed: {s}\n", .{@errorName(err)});
        std.process.exit(1);
    };
    var updated_ctx = ctx;
    updated_ctx.passes_completed += 1;
    updated_ctx.current_pass = "emission";
    return .{ .ctx = updated_ctx, .code = code };
}
