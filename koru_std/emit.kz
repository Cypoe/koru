// Koru Standard Library: emit — the generic emission walker.
//
// Companion to `std/target` (the catalog): target owns the DECLARED half —
// what a backend target says about itself as data rows; this module owns
// the ENGINE half — the target-blind traversal that asks the catalog
// questions in source order and writes what it answers. The ruling is
// concepts/frag-a-target-is-a-catalog-entry-not-a-module.md and
// docs/std-target.md: one walker, many arms.
//
// Mirrors std/realize the way target.kz does: vocabulary declared first,
// consumer second. The walk's engine is src/emit_walk.zig while the
// bootstrap compiler is Zig; this file is the pipeline's address for it —
// std/compiler's target-of routes the compile target onto per-target emit
// tors, and emit-c is the C lane's arm.
//
// The walk the engine performs (the visitor_emitter shape, generalized):
//
//   program → items → module_decl | event_decl | proc_decl | impl | flow
//   flow    → invocation | continuations | inline_body
//   site    → produce | call | assign | guard | branch | text
//
// At each node the walker asks the catalog:
//   emit.type(name)    — std/target:type     — how a Koru type spells here
//   emit.name(key)     — std/target:name     — which minted constant
//   emit.builtin(name) — std/target:builtin  — lowered, or refused?
//   emit.prelude()     — std/target:prelude  — the static surface
//   emit.fragment(k)   — std/target:fragment — is this construct refused?
//   emit.construct(p)  — std/target:construct— does this proc exist here?
//
// A query the catalog cannot answer is a refusal-shaped null, never a
// guess — the same contract the c emitter enforces today, made generic.

// The node kinds the walker visits — one per walk level above. Declared
// as data so a second arm (a JS walker, a pretty-printer) rides it too.
pub const WalkNode = struct {
    kind: []const u8,   // "item" | "decl" | "flow" | "site"
    name: []const u8,   // "event_decl", "produce", …
};

// A catalog query the walker performs at a node — the walk-shape's own
// rows: which verb it asks, with what key material, and what an
// unanswered query means at this point in the walk (refuse | skip | raw).
pub const WalkQuery = struct {
    node: []const u8,        // the WalkNode that asks
    verb: []const u8,        // "type" | "name" | "builtin" | "prelude" | "fragment" | "construct"
    key: []const u8,         // "field.type", "inv.segments[0]", …
    on_miss: []const u8,     // "refuse" | "skip" | "raw-text"
};

// The walk itself: an ordered list of (node, query) obligations. The
// engine's correctness IS this table — the catalog answers data, the
// walk table owns the order questions get asked in.
pub const Walk = struct {
    nodes: std.ArrayList(WalkNode),
    queries: std.ArrayList(WalkQuery),
};

const std = @import("std");
const ast = @import("ast");

// The C lane's pipeline address — selected under --lang=c. A composed
// chain of pass tors over one emission session: open builds indexes +
// preamble, decls/defs/driver run the walk's passes, close runs the
// post-passes and returns code + the declared artifact name.
~[comptime] pub tor emit-c { ctx: std/compiler:CompilerContext } -> { ctx: std/compiler:CompilerContext, code: string, artifact: string }

~emit-c = emit-c-open(ctx): s1
|> emit-c-decls(s1.ctx, s1.session): s2
|> emit-c-defs(s2.ctx, s2.session): s3
|> emit-c-driver(s3.ctx, s3.session): s4
|> emit-c-close(s4.ctx, s4.session): e -> e

// The session crosses tors as an opaque usize — the pipeline threads the handle.
~[comptime] pub tor emit-c-open { ctx: std/compiler:CompilerContext } -> { ctx: std/compiler:CompilerContext, session: usize }

~proc emit-c-open|zig {
    const c_emitter = @import("c_emitter");
    const session = c_emitter.sessionOpen(ctx.allocator, ctx.ast, CompilerEnv.library) catch |err| {
        std.debug.print("error[KORU047]: C emission failed at open: {s}\n", .{@errorName(err)});
        std.process.exit(1);
    };
    var updated_ctx = ctx;
    updated_ctx.passes_completed += 1;
    updated_ctx.current_pass = "emit-c-open";
    return .{ .ctx = updated_ctx, .session = @intFromPtr(session) };
}

~[comptime] pub tor emit-c-decls { ctx: std/compiler:CompilerContext, session: usize } -> { ctx: std/compiler:CompilerContext, session: usize }

~proc emit-c-decls|zig {
    const c_emitter = @import("c_emitter");
    const s: *c_emitter.Session = @ptrFromInt(session);
    c_emitter.sessionDeclPass(s) catch |err| {
        std.debug.print("error[KORU047]: C emission failed at decls: {s}\n", .{@errorName(err)});
        std.process.exit(1);
    };
    var updated_ctx = ctx;
    updated_ctx.passes_completed += 1;
    updated_ctx.current_pass = "emit-c-decls";
    return .{ .ctx = updated_ctx, .session = session };
}

~[comptime] pub tor emit-c-defs { ctx: std/compiler:CompilerContext, session: usize } -> { ctx: std/compiler:CompilerContext, session: usize }

~proc emit-c-defs|zig {
    const c_emitter = @import("c_emitter");
    const s: *c_emitter.Session = @ptrFromInt(session);
    c_emitter.sessionDefPass(s) catch |err| {
        std.debug.print("error[KORU047]: C emission failed at defs: {s}\n", .{@errorName(err)});
        std.process.exit(1);
    };
    var updated_ctx = ctx;
    updated_ctx.passes_completed += 1;
    updated_ctx.current_pass = "emit-c-defs";
    return .{ .ctx = updated_ctx, .session = session };
}

~[comptime] pub tor emit-c-driver { ctx: std/compiler:CompilerContext, session: usize } -> { ctx: std/compiler:CompilerContext, session: usize }

~proc emit-c-driver|zig {
    const c_emitter = @import("c_emitter");
    const s: *c_emitter.Session = @ptrFromInt(session);
    c_emitter.sessionDriverPass(s) catch |err| {
        std.debug.print("error[KORU047]: C emission failed at driver: {s}\n", .{@errorName(err)});
        std.process.exit(1);
    };
    var updated_ctx = ctx;
    updated_ctx.passes_completed += 1;
    updated_ctx.current_pass = "emit-c-driver";
    return .{ .ctx = updated_ctx, .session = session };
}

~[comptime] pub tor emit-c-close { ctx: std/compiler:CompilerContext, session: usize } -> { ctx: std/compiler:CompilerContext, code: string, artifact: string }

~proc emit-c-close|zig {
    const c_emitter = @import("c_emitter");
    const emit_walk = @import("emit_walk");
    const s: *c_emitter.Session = @ptrFromInt(session);
    const code = c_emitter.sessionClose(s) catch |err| {
        std.debug.print("error[KORU047]: C emission failed at close: {s}\n", .{@errorName(err)});
        std.process.exit(1);
    };
    c_emitter.sessionDestroy(s);
    // The artifact name is the target row's claim — the literal is the
    // pre-catalog spelling, kept while the catalog is advisory.
    const artifact = emit_walk.targetField(ctx.allocator, "c", "artifact") orelse "output_emitted.c";
    var updated_ctx = ctx;
    updated_ctx.passes_completed += 1;
    updated_ctx.current_pass = "emission";
    return .{ .ctx = updated_ctx, .code = code, .artifact = artifact };
}
