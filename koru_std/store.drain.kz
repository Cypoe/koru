// Koru Standard Library: the `drain` part of store.kz.
// Joined via `~part drain` in store.kz; merged into the module at load.

// ------------------------------------------------------------------
// Drain — a rule whose row body is exactly `take(s[e])` with a discard
// `| item` removes every row the invoked sweep visits. Per-row take
// reads every column into the payload and swap-writes the last row's
// columns into the freed slot — work for the payload's sake and for
// survivor liveness. A drain has neither.
//
// What stays observable: every live slot's generation bumps once, the
// freelist grows in sequential-take push order — `row_hslot[0]`, then
// `row_hslot[n-1]` down to `row_hslot[1]` (take removes index 0 each
// iteration, so the tail row drops into the hole and dies next) — and
// every freed slot's hslot_row is tombstoned. That is a READ-ONLY
// traversal of the mapping: no swap, no fixup, no column traffic; the
// post-state equals sequential take's modulo dead bytes insert
// overwrites. Slot-reuse order after a refill IS observable, so this
// reproduces take's bookkeeping rather than calling the clear unit.
// Every doubt declines the site: `when` makes the walk selective, a
// `| item` read makes materialisation load-bearing, an owned column
// discharges one obligation at a time, a `! removed` arm fires per row.
// An index column is NO doubt — take reseats nothing and dead handles
// idle in buckets — so a teardown leaves the index exactly as
// sequential take would. A declined site stays per-row take.
// ------------------------------------------------------------------

const DrainScan = struct {
    const ast = @import("ast");

    // The pre-rewrite body is one `take(s[row_bind])` site whose
    // continuations are all empty `item`/`empty` arms — the payload
    // may be bound but nothing else runs per row.
    fn isBody(store: []const u8, body: *const ast.Continuation, row_bind: []const u8) bool {
        const node = body.node orelse return false;
        const inv = switch (node) {
            .invocation => |iv| iv,
            else => return false,
        };
        if (!TakeScan.isTakeOn(store, &inv)) return false;
        var addressed = false;
        for (inv.args) |a| {
            if (!std.mem.eql(u8, a.name, "expr")) continue;
            const v = if (a.value.len >= 2 and a.value[0] == '"') a.value[1 .. a.value.len - 1] else a.value;
            const lb = std.mem.indexOfScalar(u8, v, '[') orelse return false;
            if (!std.mem.endsWith(u8, v, "]")) return false;
            if (!std.mem.eql(u8, std.mem.trim(u8, v[0..lb], " "), store)) return false;
            if (!std.mem.eql(u8, std.mem.trim(u8, v[lb + 1 .. v.len - 1], " "), row_bind)) return false;
            addressed = true;
        }
        if (!addressed) return false;
        for (body.continuations) |c| {
            if (!std.mem.eql(u8, c.branch, "item") and !std.mem.eql(u8, c.branch, "empty")) return false;
            if (c.node) |cn| {
                if (cn != .terminal) return false;
            }
            if (c.kind != .terminal) return false;
            if (c.continuations.len > 0 or c.condition != null or c.destructure.len > 0) return false;
        }
        return true;
    }

    // The body a drain-lowered site emits — the freelist order and
    // bookkeeping of sequential take, read off the original mapping.
    fn sweepBody(alloc: std.mem.Allocator, host_is_js: bool, store: []const u8) []const u8 {
        if (host_is_js) return std.fmt.allocPrint(alloc,
            \\const __koru_dn = __koru_store_{s}.len;
            \\if (__koru_dn > 0) {{
            \\  let __koru_slot = __koru_store_{s}.__koru_row_hslot[0];
            \\  __koru_store_{s}.__koru_hslot_gen[__koru_slot] = (__koru_store_{s}.__koru_hslot_gen[__koru_slot] + 1) % 2097152;
            \\  __koru_store_{s}.__koru_hslot_row[__koru_slot] = -1;
            \\  __koru_store_{s}.__koru_hslot_free[__koru_store_{s}.__koru_hslot_free_len] = __koru_slot;
            \\  __koru_store_{s}.__koru_hslot_free_len += 1;
            \\  for (let __koru_k = 1; __koru_k < __koru_dn; __koru_k++) {{
            \\    __koru_slot = __koru_store_{s}.__koru_row_hslot[__koru_dn - __koru_k];
            \\    __koru_store_{s}.__koru_hslot_gen[__koru_slot] = (__koru_store_{s}.__koru_hslot_gen[__koru_slot] + 1) % 2097152;
            \\    __koru_store_{s}.__koru_hslot_row[__koru_slot] = -1;
            \\    __koru_store_{s}.__koru_hslot_free[__koru_store_{s}.__koru_hslot_free_len] = __koru_slot;
            \\    __koru_store_{s}.__koru_hslot_free_len += 1;
            \\  }}
            \\  __koru_store_{s}.len = 0;
            \\}}
            \\return;
        , .{ store, store, store, store, store, store, store, store, store, store, store, store, store, store, store, store }) catch unreachable;
        return std.fmt.allocPrint(alloc,
            \\const __koru_dn = __koru_store_{s}.len;
            \\if (__koru_dn > 0) {{ __koru_store_{s}.__koru_gen0 = false;
            \\    if (__koru_store_{s}.__koru_ident) {{
            \\        __koru_store_{s}.__koru_ident = false;
            \\        // Identity: freelist 0, n-1 .. 1, free_len 0; tombstones are dead bytes.
            \\        for (0..__koru_dn) |__koru_i| __koru_store_{s}.__koru_hslot_gen[__koru_i] +%= 1;
            \\        __koru_store_{s}.__koru_hslot_free[0] = 0;
            \\        for (1..__koru_dn) |__koru_k| __koru_store_{s}.__koru_hslot_free[__koru_k] = __koru_dn - __koru_k;
            \\        __koru_store_{s}.__koru_hslot_free_len = __koru_dn;
            \\    }} else {{
            \\        const __koru_slot0 = __koru_store_{s}.__koru_row_hslot[0];
            \\        __koru_store_{s}.__koru_hslot_gen[__koru_slot0] +%= 1;
            \\        __koru_store_{s}.__koru_hslot_row[__koru_slot0] = @import("std").math.maxInt(usize);
            \\        __koru_store_{s}.__koru_hslot_free[__koru_store_{s}.__koru_hslot_free_len] = __koru_slot0;
            \\        __koru_store_{s}.__koru_hslot_free_len += 1;
            \\        for (1..__koru_dn) |__koru_k| {{
            \\            const __koru_slot = __koru_store_{s}.__koru_row_hslot[__koru_dn - __koru_k];
            \\            __koru_store_{s}.__koru_hslot_gen[__koru_slot] +%= 1;
            \\            __koru_store_{s}.__koru_hslot_row[__koru_slot] = @import("std").math.maxInt(usize);
            \\            __koru_store_{s}.__koru_hslot_free[__koru_store_{s}.__koru_hslot_free_len] = __koru_slot;
            \\            __koru_store_{s}.__koru_hslot_free_len += 1;
            \\        }}
            \\    }}
            \\    __koru_store_{s}.len = 0;
            \\}}
            \\return;
        , .{ store, store, store, store, store, store, store, store, store, store, store, store, store, store, store, store, store, store, store, store, store }) catch unreachable;
    }
};
