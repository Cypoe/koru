// PINS: the each-name-once law holds across paths — every destructure
// entry emits one `const <local>`, so `{ user.x, x }` binds `x` twice and
// refuses PARSE010 at the arm line. The sibling `{ user.y, x }` binds
// distinct names and stays legal.
~import std/io
const std = @import("std");
const Point = struct { x: i64, y: i64 };

~tor fetch { id: i64 }
| found { user: Point, x: i64 }
| missing

~proc fetch|zig {
    if (id == 1) return .{ .found = .{ .user = .{ .x = 1, .y = 2 }, .x = 9 } };
    return .{ .missing = .{} };
}

~fetch(id: 1)
| found { user.x, x } |> std/io:print.ln("x = {{ x:d }}")
| missing |> std/io:print.ln("nope")
