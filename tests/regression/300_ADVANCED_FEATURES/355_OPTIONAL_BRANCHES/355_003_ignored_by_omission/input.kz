// Test 355_003: Optional Branches - Ignored by Omission
//
// Verifies:
// 1. Optional branches can be COMPLETELY IGNORED
// 2. Omission is the entire mechanism — nothing to write
// 3. Only required branches need handlers

~import std/io

// Event with required + multiple optional branches
// success is REQUIRED, warning and debug are OPTIONAL (ignored)
~tor analyze { value: u32 }
| success u32
| ?warning string
| ?debug string

~proc analyze|zig {
    if (value > 100) {
        return .{ .warning = "Large value" };
    }
    return .{ .success = value * 2 };
}

// value=50 → success
~analyze(value: 50)
| success _ |> std/io:print.ln("SUCCESS")
// No warning arm — optional branches just ignored

// value=150 → warning (optional, no handler — silently ignored)
~analyze(value: 150)
| success _ |> std/io:print.ln("SUCCESS")
