// Koru Standard Library: the `qbinds` part of store.kz.
// Joined via `~part qbinds` in store.kz; merged into the store module at load.

// The path half of sweep capture collection — the walk that answers "which
// enclosing names can this transplanted body see" (arm bindings, destructure
// fields, mid-pipe return binds, `! each` loop items) and the pick that turns
// in-scope into captured once a body's own refs are known. `Cap` keeps the
// Bind record and the reference scans; the walk lives here so qcaps stays
// under its line pin.
const Binds = struct {
    const ast = @import("ast");
    /// `for`'s `expr` arg — the iterable text an `! each` binding iterates.
    fn forIterableExpr(inv: *const ast.Invocation) ?[]const u8 {
        for (inv.args) |a| {
            if (std.mem.eql(u8, a.name, "expr")) return a.value;
        }
        return null;
    }
    fn isForTor(path: ast.DottedPath) bool {
        if (path.segments.len != 1 or !std.mem.eql(u8, path.segments[0], "for")) return false;
        const mq = path.module_qualifier orelse "";
        return mq.len == 0 or std.mem.eql(u8, mq, "std.control");
    }
    fn isIdentChar(ch: u8) bool {
        return Cap.isIdentStart(ch) or (ch >= '0' and ch <= '9') or ch == '-';
    }
    fn isBareIdent(t: []const u8) bool {
        if (t.len == 0 or !Cap.isIdentStart(t[0])) return false;
        for (t) |ch| {
            if (!isIdentChar(ch)) return false;
        }
        return true;
    }
    /// Element type of a `for` iterable when this layer can name it: a
    /// top-level `a..b` range iterates usize; an `&[_]T{…}`/`[_]T{…}`
    /// literal iterates T. A bare `name` and everything else return null —
    /// the caller records the expr in `each_iter` and the post-pass /
    /// refusal share the "?" type as the un-named marker.
    fn eachElemType(alloc: std.mem.Allocator, expr: []const u8) ?[]const u8 {
        const t = std.mem.trim(u8, expr, " \t");
        if (t.len == 0) return null;
        const mask = ast.expressionMask(alloc, t);
        var i: usize = 0;
        var depth: usize = 0;
        while (i < t.len) : (i += 1) {
            if (!mask[i]) continue;
            const ch = t[i];
            if (ch == '(' or ch == '[' or ch == '{') depth += 1;
            if (ch == ')' or ch == ']' or ch == '}') depth -|= 1;
            if (ch == '.' and depth == 0 and i + 1 < t.len and t[i + 1] == '.') return "usize";
        }
        var s = t;
        if (s[0] == '&') s = std.mem.trim(u8, s[1..], " \t");
        if (s.len > 0 and s[0] == '[') {
            const close = std.mem.indexOfScalar(u8, s, ']') orelse return null;
            const rest = std.mem.trim(u8, s[close + 1 ..], " \t");
            const brace = std.mem.indexOfScalar(u8, rest, '{') orelse return null;
            const elt = std.mem.trim(u8, rest[0..brace], " \t");
            if (elt.len > 0) return alloc.dupe(u8, elt) catch unreachable;
        }
        return null;
    }
    /// Element type of a bind's own declared type — `[]T`/`[N]T`/`[]const T`
    /// iterate T; leading `?`/`*` decorators strip off first.
    fn iterElemType(ty: []const u8) ?[]const u8 {
        var s = std.mem.trim(u8, ty, " \t");
        while (s.len > 0 and (s[0] == '*' or s[0] == '?')) s = std.mem.trim(u8, s[1..], " \t");
        if (std.mem.startsWith(u8, s, "[]")) {
            s = std.mem.trim(u8, s[2..], " \t");
            if (std.mem.startsWith(u8, s, "const ")) s = std.mem.trim(u8, s[6..], " \t");
            return if (s.len > 0) s else null;
        }
        if (s.len > 0 and s[0] == '[') {
            const close = std.mem.indexOfScalar(u8, s, ']') orelse return null;
            const rest = std.mem.trim(u8, s[close + 1 ..], " \t");
            return if (rest.len > 0) rest else null;
        }
        return null;
    }
    /// Second pass for `! each` binds whose `for` iterable named nothing
    /// this layer could type: a bare `for(name)` resolves its element off
    /// a collected bind's own `[]T`/`[N]T` once every ancestor is in.
    /// What still cannot be named keeps the "?" marker — a body that
    /// captures it refuses rather than emit an untyped field.
    fn resolveEachIters(alloc: std.mem.Allocator, avail: []Cap.Bind) void {
        for (avail) |*b| {
            if (!std.mem.eql(u8, b.type, "?")) continue;
            const it = b.each_iter orelse continue;
            if (!isBareIdent(it)) continue;
            for (avail) |t| {
                if (!std.mem.eql(u8, t.name, it)) continue;
                if (iterElemType(t.type)) |et| b.type = alloc.dupe(u8, et) catch unreachable;
            }
        }
    }
    /// One refusal text for every sweep boundary an `! each` bind with an
    /// un-nameable element type tries to cross — the sweep body and the
    /// `| none` arm refuse identically, so the teaching stays one string.
    /// `ctx` spells which body did the reading ("the sweep body", "the
    /// `| none` body").
    fn eachUntypedMsg(alloc: std.mem.Allocator, ctx: []const u8, store_name: []const u8, b: Cap.Bind) []const u8 {
        return std.fmt.allocPrint(alloc, "std/store:query({s}): {s} reads '{s}', bound by `! each` over `{s}` — the iterable's element type is not derivable at the sweep boundary. A range `a..b`, an `&[_]T{{…}}` literal, or a `[]T`/`[N]T` iterable names one; anything else needs the value lifted through a typed binding first.", .{ store_name, ctx, b.name, b.each_iter orelse b.name }) catch unreachable;
    }
    /// A body-arm's capture pick: an avail bind rides the body input only
    /// when the body references it, once each; "?" marks an `! each` bind
    /// whose iterable named no element — refuse rather than emit an untyped
    /// field. `lexical` counts picks that need the enclosing frame.
    const Picked = struct { caps: std.ArrayList(Cap.Bind), lexical: usize };
    fn pickCaptures(alloc: std.mem.Allocator, avail: []const Cap.Bind, refs: []const []const u8, ctx: []const u8, store_name: []const u8) union(enum) { ok: Picked, refuse: []const u8 } {
        var caps = std.ArrayList(Cap.Bind).initCapacity(alloc, 4) catch unreachable;
        var lexical: usize = 0;
        for (avail) |b| {
            var used = false;
            for (refs) |r| {
                if (std.mem.eql(u8, r, b.name)) {
                    used = true;
                    break;
                }
            }
            if (!used) continue;
            if (std.mem.eql(u8, b.type, "?")) return .{ .refuse = eachUntypedMsg(alloc, ctx, store_name, b) };
            var seen = false;
            for (caps.items) |c| {
                if (std.mem.eql(u8, c.name, b.name)) {
                    seen = true;
                    break;
                }
            }
            if (seen) continue;
            caps.append(alloc, b) catch unreachable;
            if (b.lexical) lexical += 1;
        }
        return .{ .ok = .{ .caps = caps, .lexical = lexical } };
    }
    fn collectBindsOnPath(alloc: std.mem.Allocator, items: []const ast.Item, cont: *const ast.Continuation, target: *const ast.Invocation, out: *std.ArrayList(Cap.Bind)) bool {
        // Returns true if `target` lives under `cont`. Pushes mid-pipe binds
        // on the path TO the target (ancestors only — not sibling arms or
        // the sweep body itself).
        if (cont.node) |*n| {
            if (n.* == .invocation and &n.invocation == target) return true;
        }
        for (cont.continuations) |*c| {
            if (collectBindsOnPath(alloc, items, c, target, out)) {
                // The CHILD's arm binding is in scope for everything under
                // it, so a sweep body nested in `! draw w` or `! progress
                // pr` reads those names — and until this was recorded, the
                // transplanted body got `use of undeclared identifier 'w'`.
                // Its type is the branch payload on THIS cont's invocation,
                // which is the tor whose branches the child arm handles.
                //
                // gallery works around the gap by binding a sub-window
                // mid-pipe first (`sub(parent: win, …): root`), which lands
                // in the return_binding case below. That is a fine spelling
                // and not the only one: an arm payload has no call to hang
                // a mid-pipe bind on.
                if (c.binding) |ab| {
                    if (!std.mem.eql(u8, ab, "_") and !std.mem.startsWith(u8, ab, "_")) {
                        if (cont.node) |*pn| {
                            if (pn.* == .invocation) {
                                if (RetQual.lookupBranch(items, pn.invocation.path, std.mem.trim(u8, c.branch, " "))) |bt| {
                                    out.append(alloc, .{
                                        .name = ab,
                                        .type = alloc.dupe(u8, bt.type) catch unreachable,
                                        .module_path = if (bt.module_path) |mp| alloc.dupe(u8, mp) catch unreachable else null,
                                        // The payload's obligation rides along, QUALIFIED with the
                                        // module that declared it. Without the phantom at all the
                                        // synthesized sweep-body input declares a bare type and the
                                        // checker sees an untracked name; without the qualifier the
                                        // state resolves against the CONSUMER's module and the
                                        // mismatch reads `expected 'std.list:list' but got
                                        // 'myprog:list'` (690_252).
                                        //
                                        // Written in the prefixed `mod:!state` spelling that the
                                        // rest of this file's phantom handling expects, from the
                                        // author's bare trailing-bang `state!`.
                                        .phantom = if (bt.phantom) |ph| blk_bph: {
                                            if (std.mem.indexOfScalar(u8, ph, ':') != null) break :blk_bph alloc.dupe(u8, ph) catch unreachable;
                                            const owed = ph.len > 1 and ph[ph.len - 1] == '!';
                                            const base = if (owed) ph[0 .. ph.len - 1] else ph;
                                            const mp = bt.module_path orelse break :blk_bph alloc.dupe(u8, ph) catch unreachable;
                                            break :blk_bph std.fmt.allocPrint(alloc, "{s}:{s}{s}", .{ mp, if (owed) "!" else "", base }) catch unreachable;
                                        } else null,
                                    }) catch unreachable;
                                } else blk_each: {
                                    // `! each x` on `std.control:for` — the
                                    // payload is wildcard `*`, so lookupBranch
                                    // cannot type it (690_370). The binding is
                                    // the loop ITEM: its type is the iterable's
                                    // element — `a..b` iterates usize, `[_]T{…}`
                                    // iterates T. A bare `for(name)` defers to
                                    // resolveEachIters against the collected
                                    // binds; what cannot be named stays "?" and
                                    // refuses if a body captures it.
                                    if (!std.mem.eql(u8, std.mem.trim(u8, c.branch, " "), "each")) break :blk_each;
                                    if (!isForTor(pn.invocation.path)) break :blk_each;
                                    const expr = forIterableExpr(&pn.invocation) orelse break :blk_each;
                                    out.append(alloc, .{
                                        .name = ab,
                                        .type = eachElemType(alloc, expr) orelse "?",
                                        .each_iter = alloc.dupe(u8, expr) catch unreachable,
                                    }) catch unreachable;
                                }
                            }
                        }
                    }
                }
                // A DESTRUCTURE arm (`! removed { id }`) binds its fields
                // the same way — the interceptor-payload threading
                // (690_093). The fields are the create's store columns, so
                // the type resolves from the parent invocation's seed
                // block, not lookupBranch (a record payload has no single
                // type to return). Skipped when the parent is not a
                // std.store:new — a generic destructure's field types are
                // a record lookup this pass does not do, and an untyped
                // capture is worse than none.
                if (c.destructure.len > 0) {
                    if (cont.node) |*pn| {
                        if (pn.* == .invocation) {
                            const is_create = blk: {
                                if (pn.invocation.path.module_qualifier) |mq| {
                                    if (std.mem.eql(u8, mq, "std.store") and pn.invocation.path.segments.len == 1 and std.mem.eql(u8, pn.invocation.path.segments[0], "new")) break :blk true;
                                }
                                break :blk false;
                            };
                            if (is_create) {
                                for (c.destructure) |df| {
                                    if (Cap.storeColumnType(alloc, &pn.invocation, df.name)) |ft| {
                                        out.append(alloc, .{ .name = alloc.dupe(u8, df.name) catch unreachable, .type = ft }) catch unreachable;
                                    }
                                }
                            }
                        }
                    }
                }
                // Child path hit — this cont is an ancestor. Record its
                // mid-pipe bind if any, then bubble up.
                if (cont.node) |*n| {
                    if (n.* == .invocation) {
                        if (n.invocation.return_binding) |rb| {
                            if (RetQual.lookupReturn(items, n.invocation.path)) |rt| {
                                // Zig treats two identical anonymous structs
                                // as distinct types. fmt:ln's `.{ .text = … }`
                                // will not coerce into the captured field, so
                                // the call site rebuilds through result
                                // location (690_294).
                                const rebuild = std.mem.eql(u8, rt.type, "struct { text: []const u8 }");
                                out.append(alloc, .{
                                    .name = rb,
                                    .type = alloc.dupe(u8, rt.type) catch unreachable,
                                    .module_path = if (rt.module_path) |mp| alloc.dupe(u8, mp) catch unreachable else null,
                                    // Same rule as the arm-binding capture above:
                                    // the RETURN's obligation rides along, in the
                                    // prefixed `mod:!state` spelling lookupReturnIn
                                    // builds off `return_phantom`. Without it the
                                    // synthesized sweepbody input declares the bare
                                    // type and the checker reads the capture as
                                    // untracked (KORU030).
                                    .phantom = if (rt.phantom) |ph| alloc.dupe(u8, ph) catch unreachable else null,
                                    .value = if (rebuild) std.fmt.allocPrint(alloc, ".{{ .text = {s}.text }}", .{rb}) catch unreachable else null,
                                }) catch unreachable;
                            } else {
                                out.append(alloc, .{
                                    .name = rb,
                                    .type = alloc.dupe(u8, "i64") catch unreachable,
                                }) catch unreachable;
                            }
                        }
                    }
                }
                return true;
            }
        }
        return false;
    }
};
