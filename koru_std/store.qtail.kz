// Koru Standard Library: the `qtail` part of store.kz — the query site's
// continuation-tail plumbing: the named-arms/branchless-sequel split, the
// sweep-run unit's capture re-threading, and the unit's assembly.
// Joined via `~part qtail` in store.kz; merged into the store module at load.

const QTail = struct {
    const ast = @import("ast");
    const errors = @import("errors");
    const H = struct {
        const mkPathH = @import("emitter_helpers").mkPathH;
        const stripQuotes = @import("emitter_helpers").stripQuotes;
        // An owned column's __store_insert phantom is the CONSUMING form
        // `mod:!state` (ownership moves IN). A sweep projects it as a BARE BORROW
        // `mod:state` (no `!`) — read accepts it and consumes nothing, so the
        // store keeps the live `<state!>` it frees at teardown (query's qbody does
        // the same). Strip the `!` right after the `:`.
        const bareBorrow = @import("emitter_helpers").bareBorrow;
        const isKebabIdentChar = @import("emitter_helpers").isKebabIdentChar;
    };

    /// `flow.body.continuations` carries two different things. The NAMED arms
    /// (`! query` / `! first` / `| none`) are this site's vocabulary — the
    /// transform claims them. A BRANCHLESS continuation is a `|>` step the
    /// chain resumed with after the arm block: inside an arm body the query
    /// is a step in a chain, not the statement's site, and the tail must run
    /// after the sweep — it used to be dropped with the arms' whole list when
    /// the replacement re-rooted (690_366). A NAMED arm the site does not
    /// claim is the same failure in the other direction: it can never run, so
    /// it is refused by name (690_364).
    const Split = struct { tail: []const ast.Continuation, refused: ?ast.SiteResult };
    fn siteTail(alloc: std.mem.Allocator, reporter: anytype, flow: *const ast.Flow, store_name: []const u8) Split {
        var tail = std.ArrayList(ast.Continuation).initCapacity(alloc, 4) catch unreachable;
        for (flow.body.continuations) |c| {
            const bname = std.mem.trim(u8, c.branch, " \t");
            if (bname.len == 0 and !c.is_catchall) {
                tail.append(alloc, c) catch unreachable;
                continue;
            }
            if (std.mem.eql(u8, bname, "query") or std.mem.eql(u8, bname, "first") or std.mem.eql(u8, bname, "none")) continue;
            return .{ .tail = tail.items, .refused = ast.refuse(alloc, reporter, .KORU161, flow.location, flow.module, "std/store:query({s}): the '{s}' branch is not one a query site answers — `! query <row>`, `! first <row>` and `| none` are the site's arms; an arm the site does not claim can never run", .{ store_name, bname }) };
        }
        return .{ .tail = tail.items, .refused = null };
    }

    /// Lexical captures the loop still reads, re-threaded as the lifted tor's
    /// inputs — reachable only when a tail kept a head site off the proc road;
    /// the input set is what the emitted loop text actually names.
    const Captures = struct { fields: []ast.Field, args: []ast.Arg };
    fn srunCaptures(alloc: std.mem.Allocator, avail: []const Cap.Bind, loop_text: []const u8, has_lexical: bool) Captures {
        var fields = std.ArrayList(ast.Field).initCapacity(alloc, 4) catch unreachable;
        var args = std.ArrayList(ast.Arg).initCapacity(alloc, 4) catch unreachable;
        if (has_lexical) {
            for (avail) |b| {
                if (!b.lexical) continue;
                if (!nameInHostText(alloc, loop_text, b.name)) continue;
                fields.append(alloc, ast.Field{
                    .name = alloc.dupe(u8, b.name) catch unreachable,
                    .type = alloc.dupe(u8, b.type) catch unreachable,
                    .module_path = b.module_path,
                    .phantom = if (b.phantom) |ph| blk_ph: {
                        if (ph.len > 1 and ph[ph.len - 1] == '!') break :blk_ph alloc.dupe(u8, ph[0 .. ph.len - 1]) catch unreachable;
                        break :blk_ph H.bareBorrow(alloc, ph);
                    } else null,
                }) catch unreachable;
                args.append(alloc, ast.Arg{
                    .name = alloc.dupe(u8, b.name) catch unreachable,
                    .value = alloc.dupe(u8, b.value orelse b.name) catch unreachable,
                }) catch unreachable;
            }
        }
        return .{ .fields = fields.items, .args = args.items };
    }

    /// A boundary-aware name occurrence in emitted host text — the srun-input
    /// set is exactly the lexical captures the loop text still names.
    fn nameInHostText(alloc: std.mem.Allocator, text: []const u8, name: []const u8) bool {
        if (name.len == 0) return false;
        const mask = ast.expressionMask(alloc, text);
        var i: usize = 0;
        while (i + name.len <= text.len) : (i += 1) {
            if (!mask[i]) continue;
            if (!ast.identBoundaryBefore(text, i) or (i > 0 and text[i - 1] == '.')) continue;
            if (!std.mem.startsWith(u8, text[i..], name)) continue;
            const after = i + name.len;
            if (after < text.len and H.isKebabIdentChar(text[after])) continue;
            return true;
        }
        return false;
    }

    /// The head-site sweep-run road: mint `__store_sweeprun_<store>_L<line>_`
    /// and its proc, then re-root the site as a call into it — carrying the
    /// branchless `|>` tail as the site's continuations so it emits after the
    /// sweep instead of evaporating (690_366).
    fn sweepRunSite(alloc: std.mem.Allocator, flow: *const ast.Flow, store_name: []const u8, sc_loc: errors.SourceLocation, home_ns: []const u8, proc_target: []const u8, host_is_cs: bool, retain_ann: []const []const u8, loop_text: []const u8, tail: []const ast.Continuation, cap: Captures, appended: *std.ArrayList(ast.Item)) ast.SiteResult {
        // Same arm-line key as sbody_name above — the two must agree.
        const srun_name = std.fmt.allocPrint(alloc, "__store_sweeprun_{s}_L{d}_{s}", .{ store_name, sc_loc.line, storeSiteTag(alloc, sc_loc.file) }) catch unreachable;
        appended.append(alloc, ast.Item{ .event_decl = ast.EventDecl{
            .path = H.mkPathH(alloc, home_ns, srun_name),
            .input = ast.Shape{ .fields = cap.fields },
            .branches = &[_]ast.Branch{},
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann,
            .location = flow.location,
            .module = alloc.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        const srun_body = std.fmt.allocPrint(alloc, "{s}{s}", .{ loop_text, if (host_is_cs) "" else "return;" }) catch unreachable;
        appended.append(alloc, ast.Item{ .proc_decl = ast.ProcDecl{
            .path = H.mkPathH(alloc, home_ns, srun_name),
            .body = ast.Source{ .text = srun_body, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
            .annotations = &[_][]const u8{},
            .target = alloc.dupe(u8, proc_target) catch unreachable,
            .location = flow.location,
            .module = alloc.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        const srun_inv = ast.Invocation{
            .path = H.mkPathH(alloc, home_ns, srun_name),
            .args = cap.args,
            .source_module = alloc.dupe(u8, flow.module) catch unreachable,
        };
        return .{ .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(srun_inv, tail, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .super_shape = null,
            .inline_body = null,
            .preamble_code = null,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = alloc.dupe(u8, flow.module) catch unreachable,
        } }, .appended = appended.toOwnedSlice(alloc) catch unreachable, .consumed_arms = &.{ "query", "first", "none" } };
    }
};
