// 330_145 companion module — the window/frames analog as minimal tors.
const std = @import("std");

pub const Win = struct { n: i32 };

// Producer: issues the opened! obligation on | win.
~pub tor open {} | win *Win<opened!> | err string
~proc open|zig {
    const w = std.heap.page_allocator.create(Win) catch unreachable;
    w.* = .{ .n = 1 };
    return .{ .win = w };
}

// A read needing the live states — the window.size(win: w) analog.
~pub tor read { w: *Win<opened|active> }
~proc read|zig { _ = w.n; }

// Settles the active! obligation that | done hands back.
~pub tor close { w: *Win<!active> }
~proc close|zig { std.heap.page_allocator.destroy(w); }

// Event-loop discharger — the frames analog: takes custody of w for the
// loop's duration, fires ! tick per iteration, hands active! back on done.
~pub tor pump { w: *Win<!opened|!active> }
! tick i64
| done *Win<active!>
~proc pump|zig {
    tick(0);
    return .{ .done = w };
}
