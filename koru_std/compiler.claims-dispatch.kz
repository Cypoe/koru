// Koru Standard Library: the `claims-dispatch` part of compiler.kz.
// Joined via `~part claims-dispatch` in compiler.kz; merged into the
// compiler module at load — shares the claims parts' types and the
// `spec` alias. This part owns the MULTI-WAY dispatch reading: a
// `cond` impl's arms are a first-match cascade, so arm i's premise is
// its own guard's cases MINUS every earlier arm's — `g_i ∧ ¬g_1 ∧ …
// ∧ ¬g_{i-1}`, a product of clause sets the same DNF machinery reads.
//
// Three rules keep it honest:
//   * a guardless `| c _` arm is the default — every LATER arm's
//     premise is empty (unreachable), so it contributes no meets at
//     all and discharges nothing vacuously it shouldn't;
//   * the arm binding (`| c p when p == 0`) reads as the scrutinee —
//     the guard text is renamed identifier-for-identifier before the
//     linear parser sees it, so shadowing a field name is sound;
//   * the scrutinee must be one integer field — `cond(f(x))` or a
//     non-integer names a named outside-P, never a guess.

// Whole-identifier rename in guard text — `p == 0` with binding `p`
// and scrutinee `i` reads `i == 0`. Quote-delimited spans are left
// alone: a char literal naming the binding stays a char literal.
fn claimsRenameIdent(
    alloc: std.mem.Allocator,
    text: []const u8,
    from: []const u8,
    to: []const u8,
) []const u8 {
    if (from.len == 0 or std.mem.eql(u8, from, "_") or std.mem.eql(u8, from, to)) return text;
    const ident = struct {
        fn ok(c: u8) bool {
            return std.ascii.isAlphanumeric(c) or c == '_';
        }
    }.ok;
    var out = std.ArrayListUnmanaged(u8){};
    var i: usize = 0;
    while (i < text.len) {
        const c = text[i];
        if (c == '\'' or c == '"') {
            const end = std.mem.indexOfScalarPos(u8, text, i + 1, c) orelse text.len - 1;
            out.appendSlice(alloc, text[i .. end + 1]) catch unreachable;
            i = end + 1;
            continue;
        }
        if (i == 0 or !ident(text[i - 1])) {
            var j = i;
            while (j < text.len and ident(text[j])) j += 1;
            if (std.mem.eql(u8, text[i..j], from)) {
                out.appendSlice(alloc, to) catch unreachable;
                i = j;
                continue;
            }
        }
        out.append(alloc, c) catch unreachable;
        i += 1;
    }
    return out.items;
}

// Clause-set product: every clause of `a` conjoined with every clause
// of `b`. This is `A ∧ B` at the case level — used to subtract earlier
// arms' negated cases from a later arm's own. Same budget as the DNF.
fn claimsClauseProduct(
    alloc: std.mem.Allocator,
    a: []const []const GuardCmp,
    b: []const []const GuardCmp,
) GuardCases {
    var out = std.ArrayListUnmanaged([]const GuardCmp){};
    for (a) |ca| {
        for (b) |cb| {
            var joined = std.ArrayListUnmanaged(GuardCmp){};
            joined.appendSlice(alloc, ca) catch unreachable;
            joined.appendSlice(alloc, cb) catch unreachable;
            out.append(alloc, joined.items) catch unreachable;
            if (out.items.len > GUARD_CASE_CAP)
                return .{ .outside = "the impl's dispatch case-splits past the fence's case budget" };
        }
    }
    return .{ .ok = out.items };
}

const ArmProduce = union(enum) {
    ok: struct { branch_name: []const u8, scalar_field: ?[]const u8 },
    outside: []const u8,
};

// What a dispatch arm produces: one branch constructor, terminal, pun
// fields or a scalar that IS a field. Shared by the if-dispatch and
// the cond cascade — a `->` value arm or a continuing arm is a named
// outside-P either way.
fn claimsArmProduce(
    alloc: std.mem.Allocator,
    cont: *const ast.Continuation,
    fields: []const ast.Field,
    subject: []const u8,
) ArmProduce {
    const bc_node = cont.node orelse
        return .{ .outside = std.fmt.allocPrint(alloc, "arm '{s}' produces nothing the fence reads", .{cont.branch}) catch unreachable };
    if (bc_node != .branch_constructor)
        return .{ .outside = std.fmt.allocPrint(alloc, "arm '{s}' is not produced by a branch constructor", .{cont.branch}) catch unreachable };
    const bc = &bc_node.branch_constructor;
    var scalar_field: ?[]const u8 = null;
    if (bc.plain_value) |pv| {
        const pv_t = std.mem.trim(u8, pv, " \t");
        if (claimsFieldListed(fields, pv_t)) {
            scalar_field = pv_t;
        } else {
            return .{ .outside = std.fmt.allocPrint(alloc, "arm '{s}' produces '{s}' — not a field of '{s}'", .{ bc.branch_name, pv_t, subject }) catch unreachable };
        }
    } else {
        for (bc.fields) |f| {
            const es = f.expression_str orelse
                return .{ .outside = std.fmt.allocPrint(alloc, "arm '{s}' field '{s}' carries no produce expression", .{ bc.branch_name, f.name }) catch unreachable };
            if (!claimsFieldListed(fields, f.name) or !std.mem.eql(u8, es, f.name))
                return .{ .outside = std.fmt.allocPrint(alloc, "arm '{s}' produces '{s}': '{s}' — the fence reads pun produces only", .{ bc.branch_name, f.name, es }) catch unreachable };
        }
    }
    if (cont.continuations.len != 0)
        return .{ .outside = std.fmt.allocPrint(alloc, "arm '{s}' continues past its produce — the fence reads terminal arms", .{cont.branch}) catch unreachable };
    return .{ .ok = .{ .branch_name = bc.branch_name, .scalar_field = scalar_field } };
}

// The cond cascade → arm case meets. Arm i's premise is its own guard
// under every earlier guard's negation — first-match means later arms
// see only what earlier arms left. One ArmMeet per surviving clause.
fn claimsCondArmMeets(
    alloc: std.mem.Allocator,
    inv: *const ast.Invocation,
    conts: []const ast.Continuation,
    fields: []const ast.Field,
    subject: []const u8,
    out: *std.ArrayListUnmanaged(ArmMeet),
) ?[]const u8 {
    if (inv.args.len == 0) return "the cond carries no scrutinee";
    const scrutinee = std.mem.trim(u8, inv.args[0].value, " \t");
    if (!claimsFieldListed(fields, scrutinee))
        return std.fmt.allocPrint(alloc, "the cond scrutinee '{s}' is not a field of '{s}' — the fence reads field scrutinees", .{ scrutinee, subject }) catch unreachable;
    if (!claimsIntField(fields, scrutinee))
        return std.fmt.allocPrint(alloc, "the cond scrutinee '{s}' is not an integer field — the rank grammar is integer-only", .{scrutinee}) catch unreachable;
    const empty_clause: []const GuardCmp = &.{};
    const catchall = [_][]const GuardCmp{empty_clause};
    var priors = std.ArrayListUnmanaged(?GuardExpr){};
    for (conts) |*cont| {
        var guard: ?GuardExpr = null;
        if (cont.condition) |ctext| {
            const renamed = if (cont.binding) |b| claimsRenameIdent(alloc, ctext, b, scrutinee) else ctext;
            guard = switch (claimsParseGuard(alloc, renamed, fields, subject)) {
                .outside => |m| return m,
                .ok => |e| e,
            };
        }
        var cases: []const []const GuardCmp = if (guard) |*ge| switch (claimsGuardCases(alloc, ge, false)) {
            .outside => |m| return m,
            .ok => |cs| cs,
        } else catchall[0..];
        for (priors.items) |*pg| {
            if (pg.*) |*ge| {
                const neg = switch (claimsGuardCases(alloc, ge, true)) {
                    .outside => |m| return m,
                    .ok => |cs| cs,
                };
                cases = switch (claimsClauseProduct(alloc, cases, neg)) {
                    .outside => |m| return m,
                    .ok => |cs| cs,
                };
            } else {
                cases = &.{}; // earlier default — this arm cannot fire
                break;
            }
        }
        switch (claimsArmProduce(alloc, cont, fields, subject)) {
            .outside => |m| return m,
            .ok => |prod| {
                for (cases) |clause| {
                    var rows = std.ArrayListUnmanaged(spec.LinRow){};
                    for (clause) |cmp| {
                        for (claimsGuardRows(alloc, cmp.lhs, cmp.rhs, cmp.op, cmp.neg, cmp.src)) |r|
                            rows.append(alloc, r) catch unreachable;
                    }
                    out.append(alloc, .{ .arm = prod.branch_name, .rows = rows, .scalar_field = prod.scalar_field }) catch unreachable;
                }
            },
        }
        priors.append(alloc, guard) catch unreachable;
    }
    return null;
}
