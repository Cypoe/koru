// Koru Standard Library: the `mint` part of tree.kz.
// Joined via `~part mint` in tree.kz; merged into the tree module.
//
// `std/tree:mint(Node) { item: v, left: l, right: r }` — create one node.
// The transform validates the arg block against Node's registered fields
// (required edges and payloads must be spelled; `?` fields may be omitted or
// null), synthesizes `mint-Node` into the caller's module on first use
// (dispatch-gap doctrine: the concrete per-type tor is synthesized, the lane
// verb routes), and rewrites the site to call it.
//
// The single-owner law is not a check here — it is the signature: edge
// params are `?*T<!owned>` / `*T<!owned>`, so an edge arg must be a fresh
// mint or `null`; re-using an already-bound child is a second consume of an
// owned binding, which the obligation checker already refuses.

~[comptime|transform]pub tor mint {
    expr: Expression,
    source: ?Source,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~proc mint|zig {
    const ast = @import("ast");
    const struct_literal = @import("struct_literal");

    const flow = if (item.* == .flow) &item.flow else @panic("std/tree:mint: expected a flow site");
    var type_name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "expr")) type_name = stripQuotesLocal(std.mem.trim(u8, arg.value, " \t"));
    }
    const home = TerminalRef_scopeOfFlow(program, flow);

    const decl = findNodeDecl(program, allocator, type_name, home) orelse {
        if (ast.declarationRefused(allocator, program, flow.module, "std/tree:node({s}):", .{type_name}))
            return .{};
        return ast.refuse(allocator, reporter, .KORU184, flow.location, flow.module, "std/tree:mint({s}): unknown node kind — no std/tree:node({s}) declares it in this scope", .{ type_name, type_name });
    };

    // The attached block — `mint(Node) { f: v, ... }`. It may ride the
    // `source` param or arrive as an arg's source_value.
    var block_text: ?[]const u8 = if (source) |s| s.text else null;
    if (block_text == null) {
        for (invocation.args) |a| {
            if (a.source_value) |sv| block_text = sv.text;
        }
    }
    const bt = block_text orelse {
        return ast.refuse(allocator, reporter, .KORU184, flow.location, flow.module, "std/tree:mint({s}): a mint needs a field block — mint({s}) {{ {s}: value, ... }}", .{ type_name, type_name, decl.fields[0].name });
    };

    const braced = std.fmt.allocPrint(allocator, "{{{s}}}", .{bt}) catch unreachable;
    const args_parsed = struct_literal.parseFields(allocator, braced) catch {
        return ast.refuse(allocator, reporter, .KORU184, flow.location, flow.module, "std/tree:mint({s}): malformed field block", .{type_name});
    };

    // Validate + collect: every arg names a declared field, each required
    // field is spelled, a `null` on a required edge is the type error it
    // looks like (a required child is never absent).
    var values = std.StringHashMap([]const u8).init(allocator);
    for (args_parsed) |a| {
        const v = if (std.mem.trim(u8, a.value, " \t").len == 0) a.name else std.mem.trim(u8, a.value, " \t");
        var known = false;
        for (decl.fields) |f| {
            if (std.mem.eql(u8, f.name, a.name)) {
                known = true;
                if (f.kind == .edge and !f.optional and std.mem.eql(u8, v, "null")) {
                    return ast.refuse(allocator, reporter, .KORU184, flow.location, flow.module, "std/tree:mint({s}): edge '{s}' is declared required (`{s}: {s}`, no `?`) — a null child is what `?{s}` spells", .{ type_name, f.name, f.name, f.edge_type, f.edge_type });
                }
            }
        }
        if (!known) {
            return ast.refuse(allocator, reporter, .KORU184, flow.location, flow.module, "std/tree:mint({s}): '{s}' is not a field of {s} — the declaration lists exactly the node's payload fields and edge slots", .{ type_name, a.name, type_name });
        }
        values.put(allocator.dupe(u8, a.name) catch unreachable, allocator.dupe(u8, v) catch unreachable) catch unreachable;
    }
    for (decl.fields) |f| {
        if (f.optional) continue;
        if (!values.contains(f.name)) {
            return ast.refuse(allocator, reporter, .KORU184, flow.location, flow.module, "std/tree:mint({s}): field '{s}' is required — non-`?` fields must be spelled at mint (spell `null` only on a `?` edge)", .{ type_name, f.name });
        }
    }

    // Synthesize mint-<Name> lazily — idempotent across stage re-fires.
    const synth_name = std.fmt.allocPrint(allocator, "mint-{s}", .{type_name}) catch unreachable;
    var appended: []const ast.Item = &.{};
    if (!hasSynthTor(program, synth_name)) {
        appended = synthMint(allocator, flow, decl, synth_name);
    }

    // Rewrite: std/tree:mint(Node) {..} -> <module>:mint-Node(f: v, ...)
    const new_args = allocator.alloc(ast.Arg, decl.fields.len) catch unreachable;
    for (decl.fields, 0..) |f, i| {
        new_args[i] = .{
            .name = allocator.dupe(u8, f.name) catch unreachable,
            .value = if (values.get(f.name)) |v| v else allocator.dupe(u8, "null") catch unreachable,
            .had_explicit_label = true,
        };
    }
    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    segs[0] = synth_name;
    // Mutate the site's own invocation — `: n` return bindings, `-> x`
    // produces, annotations, and variant selection all ride fields a
    // from-scratch Invocation would silently drop.
    var new_inv = invocation.*;
    new_inv.path = ast.DottedPath{
        .module_qualifier = allocator.dupe(u8, flow.module) catch unreachable,
        .segments = segs,
    };
    new_inv.args = new_args;
    // Swap ONLY the node — the `: n` bind, the `-> x` produce, and every
    // branch arm live on the wrapper continuation around it. A flow-level
    // replacement would have to re-derive them; a node replacement keeps
    // them exactly where the author wrote them.
    return .{ .replacement_node = .{ .node = ast.Node{ .invocation = new_inv } }, .appended = appended };
}

fn stripQuotesLocal(s0: []const u8) []const u8 {
    var s = s0;
    if (s.len >= 2 and s[0] == '"' and s[s.len - 1] == '"') s = s[1 .. s.len - 1];
    return s;
}

/// The per-type constructor pair: `mint-Node { <fields> } -> *Node<owned!>`
/// plus its `|zig` proc. Params ride declared field order; edge params are
// `?*T<!owned>` (optional) or `*T<!owned>` (required) — the consume that
/// moves each child's obligation inside the new node.
fn synthMint(
    allocator: std.mem.Allocator,
    flow: *const astz.Flow,
    decl: TreeDecl,
    synth_name: []const u8,
) []const astz.Item {
    const path = astz.DottedPath{
        .module_qualifier = allocator.dupe(u8, flow.module) catch unreachable,
        .segments = blk: {
            const segs = allocator.alloc([]const u8, 1) catch unreachable;
            segs[0] = allocator.dupe(u8, synth_name) catch unreachable;
            break :blk segs;
        },
    };
    const in = allocator.alloc(astz.Field, decl.fields.len) catch unreachable;
    var init = std.ArrayList(u8).initCapacity(allocator, 96) catch unreachable;
    for (decl.fields, 0..) |f, i| {
        switch (f.kind) {
            .payload => {
                in[i] = .{
                    .name = allocator.dupe(u8, f.name) catch unreachable,
                    .type = allocator.dupe(u8, f.zig_type) catch unreachable,
                    .phantom = null,
                };
                init.appendSlice(allocator, std.fmt.allocPrint(allocator, ".{s} = {s}, ", .{ f.name, f.name }) catch unreachable) catch unreachable;
            },
            .edge => {
                in[i] = .{
                    .name = allocator.dupe(u8, f.name) catch unreachable,
                    .type = if (f.optional)
                        std.fmt.allocPrint(allocator, "?*{s}", .{f.edge_type}) catch unreachable
                    else
                        std.fmt.allocPrint(allocator, "*{s}", .{f.edge_type}) catch unreachable,
                    .phantom = allocator.dupe(u8, "!owned") catch unreachable,
                };
                init.appendSlice(allocator, std.fmt.allocPrint(allocator, ".{s} = {s}, ", .{ f.name, f.name }) catch unreachable) catch unreachable;
            },
        }
    }
    const ed = astz.Item{ .event_decl = astz.EventDecl{
        .path = path,
        .input = astz.Shape{ .fields = in },
        .branches = &.{},
        .return_type = std.fmt.allocPrint(allocator, "*{s}", .{decl.name}) catch unreachable,
        .return_phantom = allocator.dupe(u8, "owned!") catch unreachable,
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &.{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };
    const body = std.fmt.allocPrint(
        allocator,
        "const __koru_a = koru_allocator();\nconst __koru_n = __koru_a.create({s}) catch @panic(\"std/tree:mint({s}): allocation failed\");\n__koru_n.* = .{{ {s}}};\nreturn __koru_n;",
        .{ decl.name, decl.name, init.items },
    ) catch unreachable;
    const pd = astz.Item{ .proc_decl = astz.ProcDecl{
        .path = path,
        .body = astz.Source{
            .text = body,
            .location = flow.location,
            .scope = .{ .bindings = &.{} },
            .phantom_type = null,
        },
        .annotations = &.{},
        .target = allocator.dupe(u8, "zig") catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } };
    const out = allocator.alloc(astz.Item, 2) catch unreachable;
    out[0] = ed;
    out[1] = pd;
    return out;
}
