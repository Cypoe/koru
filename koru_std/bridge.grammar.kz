// Koru Standard Library: the `grammar` part of bridge — the host `grammar`
// verb's render. Joined via `~part grammar` in bridge.kz; merged into the
// bridge module at load.

fn renderGrammar(allocator: std.mem.Allocator, scope: []const u8, defined: ?*DefinedFlows, introspection: bool) ?[]const u8 {
    const rt = @import("root").koru_std.koru_runtime;
    var out = std.ArrayList(u8).initCapacity(allocator, 512) catch unreachable;

    switch (rt.scope_grammar_event.handler(.{ .name = scope })) {
        .ok => |g| out.appendSlice(allocator, g) catch unreachable,
        .not_found => return null,
    }

    if (introspection) {
        out.append(allocator, '\n') catch unreachable;
        out.appendSlice(allocator, introspection_verbs) catch unreachable;
    }
    // The session's inventions, same as `vocabulary` renders them.
    appendDefinedLines(&out, allocator, defined);
    // Bound names are NOT grammar: this render heads the system message,
    // which must stay byte-identical across calls for prefix caching — and
    // the bindings table mutates (and reshuffles in hash order) every turn.
    // The live table stays on `vocabulary()` and each report's `bound: rN`.
    return out.toOwnedSlice(allocator) catch unreachable;
}
