// Test 355_014: MUST_RUN — a declined `?!` panic branch keeps its loud
//                         arm when a `|*` residual is present.
//
// `?!` means "unsafe to ignore": the compiler synthesizes a @panic arm so
// the path cannot silently proceed (355_012 pins the loudness; 355_009
// pins the `?` contrast). A `|*` residual routes OPTIONAL branches only —
// it is no answer for a panic variant, which exists in the emitted union
// either way. Presence of the residual must not disarm the panic
// synthesis: the arm's job is codegen exhaustiveness as much as contract.

~import std/io

~tor risky { }
| ok u32
| ?warn string
| ?!panic string

~proc risky|zig {
    return .{ .ok = 1 };
}

~risky()
| ok _ |> std/io:print.ln("GOT SUCCESS")
|* |> std/io:print.ln("GOT OPTIONAL")
