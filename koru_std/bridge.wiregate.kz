// Koru Standard Library: the `wiregate` part of bridge.kz — the
// scope-directed gate and the dispatch that consumes its canonical form.
// Joined via `~part wiregate` in bridge.kz; merged into the bridge module
// at load.
//
// One scanner, two duties, same lookups: `wireGate` admits — an arg value
// is a quoted string or a bare Koru expression, judged by the language's
// own expression parser, and `dispatchThroughScope` normalizes the same
// way, so what the gate admits is exactly what dispatch executes. Field
// names are still judged against the scope's input_fn (or this file's
// host table for the introspection verbs); untyped scopes see the flat
// grammar unchanged.

const GateRejection = struct { message: []const u8, line: u32, column: u32, not_invocation: bool };

// The introspection-granted host verbs' field vocabularies — one table the
// scanner, the dispatch, and the prompt render all read. note's text and
// bind's value are plain strings — quoted wire like every other field.
// vocabulary/grammar take none.
const HostVerbSpec = struct { name: []const u8, fields: []const Runtime.InputFieldSpec, doc: []const u8 = "" };
const host_verbs = [_]HostVerbSpec{
    .{ .name = "vocabulary", .fields = &.{} },
    .{ .name = "grammar", .fields = &.{} },
    .{ .name = "bind", .fields = &.{
        .{ .name = "name", .type_name = "string" },
        .{ .name = "value", .type_name = "string" },
    } },
    .{ .name = "abandon", .fields = &.{
        .{ .name = "reason", .type_name = "string" },
    }, .doc = " — ends the session with your reason: what you tried, what blocked you" },
};

fn hostInputLookup(verb: []const u8) ?[]const Runtime.InputFieldSpec {
    for (host_verbs) |v| {
        if (std.mem.eql(u8, verb, v.name)) return v.fields;
    }
    return null;
}

// The verbs introspection grants, rendered in `vocabulary`/`grammar` and
// exported for the agent's prompt doc — derived at comptime from the table
// the gate enforces: the prompt, the parser, and the dispatch read the same
// declaration, typed fields spelled the way scope verbs spell theirs.
pub const introspection_verbs: []const u8 = blk: {
    var text: []const u8 = "";
    for (host_verbs) |v| {
        if (text.len > 0) text = text ++ "\n";
        text = text ++ v.name ++ "(";
        for (v.fields, 0..) |f, i| {
            if (i > 0) text = text ++ ", ";
            text = text ++ f.name ++ ": " ++ f.type_name;
        }
        text = text ++ ")" ++ v.doc;
    }
    break :blk text;
};

fn scopeInputFn(br: *Bridge) ?Runtime.InputLookupFn {
    return switch (Runtime.get_scope_event.handler(.{ .name = br.scope })) {
        .scope => |s| s.input_fn,
        .not_found => null,
    };
}

// The wire grammar check, shared by the single-item gate and the per-item
// gate a sequenced turn runs on every slice: one predicate, two surfaces —
// a one-item turn returns the refusal as the turn's verdict; a multi-item
// turn reports it as a `step N/M parse-error` line and runs on. A grammar
// that only held on the first item of a turn is the convention the wire
// ruling retired — the unit of enforcement is the item. (440_021; kopium
// bridge-mirror 2026-09-12-wire-gate-scope)
fn wireGate(br: *Bridge, source: []const u8) ?GateRejection {
    return switch (Runtime.parse_wire_event.handler(.{
        .source = source,
        .input_fn = scopeInputFn(br),
        .host_input_fn = hostInputLookup,
    })) {
        .parsed => null,
        .parse_error => |e| .{ .message = e.message, .line = e.line, .column = e.column, .not_invocation = e.not_invocation },
    };
}

// dispatchThroughScope moved to the `scopedispatch` part — the wire's
// last mile: normalize, then run through the scope.
