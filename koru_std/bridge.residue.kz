// Koru Standard Library: the `residue` part of bridge.kz — residue
// teaching text and the observer-channel classifier. Joined via
// `~part residue` in bridge.kz; merged into the bridge module at load.

/// The report a bound residue hands back. The name is narrative only —
/// `say`'s field is Source, so `say(text: rN)` would deliver the literal
/// name; the only honest redelivery is re-emitting the prose under `say:`.
fn residueNote(rn: []const u8) []const u8 {
    return std.fmt.allocPrint(std.heap.page_allocator,
        "residue bound: {s} — your reply was not wire; nothing reached the user, but the observer kept it. Prose meant for the user wants `say:` up front (no quoting needed), `note:` for thinking out loud — re-emit your text in that shape", .{rn})
        catch @panic("bridge: OOM building residue report");
}

/// A `note(...)`/`note:`-prefixed item that failed the wire gate is prose
/// wearing the observer channel's costume — in an introspection session the
/// text binds as residue (captured, teachable, free) rather than striking as
/// a wire failure. Without the grant it is plain malformed wire.
fn isNoteAttempt(br: *Bridge, item: []const u8) bool {
    if (!br.introspection) return false;
    const t = std.mem.trim(u8, item, " \t\r\n");
    return std.mem.startsWith(u8, t, "note(") or std.mem.startsWith(u8, t, "note:");
}
