// Test 355_014: MUST_RUN — a declined `?!` panic branch keeps its loud
//                         arm while plain `?` siblings go unnamed.
//
// `?!` means "unsafe to ignore": the compiler synthesizes a @panic arm so
// the path cannot silently proceed (355_012 pins the loudness; 355_009
// pins the `?` contrast). A plain `?warn` unnamed here absorbs silently —
// but the `?!panic` variant still gets its loud arm: panic synthesis is
// codegen exhaustiveness, not a coverage grant the consumer can waive.

~import std/io

~tor risky { }
| ok u32
| ?warn string
| ?!panic string

~proc risky|zig {
    return .{ .ok = 1 };
}

~risky()
| ok _ |> std/io:print.ln("GOT SUCCESS")
