// Koru Standard Library: the `acquire` part of fleet — the shared
// ownership-acquire helpers `std/node` calls from host code. Joined via
// `~part acquire` in fleet.kz; merged into the fleet module at load.

// ============================================================================
// SHARED ACQUIRE — the single claim path, pub for `std/node`: caller either
// ends up holding the id (fresh claim or already-owner, at the record's
// epoch), learns the foreign owner, or fails on I/O. `nb` carries the
// foreign owner's name back — the slice lives in the caller's buffer.
// ============================================================================

pub const Acquire = union(enum) {
    held: u32,
    foreign: []const u8,
    failed,
};

pub fn fleetAcquire(world: []const u8, id: []const u8, node: []const u8, nb: []u8) Acquire {
    ensureDirs(world) catch return .failed;
    var pb: [1024]u8 = undefined;
    const p = ownerPath(&pb, world, id) orelse return .failed;
    if (ownerRead(world, id, nb)) |rec| {
        if (std.mem.eql(u8, rec.node, node)) return .{ .held = rec.epoch };
        return .{ .foreign = rec.node };
    }
    const epoch = epochRead(world, id) + 1;
    var cb: [1024]u8 = undefined;
    const body = std.fmt.bufPrint(&cb, "node={s}\nepoch={d}\n", .{ node, epoch }) catch
        return .failed;
    const f = std.fs.cwd().createFile(p, .{ .exclusive = true }) catch |err| {
        if (err == error.PathAlreadyExists) {
            if (ownerRead(world, id, nb)) |rec| {
                if (std.mem.eql(u8, rec.node, node)) return .{ .held = rec.epoch };
                return .{ .foreign = rec.node };
            }
            return .failed;
        }
        return .failed;
    };
    f.writeAll(body) catch {
        f.close();
        return .failed;
    };
    f.close();
    _ = epochBump(world, id);
    return .{ .held = epoch };
}

// The record's owner is some other node — the slice lives in `nb`.
pub fn fleetForeignOwner(world: []const u8, id: []const u8, node: []const u8, nb: []u8) ?[]const u8 {
    const rec = ownerRead(world, id, nb) orelse return null;
    if (std.mem.eql(u8, rec.node, node)) return null;
    return rec.node;
}

// Release only if the record names `node` — a node cannot clear what it
// does not own, and a missing record is already released.
pub fn fleetReleaseIfOwner(world: []const u8, id: []const u8, node: []const u8) void {
    var nb: [256]u8 = undefined;
    const rec = ownerRead(world, id, &nb) orelse return;
    if (!std.mem.eql(u8, rec.node, node)) return;
    var pb: [1024]u8 = undefined;
    const p = ownerPath(&pb, world, id) orelse return;
    std.fs.cwd().deleteFile(p) catch {};
}
