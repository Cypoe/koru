using static KoruHost;

static class KoruHost {
    public class P {
        public long m;
    }
}

~proc mint|cs {
    return 7;
}
~proc boxed|cs {
    var p = new P { m = m };
    long s = 0;
    for (long i = 0; i < m; i++) {
        s += i;
    }
    return new Output { tag = "ok", ok = p.m + s + m };
}
~proc show|cs {
    __koru_stdout_write($"{x}\n");
}