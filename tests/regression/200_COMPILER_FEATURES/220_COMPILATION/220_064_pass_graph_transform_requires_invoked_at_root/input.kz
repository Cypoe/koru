// PINS: a [transform] decl carrying requires() that is itself invoked at a
// root flow — the transform edge is intra-transform (stage ordering), not a
// pipeline position. Before the fix, step 3 re-read it as a pipeline edge
// and refused "root pipeline never runs mk-producer" — a false refusal of a
// satisfied contract.
const std = @import("std");

~import std/io

~[keyword|comptime|transform|pre]pub tor mk-producer {
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~proc mk-producer|zig { return .{}; }

~[keyword|comptime|transform|requires("mk-producer")]pub tor mk-consumer {
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator
} -> SiteResult

~proc mk-consumer|zig { return .{}; }

~mk-consumer()
~std/io:print.ln("ok")
