// Koru Standard Library: the `contract` part of runtime — the signature
// line's full render for the wire prompt. Joined via `~part contract` in
// runtime.kz; merged into the runtime module at load.
//
// The vocabulary line IS the declaration — `pub tor name { field: type }`,
// then `-> type<obligation!>` for a bare return or `| branch payload` for
// declared outcomes. One surface: the text that defines the verb is the
// text that teaches it, so the prompt cannot describe a call the law
// would refuse — or hide an outcome the law would fire.

/// The declaration head: `pub tor name { field: type, field: type<phantom> }`.
fn wireSignatureLine(out: *std.ArrayList(u8), allocator: std.mem.Allocator, event_name: []const u8, input: []const InputFieldSpec) void {
    out.appendSlice(allocator, "pub tor ") catch unreachable;
    out.appendSlice(allocator, event_name) catch unreachable;
    if (input.len == 0) {
        out.appendSlice(allocator, " {}") catch unreachable;
        return;
    }
    out.appendSlice(allocator, " { ") catch unreachable;
    for (input, 0..) |field, i| {
        if (i > 0) out.appendSlice(allocator, ", ") catch unreachable;
        out.appendSlice(allocator, field.name) catch unreachable;
        out.appendSlice(allocator, ": ") catch unreachable;
        out.appendSlice(allocator, field.type_name) catch unreachable;
        if (field.phantom) |p| {
            out.append(allocator, '<') catch unreachable;
            out.appendSlice(allocator, p) catch unreachable;
            out.append(allocator, '>') catch unreachable;
        }
    }
    out.appendSlice(allocator, " }") catch unreachable;
}

/// The declaration's outcome clause, spelled as the source spells it:
/// a bare return (`| ok` with a positional `__type_ref` payload) renders
/// ` -> T<obligation!>` — mints already ride the type text — and a
/// declared outcome list renders ` | name T | name { f: t }`, `?` marking
/// the one optional branch. A void decl gets no clause.
fn wireDeclOutcome(out: *std.ArrayList(u8), allocator: std.mem.Allocator, branches: []const BranchSpec) void {
    if (branches.len == 1 and std.mem.eql(u8, branches[0].name, "ok") and
        branches[0].fields.len == 1 and std.mem.eql(u8, branches[0].fields[0].name, "__type_ref"))
    {
        out.appendSlice(allocator, " -> ") catch unreachable;
        out.appendSlice(allocator, branches[0].fields[0].type_name) catch unreachable;
        return;
    }
    for (branches) |branch| {
        out.appendSlice(allocator, " | ") catch unreachable;
        if (branch.is_optional) out.append(allocator, '?') catch unreachable;
        out.appendSlice(allocator, branch.name) catch unreachable;
        if (branch.fields.len == 1 and std.mem.eql(u8, branch.fields[0].name, "__type_ref")) {
            out.append(allocator, ' ') catch unreachable;
            out.appendSlice(allocator, branch.fields[0].type_name) catch unreachable;
        } else if (branch.fields.len > 0) {
            out.appendSlice(allocator, " { ") catch unreachable;
            for (branch.fields, 0..) |f, i| {
                if (i > 0) out.appendSlice(allocator, ", ") catch unreachable;
                out.appendSlice(allocator, f.name) catch unreachable;
                out.appendSlice(allocator, ": ") catch unreachable;
                out.appendSlice(allocator, f.type_name) catch unreachable;
            }
            out.appendSlice(allocator, " }") catch unreachable;
        }
    }
}
