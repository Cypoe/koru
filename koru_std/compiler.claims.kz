// Koru Standard Library: the `claims` part of compiler.kz.
// Joined via `~part claims` in compiler.kz; merged into the compiler module at load.
//
// The claims-check pass: validates every `~std/spec:claim` site — the atom
// is registered vocabulary (unregistered is a named refusal, the
// signal-vocabulary discipline), the `on:` subject resolves to exactly one
// declared tor, and the atom's declared parameters are well-formed: for
// `terminates`, `rank` is a linear form over the step tor's own input
// fields. A well-formed claim reports `declared` on the census line —
// `proved`/`refuted` verdicts belong to the prover reader, not this pass.
// `std`, `ast` and `Program` are imported by the parent's preamble.
// `spec` is the contract vocabulary — koru_spec is emitted with the
// compiler core (compiler.kz ~import std/spec), so the pass may name it.
const spec = koru_std.koru_spec;

// `on` resolves the way an invocation path does: `mod:tor` names the
// qualified decl exactly; a bare `tor` names the program's own decl —
// never a stdlib tor that happens to share the last segment (badvar's
// `step` vs std.build:step).
fn claimsSubjectMatch(ev: *const ast.EventDecl, on: []const u8, main_mod: []const u8) bool {
    if (ev.path.segments.len == 0) return false;
    if (std.mem.indexOfScalar(u8, on, ':')) |colon| {
        const q = ev.path.module_qualifier orelse return false;
        return std.mem.eql(u8, q, on[0..colon]) and
            std.mem.eql(u8, ev.path.segments[ev.path.segments.len - 1], on[colon + 1 ..]);
    }
    if (!std.mem.eql(u8, ev.path.segments[ev.path.segments.len - 1], on)) return false;
    const q = ev.path.module_qualifier orelse return true;
    return std.mem.eql(u8, q, main_mod);
}

fn claimsSubjectFields(
    al: std.mem.Allocator,
    items: []const ast.Item,
    on: []const u8,
    main_mod: []const u8,
    found: *usize,
    out: *std.ArrayListUnmanaged(ast.Field),
    subject: *?*const ast.EventDecl,
) void {
    for (items) |*item| {
        switch (item.*) {
            .event_decl => |*ev| {
                if (!claimsSubjectMatch(ev, on, main_mod)) continue;
                found.* += 1;
                if (found.* == 1) {
                    for (ev.input.fields) |f| out.append(al, f) catch return;
                    subject.* = ev;
                }
            },
            .module_decl => |*m| claimsSubjectFields(al, m.items, on, main_mod, found, out, subject),
            else => {},
        }
    }
}

fn claimsFieldListed(fields: []const ast.Field, name: []const u8) bool {
    for (fields) |f| {
        if (std.mem.eql(u8, f.name, name)) return true;
    }
    return false;
}

fn claimsFieldOf(fields: []const ast.Field, name: []const u8) ?*const ast.Field {
    for (fields) |*f| {
        if (std.mem.eql(u8, f.name, name)) return f;
    }
    return null;
}

// A field's type text may carry `&`-contract atoms — `i64 & >=0` — the
// base type is everything before the first `&`.
fn claimsFieldBase(t: []const u8) []const u8 {
    const cut = std.mem.indexOfScalar(u8, t, '&') orelse t.len;
    return std.mem.trim(u8, t[0..cut], " ");
}

// The linear fragment is integer arithmetic — a rank or guard naming a
// float or string field is outside-P, not a silent real-domain read.
fn claimsIntField(fields: []const ast.Field, name: []const u8) bool {
    const f = claimsFieldOf(fields, name) orelse return false;
    const t = claimsFieldBase(f.type);
    if (std.mem.eql(u8, t, "usize") or std.mem.eql(u8, t, "comptime_int")) return true;
    if (t.len < 2 or (t[0] != 'i' and t[0] != 'u')) return false;
    for (t[1..]) |c| {
        if (!std.ascii.isDigit(c)) return false;
    }
    return true;
}
// The subject's declared field types are contract premises: `&`-atoms
// on `i64 & >=0` or relational `& x <= y + margin` are rows that hold
// at every entry AND for every produced value. `!=` contributes
// nothing — under-assuming is conservative. An atom that is not one
// comparison is outside-P: the type text is contract text the fence
// must be able to read before it may assume it.
const TypeRows = union(enum) { rows: []const spec.LinRow, outside: []const u8 };

// One `&`-atom as rows — `atom` is the text after a `&`; `self_name` is
// the name an implicit-self comparison (`>=0`) binds to; `site` spells
// where the atom sits for the diagnostic (`field 'i'`, `produced 'i'`).
fn claimsTypedAtomRows(
    alloc: std.mem.Allocator,
    atom: []const u8,
    self_name: []const u8,
    site: []const u8,
    fields: []const ast.Field,
    subject: []const u8,
) TypeRows {
    const split = spec.splitLinCmp(atom);
    const sp = switch (split) {
        .one => |s| s,
        else => return .{ .outside = std.fmt.allocPrint(alloc, "the '&' atom '{s}' on {s} of '{s}' is not one linear comparison", .{ atom, site, subject }) catch unreachable },
    };
    var lhs: []const spec.LinPart = undefined;
    const ltxt = std.mem.trim(u8, atom[0..sp.pos], " ");
    if (ltxt.len == 0) {
        // Implicit self: `& >=0` means `<self> >= 0`.
        const one = [_]spec.LinPart{.{ .coef = 1, .name = self_name }};
        lhs = alloc.dupe(spec.LinPart, &one) catch unreachable;
    } else {
        lhs = spec.parseLinExpr(alloc, ltxt) orelse
            return .{ .outside = std.fmt.allocPrint(alloc, "the '&' atom '{s}' on {s} of '{s}' is not a linear form", .{ atom, site, subject }) catch unreachable };
    }
    const rtxt = std.mem.trim(u8, atom[sp.pos + sp.op.len ..], " ");
    const rhs = spec.parseLinExpr(alloc, rtxt) orelse
        return .{ .outside = std.fmt.allocPrint(alloc, "the '&' atom '{s}' on {s} of '{s}' is not a linear form", .{ atom, site, subject }) catch unreachable };
    // Relational atoms may name sibling fields; a stranger is a
    // broken contract, not a premise.
    for (lhs) |p| {
        if (p.name) |n| {
            if (!claimsIntField(fields, n))
                return .{ .outside = std.fmt.allocPrint(alloc, "the '&' atom '{s}' names '{s}' — not an integer field of '{s}'", .{ atom, n, subject }) catch unreachable };
        }
    }
    for (rhs) |p| {
        if (p.name) |n| {
            if (!claimsIntField(fields, n))
                return .{ .outside = std.fmt.allocPrint(alloc, "the '&' atom '{s}' names '{s}' — not an integer field of '{s}'", .{ atom, n, subject }) catch unreachable };
        }
    }
    return .{ .rows = claimsGuardRows(alloc, lhs, rhs, sp.op, false, "field type") };
}

// Every `&`-atom across `decl_fields`' type text as rows, with names
// validated against the subject's `fields`. Two callers: the tor's own
// field decl (decl_fields == fields) and an arm's payload schema.
fn claimsFieldTypeRows(
    alloc: std.mem.Allocator,
    decl_fields: []const ast.Field,
    fields: []const ast.Field,
    subject: []const u8,
) TypeRows {
    var rows = std.ArrayListUnmanaged(spec.LinRow){};
    for (decl_fields) |f| {
        const cut = std.mem.indexOfScalar(u8, f.type, '&') orelse continue;
        var atoms = std.mem.splitScalar(u8, f.type[cut + 1 ..], '&');
        while (atoms.next()) |raw| {
            const atom = std.mem.trim(u8, raw, " ");
            if (atom.len == 0) continue;
            const site = std.fmt.allocPrint(alloc, "field '{s}'", .{f.name}) catch unreachable;
            const ar = claimsTypedAtomRows(alloc, atom, f.name, site, fields, subject);
            switch (ar) {
                .outside => |m| return .{ .outside = m },
                .rows => |rs| {
                    for (rs) |r| rows.append(alloc, r) catch unreachable;
                },
            }
        }
    }
    return .{ .rows = rows.items };
}

// A row set under a jump's rebinding — produced values satisfy the
// declared type, so `i & >=0` read under `i' = i − 1` is `i − 1 >= 0`:
// the type's own bound, stated about the next state.
fn claimsSubRows(
    alloc: std.mem.Allocator,
    rows: []const spec.LinRow,
    subs: []const spec.LinSub,
) []const spec.LinRow {
    var out = std.ArrayListUnmanaged(spec.LinRow){};
    for (rows) |r| {
        var parts = std.ArrayListUnmanaged(spec.LinPart){};
        for (r.terms) |t|
            parts.append(alloc, .{ .coef = t.coef, .name = t.name }) catch unreachable;
        parts.append(alloc, .{ .coef = -r.bound, .name = null }) catch unreachable;
        const subbed = spec.linSubstitute(alloc, parts.items, subs);
        // Σterms − b = Σsubbed  ⇒  Σsubbed_named <= −subbed_const; the
        // strictness flag rides through untouched.
        var const_part: i64 = 0;
        var named = std.ArrayListUnmanaged(spec.LinTerm){};
        for (subbed) |p| {
            if (p.name) |n| named.append(alloc, .{ .coef = p.coef, .name = n }) catch unreachable
            else const_part += p.coef;
        }
        out.append(alloc, .{ .terms = named.items, .bound = -const_part, .strict = r.strict, .src = r.src }) catch unreachable;
    }
    return out.items;
}

// `| live { i: i64 & >=0 }` on a branch is the arm's produce contract —
// CHECKED, not assumed: under the pun-only fence the produced fields
// are the same-named tor fields, so the discharge is
// `arm-meet ∪ declared types ⊢ payload rows`. A scalar payload parses
// as `{ __type_ref: <type> }` — its implicit self is the produced
// value, which the arm's scalar_field names. What the meet cannot
// establish is refused: the declaration may be a lie, and a contract
// that cannot be established must not silently ride.
const ProduceVerdict = union(enum) { ok: usize, refuse: []const u8 };

fn claimsProduceCheck(
    alloc: std.mem.Allocator,
    items: []const ast.Item,
    ev: *const ast.EventDecl,
    fields: []const ast.Field,
    subject: []const u8,
) ProduceVerdict {
    var has_typed = false;
    for (ev.branches) |b| {
        for (b.payload.fields) |f| {
            if (std.mem.indexOfScalar(u8, f.type, '&') != null) has_typed = true;
        }
    }
    if (!has_typed) return .{ .ok = 0 };

    const impl = claimsImplFlow(items, ev) orelse
        return .{ .refuse = std.fmt.allocPrint(alloc, "'{s}' declares typed payloads but its impl is not an if-dispatch — the produce contract cannot be established", .{subject}) catch unreachable };
    var arm_meets = std.ArrayListUnmanaged(ArmMeet){};
    if (claimsArmMeets(alloc, impl, fields, subject, &arm_meets)) |reason|
        return .{ .refuse = std.fmt.allocPrint(alloc, "'{s}' declares typed payloads; {s}", .{ subject, reason }) catch unreachable };
    const type_rows = switch (claimsFieldTypeRows(alloc, fields, fields, subject)) {
        .outside => |m| return .{ .refuse = m },
        .rows => |rs| rs,
    };

    var n: usize = 0;
    for (arm_meets.items) |*am| {
        var branch: ?*const ast.Branch = null;
        for (ev.branches) |*b| {
            if (std.mem.eql(u8, b.name, am.arm)) {
                branch = b;
                break;
            }
        }
        const br = branch orelse
            return .{ .refuse = std.fmt.allocPrint(alloc, "arm '{s}' is not a declared branch of '{s}'", .{ am.arm, subject }) catch unreachable };
        var prows = std.ArrayListUnmanaged(spec.LinRow){};
        for (br.payload.fields) |f| {
            const cut = std.mem.indexOfScalar(u8, f.type, '&') orelse continue;
            const self_name = if (std.mem.eql(u8, f.name, "__type_ref"))
                am.scalar_field orelse
                    return .{ .refuse = std.fmt.allocPrint(alloc, "arm '{s}' declares a typed scalar payload but produces no field of '{s}'", .{ am.arm, subject }) catch unreachable }
            else
                f.name;
            var atoms = std.mem.splitScalar(u8, f.type[cut + 1 ..], '&');
            while (atoms.next()) |raw| {
                const atom = std.mem.trim(u8, raw, " ");
                if (atom.len == 0) continue;
                const site = std.fmt.allocPrint(alloc, "produced '{s}'", .{self_name}) catch unreachable;
                switch (claimsTypedAtomRows(alloc, atom, self_name, site, fields, subject)) {
                    .outside => |m| return .{ .refuse = m },
                    .rows => |rs| for (rs) |r| prows.append(alloc, r) catch unreachable,
                }
            }
        }
        if (prows.items.len == 0) continue;
        n += 1;
        var meet = std.ArrayListUnmanaged(spec.LinRow){};
        for (am.rows.items) |r| meet.append(alloc, r) catch unreachable;
        for (type_rows) |r| meet.append(alloc, r) catch unreachable;
        for (prows.items) |pr| {
            var lhs = std.ArrayListUnmanaged(spec.LinPart){};
            for (pr.terms) |t| lhs.append(alloc, .{ .coef = t.coef, .name = t.name }) catch unreachable;
            const rhs = [_]spec.LinPart{.{ .coef = pr.bound, .name = null }};
            const op: []const u8 = if (pr.strict) "<" else "<=";
            switch (claimsEntail(alloc, meet.items, lhs.items, &rhs, op)) {
                .entailed => {},
                .open => return .{ .refuse = std.fmt.allocPrint(alloc, "arm '{s}' of '{s}' does not establish '{s}' under its '{s}' meet — a declared produce contract", .{ am.arm, subject, spec.linSpell(alloc, pr.terms, pr.bound, pr.strict), am.arm }) catch unreachable },
                .outside => return .{ .refuse = "the produce-contract meet exceeds the decidable fence" },
            }
        }
    }
    return .{ .ok = n };
}

~proc pass-claims-check|zig {
    var mutable_ctx = ctx;
    mutable_ctx.current_pass = "claims_check";

    const reporter = mutable_ctx.reporter orelse {
        @panic("pass-claims-check: the compilation carries no diagnostic reporter");
    };
    const err_base = reporter.errors.items.len;

    const claims = spec.claim_registry[0..spec.claim_registry_count];
    if (claims.len == 0) return .{ .ctx = ctx };
    var checked_evs = std.ArrayListUnmanaged(*const ast.EventDecl){};

    var refused = false;

    for (claims) |c| {
        if (c.malformed) {
            reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): the Source block is not parseable — claims carry `{{ \"rank\": \"<linear form>\" }}`", .{c.atom}) catch {};
            refused = true;
            continue;
        }
        // 1. registered vocabulary — an atom outside the registry means
        //    nothing spec-side, so the claim means nothing.
        const catom = spec.claimAtom(c.atom) orelse {
            reporter.addError(.KORU213, c.line, c.column, "std/spec:claim: '{s}' is not a registered claim atom — the vocabulary lives in std/spec; register it there or drop the claim", .{c.atom}) catch {};
            refused = true;
            continue;
        };
        // 2. the subject resolves to exactly one declared tor — a claim on
        //    nothing is a lie, a claim on two things is a guess.
        var nfound: usize = 0;
        var fields = std.ArrayListUnmanaged(ast.Field){};
        var subject_ev: ?*const ast.EventDecl = null;
        claimsSubjectFields(mutable_ctx.allocator, mutable_ctx.ast.items, c.on, mutable_ctx.ast.main_module_name, &nfound, &fields, &subject_ev);
        if (nfound == 0) {
            reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): on '{s}' names no tor in the program", .{ c.atom, c.on }) catch {};
            refused = true;
            continue;
        }
        if (nfound > 1) {
            reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): on '{s}' names {d} tors — a claim needs one subject", .{ c.atom, c.on, nfound }) catch {};
            refused = true;
            continue;
        }
        // 3. the atom's declared parameters are present.
        var missing = false;
        for (catom.required) |req| {
            const val = if (std.mem.eql(u8, req, "rank")) c.rank else if (std.mem.eql(u8, req, "goal")) c.goal else "";
            if (val.len == 0) {
                reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): the atom requires a \"{s}\" field in the JSON block", .{ c.atom, req }) catch {};
                refused = true;
                missing = true;
            }
        }
        if (missing) continue;
        // 4. the atom's linear parameters parse and name only the tor's
        //    own input fields — `rank` (a linear form) for `terminates`,
        //    `goal` (a linear comparison) for `honors`. The grammar is
        //    the same one std/refine's relational atoms speak, owned
        //    spec-side: the contract vocabulary owns it.
        var rank_parts: []const spec.LinPart = &.{};
        var goal_lhs: []const spec.LinPart = &.{};
        var goal_rhs: []const spec.LinPart = &.{};
        var goal_op: []const u8 = "";
        var needs_goal = false;
        for (catom.required) |req| {
            if (std.mem.eql(u8, req, "goal")) needs_goal = true;
        }
        // `rank` is optional on `terminates` — a declared rank must still
        // parse (malformed is a refusal); absent, the prover infers rank
        // candidates from the arm guards.
        if (c.rank.len > 0) {
            rank_parts = spec.parseLinExpr(mutable_ctx.allocator, c.rank) orelse {
                reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): rank '{s}' is not a linear form — terms are `N`, `name`, `N*name` joined by `+`/`-`", .{ c.atom, c.rank }) catch {};
                refused = true;
                continue;
            };
        }
        if (needs_goal) {
            const gsplit = spec.splitLinCmp(c.goal);
            const gcmp = switch (gsplit) {
                .one => |s| s,
                else => {
                    reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): goal '{s}' is not a single linear comparison — one of `<` `<=` `>` `>=` `==` `!=` over linear forms", .{ c.atom, c.goal }) catch {};
                    refused = true;
                        continue;
                },
            };
            goal_op = gcmp.op;
            const gl = spec.parseLinExpr(mutable_ctx.allocator, std.mem.trim(u8, c.goal[0..gcmp.pos], " \t")) orelse {
                reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): goal's left side '{s}' is not a linear form", .{ c.atom, c.goal }) catch {};
                refused = true;
                continue;
            };
            const gr = spec.parseLinExpr(mutable_ctx.allocator, std.mem.trim(u8, c.goal[gcmp.pos + gcmp.op.len ..], " \t")) orelse {
                reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): goal's right side '{s}' is not a linear form", .{ c.atom, c.goal }) catch {};
                refused = true;
                continue;
            };
            goal_lhs = gl;
            goal_rhs = gr;
        }
        var bad_var: ?[]const u8 = null;
        for (rank_parts) |part| {
            const n = part.name orelse continue;
            var ok = false;
            for (fields.items) |f| {
                if (std.mem.eql(u8, f.name, n)) ok = true;
            }
            if (!ok) bad_var = n;
        }
        if (bad_var) |n| {
            reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): rank '{s}' names '{s}' — not an input field of '{s}'", .{ c.atom, c.rank, n, c.on }) catch {};
            refused = true;
            continue;
        }
        bad_var = null;
        for (goal_lhs) |part| {
            const n = part.name orelse continue;
            var ok = false;
            for (fields.items) |f| {
                if (std.mem.eql(u8, f.name, n)) ok = true;
            }
            if (!ok) bad_var = n;
        }
        for (goal_rhs) |part| {
            const n = part.name orelse continue;
            var ok = false;
            for (fields.items) |f| {
                if (std.mem.eql(u8, f.name, n)) ok = true;
            }
            if (!ok) bad_var = n;
        }
        if (bad_var) |n| {
            reporter.addError(.KORU213, c.line, c.column, "std/spec:claim({s}): goal '{s}' names '{s}' — not an input field of '{s}'", .{ c.atom, c.goal, n, c.on }) catch {};
            refused = true;
            continue;
        }
        // Produce contracts: `&`-atoms on the subject's branch payloads
        // are obligations the impl must establish — checked once per
        // subject, refused when the meet leaves one open.
        if (subject_ev) |ev| {
            var seen = false;
            for (checked_evs.items) |p| {
                if (p == ev) seen = true;
            }
            if (!seen) {
                checked_evs.append(mutable_ctx.allocator, ev) catch unreachable;
                switch (claimsProduceCheck(mutable_ctx.allocator, mutable_ctx.ast.items, ev, fields.items, c.on)) {
                    .ok => |np| {
                        if (np > 0)
                            std.debug.print("[contract] {s}: produce contracts proven on {d} arm{s}\n", .{ c.on, np, if (np == 1) "" else "s" });
                    },
                    .refuse => |m| {
                        reporter.addError(.KORU213, c.line, c.column, "std/spec:contract: {s}", .{m}) catch {};
                        refused = true;
                        continue;
                    },
                }
            }
        }
        // census line — the declared record, pinned by expected_comptime.txt.
        // A judged claim goes on to the prover reader: `proven` means
        // every discharge succeeded; `unproven` and `outside-P` name
        // what the judgment could not decide — the claim still stands
        // declared, and the verdict routes it (guard lane).
        var judged = false;
        var word: []const u8 = "";
        var detail: []const u8 = "";
        if (subject_ev) |ev| {
            if (std.mem.eql(u8, c.atom, "terminates")) {
                const verdict = if (c.rank.len > 0)
                    proveTerminates(mutable_ctx.allocator, mutable_ctx.ast.items, ev, fields.items, rank_parts, c.on)
                else
                    proveTerminatesInferred(mutable_ctx.allocator, mutable_ctx.ast.items, ev, fields.items, c.on);
                word = switch (verdict) {
                    .proven => "proven",
                    .unproven => "unproven",
                    .outside => "outside-P",
                };
                detail = switch (verdict) {
                    .proven => |d| d,
                    .unproven => |d| d,
                    .outside => |d| d,
                };
                judged = true;
            } else if (std.mem.eql(u8, c.atom, "honors")) {
                const verdict = proveHonors(mutable_ctx.allocator, mutable_ctx.ast.items, ev, fields.items, goal_lhs, goal_rhs, goal_op, c.on);
                word = switch (verdict) {
                    .proven => "proven",
                    .unproven => "unproven",
                    .outside => "outside-P",
                };
                detail = switch (verdict) {
                    .proven => |d| d,
                    .unproven => |d| d,
                    .outside => |d| d,
                };
                judged = true;
            }
        }
        if (judged) {
            std.debug.print("[claim] {s}:{d} {s} on {s}: {s} — {s}\n", .{ c.file, c.line, c.atom, c.on, word, detail });
            continue;
        }
        std.debug.print("[claim] {s}:{d} {s} on {s}: declared\n", .{ c.file, c.line, c.atom, c.on });
    }

    if (refused) {
        drainReporter(reporter, &mutable_ctx, err_base);
        return .{ .failed = .{ .ctx = mutable_ctx, .message = "claims check: unregistered or malformed claim" } };
    }

    mutable_ctx.passes_completed += 1;
    return .{ .ctx = mutable_ctx };
}

// The pass declaration itself (the parent's ~part claims joins this file
// into the compiler module): validates ~std/spec:claim sites — the atom is
// registered vocabulary, the `on:` subject resolves, the atom's declared
// parameters are well-formed — and issues the prover's verdict.
~[
- contract:requires("pass-witness-check")
]pub tor pass-claims-check { ctx: CompilerContext }
| ctx CompilerContext
| failed { ctx: CompilerContext, message: string }

// A linear form's canonical spelling for the census line —
// `limit - i - 1`, terms first (declaration order), constant last.
fn claimsSpellParts(alloc: std.mem.Allocator, parts: []const spec.LinPart) []const u8 {
    var out = std.ArrayList(u8).initCapacity(alloc, parts.len * 10 + 8) catch unreachable;
    var first = true;
    // Canonical order: positive terms, then negative, then the constant —
    // `limit - i`, not `-i + limit`.
    for ([_]i64{ 1, -1 }) |sign| {
    for (parts) |p| {
        const n = p.name orelse continue;
        if ((p.coef >= 0) != (sign > 0)) continue;
        const c = if (p.coef < 0) -p.coef else p.coef;
        if (!first) {
            out.appendSlice(alloc, if (p.coef < 0) " - " else " + ") catch unreachable;
        } else if (p.coef < 0) {
            out.appendSlice(alloc, "-") catch unreachable;
        }
        if (c != 1) out.appendSlice(alloc, std.fmt.allocPrint(alloc, "{d}*", .{c}) catch unreachable) catch unreachable;
        out.appendSlice(alloc, n) catch unreachable;
        first = false;
    }
    }
    for (parts) |p| {
        if (p.name != null) continue;
        if (first) {
            out.appendSlice(alloc, std.fmt.allocPrint(alloc, "{d}", .{p.coef}) catch unreachable) catch unreachable;
        } else if (p.coef > 0) {
            out.appendSlice(alloc, std.fmt.allocPrint(alloc, " + {d}", .{p.coef}) catch unreachable) catch unreachable;
        } else if (p.coef < 0) {
            out.appendSlice(alloc, std.fmt.allocPrint(alloc, " - {d}", .{-p.coef}) catch unreachable) catch unreachable;
        }
        first = false;
    }
    if (first) out.appendSlice(alloc, "0") catch unreachable;
    return out.toOwnedSlice(alloc) catch unreachable;
}
