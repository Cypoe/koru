// Compiler target routing + artifact materialization
//
// target-of reads the compile target (--lang / CompilerEnv.lang) and
// selects the matching emission arm; emit-js / emit-cs are the non-zig
// target emitters; the emit-*-artifact chains spell what emission does
// with the code string once it exists — write the artifact, validate
// it, invoke the host toolchain. Ordinary tors in the pipeline: a user
// emission override can drop, reorder, or interpose on any of them.
// Emit-only pipelines and custom Stage-D verbs are user-space
// decisions, not driver privileges.
// ============================================================
// ARTIFACT MATERIALIZATION - what emission does with the code
// string once it exists. These are ordinary tors: write the
// artifact, validate it, invoke the host toolchain. A user
// emission override can drop, reorder, or interpose on any of
// them — emit-only pipelines and custom Stage-D verbs are
// user-space decisions, not driver privileges.
// ============================================================

// Per-target composed artifact chains — one entry per target-of arm.

~pub tor emit-zig-artifact { ctx: CompilerContext } -> { ctx: CompilerContext, code: string }

~emit-zig-artifact = emit-zig(ctx): e
|> write-artifact(e.ctx, e.code, name: "output_emitted.zig"): w
|> std/compiler:has-flag(flag: "deep-check"): h
|> std/compiler:branch(cond: h)
| yes |> validate-emitted(w.ctx, w.code): v -> v
| no |> host-build-zig(w.ctx, w.code): v -> v

~pub tor emit-js-artifact { ctx: CompilerContext } -> { ctx: CompilerContext, code: string }

~emit-js-artifact = emit-js(ctx): e
|> write-artifact(e.ctx, e.code, name: "output_emitted.js"): w -> w

~pub tor emit-cs-artifact { ctx: CompilerContext } -> { ctx: CompilerContext, code: string }

~emit-cs-artifact = emit-cs(ctx): e
|> write-artifact(e.ctx, e.code, name: "output_emitted.cs"): w
|> host-build-cs(w.ctx, w.code): v -> v

// Write the emitted code to its artifact file.
~pub tor write-artifact { ctx: CompilerContext, code: string, name: string } -> { ctx: CompilerContext, code: string }

~proc write-artifact|zig {
    const file = std.fs.cwd().createFile(name, .{}) catch |err| {
        std.debug.print("error: could not create {s}: {s}\n", .{ name, @errorName(err) });
        std.process.exit(1);
    };
    defer file.close();
    file.writeAll(code) catch |err| {
        std.debug.print("error: could not write {s}: {s}\n", .{ name, @errorName(err) });
        std.process.exit(1);
    };

    const stdout = std.fs.File.stdout();
    var buf: [512]u8 = undefined;
    const msg = std.fmt.bufPrint(&buf, "✓ Generated {s} ({d} bytes)\n", .{ name, code.len }) catch return .{ .ctx = ctx, .code = code };
    stdout.writeAll(msg) catch {};
    return .{ .ctx = ctx, .code = code };
}

// --deep-check: the emitted text must be a parseable program, not just text.
// Replaces the Stage-D build with a zig.Ast witness — fuzz splices land
// Koru-shaped lines inside `proc|zig` bodies and record fields, and both
// paste verbatim into the Zig — a green verdict on emission `zig ast-check`
// refuses. "Emitted" is not the verdict; "emitted valid" is.
~pub tor validate-emitted { ctx: CompilerContext, code: string } -> { ctx: CompilerContext, code: string }

~proc validate-emitted|zig {
    const emitted_z = ctx.allocator.dupeZ(u8, code) catch unreachable;
    const emit_tree = std.zig.Ast.parse(ctx.allocator, emitted_z, .zig) catch |perr| {
        std.debug.print("error[KORU207]: emission validation itself failed ({s}) — output_emitted.zig could not be parsed\n", .{@errorName(perr)});
        std.process.exit(1);
    };
    if (emit_tree.errors.len != 0) {
        var aw: std.Io.Writer.Allocating = .init(ctx.allocator);
        for (emit_tree.errors) |perr| {
            if (perr.is_note) continue;
            const loc = emit_tree.tokenLocation(0, perr.token);
            emit_tree.renderError(perr, &aw.writer) catch {};
            std.debug.print("error[KORU207]: output_emitted.zig:{d}:{d}: emitted Zig does not parse — {s}\n", .{ loc.line + 1, loc.column + 1, aw.written() });
            aw.clearRetainingCapacity();
        }
        std.process.exit(1);
    }
    return .{ .ctx = ctx, .code = code };
}

// Stage D for the Zig target: zig build (via build_output.zig when the
// program declared build:requires) or a direct build-exe, then place the
// artifact at the -o name. Failures exit non-zero — the compile's verdict
// IS the build's verdict.
~pub tor host-build-zig { ctx: CompilerContext, code: string } -> { ctx: CompilerContext, code: string }

~proc host-build-zig|zig {
    const emitter_helpers = @import("emitter_helpers");
    const allocator = ctx.allocator;
    const stdout = std.fs.File.stdout();
    const stderr = std.fs.File.stderr();
    var buf: [512]u8 = undefined;

    const output_exe = emitter_helpers.outputExeName(allocator);

    // Check for cross-compilation target from build:config
    const build_target = emitter_helpers.getBuildConfig("target");

    var zig_lib_buf: [4096]u8 = undefined;
    const zig_lib_overlay = emitter_helpers.ensureZigLibOverlay(allocator, CompilerEnv.koru_home, &zig_lib_buf);
    if (zig_lib_overlay == null) {
        stderr.writeAll("note: koru zig-lib overlay unavailable — building emitted program against stock zig std\n") catch {};
    }

    // First check if build_output.zig exists (has user build requirements)
    const has_build_output = blk: {
        std.fs.cwd().access("build_output.zig", .{}) catch break :blk false;
        break :blk true;
    };

    if (has_build_output) {
        // Use zig build with build_output.zig (includes user dependencies)
        var bo_argv: [9][]const u8 = undefined;
        bo_argv[0] = "zig";
        bo_argv[1] = "build";
        bo_argv[2] = "--build-file";
        bo_argv[3] = "build_output.zig";
        var bo_argc: usize = 4;
        if (zig_lib_overlay) |ov| {
            bo_argv[bo_argc] = "--zig-lib-dir"; bo_argc += 1;
            bo_argv[bo_argc] = ov; bo_argc += 1;
        }
        var opt_buf: [24]u8 = undefined;
        // Output Debug by default; --release=<mode> or -O <Mode> opts
        // into a release build. Passed as -Doptimize so
        // build_output.zig's standardOptimizeOption honors it.
        const out_opt = if (CompilerEnv.hasFlag("debug")) "Debug" else if (CompilerEnv.hasFlag("release=fast")) "ReleaseFast" else if (CompilerEnv.hasFlag("release=safe")) "ReleaseSafe" else if (CompilerEnv.hasFlag("release=small")) "ReleaseSmall" else "Debug";
        bo_argv[bo_argc] = std.fmt.bufPrint(&opt_buf, "-Doptimize={s}", .{out_opt}) catch "-Doptimize=Debug";
        bo_argc += 1;
        var dt_buf: [128]u8 = undefined;
        if (build_target) |t| {
            bo_argv[bo_argc] = std.fmt.bufPrint(&dt_buf, "-Dtarget={s}", .{t}) catch "-Dtarget=native";
            bo_argc += 1;
        }
        const result = std.process.Child.run(.{
            .allocator = allocator,
            .argv = bo_argv[0..bo_argc],
            .max_output_bytes = 10 * 1024 * 1024,
        }) catch |err| {
            const err_msg = std.fmt.bufPrint(&buf, "✗ zig build failed: {}\n", .{err}) catch "✗ zig build failed\n";
            stderr.writeAll(err_msg) catch {};
            std.process.exit(1);
        };
        defer allocator.free(result.stdout);
        defer allocator.free(result.stderr);

        var buf2: [512]u8 = undefined;
        // Full Term union — a bare `.Exited` access panics when the zig
        // build was signal-killed (OOM killer under memory pressure),
        // and that panic reads as a compiler crash.
        switch (result.term) {
            .Exited => |exit_code| if (exit_code == 0) {
                // Copy from zig-out/bin/output to the requested output name.
                //
                // Zig names a wasm executable `output.wasm`; every other
                // target produces a bare `output`. Looking only for the bare
                // name made a SUCCESSFUL cross-compile report failure —
                // "Failed to copy output: error.FileNotFound" with a perfectly
                // good .wasm sitting in zig-out/bin the whole time.
                //
                // Only the SOURCE name varies. The destination stays exactly
                // what was asked for: a wasm host is handed the bytes, and
                // neither WebAssembly.compile nor the test harness cares what
                // the file on disk is called.
                const is_wasm = if (build_target) |t| std.mem.indexOf(u8, t, "wasm") != null else false;
                const zig_artifact = if (is_wasm) "zig-out/bin/output.wasm" else "zig-out/bin/output";
                std.fs.cwd().copyFile(zig_artifact, std.fs.cwd(), output_exe, .{}) catch |copy_err| {
                    const msg2 = std.fmt.bufPrint(&buf2, "✗ Failed to copy output: {}\n", .{copy_err}) catch "✗ Failed to copy output\n";
                    stderr.writeAll(msg2) catch {};
                    std.process.exit(1);
                };
                // The mode rides the success line — a silent Debug
                // default is how a benchmark ends up timing a
                // bounds-checked binary without knowing it.
                const msg2 = std.fmt.bufPrint(&buf2, "✓ Compiled to {s} ({s})\n", .{ output_exe, out_opt }) catch return .{ .ctx = ctx, .code = code };
                stdout.writeAll(msg2) catch {};
            } else {
                const msg2 = std.fmt.bufPrint(&buf2, "✗ Compilation failed\n", .{}) catch "✗ Compilation failed\n";
                stdout.writeAll(msg2) catch {};
                if (result.stderr.len > 0) {
                    stderr.writeAll("Error: ") catch {};
                    stderr.writeAll(result.stderr) catch {};
                    stderr.writeAll("\n") catch {};
                }
                std.process.exit(1);
            },
            .Signal => |sig| {
                const msg2 = std.fmt.bufPrint(&buf2, "✗ zig build was killed by signal {d} — ended from outside, before it could finish. This usually means the machine ran out of memory, or something killed it externally. Check memory and load, then rerun. The source program was never judged.\n", .{sig}) catch "✗ zig build killed\n";
                stderr.writeAll(msg2) catch {};
                std.process.exit(1);
            },
            .Stopped => |sig| {
                const msg2 = std.fmt.bufPrint(&buf2, "✗ zig build was stopped by signal {d} and never resumed — resume or kill it, then rerun\n", .{sig}) catch "✗ zig build stopped\n";
                stderr.writeAll(msg2) catch {};
                std.process.exit(1);
            },
            .Unknown => |status| {
                const msg2 = std.fmt.bufPrint(&buf2, "✗ zig build ended in an unknown state (status {d}) — rerun; if it repeats, the machine is the suspect\n", .{status}) catch "✗ zig build failed\n";
                stderr.writeAll(msg2) catch {};
                std.process.exit(1);
            },
        }
    } else {
        // Fall back to direct zig build-exe (no user dependencies)
        var emit_path_buf: [256]u8 = undefined;
        const emit_path = std.fmt.bufPrint(&emit_path_buf, "-femit-bin={s}", .{output_exe}) catch unreachable;
        const debug = CompilerEnv.hasFlag("debug");
        const release_fast = CompilerEnv.hasFlag("release=fast");
        const release_safe = CompilerEnv.hasFlag("release=safe");
        const release_small = CompilerEnv.hasFlag("release=small");
        const exe_opt = if (debug) "Debug" else if (release_fast) "ReleaseFast" else if (release_safe) "ReleaseSafe" else if (release_small) "ReleaseSmall" else "Debug";
        // `Source`-typed fields emit `__koru_ast.` references into
        // output_emitted.zig. When the emitted text uses them, the ast
        // module (plus its errors and glob_pattern_matcher deps) must be
        // mapped via --dep/-M — the bare build-exe path has no build file
        // to do it. Positional and -M main-module spellings conflict, so
        // the module cluster takes the explicit -Mroot= form.
        const needs_ast_module = std.mem.indexOf(u8, code, "__koru_ast.") != null;
        var exe_argv: [24][]const u8 = undefined;
        var exe_argc: usize = 0;
        exe_argv[exe_argc] = "zig"; exe_argc += 1;
        exe_argv[exe_argc] = "build-exe"; exe_argc += 1;
        // koru_allocator() backs onto std.heap.c_allocator (real libc
        // malloc/free) -- needs libc linked on this direct build-exe path too.
        exe_argv[exe_argc] = "-lc"; exe_argc += 1;
        if (build_target) |t| {
            exe_argv[exe_argc] = "-target"; exe_argc += 1;
            exe_argv[exe_argc] = t; exe_argc += 1;
        }
        exe_argv[exe_argc] = "-O"; exe_argc += 1;
        // The OUTPUT binary defaults to Debug: safety checks (bounds,
        // overflow, unreachable) stay on, which is the mode the test suite
        // should judge. The earlier ReleaseFast default was a benchmark
        // optimization that leaked into every output and hid UB.
        // `--release=<mode>` or `-O <Mode>` opts into a release build;
        // `--debug` stays an explicit Debug and wins over release flags.
        exe_argv[exe_argc] = exe_opt; exe_argc += 1;
        exe_argv[exe_argc] = emit_path; exe_argc += 1;
        if (zig_lib_overlay) |ov| {
            exe_argv[exe_argc] = "--zig-lib-dir"; exe_argc += 1;
            exe_argv[exe_argc] = ov; exe_argc += 1;
        }
        var ast_path_buf: [1024]u8 = undefined;
        var errors_path_buf: [1024]u8 = undefined;
        var gpm_path_buf: [1024]u8 = undefined;
        var root_mod_buf: [512]u8 = undefined;
        var ast_mod_buf: [1088]u8 = undefined;
        var errors_mod_buf: [1088]u8 = undefined;
        var gpm_mod_buf: [1088]u8 = undefined;
        if (needs_ast_module) {
            const ast_path = std.fmt.bufPrint(&ast_path_buf, "{s}/src/ast.zig", .{CompilerEnv.koru_home}) catch unreachable;
            const errors_path = std.fmt.bufPrint(&errors_path_buf, "{s}/src/errors.zig", .{CompilerEnv.koru_home}) catch unreachable;
            const gpm_path = std.fmt.bufPrint(&gpm_path_buf, "{s}/src/glob_pattern_matcher.zig", .{CompilerEnv.koru_home}) catch unreachable;
            exe_argv[exe_argc] = "--dep"; exe_argc += 1;
            exe_argv[exe_argc] = "ast"; exe_argc += 1;
            exe_argv[exe_argc] = std.fmt.bufPrint(&root_mod_buf, "-Mroot=output_emitted.zig", .{}) catch unreachable; exe_argc += 1;
            exe_argv[exe_argc] = "--dep"; exe_argc += 1;
            exe_argv[exe_argc] = "errors"; exe_argc += 1;
            exe_argv[exe_argc] = "--dep"; exe_argc += 1;
            exe_argv[exe_argc] = "glob_pattern_matcher"; exe_argc += 1;
            exe_argv[exe_argc] = std.fmt.bufPrint(&ast_mod_buf, "-Mast={s}", .{ast_path}) catch unreachable; exe_argc += 1;
            exe_argv[exe_argc] = std.fmt.bufPrint(&errors_mod_buf, "-Merrors={s}", .{errors_path}) catch unreachable; exe_argc += 1;
            exe_argv[exe_argc] = std.fmt.bufPrint(&gpm_mod_buf, "-Mglob_pattern_matcher={s}", .{gpm_path}) catch unreachable; exe_argc += 1;
        } else {
            exe_argv[exe_argc] = "output_emitted.zig"; exe_argc += 1;
        }
        const result = std.process.Child.run(.{
            .allocator = allocator,
            .argv = exe_argv[0..exe_argc],
            .max_output_bytes = 10 * 1024 * 1024,
        }) catch |err| {
            const err_msg = std.fmt.bufPrint(&buf, "✗ zig build-exe failed: {}\n", .{err}) catch "✗ zig build-exe failed\n";
            stderr.writeAll(err_msg) catch {};
            std.process.exit(1);
        };
        defer allocator.free(result.stdout);
        defer allocator.free(result.stderr);

        var buf2: [512]u8 = undefined;
        // Full Term union — same contract as the build-file path above.
        switch (result.term) {
            .Exited => |exit_code| if (exit_code == 0) {
                const msg2 = std.fmt.bufPrint(&buf2, "✓ Compiled to {s} ({s})\n", .{ output_exe, exe_opt }) catch return .{ .ctx = ctx, .code = code };
                stdout.writeAll(msg2) catch {};
            } else {
                const msg2 = std.fmt.bufPrint(&buf2, "✗ Compilation failed\n", .{}) catch "✗ Compilation failed\n";
                stdout.writeAll(msg2) catch {};
                if (result.stderr.len > 0) {
                    stderr.writeAll("Error: ") catch {};
                    stderr.writeAll(result.stderr) catch {};
                    stderr.writeAll("\n") catch {};
                }
                std.process.exit(1);
            },
            .Signal => |sig| {
                const msg2 = std.fmt.bufPrint(&buf2, "✗ zig build-exe was killed by signal {d} — ended from outside, before it could finish. This usually means the machine ran out of memory, or something killed it externally. Check memory and load, then rerun. The source program was never judged.\n", .{sig}) catch "✗ zig build-exe killed\n";
                stderr.writeAll(msg2) catch {};
                std.process.exit(1);
            },
            .Stopped => |sig| {
                const msg2 = std.fmt.bufPrint(&buf2, "✗ zig build-exe was stopped by signal {d} and never resumed — resume or kill it, then rerun\n", .{sig}) catch "✗ zig build stopped\n";
                stderr.writeAll(msg2) catch {};
                std.process.exit(1);
            },
            .Unknown => |status| {
                const msg2 = std.fmt.bufPrint(&buf2, "✗ zig build-exe ended in an unknown state (status {d}) — rerun; if it repeats, the machine is the suspect\n", .{status}) catch "✗ zig build failed\n";
                stderr.writeAll(msg2) catch {};
                std.process.exit(1);
            },
        }
    }

    return .{ .ctx = ctx, .code = code };
}

// Stage D for the C# target: a minimal csproj IS the driver — dotnet has no
// file-based run, so the apphost lands at exactly the path koruc was asked
// for via AssemblyName.
~pub tor host-build-cs { ctx: CompilerContext, code: string } -> { ctx: CompilerContext, code: string }

~proc host-build-cs|zig {
    const emitter_helpers = @import("emitter_helpers");
    const allocator = ctx.allocator;
    const stdout = std.fs.File.stdout();
    const stderr = std.fs.File.stderr();
    var buf: [512]u8 = undefined;

    const output_exe = emitter_helpers.outputExeName(allocator);
    const cs_out_dir = std.fs.path.dirname(output_exe) orelse ".";
    const cs_assembly = std.fs.path.basename(output_exe);
    const csproj_text = std.fmt.allocPrint(allocator,
        "<Project Sdk=\"Microsoft.NET.Sdk\">\n" ++
        "  <PropertyGroup>\n" ++
        "    <OutputType>Exe</OutputType>\n" ++
        "    <TargetFramework>net8.0</TargetFramework>\n" ++
        "    <ImplicitUsings>disable</ImplicitUsings>\n" ++
        "    <Nullable>disable</Nullable>\n" ++
        "    <AssemblyName>{s}</AssemblyName>\n" ++
        "    <WarningLevel>0</WarningLevel>\n" ++
        "    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>\n" ++
        "  </PropertyGroup>\n" ++
        "  <ItemGroup>\n" ++
        "    <Compile Include=\"output_emitted.cs\" />\n" ++
        "  </ItemGroup>\n" ++
        "</Project>\n", .{cs_assembly}) catch |err| {
        std.debug.print("✗ csproj generation failed: {}\n", .{err});
        std.process.exit(1);
    };
    defer allocator.free(csproj_text);
    const csproj_file = std.fs.cwd().createFile("koru.csproj", .{}) catch |err| {
        std.debug.print("✗ csproj write failed: {}\n", .{err});
        std.process.exit(1);
    };
    defer csproj_file.close();
    csproj_file.writeAll(csproj_text) catch |err| {
        std.debug.print("✗ csproj write failed: {}\n", .{err});
        std.process.exit(1);
    };

    const cs_result = std.process.Child.run(.{
        .allocator = allocator,
        .argv = &.{ "dotnet", "build", "koru.csproj", "-o", cs_out_dir, "--nologo", "-v:q" },
        .max_output_bytes = 10 * 1024 * 1024,
    }) catch |err| {
        const msg3 = std.fmt.bufPrint(&buf, "✗ dotnet build failed to launch: {} — is the .NET SDK on PATH?\n", .{err}) catch "✗ dotnet build failed to launch\n";
        stderr.writeAll(msg3) catch {};
        std.process.exit(1);
    };
    defer allocator.free(cs_result.stdout);
    defer allocator.free(cs_result.stderr);
    switch (cs_result.term) {
        .Exited => |exit_code| if (exit_code == 0) {
            const msg3 = std.fmt.bufPrint(&buf, "✓ Compiled to {s} (dotnet build)\n", .{output_exe}) catch return .{ .ctx = ctx, .code = code };
            stdout.writeAll(msg3) catch {};
        } else {
            stdout.writeAll("✗ dotnet build failed\n") catch {};
            if (cs_result.stderr.len > 0) {
                stderr.writeAll(cs_result.stderr) catch {};
            }
            if (cs_result.stdout.len > 0) {
                stderr.writeAll(cs_result.stdout) catch {};
            }
            std.process.exit(1);
        },
        else => {
            stdout.writeAll("✗ dotnet build ended abnormally\n") catch {};
            std.process.exit(1);
        },
    }
    return .{ .ctx = ctx, .code = code };
}


// ------------------------------------------------------------
// Target routing
// ------------------------------------------------------------

// Target router: reads the compile target (--lang / CompilerEnv.lang) and
// selects the matching emission arm. Unknown targets take the zig arm —
// the Zig visitor is the reference emitter.
~[comptime] pub tor target-of { ctx: CompilerContext }
| zig
| js
| cs
| other

~proc target-of|zig {
    _ = ctx;
    if (std.mem.eql(u8, CompilerEnv.lang, "js")) return .{ .js = .{} };
    if (std.mem.eql(u8, CompilerEnv.lang, "cs")) return .{ .cs = .{} };
    if (std.mem.eql(u8, CompilerEnv.lang, "zig")) return .{ .zig = .{} };
    return .{ .other = .{} };
}

// JS code emission tor - selected by target-of under --lang=js
~pub tor emit-js { ctx: CompilerContext } -> { ctx: CompilerContext, code: string }

// C# code emission tor - selected by target-of under --lang=cs
~pub tor emit-cs { ctx: CompilerContext } -> { ctx: CompilerContext, code: string }

// Implementation of JS code emission — selected by the target-of arm under
// --lang=js. It walks ctx.ast and emits runnable JavaScript for the
// event-pump subset (tors, |js proc bodies, effect handlers, terminal
// branches, flows). CompilerEnv is already in scope at file level in the
// generated backend_output_emitted.zig (re-exported pub const) — reference
// it directly rather than re-importing, which would shadow that declaration.
~proc emit-js|zig {
    const js_emitter = @import("js_emitter");
    // Fail loud: a JS-emit failure must surface, not silently fall back to
    // Zig. A refusal is a USER error — some tor has no JavaScript
    // implementation on this target (a zig-only proc, an unmodelled
    // construct) — so it becomes a clean, located diagnostic (the
    // js_emitter already printed WHICH tor) and exit 1. The old
    // std.debug.panic made every refusal read as a compiler bug: SIGABRT,
    // a raw error name, and a backtrace that buried the reason. Pinned by
    // 400_191_zig_only_proc_js_build_refuses.
    const js_code = js_emitter.emit(ctx.allocator, ctx.ast, CompilerEnv.library) catch |err| {
        std.debug.print("error[KORU047]: JS emission failed: {s}\n", .{@errorName(err)});
        std.process.exit(1);
    };

    var updated_ctx = ctx;
    updated_ctx.passes_completed += 1;
    updated_ctx.current_pass = "emission";
    return .{ .ctx = updated_ctx, .code = js_code };
}

// Implementation of C# code emission — selected by the target-of arm under
// --lang=cs. Same fail-loud contract as the JS emitter: an unmodelled
// construct or unlowered builtin refuses here, never falls back to the Zig
// visitor's output.
~proc emit-cs|zig {
    const cs_emitter = @import("cs_emitter");
    const cs_code = cs_emitter.emit(ctx.allocator, ctx.ast, CompilerEnv.library) catch |err| {
        std.debug.print("error[KORU047]: CS emission failed: {s}\n", .{@errorName(err)});
        std.process.exit(1);
    };

    var updated_ctx = ctx;
    updated_ctx.passes_completed += 1;
    updated_ctx.current_pass = "emission";
    return .{ .ctx = updated_ctx, .code = cs_code };
}
