// Koru Standard Library: fleet — a named, custody-owning index of cells.
//
//   std/fleet:new(node, scope: "cell", world: "cells", capacity: 256)
//
//   std/fleet(node)                         // borrow the fleet
//   | fleet f |> std/fleet:spawn(f, id: "room-42", cell: room_state)
//     | spawned b |> ...
//     | resident |> ...
//     | refused |> ...
//
//   std/fleet(node.room-42)                 // borrow a member, static name
//   | cell c |> std/cell:run(c, src)
//   | not-found |> ...
//
//   std/fleet(node[id])                     // borrow a member, runtime key
//   | cell c |> ...
//   | not-found |> ...
//
// A fleet is residency + custody: it owns every `*Cell<cell!>` it mints
// (`spawn` wraps `std/cell`'s cell-create, `evict` its destroy), so the
// cell obligation never leaves the index — a member cannot be dropped,
// only evicted through the discharge path. `| fleet f |` and `| cell c |`
// are BORROWS: enough to run, define, and inspect; never enough to mint or
// hang up. That is the whole shape of the surface — one transform reading the
// target's form, ordinary borrow-gated tors for everything else.
//
// `new` mints the NAME, not the contents — membership is runtime data, the
// way a store's name is comptime while its rows are not. The registry maps
// the declared name to a `*Fleet`; `default`'s rewrite bakes the name into a
// `fleet-self`/`member-named` call, so a lookup with no `std/fleet:new` is a
// comptime refusal, not a runtime miss.

~import std/bridge
~import std/cell

const std = @import("std");
const ast = @import("ast");
const ast_functional = @import("ast_functional");
const Cl = @import("root").koru_std.koru_cell;

// ============================================================================
// FLEET — the resident-cell index. One per `std/fleet:new` name; members are
// `*Cell` keyed by cell id. The map is the custody: `spawn` puts, `evict`
// removes + discharges, `member`/`member-named` hand out borrows only.
// ============================================================================

pub const Fleet = struct {
    name: []const u8,
    scope: []const u8,
    world_root: []const u8,
    capacity: usize,
    members: std.StringHashMap(*Cl.Cell),
    allocator: std.mem.Allocator,
};

var fleet_registry: ?std.StringHashMap(*Fleet) = null;

fn registry() *std.StringHashMap(*Fleet) {
    if (fleet_registry == null) {
        fleet_registry = std.StringHashMap(*Fleet).init(koru_allocator());
    }
    return &fleet_registry.?;
}

// Name-addressed lookup shared by `fleet-self`, `member-named`, and the
// `new`-emitted init. `new` is checked at comptime, so a missing name here is
// a source-order violation, not user error — panic with the teaching.
fn fleetByName(name: []const u8) *Fleet {
    return registry().get(name) orelse
        std.debug.panic("std/fleet: '{s}' has no fleet — `std/fleet:new({s}, ...)` must precede its lookups in source order", .{ name, name });
}

fn fleetMember(f: *Fleet, id: []const u8) ?*Cl.Cell {
    if (f.members.get(id)) |c| return c;
    return fleetActivate(f, id);
}

// Dormant-but-durable re-activation, Orleans-style: a member miss probes
// `<world_root>/<id>/state.kv`; the file's `#shape`/`#shape_def` header is
// enough to rebuild the cell with its state restored, so `| not-found` means
// "never existed anywhere", not "not in memory". At capacity the fleet evicts
// an arbitrary resident to make room — residency is a cache; the directory
// is the truth. A worldless fleet has no durable floor and keeps the old
// miss semantics.
fn fleetActivate(f: *Fleet, id: []const u8) ?*Cl.Cell {
    if (f.world_root.len == 0) return null;
    var pb: [1024]u8 = undefined;
    const path = std.fmt.bufPrint(&pb, "{s}/{s}/state.kv", .{ f.world_root, id }) catch return null;
    const a = f.allocator;
    const src = std.fs.cwd().readFileAlloc(a, path, 1024 * 1024) catch return null;
    defer a.free(src);
    var shape: ?[]const u8 = null;
    var shape_def: ?[]const u8 = null;
    var lines = std.mem.splitScalar(u8, src, '\n');
    while (lines.next()) |line| {
        if (line.len == 0 or line[0] != '#') break;
        if (std.mem.startsWith(u8, line, "#shape=")) shape = line["#shape=".len..];
        if (std.mem.startsWith(u8, line, "#shape_def=")) shape_def = line["#shape_def=".len..];
    }
    if (shape == null or shape_def == null) return null;
    if (f.members.count() >= f.capacity) {
        var it = f.members.iterator();
        if (it.next()) |kv| {
            const evicted = f.members.fetchRemove(kv.key_ptr.*).?;
            Cl.cellDestroy(evicted.value);
            a.free(evicted.key);
        }
    }
    const c = Cl.cellCreate(shape.?, shape_def.?, id, f.scope, f.world_root) orelse return null;
    const key = a.dupe(u8, id) catch {
        Cl.cellDestroy(c);
        return null;
    };
    f.members.put(key, c) catch {
        a.free(key);
        Cl.cellDestroy(c);
        return null;
    };
    return c;
}

// ============================================================================
// FLEET-INIT — what `std/fleet:new` rewrites to. Void: the declaration is a
// statement, not a turn.
// ============================================================================

~pub tor fleet-init { name: string, scope: string, world: string, capacity: usize }

~proc fleet-init|zig {
    const a = koru_allocator();
    const reg = registry();
    if (reg.get(name) != null) return;
    const f = a.create(Fleet) catch unreachable;
    f.* = .{
        .name = a.dupe(u8, name) catch unreachable,
        .scope = a.dupe(u8, scope) catch unreachable,
        .world_root = a.dupe(u8, world) catch unreachable,
        .capacity = capacity,
        .members = std.StringHashMap(*Cl.Cell).init(a),
        .allocator = a,
    };
    reg.put(f.name, f) catch unreachable;
}

// ============================================================================
// FLEET-SELF — `std/fleet(node)`: borrow the fleet itself.
// ============================================================================

~pub tor fleet-self { fleet: string }
| fleet *Fleet<fleet>
| ?not-found

~proc fleet-self|zig {
    const f = registry().get(fleet) orelse return .{ .not_found = .{} };
    return .{ .fleet = f };
}

// ============================================================================
// MEMBER / MEMBER-NAMED — `std/fleet(node.ID)`: borrow the member cell.
// `member` is the borrow-typed verb (inside a `| fleet f |` arm);
// `member-named` is the name-addressed surface `default` emits.
// ============================================================================

~pub tor member { f: *Fleet<fleet>, id: string }
| cell *std/cell:Cell<cell>
| not-found

~proc member|zig {
    if (fleetMember(f, id)) |b| return .{ .cell = b };
    return .{ .not_found = .{} };
}

~pub tor member-named { fleet: string, id: string }
| cell *std/cell:Cell<cell>
| not-found

~proc member-named|zig {
    if (fleetMember(fleetByName(fleet), id)) |b| return .{ .cell = b };
    return .{ .not_found = .{} };
}

// ============================================================================
// CELL-SPAWN — activate a cell under fleet custody. The user-facing verb is
// `spawn(f, id:, cell: <proto>)`, whose [pre] transform resolves the proto and
// rewrites here with `shape`/`shape_def` baked. `| spawned` yields the borrow
// so the caller can dispatch into it immediately.
// ============================================================================

~pub tor cell-spawn { f: *Fleet<fleet>, id: string, shape: string, shape_def: string }
| spawned *std/cell:Cell<cell>
| resident
| refused

~proc cell-spawn|zig {
    if (f.members.get(id) != null) return .resident;
    // The identity is durable, not just resident: a state file on the world
    // floor means this id is a cell that exists, dormant or not — `resident`,
    // not a silent resurrection.
    if (f.world_root.len > 0) {
        var pb: [1024]u8 = undefined;
        if (std.fmt.bufPrint(&pb, "{s}/{s}/state.kv", .{ f.world_root, id })) |p| {
            if (std.fs.cwd().access(p, .{})) |_| {
                return .resident;
            } else |_| {}
        } else |_| {}
    }
    if (f.members.count() >= f.capacity) return .refused;
    const a = f.allocator;
    const b = Cl.cellCreate(shape, shape_def, id, f.scope, f.world_root) orelse
        return .refused;
    const key = a.dupe(u8, id) catch {
        Cl.cellDestroy(b);
        return .refused;
    };
    f.members.put(key, b) catch {
        a.free(key);
        Cl.cellDestroy(b);
        return .refused;
    };
    return .{ .spawned = b };
}

// ============================================================================
// EVICT — hibernate a cell: remove + `std/cell`'s destroy. The destroy
// discharges the cell obligation and releases whatever the cell still held —
// that is the point of routing teardown through here.
// ============================================================================

~pub tor evict { f: *Fleet<fleet>, id: string }
| evicted
| absent

~proc evict|zig {
    if (f.members.fetchRemove(id)) |kv| {
        Cl.cellDestroy(kv.value);
        f.allocator.free(kv.key);
        return .evicted;
    }
    return .absent;
}

// ============================================================================
// RETIRE — the durable counterpart of `evict`: evict releases residency and
// the state file survives; retire deletes `<world_root>/<id>` outright —
// the cell stops existing anywhere. `| absent` only when nothing was there.
// ============================================================================

~pub tor retire { f: *Fleet<fleet>, id: string }
| retired
| absent

~proc retire|zig {
    var found = false;
    if (f.members.fetchRemove(id)) |kv| {
        Cl.cellDestroy(kv.value);
        f.allocator.free(kv.key);
        found = true;
    }
    if (f.world_root.len > 0) {
        var pb: [1024]u8 = undefined;
        if (std.fmt.bufPrint(&pb, "{s}/{s}", .{ f.world_root, id })) |p| {
            if (std.fs.cwd().access(p, .{})) |_| {
                found = true;
            } else |_| {}
            std.fs.cwd().deleteTree(p) catch {};
        } else |_| {}
    }
    return if (found) .{ .retired = .{} } else .{ .absent = .{} };
}

// ============================================================================
// COUNT — resident cells.
// ============================================================================

~pub tor count { f: *Fleet<fleet> } -> u32

~proc count|zig {
    return @intCast(f.members.count());
}

// ============================================================================
// DRAIN — shutdown: close every resident cell, retire the fleet's registry
// entry, and release everything the index allocated. A daemon runs fleets
// forever; a program that created one must drain it before exit — the leak
// check counts every byte the registry still holds.
// ============================================================================

~pub tor drain { f: *Fleet<fleet> } -> u32

~proc drain|zig {
    var n: u32 = 0;
    var it = f.members.iterator();
    while (it.next()) |e| {
        Cl.cellDestroy(e.value_ptr.*);
        f.allocator.free(e.key_ptr.*);
        n += 1;
    }
    f.members.deinit();
    const a = f.allocator;
    const reg = registry();
    _ = reg.remove(f.name);
    a.free(f.name);
    a.free(f.scope);
    a.free(f.world_root);
    a.destroy(f);
    if (reg.count() == 0) {
        reg.deinit();
        fleet_registry = null;
    }
    return n;
}

// ============================================================================
// Helpers for the transforms (local — the CH pattern in channel.kz).
// ============================================================================

const FH = struct {
    fn trim(s: []const u8) []const u8 {
        return std.mem.trim(u8, s, " \t\n\r");
    }
    fn stripQuotes(s: []const u8) []const u8 {
        const t = trim(s);
        if (t.len >= 2 and t[0] == '"' and t[t.len - 1] == '"') return t[1 .. t.len - 1];
        return t;
    }
    fn identOk(s: []const u8) bool {
        if (s.len == 0) return false;
        for (s, 0..) |c, i| {
            const ok = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or c == '-' or (i > 0 and c >= '0' and c <= '9');
            if (!ok) return false;
        }
        return true;
    }
    // Recursive scan: every flow item whose invocation is `std/fleet:new`
    // with `expr` == name. Runs in [pre] — decl sites are still raw.
    fn findDecl(items: []const ast.Item, name: []const u8) bool {
        for (items) |*it| {
            switch (it.*) {
                .flow => |*f| {
                    const inv = f.inv();
                    if (inv.path.module_qualifier) |mq| {
                        if (std.mem.eql(u8, mq, "std.fleet") and inv.path.segments.len == 1 and std.mem.eql(u8, inv.path.segments[0], "new")) {
                            for (inv.args) |a| {
                                if (std.mem.eql(u8, a.name, "expr") and std.mem.eql(u8, stripQuotes(a.value), name)) return true;
                            }
                        }
                    }
                },
                .module_decl => |*m| if (findDecl(m.items, name)) return true,
                else => {},
            }
        }
        return false;
    }
    // `spawn`/`evict` call bridge's create/close from HOST code — nothing in
    // the program invokes them, so dead-strip would retire the tors and the
    // emitted `koru_bridge` module would land without its handlers (channel's
    // rings anchor: the import is not the fix, retention is). Splice `retain`
    // onto those two event_decls; idempotent across multiple `new`s.
    fn retainBridgeEvents(prog: *const ast.Program, alloc: std.mem.Allocator) void {
        const W = struct {
            fn retain(its: []const ast.Item, want: []const u8, al: std.mem.Allocator) void {
                for (its) |*pi| {
                    switch (pi.*) {
                        .module_decl => |*md| {
                            if (std.mem.eql(u8, md.logical_name, "std.bridge")) {
                                for (md.items) |*mi| {
                                    if (mi.* != .event_decl) continue;
                                    const ed = &mi.event_decl;
                                    if (ed.path.segments.len == 1 and std.mem.eql(u8, ed.path.segments[0], want)) {
                                        for (ed.annotations) |a| if (std.mem.eql(u8, a, "retain")) return;
                                        const grown = al.alloc([]const u8, ed.annotations.len + 1) catch unreachable;
                                        @memcpy(grown[0..ed.annotations.len], ed.annotations);
                                        grown[ed.annotations.len] = al.dupe(u8, "retain") catch unreachable;
                                        @constCast(ed).annotations = grown;
                                    }
                                }
                                return;
                            }
                            retain(md.items, want, al);
                        },
                        else => {},
                    }
                }
            }
        };
        W.retain(prog.items, "create", alloc);
        W.retain(prog.items, "close", alloc);
        // `run` too — `std/cell:run` reaches `Br.run_event.handler` from host
        // code, and a fleet program can run cells without ever spelling
        // `std/cell:open`.
        W.retain(prog.items, "run", alloc);
    }
    // The arm-name check Lars asked for: a continuation carrying `branch`.
    fn hasArm(flow: *const ast.Flow, branch: []const u8) bool {
        for (flow.body.continuations) |*c| {
            if (c.kind == .terminal and std.mem.eql(u8, trim(c.branch), branch)) return true;
        }
        return false;
    }
    fn anyArm(flow: *const ast.Flow) ?[]const u8 {
        for (flow.body.continuations) |*c| {
            const b = trim(c.branch);
            if (b.len > 0) return b;
        }
        return null;
    }
};

// ============================================================================
// FLEET.NEW — `std/fleet:new(name, scope: "cell", world: "cells", capacity: N)`
// mints the name at comptime and rewrites to a `fleet-init` call so the
// registry is populated at the point the declaration sat in source.
// ============================================================================

~[keyword|comptime|transform]pub tor new {
    expr: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc new|zig {
    if (item.* != .flow) @panic("fleet:new transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    if (invocation != flow.inv()) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:new: a fleet declaration is a top-level item", .{}) };
    }

    var fleet_name: []const u8 = "";
    var scope_text: ?[]const u8 = null;
    var world_text: []const u8 = "";
    var cap_text: []const u8 = "256";
    for (invocation.args) |a| {
        const an = std.mem.trim(u8, a.name, " \t");
        if (std.mem.eql(u8, an, "expr")) {
            fleet_name = FH.stripQuotes(a.value);
            continue;
        }
        if (std.mem.eql(u8, an, "scope")) {
            scope_text = FH.stripQuotes(a.value);
            continue;
        }
        if (std.mem.eql(u8, an, "world")) {
            world_text = FH.stripQuotes(a.value);
            continue;
        }
        if (std.mem.eql(u8, an, "capacity")) {
            cap_text = FH.trim(a.value);
            continue;
        }
        // A bare positional that leads is the name; anything else is a stray.
        if (a.expression_value == null and std.mem.eql(u8, an, FH.trim(a.value))) {
            if (fleet_name.len == 0) {
                fleet_name = FH.stripQuotes(an);
                continue;
            }
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:new({s}): '{s}' is a bare positional — scope, world, and capacity are named", .{ fleet_name, an }) };
        }
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:new: unknown argument '{s}' — the head is `std/fleet:new(name, scope: \"cell\", world: \"cells\", capacity: N)`", .{an}) };
    }
    if (fleet_name.len == 0) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:new needs the fleet name — `std/fleet:new(node, scope: \"cell\")`", .{}) };
    }
    if (!FH.identOk(fleet_name)) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:new: the fleet name '{s}' is not usable — it must be an identifier (a-z, A-Z, 0-9, '_', '-'; no leading digit)", .{fleet_name}) };
    }
    const scope = scope_text orelse {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:new({s}): a fleet names its vocabulary — `scope: \"cell\"`, the register block its cells dispatch against", .{fleet_name}) };
    };
    _ = std.fmt.parseInt(usize, cap_text, 10) catch {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:new({s}): capacity '{s}' is not a comptime integer — the index is sized at the declaration", .{ fleet_name, cap_text }) };
    };

    if (FH.anyArm(flow)) |arm| {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:new({s}): `{s}` doesn't parse on a declaration — members attach through `std/fleet({s}.ID)` and verbs take the `| fleet f |` borrow", .{ fleet_name, arm, fleet_name }) };
    }

    // The fleet's procs reach create/close through host code only — retain
    // them or dead-strip strips them.
    FH.retainBridgeEvents(program, allocator);

    // Rewrite to the init call — `name`/`scope`/`world` as string literals,
    // capacity as the raw integer text.
    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    segs[0] = allocator.dupe(u8, "fleet-init") catch unreachable;
    const init_args = allocator.alloc(ast.Arg, 4) catch unreachable;
    init_args[0] = ast.Arg{ .name = allocator.dupe(u8, "name") catch unreachable, .value = std.fmt.allocPrint(allocator, "\"{s}\"", .{fleet_name}) catch unreachable };
    init_args[1] = ast.Arg{ .name = allocator.dupe(u8, "scope") catch unreachable, .value = std.fmt.allocPrint(allocator, "\"{s}\"", .{scope}) catch unreachable };
    init_args[2] = ast.Arg{ .name = allocator.dupe(u8, "world") catch unreachable, .value = std.fmt.allocPrint(allocator, "\"{s}\"", .{world_text}) catch unreachable };
    init_args[3] = ast.Arg{ .name = allocator.dupe(u8, "capacity") catch unreachable, .value = allocator.dupe(u8, cap_text) catch unreachable };
    const init_inv = ast.Invocation{
        .path = ast.DottedPath{ .module_qualifier = allocator.dupe(u8, "std.fleet") catch unreachable, .segments = segs },
        .args = init_args,
    };
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(init_inv, &.{}, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = invocation.preamble_code,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}

// ============================================================================
// FLEET.SPAWN — `std/fleet:spawn(f, id: "room-42", cell: room_state)`: bind the
// shape at spawn. The `cell:` name resolves against the program's `std/proto`
// decls at transform time ([pre], like cell:open — decl sites still legible),
// its field block bakes into the `shape_def` manifest, and the call rewrites
// to `cell-spawn`. A spawn without `cell:` refuses — a fleet member IS a cell.
// ============================================================================

~[keyword|comptime|transform|pre]pub tor spawn {
    expr: Expression,
    cell: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
}
| spawned *
| resident
| refused

~[transform]proc spawn|zig {
    if (item.* != .flow) @panic("fleet:spawn transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    var f_text: ?[]const u8 = null;
    var shape: []const u8 = "";
    var id_text: ?[]const u8 = null;
    for (invocation.args) |a| {
        const an = FH.trim(a.name);
        if (std.mem.eql(u8, an, "expr")) {
            f_text = a.value;
            continue;
        }
        if (std.mem.eql(u8, an, "cell")) {
            shape = FH.stripQuotes(a.value);
            continue;
        }
        if (std.mem.eql(u8, an, "id")) {
            id_text = a.value;
            continue;
        }
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:spawn: unknown argument '{s}' — the head is `std/fleet:spawn(f, id: \"room-42\", cell: room_state)`", .{an}) };
    }
    if (f_text == null) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:spawn needs the fleet borrow — `| fleet f |> std/fleet:spawn(f, id: \"...\", cell: <shape>)`", .{}) };
    }
    if (id_text == null) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:spawn: cells are named — pass `id: \"room-42\"`", .{}) };
    }
    if (shape.len == 0) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:spawn: a fleet member is a cell — name the shape, `cell: room_state` (a declared std/proto)", .{}) };
    }
    // CH lives in this same emitted module (koru_std.koru_cell) — a direct
    // ref, not `Cl`/`@import("root")`: transform procs are analyzed under the
    // backend exe too, where `root` is backend.zig and has no `koru_std`.
    const proto_source = koru_std.koru_cell.CH.findProtoSource(program.items, shape) orelse {
        if (ast.declarationRefused(allocator, program, flow.module, "std/proto({s})", .{shape})) return .{ .transformed = .{} };
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet:spawn: unknown shape '{s}' — no `std/proto({s}) {{ ... }}` declared", .{ shape, shape }) };
    };
    const manifest = koru_std.koru_cell.CH.shapeManifest(allocator, proto_source);

    // The spawn sits mid-chain inside a `| fleet f` arm — rewrite the site's
    // invocation in place; the spawned/resident/refused arms pass through.
    const site = koru_std.koru_cell.CH.findSite(&flow.body, invocation) orelse
        return .{ .transformed = .{} };

    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    segs[0] = allocator.dupe(u8, "cell-spawn") catch unreachable;
    const args = allocator.alloc(ast.Arg, 4) catch unreachable;
    args[0] = ast.Arg{ .name = allocator.dupe(u8, "f") catch unreachable, .value = allocator.dupe(u8, f_text.?) catch unreachable };
    args[1] = ast.Arg{ .name = allocator.dupe(u8, "id") catch unreachable, .value = allocator.dupe(u8, id_text.?) catch unreachable };
    args[2] = ast.Arg{ .name = allocator.dupe(u8, "shape") catch unreachable, .value = std.fmt.allocPrint(allocator, "\"{s}\"", .{shape}) catch unreachable };
    args[3] = ast.Arg{ .name = allocator.dupe(u8, "shape_def") catch unreachable, .value = std.fmt.allocPrint(allocator, "\"{s}\"", .{manifest}) catch unreachable };
    const call_inv = ast.Invocation{
        .path = ast.DottedPath{ .module_qualifier = allocator.dupe(u8, "std.fleet") catch unreachable, .segments = segs },
        .args = args,
    };
    const conts = allocator.alloc(ast.Continuation, site.continuations.len) catch unreachable;
    for (site.continuations, 0..) |*c, i| {
        conts[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
    }
    return .{ .transformed = .{ .replacement_node = .{
        .node = .{ .invocation = call_inv },
        .children = conts,
    } } };
}

// ============================================================================
// FLEET.DEFAULT — `std/fleet(<target>)`: the borrow join. [pre] so the rewrite
// lands before `new` transforms away — the scan reads raw declaration sites.
//
//   node        → fleet-self(node)          needs `| fleet f |`
//   node.ID     → member-named(node, "ID")  needs `| cell c |` (+ `| not-found`)
//   node[expr]  → member-named(node, expr)  needs `| cell c |` (+ `| not-found`)
// ============================================================================

~[keyword|comptime|transform|pre]pub tor default {
    expr: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc default|zig {
    if (item.* != .flow) @panic("fleet:default transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    if (invocation != flow.inv()) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet: the bare borrow is a top-level item — member lookups inside a chain go through `std/fleet:member(f, id)` on a `| fleet f |` borrow", .{}) };
    }
    if (invocation.args.len == 0) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet: the borrow needs a target — `std/fleet(node)` for the fleet, `std/fleet(node.ID)` for a member", .{}) };
    }
    const target = FH.trim(invocation.args[0].value);
    if (invocation.args.len > 1) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet({s}): the borrow takes only the target", .{target}) };
    }
    if (target.len == 0) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet: the borrow needs a target — `std/fleet(node)` for the fleet, `std/fleet(node.ID)` for a member", .{}) };
    }

    // Target form: `name[key]` subscript (runtime id), `name.member` (static
    // id), or bare `name` (the fleet itself).
    var fleet_name: []const u8 = target;
    var member_text: ?[]const u8 = null;
    var member_is_expr = false;
    if (std.mem.indexOfScalar(u8, target, '[')) |ob| {
        fleet_name = FH.trim(target[0..ob]);
        const close = std.mem.lastIndexOfScalar(u8, target, ']') orelse
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet({s}): unbalanced `[` — the member subscript is `std/fleet(node[id])`", .{target}) };
        member_text = FH.trim(target[ob + 1 .. close]);
        member_is_expr = true;
    } else if (std.mem.indexOfScalar(u8, target, '.')) |dot| {
        fleet_name = FH.trim(target[0..dot]);
        member_text = FH.trim(target[dot + 1 ..]);
    }

    if (!FH.identOk(fleet_name)) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet({s}): '{s}' is not a usable fleet name", .{ target, fleet_name }) };
    }
    if (!FH.findDecl(program.items, fleet_name)) {
        if (ast.declarationRefused(allocator, program, flow.module, "std/fleet:new({s}):", .{fleet_name})) return .{ .transformed = .{} };
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet({s}): unknown fleet — no std/fleet:new({s}, ...) declared", .{ target, fleet_name }) };
    }

    // The arm the call shape needs must be there — name the missing one.
    if (member_text == null) {
        if (!FH.hasArm(flow, "fleet")) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet({s}): the fleet borrow arrives on `| fleet f |` — `std/fleet({s}) | fleet f |> ...`", .{ target, target }) };
        }
    } else {
        if (member_text.?.len == 0) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet({s}): the member name is empty — `std/fleet({s}.ID)` or `std/fleet({s}[key])`", .{ target, fleet_name, fleet_name }) };
        }
        if (!FH.hasArm(flow, "cell")) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet({s}): the member borrow arrives on `| cell c |` — `std/fleet({s}) | cell c |> ... | not-found |> ...`", .{ target, target }) };
        }
        if (!FH.hasArm(flow, "not-found")) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/fleet({s}): a member lookup can miss — `| not-found |>` is required; dormant is a decision, not silence", .{target}) };
        }
    }

    // Rewrite to the name-addressed tor. The subscript form passes its key
    // text through as a live expression; the member form quotes the name.
    const segs = allocator.alloc([]const u8, 1) catch unreachable;
    const args = allocator.alloc(ast.Arg, 2) catch unreachable;
    if (member_text) |m| {
        segs[0] = allocator.dupe(u8, "member-named") catch unreachable;
        args[0] = ast.Arg{ .name = allocator.dupe(u8, "fleet") catch unreachable, .value = std.fmt.allocPrint(allocator, "\"{s}\"", .{fleet_name}) catch unreachable };
        args[1] = ast.Arg{ .name = allocator.dupe(u8, "id") catch unreachable, .value = if (member_is_expr) allocator.dupe(u8, m) catch unreachable else std.fmt.allocPrint(allocator, "\"{s}\"", .{m}) catch unreachable };
    } else {
        segs[0] = allocator.dupe(u8, "fleet-self") catch unreachable;
        args[0] = ast.Arg{ .name = allocator.dupe(u8, "fleet") catch unreachable, .value = std.fmt.allocPrint(allocator, "\"{s}\"", .{fleet_name}) catch unreachable };
    }
    const call_inv = ast.Invocation{
        .path = ast.DottedPath{ .module_qualifier = allocator.dupe(u8, "std.fleet") catch unreachable, .segments = segs },
        .args = args[0..(if (member_text == null) 1 else 2)],
    };
    const conts = allocator.alloc(ast.Continuation, flow.body.continuations.len) catch unreachable;
    for (flow.body.continuations, 0..) |*c, i| {
        conts[i] = ast_functional.cloneContinuation(allocator, c) catch unreachable;
    }
    return .{ .transformed = .{ .replacement = ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(call_inv, conts, flow.location),
        .pre_label = null,
        .impl_of = flow.impl_of,
        .super_shape = null,
        .inline_body = null,
        .preamble_code = invocation.preamble_code,
        .is_pure = false,
        .is_transitively_pure = false,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } } } };
}
