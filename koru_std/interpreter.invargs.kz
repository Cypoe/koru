// Koru Standard Library: the `invargs` part of interpreter — the
// argument-vocabulary walk. Joined via `~part invargs` in interpreter.kz;
// merged into the interpreter module at load.
//
// checkInvocationArgs judges each invocation's named fields against the
// verb's declared input vocabulary, and each arm word against its declared
// outcome vocabulary — the checks called by checkFlowArgs in the args part.
// Owner resolution (bound scope, then the run's mounted set) lives in the
// `mounted` part.

fn checkInvocationArgs(
    cont: *const ast.Continuation,
    input_fn: ?InputLookupFn,
    branches_fn: ?BranchesLookupFn,
    defined: ?*DefinedFlows,
    bound: *std.StringHashMap(void),
    allocator: std.mem.Allocator,
) ?ValidationError {
    // Destructures are not implemented in interpreted flows — eval binds only
    // `| <branch> name`, so `{ … }` (and any annotation on a field) drops
    // silently. Refuse rather than accept a binder that binds nothing.
    if (cont.destructure.len > 0) {
        return .{
            .message = std.fmt.allocPrint(allocator, "destructure '{{ … }}' is not implemented in an interpreted flow — bind the payload by name (`| <branch> {s} |>`)", .{cont.destructure[0].name}) catch "destructure not implemented",
            .binding_name = cont.destructure[0].name,
        };
    }
    const mounted = runMountedScopes();
    if (cont.node) |*n| {
        switch (n.*) {
            .invocation => |*inv| {
                const event_name = if (inv.path.segments.len > 0) inv.path.segments[0] else "";
                const is_defined = if (defined) |d| findDefinedFlow(d, event_name) != null else false;
                if (!is_defined) {
                    if (ownerInputSpec(input_fn, mounted, event_name)) |spec| {
                        for (inv.args) |arg| {
                            var declared = false;
                            for (spec) |field| {
                                if (std.mem.eql(u8, field.name, arg.name)) {
                                    declared = true;
                                    break;
                                }
                            }
                            if (!declared) {
                                return .{
                                    .message = std.fmt.allocPrint(allocator, "unknown field '{s}' on '{s}'", .{ arg.name, event_name }) catch "unknown field",
                                    .binding_name = arg.name,
                                };
                            }
                        }
                        if (checkArmWords(input_fn, branches_fn, mounted, event_name, cont, allocator)) |e| return e;
                    }
                }
                for (inv.args) |arg| {
                    if (unboundRefName(arg.value, bound, allocator)) |name| {
                        return .{
                            .message = std.fmt.allocPrint(allocator, "unbound '{s}' on '{s}' — bind it with an arm (`| <branch> {s} |>`) or quote it for a literal", .{ name, event_name, name }) catch "unbound identifier",
                            .binding_name = name,
                        };
                    }
                }
            },
            else => {},
        }
    }
    // Each arm's own bindings scope to that arm's subtree — seed before
    // descending, lift after. An arm that re-binds an outer name is the
    // shadowing check's refusal, already answered above; names we did not
    // add are left alone.
    for (cont.continuations) |*arm| {
        var added = std.ArrayList([]const u8){};
        defer added.deinit(allocator);
        if (arm.binding) |b| seedBound(bound, &added, b, allocator);
        seedDestructure(bound, &added, arm.destructure, allocator);
        const r = checkInvocationArgs(arm, input_fn, branches_fn, defined, bound, allocator);
        for (added.items) |name| _ = bound.remove(name);
        if (r) |e| return e;
    }
    return null;
}
