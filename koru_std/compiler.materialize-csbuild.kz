// C# Stage D — the dotnet driver of artifact materialization. A minimal
// csproj IS the driver (dotnet has no file-based run): OutputType flips
// with koruc lib (Exe apphost vs callable .dll), AssemblyName lands the
// artifact at the -o path. Ordinary pipeline tor — swappable by a user
// emission override like every other materialization step.
// ============================================================

// Stage D for the C# target: a minimal csproj IS the driver — dotnet has no
// file-based run, so the apphost lands at exactly the path koruc was asked
// for via AssemblyName. `koruc lib` flips OutputType to Library — the
// artifact is a callable .dll (ASP.NET-loadable), not an apphost.
~pub tor host-build-cs { ctx: CompilerContext, code: string, output: ?string, dir: ?string } -> { ctx: CompilerContext, code: string }

~proc host-build-cs|zig {
    const emitter_helpers = @import("emitter_helpers");
    const allocator = ctx.allocator;
    const stdout = std.fs.File.stdout();
    const stderr = std.fs.File.stderr();
    var buf: [512]u8 = undefined;

    const output_exe = if (output) |o| allocator.dupe(u8, o) catch unreachable else emitter_helpers.outputExeName(allocator);
    const cs_src = if (dir) |d| std.fs.path.join(allocator, &.{ d, "output_emitted.cs" }) catch unreachable else "output_emitted.cs";
    const cs_out_dir = std.fs.path.dirname(output_exe) orelse ".";
    // `koruc lib MyLib.dll` must not produce MyLib.dll.dll — the assembly
    // name is the stem, the extension is the toolchain's to add.
    const cs_base = std.fs.path.basename(output_exe);
    const cs_assembly = if (std.mem.endsWith(u8, cs_base, ".dll")) cs_base[0 .. cs_base.len - 4] else cs_base;
    const cs_output_type = if (CompilerEnv.library) "Library" else "Exe";
    const csproj_text = std.fmt.allocPrint(allocator,
        "<Project Sdk=\"Microsoft.NET.Sdk\">\n" ++
        "  <PropertyGroup>\n" ++
        "    <OutputType>{s}</OutputType>\n" ++
        "    <TargetFramework>net8.0</TargetFramework>\n" ++
        "    <ImplicitUsings>disable</ImplicitUsings>\n" ++
        "    <Nullable>disable</Nullable>\n" ++
        "    <AssemblyName>{s}</AssemblyName>\n" ++
        "    <WarningLevel>0</WarningLevel>\n" ++
        "    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>\n" ++
        "  </PropertyGroup>\n" ++
        "  <ItemGroup>\n" ++
        "    <Compile Include=\"{s}\" />\n" ++
        "  </ItemGroup>\n" ++
        "</Project>\n", .{ cs_output_type, cs_assembly, cs_src }) catch |err| {
        std.debug.print("✗ csproj generation failed: {}\n", .{err});
        std.process.exit(1);
    };
    defer allocator.free(csproj_text);
    const csproj_file = std.fs.cwd().createFile("koru.csproj", .{}) catch |err| {
        std.debug.print("✗ csproj write failed: {}\n", .{err});
        std.process.exit(1);
    };
    defer csproj_file.close();
    csproj_file.writeAll(csproj_text) catch |err| {
        std.debug.print("✗ csproj write failed: {}\n", .{err});
        std.process.exit(1);
    };

    const cs_result = std.process.Child.run(.{
        .allocator = allocator,
        .argv = &.{ "dotnet", "build", "koru.csproj", "-o", cs_out_dir, "--nologo", "-v:q" },
        .max_output_bytes = 10 * 1024 * 1024,
    }) catch |err| {
        const msg3 = std.fmt.bufPrint(&buf, "✗ dotnet build failed to launch: {} — is the .NET SDK on PATH?\n", .{err}) catch "✗ dotnet build failed to launch\n";
        stderr.writeAll(msg3) catch {};
        std.process.exit(1);
    };
    defer allocator.free(cs_result.stdout);
    defer allocator.free(cs_result.stderr);
    switch (cs_result.term) {
        .Exited => |exit_code| if (exit_code == 0) {
            // A Library build's artifact is <assembly>.dll — naming
            // output_exe here would point at a file that does not exist.
            const cs_artifact = if (CompilerEnv.library) blk: {
                break :blk std.fmt.allocPrint(allocator, "{s}/{s}.dll", .{ cs_out_dir, cs_assembly }) catch output_exe;
            } else output_exe;
            const msg3 = std.fmt.bufPrint(&buf, "✓ Compiled to {s} (dotnet build)\n", .{cs_artifact}) catch return .{ .ctx = ctx, .code = code };
            stdout.writeAll(msg3) catch {};
        } else {
            stdout.writeAll("✗ dotnet build failed\n") catch {};
            if (cs_result.stderr.len > 0) {
                stderr.writeAll(cs_result.stderr) catch {};
            }
            if (cs_result.stdout.len > 0) {
                stderr.writeAll(cs_result.stdout) catch {};
            }
            std.process.exit(1);
        },
        else => {
            stdout.writeAll("✗ dotnet build ended abnormally\n") catch {};
            std.process.exit(1);
        },
    }
    return .{ .ctx = ctx, .code = code };
}
