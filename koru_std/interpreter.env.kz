// Koru Standard Library: the `env` part of interpreter.kz — the binding
// table and its seeding. Joined via `~part env` in interpreter.kz; merged
// into the interpreter module at load.

// ============================================================================
// ENVIRONMENT - Tracks bindings during interpretation
// ============================================================================

pub const Environment = struct {
    bindings: std.StringHashMap(Value),
    allocator: std.mem.Allocator,

    pub fn init(allocator: std.mem.Allocator) Environment {
        return .{
            .bindings = std.StringHashMap(Value).init(allocator),
            .allocator = allocator,
        };
    }

    pub fn deinit(self: *Environment) void {
        self.bindings.deinit();
    }

    /// Clear bindings but keep capacity to avoid reallocating in hot paths.
    pub fn clear(self: *Environment) void {
        self.bindings.clearRetainingCapacity();
    }

    pub fn bind(self: *Environment, name: []const u8, value: Value) !void {
        try self.bindings.put(name, value);
    }

    /// Deep-copy a run-arena Value into this env's allocator and bind it —
    /// the write for bindings that outlive their run (session, turn).
    pub fn bindCopy(self: *Environment, name: []const u8, value: Value) !void {
        const fields_copy = try self.allocator.alloc(NamedField, value.fields.len);
        for (value.fields, 0..) |f, i| {
            const fv: FieldValue = switch (f.value) {
                .string_val => |s| .{ .string_val = try self.allocator.dupe(u8, s) },
                .string_array => |arr| .{ .string_array = dupeStrs(self.allocator, arr) },
                else => f.value,
            };
            fields_copy[i] = .{
                .name = try self.allocator.dupe(u8, f.name),
                .value = fv,
            };
        }
        try self.bind(try self.allocator.dupe(u8, name), .{
            .branch = try self.allocator.dupe(u8, value.branch),
            .fields = fields_copy,
        });
    }

    pub fn get(self: *Environment, name: []const u8) ?Value {
        return self.bindings.get(name);
    }

    pub fn remove(self: *Environment, name: []const u8) void {
        _ = self.bindings.remove(name);
    }
};

/// Seed a run env's bound set from the tables that outrank it: the session's
/// durable bindings (a name an earlier turn bound is bound for this flow's
/// whole text), then this turn's earlier arm bindings (`| ok b |>` on item
/// 1 makes `b` bound on item 3). Session values were copied into session
/// memory at bind time, so a shallow transplant is safe across arena resets.
pub fn seedSessionTurnEnvs(env: *Environment, session_env: ?*Environment, turn_env: ?*Environment) void {
    if (session_env) |se| {
        var sit = se.bindings.iterator();
        while (sit.next()) |e| env.bind(e.key_ptr.*, e.value_ptr.*) catch {};
    }
    if (turn_env) |te| {
        var tit = te.bindings.iterator();
        while (tit.next()) |e| env.bind(e.key_ptr.*, e.value_ptr.*) catch {};
    }
}
