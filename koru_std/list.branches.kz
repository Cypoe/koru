// Koru Standard Library: the `branches` part of list.kz.
// Joined via `~part branches` in list.kz; merged into the list module at load.
//
// Synthesized-op branch constructors: `?name` is ignorable (a synthesized
// no-op arm when unhandled); `?!name` is a panic branch (a synthesized
// @panic arm when unhandled, supervisable when handled — the store:take
// precedent).

/// Dotted proto leaf name (`pos.x`) → flat record/push-param name (`pos_x`).
fn flatName(alloc: std.mem.Allocator, fname: []const u8) []const u8 {
    return std.mem.replaceOwned(u8, alloc, fname, ".", "_") catch unreachable;
}

fn optBranch(alloc: std.mem.Allocator, name: []const u8) astz.Branch {
    var b = emptyBranch(alloc, name);
    b.is_optional = true;
    return b;
}

fn panicBranch(alloc: std.mem.Allocator, name: []const u8) astz.Branch {
    var b = emptyBranch(alloc, name);
    b.is_panic = true;
    return b;
}

/// A panic branch carrying a string payload (e.g. `violated: string` — the
/// offending field's flat name).
fn panicStrBranch(alloc: std.mem.Allocator, name: []const u8) astz.Branch {
    var b = panicBranch(alloc, name);
    b.payload = astz.Shape{ .fields = fields1(alloc, field1(alloc, "__type_ref", "string")) };
    return b;
}

/// push-<Name>'s branch set: `?ok` is the success path a bare `|>` rides;
/// `?!violated` fires when a refine bound fails and `?!oom` when the append
/// can't allocate — both panic branches, so an unhandled site keeps the old
/// @panic behavior and a handled one supervises.
fn pushBranches(alloc: std.mem.Allocator) []astz.Branch {
    const br = alloc.alloc(astz.Branch, 3) catch unreachable;
    br[0] = optBranch(alloc, "ok");
    br[1] = panicStrBranch(alloc, "violated");
    br[2] = panicBranch(alloc, "oom");
    return br;
}
