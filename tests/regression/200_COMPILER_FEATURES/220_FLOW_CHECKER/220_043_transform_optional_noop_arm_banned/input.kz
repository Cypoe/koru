// RULING 1 (KORU037) under a transform head — the sibling of 220_018.
//
// A no-op `_` body on an OPTIONAL effect branch is illegal even when the arm
// rides a comptime transform: `run` borrows `step`'s arm vocabulary (it
// forwards `!` arms onto a generated `step` call — the `vaxis:run` shape), so
// the transform-flow exemption must not swallow the ban. `tick` is optional
// on `step`, resolvable within the invoked decl's own module.

~pub tor step {}
! ?tick i64
| ?done

~proc step|zig { return .{ .done = .{} }; }

~[comptime|transform]pub tor run { expr: Expression, item: *const std/compiler:Item, program: *const std/compiler:Program } -> SiteResult

~proc run|zig {
    const ast = @import("ast");
    const allocator = @import("std").heap.page_allocator;
    const flow = if (item.* == .flow) &item.flow else return .{};
    return .{ .replacement = ast.Item{ .inline_code = .{ .code = "// run ran", .location = flow.location, .module = allocator.dupe(u8, flow.module) catch return .{} } } };
}

~run()
! tick _ |> _
