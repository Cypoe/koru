// Koru Standard Library: the `renew` part of fleet — lease renewal.
// Joined via `~part renew` in fleet.kz; merged into the fleet module at
// load. Renewal is piggyback, celld's ttl/3 cadence without a heartbeat
// thread: every activity path (acquire-hit, durable write, the explicit
// verb) renews when the deadline is inside its last third, so a live
// owner stays held and a dead one's leases lapse.

// Renews when the deadline is inside its last TTL third; returns the
// deadline now in force so callers can cache it. The lock is required:
// an unlocked renew could overwrite a committed takeover with the stale
// epoch it read before the lock.
pub fn fleetRenewDue(world: []const u8, id: []const u8, node: []const u8, ttl_ms: u64, until: i64) i64 {
    if (ttl_ms == 0 or until == 0) return until;
    if (until - std.time.milliTimestamp() >= @as(i64, @intCast(ttl_ms / 3))) return until;
    var lb: [1024]u8 = undefined;
    const lock = std.fmt.bufPrint(&lb, "{s}/.fleet/locks/{s}", .{ world, id }) catch return until;
    std.fs.cwd().makeDir(lock) catch return until;
    defer std.fs.cwd().deleteDir(lock) catch {};
    var nb: [256]u8 = undefined;
    const rec = ownerRead(world, id, &nb) orelse return until;
    if (!std.mem.eql(u8, rec.node, node) or !leaseLive(rec.until)) return until;
    const fresh = leaseUntil(ttl_ms);
    ownerWrite(world, id, node, rec.epoch, fresh) catch return until;
    return fresh;
}

// The record's live lease deadline when `node` still owns it — the
// deadline a stamp caches after acquire. 0 when un-leased, absent, or
// already lost: a stamp holding 0 fails its due-check on the next hit.
pub fn fleetUntil(world: []const u8, id: []const u8, node: []const u8, nb: []u8) i64 {
    const rec = ownerRead(world, id, nb) orelse return 0;
    if (!std.mem.eql(u8, rec.node, node) or !leaseLive(rec.until)) return 0;
    return rec.until;
}

// ============================================================================
// RENEW — the owner refreshes its own deadline (celld renews at ttl/3; the
// cadence is the caller's — there is no heartbeat yet). Under the lock so a
// renew can never overwrite a committed takeover with its stale epoch. A
// lapsed own lease answers `free`: the way back is `claim`.
// ============================================================================

~pub tor renew { world: string, id: string, node: string, ttl-ms: u64 }
| renewed
| held-by string
| free
| failed string

~proc renew|zig {
    ensureDirs(world) catch return .{ .failed = "cannot create .fleet dirs" };
    var lb: [1024]u8 = undefined;
    const lock = std.fmt.bufPrint(&lb, "{s}/.fleet/locks/{s}", .{ world, id }) catch
        return .{ .failed = "path too long" };
    std.fs.cwd().makeDir(lock) catch
        return .{ .failed = "renew lock contended" };
    defer std.fs.cwd().deleteDir(lock) catch {};
    var nb: [256]u8 = undefined;
    const rec = ownerRead(world, id, &nb) orelse return .free;
    if (!std.mem.eql(u8, rec.node, node)) return .{ .held_by =
        std.heap.page_allocator.dupe(u8, rec.node) catch
        return .{ .failed = "out of memory" } };
    if (!leaseLive(rec.until)) return .free;
    ownerWrite(world, id, node, rec.epoch, leaseUntil(ttl_ms)) catch
        return .{ .failed = "renew write failed" };
    return .renewed;
}
