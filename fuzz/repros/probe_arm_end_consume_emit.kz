// FINDING (obligation fuzz, 2026-10-03): a fold outcome arm routed to a
// DISCHARGER instead of a back-edge passes `-c` AND all 20 coordination
// passes, then emits Zig that does not compile.
//
//   | again v |> done(h: v)     <- `again` outcome consumed, never loops
//
// Frontend + coordination accept this. Emission then produces
//   loop: while (true) { ... }          // label emitted, nothing continues it
//   var result_0 = step_event...        // never mutated
// and zig build-exe rejects the emitted source:
//   error: unused while loop label      (output_emitted.zig)
//   error: local variable is never mutated
//
// Two layers to inspect:
//   a) semantic: `spin` declares `-> *Handle<owned!>`; the `again` path
//      discharges the handle and ends the flow without producing it.
//      `arm-end-consume(step ...)` variants DO refuse (KORU022) — the
//      discharger variant does not, so the checker tracks the obligation
//      drop but not the unproduced declared return.
//   b) emission: the `loop:` label is emitted because a back-edge arm
//      exists structurally; whether a `continue :loop` is emitted depends
//      on the arm's routing — the two are not tied.
// Note: under the fuzz sweep koruc reported this class as "zig build-exe
// was killed by signal 6 — ran out of memory"; a direct run surfaces the
// real zig errors, so the signal-6/OOM message may misattribute a clean
// zig error exit under load — worth checking the spawn path.
//
// Repro (needs zig on PATH):
//   koruc fuzz/repros/probe_arm_end_consume_emit.kz
//   -> passes "Compiler coordination: Passes: 20", then backend fails.
const std = @import("std");
const Handle = struct { n: i32 };

~tor make {} -> *Handle<owned!>
~proc make|zig {
    const h = std.heap.page_allocator.create(Handle) catch unreachable;
    h.* = .{ .n = 0 };
    return h;
}

~tor step { h: *Handle<!owned> }
| again *Handle<owned!>
| stop *Handle<owned!>
~proc step|zig {
    h.n += 1;
    if (h.n < 3) return .{ .again = h };
    return .{ .stop = h };
}

~tor done { h: *Handle<!owned> }
~proc done|zig {
    std.debug.print("n={}\n", .{h.n});
    std.heap.page_allocator.destroy(h);
}

~tor spin {} -> *Handle<owned!>

~spin = make(): h0 |> #loop step(h: h0)
| again v |> done(h: v)
| stop r -> r

~spin(): hf |> done(h: hf)
