// Koru Standard Library: the `synth` part of pump — joined via
// `~part synth` in pump.kz; members land in koru_pump.
//
// A join arm's callee isn't always a declared tor: a store's `! step` /
// `! wait` arms SYNTHESIZE `<s>-step` / `<s>-live` / `<s>-wait` units at
// transform time, so nothing named `tasks-step` exists in the source
// tree — or in the pre-transform tree the explainer folds. `synthesized`
// recognizes the pattern: `<store>-<verb>` where a `std/store:new`
// site carries the arm that generates it, so a synthesized callee is
// reported as generated rather than refused as undeclared.

const PS = struct {
    fn synthesized(prog: *const ast.Program, li: ?*const ast.Invocation) ?[]const u8 {
        const inv = li orelse return null;
        if (inv.path.segments.len != 1) return null;
        const callee = inv.path.segments[0];
        const dash = std.mem.lastIndexOfScalar(u8, callee, '-') orelse return null;
        const store_name = callee[0..dash];
        const arm = if (std.mem.eql(u8, callee[dash + 1 ..], "step") or std.mem.eql(u8, callee[dash + 1 ..], "live"))
            "step"
        else if (std.mem.eql(u8, callee[dash + 1 ..], "wait"))
            "wait"
        else
            return null;
        const W = struct {
            fn scan(its: []const ast.Item, want: []const u8, want_arm: []const u8) bool {
                for (its) |*pi| {
                    switch (pi.*) {
                        .flow => |*fl| {
                            if (fl.body.node) |*n| {
                                if (n.* == .invocation) {
                                    const mq = n.invocation.path.module_qualifier orelse "";
                                    if ((std.mem.eql(u8, mq, "std.store") or std.mem.eql(u8, mq, "std/store")) and
                                        n.invocation.path.segments.len == 1 and std.mem.eql(u8, n.invocation.path.segments[0], "new"))
                                    {
                                        for (n.invocation.args) |a| {
                                            if (a.source_value == null and std.mem.eql(u8, a.value, want)) {
                                                for (fl.body.continuations) |*c| {
                                                    if (c.kind == .effect and std.mem.eql(u8, std.mem.trim(u8, c.branch, " "), want_arm)) return true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        .module_decl => |*md| {
                            if (scan(md.items, want, want_arm)) return true;
                        },
                        else => {},
                    }
                }
                return false;
            }
        };
        if (W.scan(prog.items, store_name, arm)) return store_name;
        return null;
    }
};
