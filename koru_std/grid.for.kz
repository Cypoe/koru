// Koru Standard Library: the `for` part of grid.kz — a bounded loop the
// GRID owns, so the index's proof is established once, at the door.
// Joined via `~part for` in grid.kz; merged into the grid module at load.
//
//   std/grid:for(0..n, cells)
//   ! each i |> ... cells[i] ...
//
// An ordinary `for(0..n)` hands the body an index whose bound lives in a
// VALUE `n`; nothing connects it to the grid it is about to index, so every
// `cells[i]` pays the `__koru_at` floor — and, more expensively, the panic
// edge that keeps the vectorizer out of the loop. This construct takes the
// range AND the grid, checks `lo..hi` against `__koru_size` ONCE before the
// loop begins, and then mints the binding as a trusted cursor: the same
// provenance mechanism `sweep` built for its `0..__koru_size` cursor. The
// panic the check carries is real — a range that outruns the grid fails
// loud, never clamped, because truncation is the program's to write.
//
// The trust is exactly as wide as the proof: the minted name on the named
// grid. `cells[i+1]` keeps the floor, `other[i]` keeps the floor, and an
// `i` spelled by a different scope keeps it too — the match is on the raw
// index text, which is the thing nobody else can spell.
//
// The binding is RENAMED to the minted cursor at source level
// (`i` -> `__koru_gi_<grid>_L<line>`) before the body lowers. That is what
// admits `stored { cells[i].v: ... }` to the unchecked write path: the write
// unit names an index trusted when its text is a cursor minted for THAT grid
// — a name only a grid-owned loop can mint, which is the whole reason for
// the rename. A body that leaves the binding spelled `i` would read trusted
// and write checked, an asymmetry with no principle under it.

~[comptime|transform|claims_descendants]pub tor for {
    expr: Expression,
    grid: Expression,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator
} -> SiteResult

~[transform]proc for|zig {
    const ast = @import("ast");
    const ast_functional = @import("ast_functional");

    if (item.* != .flow) @panic("grid:for transform: containing item is not a flow - walker dispatch contract broken");
    const flow = &item.flow;

    const S = struct {
        const isIdentCh = @import("emitter_helpers").isKebabIdentChar;
        // `<bind>` -> `<cur>`, whole-word, in expression context. The mask
        // leaves quoted prose alone but rewrites `{{ i }}` interpolations —
        // those are real references and would dangle otherwise. The member
        // test is `precededByMemberDot`, not "previous char is a dot": `0..i`
        // has the range's dot pair before `i` and `i` is still the binding.
        fn rename(alloc: std.mem.Allocator, text: []const u8, bind: []const u8, cur: []const u8) []const u8 {
            if (std.mem.indexOf(u8, text, bind) == null) return text;
            const mask = ast_grid.expressionMask(alloc, text);
            var out = std.ArrayList(u8).initCapacity(alloc, text.len + 32) catch unreachable;
            var i: usize = 0;
            while (i < text.len) {
                if (mask[i] and ast_grid.identBoundaryBefore(text, i) and !ast_grid.precededByMemberDot(text, i) and std.mem.startsWith(u8, text[i..], bind)) {
                    const after = i + bind.len;
                    if (after >= text.len or !isIdentCh(text[after])) {
                        out.appendSlice(alloc, cur) catch unreachable;
                        i = after;
                        continue;
                    }
                }
                out.append(alloc, text[i]) catch unreachable;
                i += 1;
            }
            return out.toOwnedSlice(alloc) catch unreachable;
        }
        // THE SHADOW RULE: an arm binding the same name owns its subtree.
        // `grid:for(g2, 0..n) ! each i |> ...` inside a `! each i` body binds
        // an INNER `i`; renaming the inner arm's references to the outer
        // cursor would reach into a scope the name was reborn in. The arm's
        // own args and `when` still see the outer binding — the shadow
        // begins at the arm's binding, not its node — so only the
        // continuation chain is skipped.
        fn walk(alloc: std.mem.Allocator, cont: *ast.Continuation, bind: []const u8, cur: []const u8) void {
            if (cont.condition) |c| {
                @constCast(cont).condition = rename(alloc, c, bind, cur);
            }
            if (cont.node) |*n| {
                switch (@constCast(n).*) {
                    .invocation => |*inv| {
                        for (inv.args) |*a| {
                            @constCast(a).value = rename(alloc, a.value, bind, cur);
                            if (a.expression_value) |ev| {
                                const fresh = alloc.create(ast.CapturedExpression) catch unreachable;
                                fresh.* = ev.*;
                                fresh.text = rename(alloc, ev.text, bind, cur);
                                @constCast(a).expression_value = fresh;
                            }
                            if (a.source_value) |sv| {
                                const fresh = alloc.create(ast.Source) catch unreachable;
                                fresh.* = sv.*;
                                fresh.text = rename(alloc, sv.text, bind, cur);
                                @constCast(a).source_value = fresh;
                            }
                        }
                        if (inv.inline_body) |ib| {
                            inv.inline_body = rename(alloc, ib, bind, cur);
                        }
                    },
                    .inline_code => {
                        @constCast(n).* = .{ .inline_code = rename(alloc, n.inline_code, bind, cur) };
                    },
                    .expression => {
                        @constCast(n).* = .{ .expression = rename(alloc, n.expression, bind, cur) };
                    },
                    else => {},
                }
            }
            for (cont.continuations) |*k| {
                if (k.binding) |kb| {
                    if (std.mem.eql(u8, std.mem.trim(u8, kb, " "), bind)) continue;
                }
                walk(alloc, @constCast(k), bind, cur);
            }
        }
        // A claims_descendants site nested INSIDE another's body double-fires:
        // the clone and the write-back each hand the inner site to the pass,
        // and its generated units land twice in the module (`duplicate struct
        // member`). `sweep`-in-`sweep` has the same hole — a runner
        // limitation, not something a site can fix — so this loop refuses it
        // loudly rather than emitting a second copy.
        fn ownsNestedGridLoop(cont: *const ast.Continuation) bool {
            if (cont.node) |*n| {
                if (n.* == .invocation) {
                    const inv = n.invocation;
                    if (inv.path.module_qualifier) |mq| {
                        if (std.mem.eql(u8, mq, "std.grid") and inv.path.segments.len == 1 and
                            (std.mem.eql(u8, inv.path.segments[0], "for") or std.mem.eql(u8, inv.path.segments[0], "sweep")))
                            return true;
                    }
                }
            }
            for (cont.continuations) |*k| {
                if (ownsNestedGridLoop(@constCast(k))) return true;
            }
            return false;
        }
    };

    // Positional args arrive PUNNED — `for(0..n, cells)` carries `cells`
    // under the name "cells", not bound to the `grid` parameter — so the
    // named arg wins and the second positional is the fallback.
    var range_text: []const u8 = "";
    var grid_name: []const u8 = "";
    for (invocation.args, 0..) |arg, ai| {
        if (std.mem.eql(u8, arg.name, "expr") or (ai == 0 and !arg.had_explicit_label)) range_text = arg.value;
        if (std.mem.eql(u8, arg.name, "grid") or (ai == 1 and !arg.had_explicit_label)) {
            var n = arg.value;
            if (n.len >= 2 and n[0] == '"') n = n[1 .. n.len - 1];
            grid_name = n;
        }
    }
    if (grid_name.len == 0) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for requires a grid: for(<lo>..<hi>, grid)", .{}) };
    }

    // THE RANGE IS TWO EXPRESSIONS, not one: `lo..hi`. The split is at the
    // TOP-LEVEL `..` only — a `..` inside parens or a subscript belongs to
    // the bounds themselves.
    var dotdot: ?usize = null;
    {
        var depth: usize = 0;
        var k: usize = 0;
        while (k + 1 < range_text.len) : (k += 1) {
            const c = range_text[k];
            if (c == '(' or c == '[' or c == '{') depth += 1;
            if (c == ')' or c == ']' or c == '}') depth -= 1;
            if (c == '.' and range_text[k + 1] == '.' and depth == 0) {
                dotdot = k;
                break;
            }
        }
    }
    const dd = dotdot orelse {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): the range is spelled <lo>..<hi>", .{range_text}) };
    };
    const lo_raw = std.mem.trim(u8, range_text[0..dd], " ");
    const hi_raw = std.mem.trim(u8, range_text[dd + 2 ..], " ");
    if (hi_raw.len == 0) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): an open range carries no bound to prove — write the end", .{range_text}) };
    }

    // ARMS: `! each <i>` carries the body; an optional `| done` continues the
    // chain after the loop, exactly as `for`'s `?done` does. Anything else is
    // a refusal, not a guess.
    var each_arm: ?*const ast.Continuation = null;
    var done_arm: ?*const ast.Continuation = null;
    for (flow.body.continuations) |*c| {
        const b = std.mem.trim(u8, @constCast(c).branch, " ");
        if (std.mem.eql(u8, b, "each")) {
            each_arm = c;
        } else if (std.mem.eql(u8, b, "done")) {
            done_arm = c;
        } else {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): unknown branch `! {s}` — the vocabulary is `! each` and `| done`", .{ grid_name, b }) };
        }
    }
    const arm = each_arm orelse {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): the loop branch is spelled `! each <index>`", .{grid_name}) };
    };
    const bind = arm.binding orelse {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): the each arm needs an index binding: `! each <index> |> ...`", .{grid_name}) };
    };
    if (done_arm) |d| {
        if (d.binding != null) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): a `| done <n>` binding is not spelled yet — every iteration runs, so the count is the range itself", .{grid_name}) };
        }
        if (S.ownsNestedGridLoop(@constCast(d))) {
            return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): a nested grid loop in the `| done` tail double-fires its generated units — hoist it into a tor and call it", .{grid_name}) };
        }
    }

    // Same module-resolution dance as sweep: the grid's CELLS live in the
    // declaring module's namespace, the generated units in this site's.
    var swept = std.ArrayList(grid_read.GridRef).initCapacity(allocator, 4) catch unreachable;
    grid_read.collect(allocator, program, &swept);
    const grid_ns = if (grid_read.find(swept.items, grid_name)) |r| r.ns else {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): no grid named '{s}' is declared in this program", .{ grid_name, grid_name }) };
    };

    const cur = grid_cursor.mint(allocator, grid_name, flow.location.line);
    if (ast.refuseUncrossable(allocator, reporter, "grid:for", grid_name, "each", arm, flow.module)) |r| return .{ .transformed = r };
    const body = ast_functional.cloneContinuation(allocator, arm) catch unreachable;
    var mutable_body = body;
    if (S.ownsNestedGridLoop(&mutable_body)) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): a nested grid loop in the body double-fires its generated units — hoist the inner loop into a tor and call it", .{grid_name}) };
    }
    // Rename FIRST, lower second: after the rename every `i` in the body is
    // the minted cursor's name, which is the name the trusted matcher and the
    // write path both recognize.
    S.walk(allocator, &mutable_body, std.mem.trim(u8, bind, " "), cur);
    grid_readwalk.lowerContTrusted(allocator, &mutable_body, swept.items, .{ .name = cur, .grid = grid_name });

    // `| done` chains after the driver call, lowered UNTRUSTED — the cursor's
    // proof does not reach past the loop, and any grid reads in the tail keep
    // the floor they deserve.
    var tail = std.ArrayList(ast.Continuation).initCapacity(allocator, 2) catch unreachable;
    if (done_arm) |d| {
        // The arm, minus its arm-ness: branch and binding are the `| done`
        // head, which does not exist on this side of the splice.
        var dc = d.*;
        dc.branch = "";
        dc.binding = null;
        grid_readwalk.lowerCont(allocator, &dc, swept.items);
        tail.append(allocator, dc) catch unreachable;
    }

    const home_ns = blk_home: {
        const Find = struct {
            fn in(its: []const ast.Item, want: []const u8, enclosing: ?[]const u8) ?[]const u8 {
                for (its) |pi| {
                    switch (pi) {
                        .flow => |f| {
                            if (std.mem.eql(u8, f.module, want)) return enclosing;
                        },
                        .module_decl => |m| {
                            if (in(m.items, want, m.logical_name)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        break :blk_home Find.in(program.items, flow.module, null) orelse flow.module;
    };
    const emit_ns = if (home_ns.len == 0 or std.mem.eql(u8, home_ns, program.main_module_name))
        "main_module."
    else
        std.fmt.allocPrint(allocator, "{s}.", .{codegen_utils_grid.buildKoruModulePath(allocator, home_ns) catch unreachable}) catch unreachable;

    const body_name = std.fmt.allocPrint(allocator, "__grid_forbody_L{d}", .{flow.location.line}) catch unreachable;
    const driver_name = std.fmt.allocPrint(allocator, "__grid_for_L{d}", .{flow.location.line}) catch unreachable;
    const lon = std.fmt.allocPrint(allocator, "__koru_forlo_L{d}", .{flow.location.line}) catch unreachable;
    const hin = std.fmt.allocPrint(allocator, "__koru_forhi_L{d}", .{flow.location.line}) catch unreachable;

    const mk = struct {
        fn path(alloc: std.mem.Allocator, module: []const u8, name: []const u8) ast.DottedPath {
            const segs = alloc.alloc([]const u8, 1) catch unreachable;
            segs[0] = alloc.dupe(u8, name) catch unreachable;
            return ast.DottedPath{ .module_qualifier = alloc.dupe(u8, module) catch unreachable, .segments = segs };
        }
    };

    const body_node = mutable_body.node orelse {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): the each arm needs a body (`|> ...`)", .{grid_name}) };
    };
    if (body_node != .invocation) {
        return .{ .transformed = ast.refuse(allocator, reporter, .KORU161, flow.location, flow.module, "std/grid:for({s}): the each body must start with an invocation this rung", .{grid_name}) };
    }

    const retain_ann = blk_ret: {
        const anns = allocator.alloc([]const u8, 1) catch unreachable;
        anns[0] = allocator.dupe(u8, "retain") catch unreachable;
        break :blk_ret anns;
    };
    var appended = std.ArrayList(ast.Item).initCapacity(allocator, 4) catch unreachable;

    const bin = allocator.alloc(ast.Field, 1) catch unreachable;
    bin[0] = ast.Field{ .name = allocator.dupe(u8, cur) catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
    appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = mk.path(allocator, home_ns, body_name),
        .input = ast.Shape{ .fields = bin },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = retain_ann,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    appended.append(allocator, ast.Item{ .flow = ast.Flow{
        .body = ast.rootSite(body_node.invocation, mutable_body.continuations, flow.location),
        .pre_label = null,
        .impl_of = mk.path(allocator, home_ns, body_name),
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    // The range rides in as event INPUT, not emitted text: lo/hi are caller
    // expressions (`for(5..b)` — `b` is a tor param) and only resolve in the
    // caller's scope. The driver proc reads them off `__koru_event_input`.
    const driver_fields = allocator.alloc(ast.Field, 2) catch unreachable;
    driver_fields[0] = ast.Field{ .name = allocator.dupe(u8, lon) catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
    driver_fields[1] = ast.Field{ .name = allocator.dupe(u8, hin) catch unreachable, .type = allocator.dupe(u8, "i64") catch unreachable };
    appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
        .path = mk.path(allocator, home_ns, driver_name),
        .input = ast.Shape{ .fields = driver_fields },
        .branches = &[_]ast.Branch{},
        .is_public = false,
        .is_implicit_flow = false,
        .annotations = &[_][]const u8{},
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    // THE PROOF IS ONE COMPARE, spelled once at the door: `lo >= 0`,
    // `hi <= size`, `lo <= hi`. Everything the loop runs has already passed
    // it, which is the entire point of the construct — a panic edge outside
    // the loop cannot keep the vectorizer out of it.
    const guard_line = if (mutable_body.condition) |c|
        std.fmt.allocPrint(allocator, "    if (!({s})) continue;\n", .{c}) catch unreachable
    else
        "";
    // Both emitters destructure event input fields into locals before the
    // proc body runs (zig: `const f = __koru_event_input.f;`, js: locals off
    // `__koru_input`) — `lon`/`hin` arrive as i64-typed locals either way.
    const for_is_js = std.mem.eql(u8, CompilerEnv.lang, "js");
    const loop = if (for_is_js)
        std.fmt.allocPrint(allocator, "if ({s} < 0 || {s} > {s}__KoruGridT_{s}.__koru_size || {s} > {s}) throw new Error(\"std/grid:for: range outruns grid '{s}'\");\nfor (let {s} = {s}; {s} < {s}; {s}++) {{\n{s}    main_module.{s}_event.handler({{ {s}: {s} }});\n}}\nreturn;", .{ lon, hin, grid_ns, grid_name, lon, hin, grid_name, cur, lon, cur, hin, cur, guard_line, body_name, cur, cur }) catch unreachable
    else
        std.fmt.allocPrint(allocator, "if ({s} < 0 or {s} > @as(i64, @intCast({s}__KoruGridT_{s}.__koru_size)) or {s} > {s}) @panic(\"std/grid:for: range outruns grid '{s}'\");\nfor (@as(usize, @intCast({s}))..@as(usize, @intCast({s}))) |{s}| {{\n{s}    {s}{s}_event.handler(.{{ .{s} = @as(i64, @intCast({s})) }});\n}}\nreturn;", .{ lon, hin, grid_ns, grid_name, lon, hin, grid_name, lon, hin, cur, guard_line, emit_ns, body_name, cur, cur }) catch unreachable;
    appended.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
        .path = mk.path(allocator, home_ns, driver_name),
        .body = ast.Source{ .text = loop, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
        .annotations = &[_][]const u8{},
        .target = allocator.dupe(u8, if (for_is_js) "js" else "zig") catch unreachable,
        .location = flow.location,
        .module = allocator.dupe(u8, flow.module) catch unreachable,
    } }) catch unreachable;

    // Args stay SOURCE TEXT — they lower in the caller's scope, which is the
    // only scope where `lim`, `b`, and friends exist. The `@intCast` wrap is
    // spelled in Koru: usize bounds meet i64-typed input fields.
    const call_args = allocator.alloc(ast.Arg, 2) catch unreachable;
    call_args[0] = ast.Arg{ .name = allocator.dupe(u8, lon) catch unreachable, .value = std.fmt.allocPrint(allocator, "@as(i64, @intCast({s}))", .{lo_raw}) catch unreachable, .had_explicit_label = true };
    call_args[1] = ast.Arg{ .name = allocator.dupe(u8, hin) catch unreachable, .value = std.fmt.allocPrint(allocator, "@as(i64, @intCast({s}))", .{hi_raw}) catch unreachable, .had_explicit_label = true };
    const call = ast.Invocation{ .path = mk.path(allocator, home_ns, driver_name), .args = call_args };
    return .{ .transformed = .{
        .replacement = ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(call, tail.toOwnedSlice(allocator) catch unreachable, flow.location),
            .pre_label = null,
            .impl_of = flow.impl_of,
            .annotations = &[_][]const u8{},
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } },
        .appended = appended.toOwnedSlice(allocator) catch unreachable,
    } };
}
