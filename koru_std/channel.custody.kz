// Koru Standard Library: the `custody` part of channel — obligation transit.
// Joined via `~part custody` in channel.kz; merged into the channel module.
//
// Custody detection — the per-edge obligation contract
// (concepts/frag-custody-transit-is-an-edge-contract). A send of a value
// whose producer ISSUED it (`-> T<state!>` — the `!` suffix marks an
// issued obligation; `T<!state>` consumes, `T<state>` borrows) transits
// custody through the vessel. Resolution this rung is same-flow: the
// ident's `return_binding` producer. Anything unresolvable stays plain.
//
// The machinery is transform composition: `new` scans send sites and emits
// a `take`/`obligate` pair per custodial kind; `send` injects the take
// under `| ok` alone; consumer units mint via obligate before the arm body.

const CC = struct {

    const SendSite = struct { flow: *const ast.Flow, inv: *const ast.Invocation };

    // scanCustody's answer — ok carries the per-kind custody states, refuse
    // is a ready refusal item the caller splices as its replacement.
    const ScanResult = union(enum) { ok: []?[]const u8, refuse: ast.Item };

    // `live!` → "live"; consume-polarity (`!live`) is never a producer.
    fn phantomStateName(ph: []const u8) ?[]const u8 {
        if (ph.len == 0 or ph[ph.len - 1] != '!') return null;
        const base = ph[0 .. ph.len - 1];
        if (base.len == 0 or base[0] == '!') return null;
        return base;
    }

    fn pathMatch(p: ast.DottedPath, mq: ?[]const u8, segs: []const []const u8) bool {
        if (p.segments.len != segs.len) return false;
        for (p.segments, segs) |a, b| {
            if (!std.mem.eql(u8, a, b)) return false;
        }
        return std.mem.eql(u8, p.module_qualifier orelse "", mq orelse "");
    }

    fn findEventDecl(prog: *const ast.Program, mq: ?[]const u8, segs: []const []const u8) ?*const ast.EventDecl {
        const W = struct {
            fn scan(its: []const ast.Item, w_mq: ?[]const u8, w_segs: []const []const u8) ?*const ast.EventDecl {
                for (its) |*pi| {
                    switch (pi.*) {
                        .event_decl => |*ed| {
                            if (pathMatch(ed.path, w_mq, w_segs)) return ed;
                        },
                        .module_decl => |*md| {
                            if (scan(md.items, w_mq, w_segs)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        return W.scan(prog.items, mq, segs);
    }

    // The invocation in `flow`'s tree whose `return_binding` is `ident` —
    // `producer(...): ident |> ...`. The root node counts too.
    fn producerInv(flow: *const ast.Flow, ident: []const u8) ?*const ast.Invocation {
        const W = struct {
            fn binds(n: *const ast.Node, w: []const u8) ?*const ast.Invocation {
                if (n.* != .invocation) return null;
                const iv = &n.invocation;
                if (iv.return_binding) |rb| {
                    if (std.mem.eql(u8, rb, w)) return iv;
                }
                return null;
            }
            fn scan(conts: []const ast.Continuation, w: []const u8) ?*const ast.Invocation {
                for (conts) |*c| {
                    if (c.node) |*n| {
                        if (binds(n, w)) |iv| return iv;
                    }
                    if (scan(c.continuations, w)) |iv| return iv;
                }
                return null;
            }
        };
        if (flow.body.node) |*n| {
            if (W.binds(n, ident)) |iv| return iv;
        }
        return W.scan(flow.body.continuations, ident);
    }

    // The obligation state `ident` carries inside `flow`, or null for plain.
    // `ident` must be bound by a tor returning `T<state!>` — consume params
    // (`T<!state>`) arrive already settled, so params never resolve.
    fn custodyOf(prog: *const ast.Program, flow: *const ast.Flow, ident: []const u8) ?[]const u8 {
        if (!CH.identOk(ident)) return null;
        const prod = producerInv(flow, ident) orelse return null;
        if (prod.path.segments.len == 0) return null;
        const decl = findEventDecl(prog, prod.path.module_qualifier orelse flow.module, prod.path.segments) orelse return null;
        const rp = decl.return_phantom orelse return null;
        return phantomStateName(rp);
    }

    // The continuation in `flow`'s tree whose node IS `invocation` — the
    // send site's holding continuation, whose children are the site's arms.
    fn holdingCont(flow: *const ast.Flow, inv: *const ast.Invocation) ?*const ast.Continuation {
        const W = struct {
            fn scan(conts: []const ast.Continuation, want: *const ast.Invocation) ?*const ast.Continuation {
                for (conts) |*c| {
                    if (c.node) |*n| {
                        if (n.* == .invocation and &n.invocation == want) return c;
                    }
                    if (scan(c.continuations, want)) |hit| return hit;
                }
                return null;
            }
        };
        return W.scan(flow.body.continuations, inv);
    }

    // The REAL flow whose continuation tree holds `target` — the nested-site
    // counterpart of siteView: the runner hands a transform a synthetic flow
    // whose body IS the site, so a sent binding's producer (upstream in the
    // containing flow) is only reachable by walking back out. `flow.site_of`
    // is the back-pointer the view stamps; null on a root site.
    fn flowContaining(prog: *const ast.Program, target: *const ast.Continuation) ?*const ast.Flow {
        const W = struct {
            fn holds(conts: []const ast.Continuation, t: *const ast.Continuation) bool {
                for (conts) |*c| {
                    if (c == t) return true;
                    if (holds(c.continuations, t)) return true;
                }
                return false;
            }
            fn scan(its: []const ast.Item, t: *const ast.Continuation) ?*const ast.Flow {
                for (its) |*pi| {
                    switch (pi.*) {
                        .flow => |*f| {
                            if (holds(f.body.continuations, t)) return f;
                        },
                        .module_decl => |*md| {
                            if (scan(md.items, t)) |hit| return hit;
                        },
                        else => {},
                    }
                }
                return null;
            }
        };
        return W.scan(prog.items, target);
    }

    // Every `std/channel:send(<name>, ...)` site in the program, paired with
    // the flow holding it so the value's producer resolves in-scope.
    fn sendSites(alloc: std.mem.Allocator, prog: *const ast.Program, chan_name: []const u8) []const SendSite {
        const W = struct {
            fn hit(n: *const ast.Node, f: *const ast.Flow, name: []const u8, out: *std.ArrayList(SendSite), al: std.mem.Allocator) void {
                if (n.* == .invocation and CH.isChannelInv(&n.invocation, "send") and CH.declSubject(&n.invocation, name)) {
                    out.append(al, .{ .flow = f, .inv = &n.invocation }) catch unreachable;
                }
            }
            fn scanConts(conts: []const ast.Continuation, f: *const ast.Flow, name: []const u8, out: *std.ArrayList(SendSite), al: std.mem.Allocator) void {
                for (conts) |*c| {
                    if (c.node) |*n| hit(n, f, name, out, al);
                    scanConts(c.continuations, f, name, out, al);
                }
            }
            fn scanItems(its: []const ast.Item, name: []const u8, out: *std.ArrayList(SendSite), al: std.mem.Allocator) void {
                for (its) |*pi| {
                    switch (pi.*) {
                        .flow => |*f| {
                            if (f.body.node) |*n| hit(n, f, name, out, al);
                            scanConts(f.body.continuations, f, name, out, al);
                        },
                        .module_decl => |*md| scanItems(md.items, name, out, al),
                        else => {},
                    }
                }
            }
        };
        var out = std.ArrayList(SendSite).initCapacity(alloc, 4) catch unreachable;
        W.scanItems(prog.items, chan_name, &out, alloc);
        return out.toOwnedSlice(alloc) catch unreachable;
    }

    // `| ok |> take(s)` — prepend the custody take to the site's ok arm; when
    // the site spells no `| ok`, synthesize one (custody moves on success
    // whether or not the user handles it). `full`/`closed` ride untouched —
    // producer custody survives those branches.
    fn injectTake(alloc: std.mem.Allocator, conts: []const ast.Continuation, take_node: ast.Node) []const ast.Continuation {
        var out = std.ArrayList(ast.Continuation).initCapacity(alloc, conts.len + 1) catch unreachable;
        var took = false;
        for (conts) |*c| {
            var nc = c.*;
            if (!took and std.mem.eql(u8, std.mem.trim(u8, c.branch, " "), "ok")) {
                if (c.node) |orig| {
                    const inner = alloc.alloc(ast.Continuation, 1) catch unreachable;
                    inner[0] = ast.Continuation{
                        .branch = "",
                        .binding = null,
                        .condition = null,
                        .node = orig,
                        .indent = c.indent,
                        .continuations = c.continuations,
                    };
                    nc.node = take_node;
                    nc.continuations = inner;
                } else {
                    nc.node = take_node;
                }
                took = true;
            }
            out.append(alloc, nc) catch unreachable;
        }
        if (!took) {
            out.append(alloc, ast.Continuation{
                .branch = alloc.dupe(u8, "ok") catch unreachable,
                .binding = null,
                .condition = null,
                .node = take_node,
                .indent = 0,
                .continuations = &.{},
            }) catch unreachable;
        }
        return out.toOwnedSlice(alloc) catch unreachable;
    }

    // Which kinds transit obligations: every `std/channel:send(<name>, ...)`
    // site's value resolves to a producer binding; a producer returning
    // `-> T<state!>` makes the kind custodial. One custody state per kind —
    // the consumer arm mints ONE phantom, so a kind that transited two
    // states couldn't be spelled.
    fn scanCustody(alloc: std.mem.Allocator, prog: *const ast.Program, reporter: anytype, flow: *const ast.Flow, chan_name: []const u8, kinds: []const CH.KindEntry) ScanResult {
        const custody = alloc.alloc(?[]const u8, kinds.len) catch unreachable;
        for (custody) |*cp| cp.* = null;
        for (sendSites(alloc, prog, chan_name)) |site| {
            var s_kind: ?[]const u8 = null;
            var s_value: ?[]const u8 = null;
            var saw_name = false;
            for (site.inv.args) |a| {
                if (a.source_value != null) continue;
                if (CH.isLabelled(a)) {
                    if (s_kind == null) {
                        s_kind = std.mem.trim(u8, a.name, " \t");
                        s_value = std.mem.trim(u8, a.value, " \t");
                    }
                } else if (!saw_name) {
                    saw_name = true;
                } else if (s_value == null) {
                    s_value = std.mem.trim(u8, a.value, " \t");
                }
            }
            const vtext = s_value orelse continue;
            var kidx: ?usize = null;
            if (s_kind) |kl| {
                for (kinds, 0..) |k, i| {
                    if (std.mem.eql(u8, k.name, kl)) kidx = i;
                }
            } else if (kinds.len == 1) {
                kidx = 0;
            }
            const ki = kidx orelse continue;
            const state = custodyOf(prog, site.flow, vtext) orelse continue;
            if (custody[ki]) |have| {
                if (!std.mem.eql(u8, have, state)) {
                    return .{ .refuse = ast.refusal(alloc, reporter, .KORU161, flow.location, flow.module, "std/channel:new({s}): kind '{s}' transits two obligation states ('{s}' and '{s}') — a consumer arm mints one phantom per kind; split the channel or the states", .{ chan_name, kinds[ki].name, have, state }) };
                }
            } else {
                custody[ki] = state;
            }
        }
        return .{ .ok = custody };
    }

    // Custody transit ops, per custodial kind: `take` consumes the
    // producer's `<!state>` under `| ok` (injected by the send transform);
    // `obligate` mints `<state!>` fresh at the consumer arm's head. The ring
    // carries bytes; these carry custody.
    fn emitCustodyOps(alloc: std.mem.Allocator, flow: *const ast.Flow, chan_name: []const u8, kinds: []const CH.KindEntry, custody: []const ?[]const u8, appended: *std.ArrayList(ast.Item)) void {
        for (kinds, 0..) |k, ki| {
            const state = custody[ki] orelse continue;
            {
                const tf = alloc.alloc(ast.Field, 1) catch unreachable;
                tf[0] = ast.Field{
                    .name = alloc.dupe(u8, "value") catch unreachable,
                    .type = alloc.dupe(u8, k.proto) catch unreachable,
                    .phantom = std.fmt.allocPrint(alloc, "!{s}", .{state}) catch unreachable,
                };
                CH.synthOp(alloc, flow, std.fmt.allocPrint(alloc, "__channel_take_{s}_{s}", .{ chan_name, k.name }) catch unreachable, tf, &.{}, null, null, "_ = value;", appended);
            }
            {
                const of = alloc.alloc(ast.Field, 1) catch unreachable;
                of[0] = ast.Field{
                    .name = alloc.dupe(u8, "p") catch unreachable,
                    .type = alloc.dupe(u8, k.proto) catch unreachable,
                    .phantom = null,
                };
                CH.synthOp(alloc, flow, std.fmt.allocPrint(alloc, "__channel_obligate_{s}_{s}", .{ chan_name, k.name }) catch unreachable, of, &.{}, k.proto, std.fmt.allocPrint(alloc, "{s}!", .{state}) catch unreachable, "return p;", appended);
            }
        }
    }

    // The `!` arms as generated units — kind arms carry the message, closed
    // arms carry nothing. A custodial kind's unit accepts a plain
    // `__payload` and obligates it back to the arm's binding as its first
    // step — `! <kind> v |> body` runs with `v` live.
    fn emitConsumerUnits(alloc: std.mem.Allocator, appended: *std.ArrayList(ast.Item), prog: *const ast.Program, flow: *const ast.Flow, chan_name: []const u8, kind_arms: []const CH.Arm, closed_arms: []const CH.Arm, kinds: []const CH.KindEntry, custody: []const ?[]const u8) void {
        for (kind_arms, 0..) |arm, ai| {
            var proto: []const u8 = "";
            var custodial = false;
            for (kinds, 0..) |k, ki| {
                if (std.mem.eql(u8, k.name, arm.kind)) {
                    proto = k.proto;
                    custodial = custody[ki] != null;
                }
            }
            if (custodial) {
                const uf = alloc.alloc(ast.Field, 1) catch unreachable;
                uf[0] = ast.Field{
                    .name = alloc.dupe(u8, "__payload") catch unreachable,
                    .type = alloc.dupe(u8, proto) catch unreachable,
                    .phantom = null,
                };
                const obl_args = alloc.alloc(ast.Arg, 1) catch unreachable;
                obl_args[0] = ast.Arg{
                    .name = alloc.dupe(u8, "p") catch unreachable,
                    .value = alloc.dupe(u8, "__payload") catch unreachable,
                    .had_explicit_label = true,
                };
                const obl_segs = alloc.alloc([]const u8, 1) catch unreachable;
                obl_segs[0] = std.fmt.allocPrint(alloc, "__channel_obligate_{s}_{s}", .{ chan_name, arm.kind }) catch unreachable;
                const obl_inv = ast.Invocation{
                    .path = ast.DottedPath{
                        .module_qualifier = alloc.dupe(u8, flow.module) catch unreachable,
                        .segments = obl_segs,
                    },
                    .args = obl_args,
                    .return_binding = arm.cont.binding,
                };
                const inner = alloc.alloc(ast.Continuation, 1) catch unreachable;
                inner[0] = ast.Continuation{
                    .branch = "",
                    .binding = null,
                    .condition = null,
                    .node = arm.cont.node,
                    .indent = arm.cont.indent,
                    .continuations = arm.cont.continuations,
                };
                const synth_arm = ast.Continuation{
                    .branch = arm.cont.branch,
                    .binding = arm.cont.binding,
                    .condition = arm.cont.condition,
                    .kind = arm.cont.kind,
                    .node = ast.Node{ .invocation = obl_inv },
                    .indent = arm.cont.indent,
                    .continuations = inner,
                };
                emitVoidUnit(alloc, appended, prog, flow, std.fmt.allocPrint(alloc, "__channel_{s}_{s}_{d}", .{ chan_name, arm.kind, ai }) catch unreachable, &synth_arm, uf);
            } else {
                const uf = alloc.alloc(ast.Field, 1) catch unreachable;
                uf[0] = ast.Field{
                    .name = alloc.dupe(u8, arm.cont.binding.?) catch unreachable,
                    .type = alloc.dupe(u8, proto) catch unreachable,
                    .phantom = null,
                };
                emitVoidUnit(alloc, appended, prog, flow, std.fmt.allocPrint(alloc, "__channel_{s}_{s}_{d}", .{ chan_name, arm.kind, ai }) catch unreachable, arm.cont, uf);
            }
        }
        for (closed_arms, 0..) |arm, ci| {
            emitVoidUnit(alloc, appended, prog, flow, std.fmt.allocPrint(alloc, "__channel_{s}_closed_{d}", .{ chan_name, ci }) catch unreachable, arm.cont, &.{});
        }
    }

    // A custodial kind dequeues into `__payload` (the unit obligates it onto
    // the arm's own binding); plain kinds dequeue straight onto the binding.
    fn stepFieldName(kinds: []const CH.KindEntry, custody: []const ?[]const u8, kind: []const u8, binding: []const u8) []const u8 {
        for (kinds, 0..) |k, ki| {
            if (std.mem.eql(u8, k.name, kind) and custody[ki] != null) return "__payload";
        }
        return binding;
    }

    // The `take` call node for a custodial send, or null when the sent value
    // carries no issued obligation. Under a nested site the runner hands
    // over a site VIEW: `flow` is synthetic, its body IS the send's holding
    // continuation, and `site_of` points back into the real tree — the
    // sent binding's producer lives upstream in the containing flow.
    fn takeNode(alloc: std.mem.Allocator, prog: *const ast.Program, flow: *const ast.Flow, chan_name: []const u8, kind_name: []const u8, sent_value: []const u8) ?ast.Node {
        const home: *const ast.Flow = if (flow.site_of) |h|
            (flowContaining(prog, h) orelse flow)
        else
            flow;
        _ = custodyOf(prog, home, sent_value) orelse return null;
        const take_name = std.fmt.allocPrint(alloc, "__channel_take_{s}_{s}", .{ chan_name, kind_name }) catch unreachable;
        const take_segs = alloc.alloc([]const u8, 1) catch unreachable;
        take_segs[0] = take_name;
        if (findEventDecl(prog, flow.module, take_segs) == null) return null;
        const ta = alloc.alloc(ast.Arg, 1) catch unreachable;
        ta[0] = ast.Arg{
            .name = alloc.dupe(u8, "value") catch unreachable,
            .value = alloc.dupe(u8, sent_value) catch unreachable,
            .had_explicit_label = true,
        };
        return ast.Node{ .invocation = ast.Invocation{
            .path = ast.DottedPath{
                .module_qualifier = alloc.dupe(u8, flow.module) catch unreachable,
                .segments = take_segs,
            },
            .args = ta,
        } };
    }

    // A `!`-arm compiled into a callable void unit: event_decl + impl.
    // pump.kz's drained-unit convention — no return contract, the arm's
    // `|>` chain IS the body. An inline_code body lands as a proc_decl.
    // Custody-adjacent only by ownership: emitConsumerUnits is its sole
    // caller, so it rides in this part.
    fn emitVoidUnit(
        allocator: std.mem.Allocator,
        appended: *std.ArrayList(ast.Item),
        program: *const ast.Program,
        flow: *const ast.Flow,
        unit_name: []const u8,
        arm: *const ast.Continuation,
        input_fields: []const ast.Field,
    ) void {
        const ast_functional = @import("ast_functional");
        const host_is_js = std.mem.eql(u8, CompilerEnv.lang, "js");
        const retain_ann = blk_ra: {
            const anns = allocator.alloc([]const u8, 1) catch unreachable;
            anns[0] = allocator.dupe(u8, "retain") catch unreachable;
            break :blk_ra anns;
        };
        appended.append(allocator, ast.Item{ .event_decl = ast.EventDecl{
            .path = CH.mkPath(allocator, flow.module, unit_name),
            .input = ast.Shape{ .fields = input_fields },
            .branches = &[_]ast.Branch{},
            .return_type = null,
            .is_public = false,
            .is_implicit_flow = false,
            .annotations = retain_ann,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
        var aclone = ast_functional.cloneContinuation(allocator, arm) catch unreachable;
        CH.rewriteCont(allocator, &aclone, CH.storeHomes(allocator, program));
        const anode = aclone.node.?;
        if (anode == .inline_code) {
            appended.append(allocator, ast.Item{ .proc_decl = ast.ProcDecl{
                .path = CH.mkPath(allocator, flow.module, unit_name),
                .body = ast.Source{ .text = anode.inline_code, .location = flow.location, .scope = .{ .bindings = &[_]ast.ScopeBinding{} }, .phantom_type = null },
                .annotations = &[_][]const u8{},
                .target = allocator.dupe(u8, if (host_is_js) "js" else "zig") catch unreachable,
                .location = flow.location,
                .module = allocator.dupe(u8, flow.module) catch unreachable,
            } }) catch unreachable;
            return;
        }
        appended.append(allocator, ast.Item{ .flow = ast.Flow{
            .body = ast.rootSite(anode.invocation, aclone.continuations, flow.location),
            .pre_label = null,
            .impl_of = CH.mkPath(allocator, flow.module, unit_name),
            .super_shape = null,
            .inline_body = anode.invocation.inline_body,
            .preamble_code = anode.invocation.preamble_code,
            .is_pure = false,
            .is_transitively_pure = false,
            .location = flow.location,
            .module = allocator.dupe(u8, flow.module) catch unreachable,
        } }) catch unreachable;
    }
};
