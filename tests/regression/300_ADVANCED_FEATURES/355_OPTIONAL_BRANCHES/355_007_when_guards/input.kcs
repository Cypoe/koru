~proc process|cs {
    // Return warning with different levels based on value
    if (value > 100) {
        return new Output { tag = "warning", warning = ("Very large", 10) };
    }

    if (value > 50) {
        return new Output { tag = "warning", warning = ("Moderately large", 4) };
    }

    if (value > 20) {
        return new Output { tag = "warning", warning = ("Slightly large", 1) };
    }

    return new Output { tag = "success", success = value * 2 };
}